---
// Floating link back to the index. Hidden inside the home-page hover iframe and in captures (?shot).
---
<a href="/" id="back-pill" aria-label="Back to all skills">← All skills</a>
<style>
  #back-pill {
    position: fixed; left: 16px; bottom: 16px; z-index: 2147483647;
    padding: 8px 14px; border-radius: 999px;
    font: 500 13px/1 ui-sans-serif, system-ui, sans-serif; letter-spacing: 0.01em;
    color: #fff; background: rgb(0 0 0 / 0.72); backdrop-filter: blur(8px);
    border: 1px solid rgb(255 255 255 / 0.18); text-decoration: none;
  }
  #back-pill:hover { background: rgb(0 0 0 / 0.88); }
</style>
<script is:inline>
  if (window.self !== window.top || new URLSearchParams(location.search).has('shot')) {
    document.getElementById('back-pill')?.remove();
  }
</script>
