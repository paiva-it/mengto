---
// Inline Solar Duotone Bold glyph (data snapshot from api.iconify.design/solar.json).
// Inline SVG instead of <iconify-icon> so the secondary layer (<g opacity=".5">) is reachable from CSS:
// .duo-ember / .duo-white etc. recolour it via --duo-c / --duo-o without touching the primary shape.
import solar from './solar.json';

interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 24, class: cls = '', label } = Astro.props;
const icon = (solar.icons as Record<string, { body: string }>)[`${name}-bold-duotone`];
if (!icon) throw new Error(`solar icon missing: ${name}`);
---
<svg
  class:list={['sdb', cls]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={icon.body}
/>
