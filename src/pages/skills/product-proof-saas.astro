  .top nav a:hover { color: var(--ink); }
  .top-cta { display: flex; gap: 8px; justify-content: flex-end; }

  /* hero */
  .hero { position: relative; padding: 64px 0 88px; background: linear-gradient(#fff, var(--pale) 85%); }
  .grid-bg { position: absolute; inset: 0; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 72px 72px; background-position: -1px -1px; mask-image: linear-gradient(#000 60%, transparent); -webkit-mask-image: linear-gradient(#000 60%, transparent); pointer-events: none; }
  .hero-grid { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; align-items: center; }
