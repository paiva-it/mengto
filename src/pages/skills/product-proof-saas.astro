---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';
import { constraintOf, draftLines, eur, RATE, SAMPLE_NOTE, totals } from '../../components/skills/product-proof-saas/rules';

const lines = draftLines(SAMPLE_NOTE);
const constraint = constraintOf(SAMPLE_NOTE);
const t = totals(lines);
const hm = (m: number) => (m >= 60 ? `${Math.floor(m / 60)} h ${m % 60 ? `${m % 60} min` : ''}`.trim() : `${m} min`);

const steps = ['Intake', 'Matching', 'Draft', 'Edit', 'Approve', 'Send'];

const icons: Record<string, string> = {
  machine: '<rect x="3" y="10" width="18" height="10" rx="2"/><path d="M7 10V5h10v5"/><path d="M7 14h.01M11 14h.01M15 14h.01M8 17h8"/>',
  book: '<path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19V5M9 7h6"/>',
  box: '<path d="m3 7 9-4 9 4-9 4z"/><path d="M3 7v10l9 4 9-4V7M12 11v10"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>',
  history: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5M12 7v5l3 2"/>',
};

const features = [
  { icon: 'machine', title: 'Model cards', body: 'Each machine you service keeps its model, serial and past tickets, so a returning Olympia arrives with its history.' },
  { icon: 'book', title: 'Manual references', body: 'Draft lines point at the section of your own service manual they came from. You can always check the source.' },
  { icon: 'box', title: 'Parts shelf', body: 'Ribbons, springs and sent-out jobs are priced from your shelf, not guessed. Out of stock shows before you quote.' },
  { icon: 'clock', title: 'Bench time', body: 'Minutes per line are yours to set. The estimate is minutes × your hourly rate + parts, shown on every ticket.' },
  { icon: 'check', title: 'Customer approval', body: 'The customer sees one page with the lines, the total and one button. Nothing is touched before they press it.' },
  { icon: 'history', title: 'Version history', body: 'Every edit is a new version with who changed what. A quote can always be traced back to the customer’s first words.' },
];

const flow = [
  { n: '01', s: 'Intake', who: 'Counter', body: 'The customer’s words are saved as written. Model and year are typed in, not inferred.' },
  { n: '02', s: 'Matching', who: 'Escapement', body: 'The note is matched against your rule table. Unmatched notes become a bench inspection, never a guess.' },
  { n: '03', s: 'Draft', who: 'Escapement', body: 'Lines, manual references, parts and minutes appear as a draft labelled “not sent”.' },
  { n: '04', s: 'Edit', who: 'Technician', body: 'Change a line, the minutes or a part. Each save is a new version.' },
  { n: '05', s: 'Approve', who: 'Technician', body: 'A person signs the draft. Editing after approval withdraws the signature.' },
  { n: '06', s: 'Send', who: 'Customer', body: 'The customer gets the quote and decides. Work starts on their yes.' },
];

const samples = [
  { machine: 'Hermes 3000 · 1964', note: 'Keys are sluggish and the type bars jam when I type quickly. Paper slips at the bottom of the page.' },
  { machine: 'Smith-Corona Silent-Super · 1957', note: 'The margin bell never rings. Otherwise it types fine.' },
  { machine: 'Adler Tippa · 1972', note: 'Found it in an attic. Not sure what is wrong, it just feels off.' },
].map((s) => ({ ...s, lines: draftLines(s.note), t: totals(draftLines(s.note)) }));

const plans = [
  { id: 'bench', name: 'Bench', m: 0, y: 0, for: 'One technician, one bench.', cta: 'Start free' },
  { id: 'workshop', name: 'Workshop', m: 24, y: 20, for: 'A counter and a few benches.', cta: 'Start Workshop trial', pick: true },
  { id: 'guild', name: 'Guild', m: 68, y: 57, for: 'Several shops, one rule table.', cta: 'Start Guild trial' },
];

const compare: { label: string; faq?: string; v: string[] }[] = [
  { label: 'Seats', v: ['1', 'Up to 4', 'Up to 15'] },
  { label: 'Draft work orders / month', faq: 'faq-work-order', v: ['15', '300', '1,500'] },
  { label: 'Over the limit', faq: 'faq-overage', v: ['Drafting pauses', '€0.10 per draft', '€0.06 per draft'] },
  { label: 'Customer approval page', faq: 'faq-approval', v: ['E-mail link', 'Branded page', 'Branded page'] },
  { label: 'Own rule table', faq: 'faq-rules', v: ['5 rules', 'Unlimited', 'Shared across shops'] },
  { label: 'Version history', faq: 'faq-history', v: ['30 days', '12 months', 'Unlimited'] },
  { label: 'Parts shelf', v: ['—', 'Included', 'Included, per shop'] },
];

const faqs = [
  { id: 'faq-work-order', q: 'What counts as a draft work order?', a: 'One run from a customer note to a draft. Editing, approving, re-sending or reopening that draft does not count again. Replaying the sample on this page counts nothing.' },
  { id: 'faq-overage', q: 'What happens when I pass the monthly limit?', a: 'On Bench, drafting pauses until the 1st and every note you type is kept. On Workshop and Guild, extra drafts are billed per draft at the end of the month, and you can set a cap of zero to behave like Bench.' },
  { id: 'faq-approval', q: 'What does the customer see when they approve?', a: 'The machine, each line in plain words, minutes, parts and the total, and one approve button. They can also reply with a question instead. A signed quote cannot be edited, only replaced by a new version.' },
  { id: 'faq-rules', q: 'Where do the rules come from?', a: 'From you. Escapement ships with five starter rules (the ones driving the demo above); each rule is a few words to look for, a cause, a line and minutes. Nothing is matched by a language model.' },
  { id: 'faq-history', q: 'How long is version history kept?', a: 'Every version of every ticket for the period on your plan. Downgrading keeps tickets but trims versions older than the new period, after a 30-day notice.' },
  { id: 'faq-billing', q: 'Monthly or yearly?', a: 'Either. Yearly is billed once, up front, and the per-month price shown is that total divided by twelve. Prices are in EUR, excluding VAT.' },
];

const audiences = [
  { id: 'for-solo', tab: 'Solo bench', title: 'You are the counter and the bench.', body: 'Type the note while the customer is still standing there, read the draft back to them, and send the quote before they reach the door.', points: ['Draft at the counter, sign at the bench', 'Estimate shown in minutes and euros', 'Call-before-replacing notes kept on top'] },
  { id: 'for-shop', tab: 'Shop with a counter', title: 'The counter takes notes. The bench signs.', body: 'Counter staff never quote. They save the customer’s words; a technician opens the draft, edits it and is the only one who can approve.', points: ['Roles: counter, technician, owner', 'Approval needs a technician seat', 'Queue of drafts waiting for a signature'] },
  { id: 'for-restorer', tab: 'Collector restorer', title: 'Long jobs, many small decisions.', body: 'Restorations run for weeks. Split a machine into several quotes, keep every version, and let the collector approve one stage at a time.', points: ['One machine, several staged quotes', 'Full version trail for provenance', 'Sent-out jobs tracked as parts'] },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Escapement — the service desk for typewriter repair benches</title>
    <meta name="description" content="Escapement turns a customer's own words into a draft typewriter work order your technician edits, signs and sends." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="shell">
      <header class="top">
        <a class="brand" href="#top" aria-label="Escapement home"><span class="mark" aria-hidden="true">E</span>Escapement</a>
        <nav aria-label="Primary">
          <a href="#product">Product</a><a href="#workflow">Workflow</a><a href="#pricing">Pricing</a><a href="#faq">FAQ</a>
        </nav>
        <div class="top-cta"><a class="btn ghost sm" href="#pricing">Sign in</a><a class="btn dark sm" href="#pricing">Start a bench</a></div>
      </header>

      <main id="main">
        <!-- HERO -->
        <section class="hero" id="top">
          <div class="grid-bg" aria-hidden="true"></div>
          <div class="wrap hero-grid">
            <div class="hero-copy">
              <p class="chip mono"><i></i>Bench workflow · sample demo</p>
              <h1>From <span class="nw">&ldquo;it skips&rdquo;</span> to a signed work order.</h1>
              <p class="lede">Escapement turns the customer&rsquo;s own words into a draft typewriter work order&nbsp;&mdash; lines, manual references, parts and bench time&nbsp;&mdash; that your technician edits and signs before anything is quoted.</p>
              <div class="cta-row"><a class="btn dark" href="#stage">Try the sample</a><a class="btn ghost" href="#workflow">See how it works</a></div>
              <dl class="facts">
                <div><dt>6 states</dt><dd class="mono">Always visible</dd></div>
                <div><dt>0 auto-quotes</dt><dd class="mono">A person signs</dd></div>
                <div><dt>Your rules</dt><dd class="mono">No model guessing</dd></div>
              </dl>
            </div>

            <div class="stage" id="stage" data-state="draft">
              <div class="stage-in">
                <div class="st-head">
                  <span class="mono">Intake #0417 / <span id="ver">v02</span></span>
                  <span class="pill mono" id="pill"><i></i><span id="status">Draft ready</span></span>
                </div>
                <ol class="steps mono" aria-label="Workflow state">
                  {steps.map((s, i) => <li data-step={s.toLowerCase()} class={i < 3 ? 'done' : ''} aria-current={i === 2 ? 'step' : undefined}><span>{String(i + 1).padStart(2, '0')}</span>{s}</li>)}
                </ol>
                <div class="st-body">
                  <form class="st-input" id="intake" novalidate>
                    <p class="lbl mono">Input · customer&rsquo;s words</p>
                    <h2 class="machine">Olympia SM3 <span>· 1961</span></h2>
                    <label for="note" class="sr-only">Customer note</label>
                    <textarea id="note" rows="6" spellcheck="false">{SAMPLE_NOTE}</textarea>
                    <div class="sim">
                      <label class="mono" for="sim">Simulate</label>
                      <select id="sim">
                        <option value="ok">Normal run</option>
                        <option value="quota">Quota reached</option>
                        <option value="network">Network drop</option>
                        <option value="flag">Flagged wording</option>
                        <option value="error">Rule set unavailable</option>
                      </select>
                    </div>
                    <button class="btn signal run" id="run" type="submit">Draft work order</button>
                    <p class="hint mono">Sample rules · fixed timing · no model call</p>
                  </form>

                  <section class="st-out" aria-labelledby="out-h">
                    <div class="out-head mono"><span id="out-h">Draft work order</span><span class="tag" id="tag">Sample · not sent</span></div>
                    <div class="msg" id="msg" role="status" aria-live="polite" hidden></div>
                    <div class="proc" id="proc" hidden>
                      <ol class="mono">
                        <li data-p="0">Reading the note</li>
                        <li data-p="1">Matching sample rules</li>
                        <li data-p="2">Pricing bench time at {eur(RATE)}/h</li>
                      </ol>
                      <div class="bar"><span id="procbar"></span></div>
                    </div>
                    <div class="lines" id="lines">
                      {lines.map((l, i) => (
                        <button type="button" class={`line${i === 0 ? ' sel' : ''}`} data-i={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                          <span class="mono k">{String(i + 1).padStart(2, '0')} · {l.area}</span>
                          <strong>{l.line}</strong>
                          <span class="why">{l.cause}.</span>
                          <span class="mono meta">{l.minutes} min · {l.ref}{l.parts.length ? ` · ${l.parts.map((p) => p.name).join(', ')}` : ''}</span>
                        </button>
                      ))}
                    </div>
                    <p class="constraint" id="constraint" hidden={!constraint}><span class="mono">Note</span>{constraint}</p>
                    <dl class="totals" id="totals">
                      <div><dt class="mono">Bench time</dt><dd>{hm(t.minutes)}</dd></div>
                      <div><dt class="mono">Parts</dt><dd>{eur(t.parts)}</dd></div>
                      <div><dt class="mono">Estimate</dt><dd>{eur(t.estimate)}</dd></div>
                    </dl>
                    <div class="actions">
                      <button type="button" class="btn ghost sm" id="edit">Edit line</button>
                      <button type="button" class="btn dark sm" id="approve">Approve</button>
                      <button type="button" class="btn ghost sm" id="send" disabled>Send quote</button>
                    </div>
                  </section>
                </div>
                <div class="st-foot">
                  <details class="pop" id="hist">
                    <summary class="mono">History (<span id="histn">2</span>)</summary>
                    <ol id="histlist"><li><b>v01</b> Intake saved</li><li><b>v02</b> Draft from sample rules</li></ol>
                  </details>
                  <details class="pop" id="trans">
                    <summary class="mono">Transcript</summary>
                    <ol id="translist"><li>Intake saved as written (v01).</li><li>Matched 2 sample rules: escapement, ribbon feed.</li><li>Draft ready, not sent (v02).</li></ol>
                  </details>
                  <span class="grow"></span>
                  <button type="button" class="link mono" id="copy">Copy transcript</button>
                  <button type="button" class="link mono" id="replay">Replay</button>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- FRICTION -->
        <section class="sec" id="product">
          <div class="wrap">
            <div class="sec-head">
              <p class="eyebrow mono">The friction</p>
              <h2>The note says &ldquo;it skips&rdquo;. The bench needs six answers.</h2>
              <p>Customers describe what they hear and feel. A ticket needs a mechanism, a manual page, parts, minutes and a yes. Escapement fills the gap in the open, and leaves the blanks blank.</p>
            </div>
            <div class="ba">
              <article class="ba-card">
                <p class="mono lbl">What arrives at the counter</p>
                <blockquote>&ldquo;{SAMPLE_NOTE}&rdquo;</blockquote>
                <p class="mono small">Olympia SM3 · 1961 · handed in Tuesday</p>
                <p class="missing"><span class="mono">Not in the note</span>Mechanism · manual page · parts · minutes · approval</p>
              </article>
              <div class="ba-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></div>
              <article class="ba-card need">
                <p class="mono lbl">What the bench needs before work starts</p>
                <ul class="checks">
                  <li class="ok"><span>Model &amp; year</span><em class="mono">from counter</em></li>
                  <li class="ok"><span>Mechanism: escapement, ribbon feed</span><em class="mono">from rules</em></li>
                  <li class="ok"><span>Manual §4.2, §6.1</span><em class="mono">from rules</em></li>
                  <li class="ok"><span>Parts: one nylon ribbon</span><em class="mono">from shelf</em></li>
                  <li class="ok"><span>{t.minutes} min at {eur(RATE)}/h</span><em class="mono">from your rate</em></li>
                  <li class="todo"><span>Customer&rsquo;s yes</span><em class="mono">only they give it</em></li>
                </ul>
              </article>
            </div>
          </div>
        </section>

        <!-- FEATURES -->
        <section class="sec tint">
          <div class="wrap">
            <div class="sec-head">
              <p class="eyebrow mono">What it does</p>
              <h2>Every module feeds the work order.</h2>
            </div>
            <div class="feat">
              {features.map((f) => (
                <article>
                  <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[f.icon]} /></span>
                  <h3>{f.title}</h3>
                  <p>{f.body}</p>
                </article>
              ))}
            </div>
          </div>
        </section>

        <!-- WORKFLOW -->
        <section class="sec" id="workflow">
          <div class="wrap">
            <div class="sec-head">
              <p class="eyebrow mono">Workflow</p>
              <h2>Six states. Escapement owns only two.</h2>
              <p>There is no one-click repair. Escapement drafts; a technician signs; the customer decides.</p>
            </div>
            <ol class="flow">
              {flow.map((f) => (
                <li class={f.who === 'Escapement' ? '' : 'human'}>
                  <span class="mono n">{f.n}</span>
                  <h3>{f.s}</h3>
                  <span class="mono who">{f.who}</span>
                  <p>{f.body}</p>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <!-- AUDIENCES -->
        <section class="sec tint" id="audiences">
          <div class="wrap">
            <div class="sec-head">
              <p class="eyebrow mono">Who it is for</p>
              <h2>Same ticket, different benches.</h2>
            </div>
            <div class="tabs" role="tablist" aria-label="Audience">
              {audiences.map((a, i) => <button role="tab" id={`tab-${a.id}`} aria-controls={a.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{a.tab}</button>)}
            </div>
            {audiences.map((a) => (
              <div class="panel" role="tabpanel" id={a.id} aria-labelledby={`tab-${a.id}`}>
                <div>
                  <h3>{a.title}</h3>
                  <p>{a.body}</p>
                </div>
                <ul class="mono">{a.points.map((p) => <li>{p}</li>)}</ul>
              </div>
            ))}
          </div>
        </section>

        <!-- PROOF -->
        <section class="sec">
          <div class="wrap">
            <div class="sec-head">
              <p class="eyebrow mono">Sample tickets</p>
              <h2>Three notes, run through the same five rules.</h2>
              <p>These notes were written for this page and drafted by the rule table in the demo above. No customer, shop or result here is real.</p>
            </div>
            <div class="tickets">
              {samples.map((s) => (
                <article class="ticket">
                  <div class="t-head mono"><span>{s.machine}</span><span class="tag">Sample</span></div>
                  <p class="t-note">&ldquo;{s.note}&rdquo;</p>
                  <ul>
                    {s.lines.map((l) => <li><span>{l.line}</span><em class="mono">{l.minutes} min</em></li>)}
                  </ul>
                  <div class="t-foot mono"><span>{s.lines.length} {s.lines.length === 1 ? 'line' : 'lines'}</span><span>Estimate {eur(s.t.estimate)}</span></div>
                </article>
              ))}
            </div>
          </div>
        </section>

        <!-- PRICING -->
        <section class="sec tint" id="pricing">
          <div class="wrap">
            <div class="sec-head row">
              <div>
                <p class="eyebrow mono">Pricing</p>
                <h2>Priced per bench, counted per draft.</h2>
              </div>
              <fieldset class="cadence">
                <legend class="sr-only">Billing cadence</legend>
                <label><input type="radio" name="cad" value="m" checked /><span>Monthly</span></label>
                <label><input type="radio" name="cad" value="y" /><span>Yearly</span></label>
              </fieldset>
            </div>
            <div class="plans">
              {plans.map((p) => (
                <article class={`plan${p.pick ? ' pick' : ''}`}>
                  <div class="p-top"><h3>{p.name}</h3>{p.pick && <span class="mono tag">Most benches</span>}</div>
                  <p class="price"><span class="amt" data-m={eur(p.m)} data-y={eur(p.y)}>{eur(p.m)}</span><span class="per mono">/ month</span></p>
                  <p class="mono cadnote" data-m={p.m ? "Billed monthly" : "No card needed"} data-y={p.y ? `Billed ${eur(p.y * 12)} yearly` : "No card needed"}>{p.m ? "Billed monthly" : "No card needed"}</p>
                  <p class="for">{p.for}</p>
                  <button type="button" class={`btn ${p.pick ? 'dark' : 'ghost'} plan-cta`} data-plan={p.name}>{p.cta}</button>
                  <p class="mono plan-msg" role="status" aria-live="polite"></p>
                </article>
              ))}
            </div>
            <div class="table-wrap" id="compare">
              <table>
                <caption class="sr-only">Plan comparison</caption>
                <thead><tr><th scope="col">Shared limits</th>{plans.map((p) => <th scope="col">{p.name}</th>)}</tr></thead>
                <tbody>
                  {compare.map((r) => (
                    <tr>
                      <th scope="row">{r.faq ? <a href={`#${r.faq}`}>{r.label}<sup class="mono">?</sup></a> : r.label}</th>
                      {r.v.map((v) => <td>{v}</td>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="foot mono">Prices in EUR excl. VAT. Escapement is a fictional product &mdash; nothing can be bought from this page.</p>
          </div>
        </section>

        <!-- FAQ -->
        <section class="sec" id="faq">
          <div class="wrap faq-grid">
            <div class="sec-head">
              <p class="eyebrow mono">FAQ</p>
              <h2>The terms in the table, in plain words.</h2>
              <p><a href="#compare" class="back mono">&larr; Back to the comparison</a></p>
            </div>
            <div class="faqs">
              {faqs.map((f) => (
                <details id={f.id}>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          </div>
        </section>
      </main>

      <footer class="ft">
        <div class="wrap">
          <div class="ft-top">
            <div>
              <a class="brand" href="#top"><span class="mark" aria-hidden="true">E</span>Escapement</a>
              <p>The service desk for typewriter repair benches. Drafts are proposals; people sign.</p>
            </div>
            <nav aria-label="Footer" class="ft-links">
              <div><p class="mono">Product</p><a href="#workflow">Workflow</a><a href="#pricing">Pricing</a><a href="#faq">FAQ</a></div>
              <div><p class="mono">Trust</p><a href="#faq-rules">How rules work</a><a href="#faq-history">Data &amp; history</a><a href="#faq-approval">Approvals</a></div>
              <div><p class="mono">Legal</p><a href="#top">Terms</a><a href="#top">Privacy</a><a href="#top">Imprint</a></div>
            </nav>
          </div>
          <p class="mono ft-note">A fictional product made for a design study. Every ticket on this page is a labelled sample.</p>
        </div>
      </footer>
    </div>
    <BackPill />
  </body>
</html>

<script>
  import { constraintOf, draftLines, eur, SAMPLE_NOTE, totals } from '../../components/skills/product-proof-saas/rules';
  import type { Line } from '../../components/skills/product-proof-saas/rules';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const STEPS = ['intake', 'matching', 'draft', 'edit', 'approve', 'send'];

  const stage = $('stage');
  const note = $<HTMLTextAreaElement>('note');
  const sim = $<HTMLSelectElement>('sim');
  const run = $<HTMLButtonElement>('run');
  const msg = $('msg');
  const proc = $('proc');
  const linesEl = $('lines');
  const totalsEl = $('totals');
  const constraintEl = $('constraint');
  const editBtn = $<HTMLButtonElement>('edit');
  const approveBtn = $<HTMLButtonElement>('approve');
  const sendBtn = $<HTMLButtonElement>('send');
  const tag = $('tag');

  let lines: Line[] = draftLines(SAMPLE_NOTE);
  let selected = 0;
  let version = 2;
  let timers: number[] = [];
  let transcript: string[] = ['Intake saved as written (v01).', 'Matched 2 sample rules: escapement, ribbon feed.', 'Draft ready, not sent (v02).'];
  const versions: [number, string][] = [[1, 'Intake saved'], [2, 'Draft from sample rules']];

  const hm = (m: number) => (m >= 60 ? `${Math.floor(m / 60)} h ${m % 60 ? `${m % 60} min` : ''}`.trim() : `${m} min`);
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  const STATUS: Record<string, string> = {
    intake: 'Intake', matching: 'Matching', draft: 'Draft ready', edit: 'Editing', approve: 'Approved', send: 'Sent · sample', error: 'Needs attention',
  };

  const log = (line: string) => {
    transcript.push(line);
    $('translist').innerHTML = transcript.map((l) => `<li>${esc(l)}</li>`).join('');
  };
  const bump = (label: string) => {
    version += 1;
    versions.push([version, label]);
    $('ver').textContent = `v${String(version).padStart(2, '0')}`;
    $('histn').textContent = String(versions.length);
    $('histlist').innerHTML = versions.map(([v, l]) => `<li><b>v${String(v).padStart(2, '0')}</b> ${esc(l)}</li>`).join('');
  };

  const setState = (s: string) => {
    stage.dataset.state = s;
    $('status').textContent = STATUS[s];
    const at = s === 'error' ? 1 : STEPS.indexOf(s);
    stage.querySelectorAll<HTMLLIElement>('.steps li').forEach((li, i) => {
      li.classList.toggle('done', i <= at && s !== 'error');
      li.classList.toggle('err', s === 'error' && i === at);
      if (i === at) {
        li.setAttribute('aria-current', 'step');
      } else {
        li.removeAttribute('aria-current');
      }
    });
    const hasDraft = ['draft', 'edit', 'approve', 'send'].includes(s);
    editBtn.disabled = !hasDraft || s === 'send';
    approveBtn.disabled = s !== 'draft';
    sendBtn.disabled = s !== 'approve';
    run.disabled = false;
    note.readOnly = s === 'matching';
    tag.textContent = s === 'send' ? 'Sample · nothing was sent' : s === 'approve' ? 'Signed · not sent' : 'Sample · not sent';
    editBtn.textContent = s === 'edit' ? 'Cancel' : 'Edit line';
    approveBtn.textContent = s === 'edit' ? 'Save' : 'Approve';
    if (s === 'edit') {
      approveBtn.disabled = false;
    }
  };

  const showMsg = (text: string, kind: string, actions = '') => {
    msg.hidden = false;
    msg.className = `msg ${kind}`;
    msg.innerHTML = `<p>${text}</p>${actions}`;
  };
  const hideMsg = () => {
    msg.hidden = true;
  };

  const renderLines = (editing = false) => {
    linesEl.classList.remove('in');
    linesEl.innerHTML = lines
      .map((l, i) => {
        const sel = i === selected;
        if (editing && sel) {
          return `<div class="line sel editing" data-i="${i}">
            <span class="mono k">${String(i + 1).padStart(2, '0')} · ${esc(l.area)} · editing</span>
            <label class="sr-only" for="ed-line">Line</label><input id="ed-line" value="${esc(l.line)}" />
            <label class="mono ed-min" for="ed-min">Minutes <input id="ed-min" type="number" min="5" max="600" step="5" value="${l.minutes}" /></label>
          </div>`;
        }
        const parts = l.parts.length ? ` · ${l.parts.map((p) => esc(p.name)).join(', ')}` : '';
        return `<button type="button" class="line${sel ? ' sel' : ''}" data-i="${i}" aria-pressed="${sel}" style="--d:${i * 55}ms">
          <span class="mono k">${String(i + 1).padStart(2, '0')} · ${esc(l.area)}</span>
          <strong>${esc(l.line)}</strong>
          <span class="why">${esc(l.cause)}.</span>
          <span class="mono meta">${l.minutes} min · ${esc(l.ref)}${parts}</span>
        </button>`;
      })
      .join('');
    const t = totals(lines);
    totalsEl.innerHTML = `<div><dt class="mono">Bench time</dt><dd>${hm(t.minutes)}</dd></div><div><dt class="mono">Parts</dt><dd>${eur(t.parts)}</dd></div><div><dt class="mono">Estimate</dt><dd>${eur(t.estimate)}</dd></div>`;
  };

  const clear = () => {
    timers.forEach(clearTimeout);
    timers = [];
  };
  const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, reduce ? 0 : ms));

  const ERRORS: Record<string, [string, string]> = {
    quota: ['Bench plan: 15 of 15 drafts used this month. Your note is kept; drafting resumes on the 1st.', '<a class="link mono" href="#pricing">See plans</a>'],
    network: ['Connection dropped while matching. Your note is saved on this device.', '<button type="button" class="link mono" data-act="retry">Retry</button>'],
    error: ['The rule set could not be loaded. Nothing was drafted or changed.', '<button type="button" class="link mono" data-act="retry">Retry</button>'],
  };

  const fail = (kind: string) => {
    clear();
    resetRun();
    proc.hidden = true;
    linesEl.hidden = false;
    setState('error');
    const [text, act] = ERRORS[kind];
    showMsg(text, 'bad', act);
    log(`Run stopped: ${kind === 'quota' ? 'quota reached' : kind === 'network' ? 'network dropped' : 'rule set unavailable'}. Previous draft unchanged.`);
    if (kind === 'network') {
      sim.value = 'ok'; // ponytail: a network drop is a one-shot fault so Retry can succeed
    }
  };

  const resetRun = () => {
    run.textContent = 'Draft work order';
    delete run.dataset.busy;
  };

  const start = () => {
    const text = note.value.trim();
    hideMsg();
    if (!text) {
      setState('error');
      showMsg('Add the customer’s words first. The draft is built only from what they said.', 'warn');
      note.focus();
      return;
    }
    if (sim.value === 'flag' || /\d{3}[\s-]?\d{3}[\s-]?\d{3}/.test(text)) {
      setState('error');
      showMsg('The note holds a phone number or flagged wording. Contact details belong in the customer record — edit the note and draft again.', 'warn');
      log('Held for review: note contains flagged wording. Nothing drafted.');
      return;
    }
    if (sim.value === 'quota') {
      fail('quota');
      return;
    }
    clear();
    setState('matching');
    run.textContent = 'Cancel';
    run.dataset.busy = '1';
    linesEl.hidden = true;
    constraintEl.hidden = true;
    proc.hidden = false;
    const items = proc.querySelectorAll('li');
    items.forEach((li) => li.classList.remove('on', 'done'));
    const bar = $('procbar');
    bar.style.width = '0%';
    log('Draft requested from the note as written.');
    [0, 1, 2].forEach((p) =>
      later(() => {
        items.forEach((li, i) => {
          li.classList.toggle('done', i < p);
          li.classList.toggle('on', i === p);
        });
        bar.style.width = `${(p + 1) * 33.3}%`;
        if (p === 1 && sim.value === 'network') {
          later(() => fail('network'), 300);
        }
        if (p === 1 && sim.value === 'error') {
          later(() => fail('error'), 300);
        }
      }, p * 520),
    );
    later(() => {
      if (stage.dataset.state !== 'matching') {
        return;
      }
      lines = draftLines(text);
      selected = 0;
      proc.hidden = true;
      linesEl.hidden = false;
      renderLines();
      void linesEl.offsetWidth;
      linesEl.classList.add('in');
      const c = constraintOf(text);
      constraintEl.hidden = !c;
      constraintEl.innerHTML = `<span class="mono">Note</span>${c ?? ''}`;
      resetRun();
      setState('draft');
      bump('Draft from sample rules');
      log(`Matched ${lines.length} ${lines.length === 1 ? 'line' : 'lines'}: ${lines.map((l) => l.area.toLowerCase()).join(', ')}. Draft ready, not sent.`);
    }, 1700);
  };

  const cancel = () => {
    clear();
    resetRun();
    proc.hidden = true;
    linesEl.hidden = false;
    constraintEl.hidden = !constraintOf(note.value);
    setState('draft');
    showMsg('Cancelled. The previous draft is unchanged.', 'info');
    log('Run cancelled by the user. Previous draft kept.');
  };

  $('intake').addEventListener('submit', (e) => {
    e.preventDefault();
    if (run.dataset.busy) {
      cancel();
      return;
    }
    start();
  });
  note.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      $<HTMLFormElement>('intake').requestSubmit();
    }
  });
  msg.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).dataset.act === 'retry') {
      start();
    }
  });

  linesEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button.line');
    if (!b || stage.dataset.state === 'edit') {
      return;
    }
    selected = Number(b.dataset.i);
    linesEl.querySelectorAll('button.line').forEach((x, i) => {
      x.classList.toggle('sel', i === selected);
      x.setAttribute('aria-pressed', String(i === selected));
    });
  });

  editBtn.addEventListener('click', () => {
    hideMsg();
    if (stage.dataset.state === 'edit') {
      renderLines();
      setState('draft');
      return;
    }
    if (stage.dataset.state === 'approve') {
      log('Editing withdrew the signature.');
    }
    setState('edit');
    renderLines(true);
    $<HTMLInputElement>('ed-line').focus();
  });

  approveBtn.addEventListener('click', () => {
    if (stage.dataset.state === 'edit') {
      const name = $<HTMLInputElement>('ed-line').value.trim();
      const min = Math.round(Number($<HTMLInputElement>('ed-min').value));
      if (!name || !(min >= 5 && min <= 600)) {
        showMsg('A line needs a name and 5–600 minutes.', 'warn');
        return;
      }
      lines[selected] = { ...lines[selected], line: name, minutes: min };
      renderLines();
      hideMsg();
      setState('draft');
      bump(`Edited line ${selected + 1}`);
      log(`Technician edited line ${selected + 1}: “${name}”, ${min} min.`);
      return;
    }
    setState('approve');
    bump('Approved by technician');
    log('Draft approved by the technician. Not sent yet.');
  });

  sendBtn.addEventListener('click', () => {
    setState('send');
    showMsg('Quote marked as sent. This is a sample — no e-mail left this page.', 'info');
    log('Quote marked as sent (sample — nothing was sent).');
  });

  $('copy').addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(transcript.map((l, i) => `${i + 1}. ${l}`).join('\n'));
      b.textContent = 'Copied';
    } catch {
      b.textContent = 'Copy failed — open Transcript';
    }
    setTimeout(() => (b.textContent = 'Copy transcript'), 1800);
  });

  $('replay').addEventListener('click', () => {
    note.value = SAMPLE_NOTE;
    sim.value = 'ok';
    transcript = [];
    log('Replay: sample note restored.');
    start();
  });

  // Audience tabs: every panel stays in the DOM, hash deep-links pick one.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role=tab]')];
  const pick = (t: HTMLButtonElement, focus = false) => {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      $(x.getAttribute('aria-controls')!).hidden = !on;
    });
    if (focus) {
      t.focus();
    }
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => {
      pick(t);
      history.replaceState(null, '', `#${t.getAttribute('aria-controls')}`);
    });
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (d) {
        pick(tabs[(i + d + tabs.length) % tabs.length], true);
      }
    });
  });

  const fromHash = () => {
    const id = location.hash.slice(1);
    const tab = tabs.find((t) => t.getAttribute('aria-controls') === id);
    pick(tab ?? tabs[0]);
    const d = id && document.getElementById(id);
    if (d instanceof HTMLDetailsElement) {
      d.open = true;
    }
  };
  fromHash();
  addEventListener('hashchange', fromHash);

  // Cadence + plan CTAs
  document.querySelectorAll<HTMLInputElement>('input[name=cad]').forEach((r) =>
    r.addEventListener('change', () => {
      document.querySelectorAll<HTMLElement>('[data-m][data-y]').forEach((el) => {
        el.textContent = el.dataset[r.value as 'm' | 'y'] ?? '';
      });
    }),
  );
  document.querySelectorAll<HTMLButtonElement>('.plan-cta').forEach((b) =>
    b.addEventListener('click', () => {
      const out = b.nextElementSibling as HTMLElement;
      const label = b.textContent;
      b.disabled = true;
      b.setAttribute('aria-busy', 'true');
      b.textContent = 'Starting…';
      out.textContent = '';
      setTimeout(() => {
        b.disabled = false;
        b.removeAttribute('aria-busy');
        b.textContent = label;
        out.textContent = `Not created: ${b.dataset.plan} is a sample plan on a design study. Your selection is kept.`;
      }, reduce ? 0 : 700);
    }),
  );
</script>

<style is:global>
