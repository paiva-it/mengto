  h1 { margin: 0; font-size: clamp(44px, 5vw, 72px); line-height: 0.98; letter-spacing: -0.045em; font-weight: 600; text-wrap: balance; }
  .nw { white-space: nowrap; }
  .lede { margin: 24px 0 0; max-width: 30em; font-size: 17px; line-height: 1.55; color: var(--ink-2); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
  .facts { display: flex; flex-wrap: wrap; gap: 14px 36px; margin: 40px 0 0; }
  .facts dt { font-weight: 600; font-size: 17px; letter-spacing: -0.02em; }
  .facts dd { margin: 4px 0 0; color: var(--ink-3); font-size: 10px; }

  /* product stage */
  .stage-in { padding: 8px; border-radius: 20px; background: rgb(255 255 255 / 0.7); border: 1px solid var(--line); box-shadow: 0 1px 2px rgb(13 17 23 / 0.04), 0 24px 60px -24px rgb(25 60 110 / 0.22); }
  .st-head, .steps, .st-body, .st-foot { background: #fff; border: 1px solid var(--line); }
  .st-head { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-radius: 12px 12px 0 0; border-bottom: 0; color: var(--ink-2); }
  .pill { display: inline-flex; align-items: center; gap: 7px; color: var(--ink); }
  [data-state='matching'] .pill i { animation: blink 1s steps(2) infinite; }
  [data-state='error'] .pill i { background: var(--bad); }
  [data-state='approve'] .pill i, [data-state='send'] .pill i { background: #1a7f4b; }
  @keyframes blink { 50% { opacity: 0.25; } }
  .steps { display: grid; grid-template-columns: repeat(6, 1fr); margin: 0; padding: 0; list-style: none; border-bottom: 0; }
  .steps li { position: relative; padding: 10px 10px 11px; font-size: 10px; color: var(--ink-3); border-right: 1px solid var(--line); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .steps li:last-child { border-right: 0; }
  .steps li span { margin-right: 6px; opacity: 0.6; }
  .steps li::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: transparent; transition: background 420ms; }
  .steps li.done { color: var(--ink); }
  .steps li.done::after { background: var(--sig); }
  .steps li[aria-current='step'] { background: var(--sig-soft); color: var(--sig); }
  .steps li.err { background: #fdecea; color: var(--bad); }
  .st-body { display: grid; grid-template-columns: 236px 1fr; }
  .st-input { padding: 18px; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 12px; }
  .lbl { margin: 0; color: var(--ink-3); font-size: 10px; }
  .machine { margin: -4px 0 0; font-size: 20px; letter-spacing: -0.02em; font-weight: 600; }
  .machine span { color: var(--ink-3); font-weight: 500; }
  textarea { width: 100%; box-sizing: border-box; resize: vertical; min-height: 140px; padding: 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--pale); font: 13.5px/1.55 var(--sans); color: var(--ink); }
  textarea:focus { outline: none; border-color: var(--sig-line); box-shadow: 0 0 0 3px var(--sig-soft); background: #fff; }
  textarea[readonly] { color: var(--ink-3); }
  .sim { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .sim label { color: var(--ink-3); font-size: 10px; }
  .sim select { flex: 1; min-width: 0; height: 30px; border: 1px solid var(--line); border-radius: 8px; background: #fff; font: 12px var(--sans); color: var(--ink); padding: 0 6px; }
  .run { width: 100%; }
  .hint { margin: 0; font-size: 9.5px; color: var(--ink-3); text-align: center; }
  .st-out { padding: 18px; background: linear-gradient(#fbfdff, var(--pale)); display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .out-head { display: flex; justify-content: space-between; gap: 8px; color: var(--ink-3); font-size: 10px; }
  .tag { color: var(--ink-2); }
  .lines { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .line { display: flex; flex-direction: column; gap: 6px; text-align: left; padding: 14px; border: 1px solid var(--line); border-radius: 12px; background: #fff; font: inherit; color: inherit; cursor: pointer; transition: border-color 180ms, background 180ms, box-shadow 180ms; }
  .line:hover { border-color: var(--line-2); }
  .line.sel { border-color: var(--sig-line); background: var(--sig-soft); box-shadow: inset 0 0 0 1px var(--sig-line); }
  .line .k { font-size: 9.5px; color: var(--ink-3); }
  .line.sel .k { color: var(--sig); }
  .line strong { font-size: 15.5px; line-height: 1.25; letter-spacing: -0.015em; font-weight: 600; }
  .line .why { font-size: 12.5px; line-height: 1.45; color: var(--ink-2); }
  .line .meta { font-size: 9.5px; color: var(--ink-3); margin-top: auto; padding-top: 4px; text-transform: none; letter-spacing: 0.02em; }
  .line input { font: 600 15px var(--sans); width: 100%; box-sizing: border-box; padding: 8px 10px; border: 1px solid var(--sig-line); border-radius: 8px; background: #fff; min-width: 0; }
  .ed-min { display: flex; align-items: center; gap: 8px; font-size: 10px; color: var(--ink-2); }
  .ed-min input { width: 72px; font: 500 13px var(--mono); }
  .lines.in .line { animation: rise 520ms cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: var(--d, 0ms); }
  @keyframes rise { from { opacity: 0; transform: translateY(8px); } }
