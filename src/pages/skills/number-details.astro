---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

const pad = (n: number) => String(n).padStart(2, '0');

const shows = [
  {
    name: 'The Slow Commute',
    line: 'Train-window conversations with people who chose the long route to work.',
    cadence: 'Weekly · Tue',
    length: '38 min',
    cover: 'cover-rings',
  },
  {
    name: 'Night Shift Botany',
    line: 'A gardener and a nurse walk greenhouses after midnight and talk about what grows in the dark.',
    cadence: 'Fortnightly',
    length: '52 min',
    cover: 'cover-stems',
  },
  {
    name: 'Small Claims',
    line: 'One petty dispute per episode, argued in full by both sides, settled by a retired judge.',
    cadence: 'Weekly · Fri',
    length: '29 min',
    cover: 'cover-dots',
  },
  {
    name: 'Overheard in Transit',
    line: 'Unscripted tape from ferries, night buses and airport gates, cut into short stories.',
    cadence: 'Monthly',
    length: '61 min',
    cover: 'cover-lines',
  },
];

const steps = [
  ['Pitch', 'A one-page letter, no deck. We read every one before the first Monday of the month.'],
  ['Pilot', 'Two paid test episodes, recorded on location. We keep the rough edges that sound true.'],
  ['Season plan', 'Eight to twelve episodes mapped on one wall, with a fact-checker assigned from day one.'],
  ['Record', 'Field kits, not booths — about fourteen hours of tape for every hour you hear.'],
  ['Release', 'Same hour every week, with full transcripts and chapter marks on day one.'],
];

const episodes = [
  ['The 06:12 from Ghent, every weekday for nine years', 'The Slow Commute', '41:08'],
  ['Moonflowers, and the nurse who times them', 'Night Shift Botany', '54:30'],
  ['Whose hedge is it, really?', 'Small Claims', '27:45'],
  ['Gate B14: fog delay, four strangers and a ukulele', 'Overheard in Transit', '62:10'],
  ['The cyclist who refuses the shortcut', 'The Slow Commute', '36:52'],
  ['One borrowed casserole dish, eleven months later', 'Small Claims', '31:19'],
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Static House — Podcasts that take the long way round</title>
    <meta name="description" content="Static House is an independent podcast network of four slow, field-recorded shows." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <BackPill />
    <div class="page">
      <header class="bar wrap">
        <a class="logo" href="#top" aria-label="Static House home">
          <span class="logo-mark" aria-hidden="true"></span>Static House
        </a>
        <nav aria-label="Primary">
          <a href="#shows">Shows</a>
          <a href="#process">How we work</a>
          <a href="#episodes">Episodes</a>
          <a href="#pitch">Pitch</a>
        </nav>
        <span class="onair" aria-label="New episode out today">
          <span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          New today
        </span>
      </header>

      <main id="top">
        <!-- 01 · Network -->
        <section class="sec hero wrap" id="shows" aria-labelledby="hero-title">
          <div class="rail" aria-hidden="true"><span class="num">01</span></div>
          <div class="body">
            <p class="label">Network · Four shows · Since 2019</p>
            <div class="hero-top">
              <h1 id="hero-title">Podcasts that take the <em>long way</em> round.</h1>
              <div class="hero-side">
                <p>Static House makes slow, field-recorded audio. No studios, no ad reads in the middle of a sentence — just four shows we would listen to on a train with no signal.</p>
                <div class="ctas">
                  <a class="btn" href="#episodes">Start listening</a>
                  <a class="btn ghost" href="#pitch">Pitch a show</a>
                </div>
              </div>
            </div>
            <ol class="shows">
              {shows.map((s, i) => (
                <li class="show">
                  <div class="show-head">
                    <span class="num" aria-hidden="true">{pad(i + 1)}</span>
                    <span class="rule" aria-hidden="true"></span>
                    <span class="meta">{s.cadence}</span>
                  </div>
                  <div class={`cover ${s.cover}`} aria-hidden="true">
                    <span>{s.name}</span>
                  </div>
                  <h2>{s.name}</h2>
                  <p>{s.line}</p>
                  <span class="meta">Avg {s.length}</span>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <!-- 02 · Process -->
        <section class="sec wrap" id="process" aria-labelledby="process-title">
          <div class="rail" aria-hidden="true"><span class="num">02</span></div>
          <div class="body">
            <p class="label">How a season gets made</p>
            <h2 class="h2" id="process-title">From a letter on our desk to the same hour every week.</h2>
            <ol class="steps">
              {steps.map(([t, d], i) => (
                <li class="step reveal">
                  <span class="num" aria-hidden="true">{pad(i + 1)}</span>
                  <h3>{t}</h3>
                  <p>{d}</p>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <!-- 03 · Episodes -->
        <section class="sec wrap" id="episodes" aria-labelledby="episodes-title">
          <div class="rail" aria-hidden="true"><span class="num">03</span></div>
          <div class="body">
            <p class="label">This week on the network</p>
            <h2 class="h2" id="episodes-title">Six new episodes, roughly four and a half hours of somewhere else.</h2>
            <ol class="eps">
              {episodes.map(([t, show, len], i) => (
                <li class="ep reveal">
                  <span class="num" aria-hidden="true">{pad(i + 1)}</span>
                  <div class="ep-text">
                    <h3>{t}</h3>
                    <span class="meta">{show}</span>
                  </div>
                  <span class="meta ep-len">{len}</span>
                  <button class="play" type="button" aria-pressed="false" aria-label={`Play “${t}”`}>
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path class="i-play" d="M5 3.5v9l7.5-4.5z" /><path class="i-pause" d="M4.5 3.5h2.6v9H4.5zM8.9 3.5h2.6v9H8.9z" /></svg>
                  </button>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <!-- 04 · Pitch -->
        <section class="sec wrap" id="pitch" aria-labelledby="pitch-title">
          <div class="rail" aria-hidden="true"><span class="num">04</span></div>
          <div class="body">
            <div class="pitch">
              <p class="label">Open call · Season 2027</p>
              <h2 id="pitch-title">Got a show that needs the long way round?</h2>
              <p>We commission two new series a year. Send one page: who is talking, where it is recorded, and why it cannot be done in a booth.</p>
              <a class="btn light" href="mailto:pitch@statichouse.example">Send a one-page pitch</a>
            </div>
          </div>
        </section>
      </main>

      <footer class="foot wrap">
        <span>© 2026 Static House Audio</span>
        <span>Lisbon · Leeds · somewhere on a night bus</span>
      </footer>
    </div>

    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el, i) => {
          el.style.setProperty('--d', `${(i % 6) * 70}ms`);
          io.observe(el);
        });
      }

      // ponytail: no audio files — the button only shows a playing state, one episode at a time.
      const buttons = document.querySelectorAll<HTMLButtonElement>('.play');
      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          const on = b.getAttribute('aria-pressed') !== 'true';
          buttons.forEach((o) => {
            o.setAttribute('aria-pressed', 'false');
            o.closest('.ep')?.classList.remove('playing');
          });
          b.setAttribute('aria-pressed', String(on));
          b.closest('.ep')?.classList.toggle('playing', on);
        }),
      );
    </script>

    <style is:global>
      :root {
        --paper: #f0ede5;
        --paper-2: #e7e3d9;
        --ink: #17171a;
        --ink-2: #4a4843;
        --mute: #8e8a80;
        --line: rgb(23 23 26 / 0.12);
        --signal: #ff5a1f;
        --cobalt: #2e55f5;
        --lime: #cfe85b;
        --mono: 'IBM Plex Mono', ui-monospace, monospace;
        --sans: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif;
      }
      html { scroll-behavior: smooth; background: var(--paper); }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

      .page { overflow-x: clip; }
      .wrap { max-width: 1360px; margin: 0 auto; padding-inline: 40px; box-sizing: border-box; }

      /* The one numbering style: two-digit mono, low contrast, architectural. */
      .num {
        font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: 0.08em;
        color: var(--mute); line-height: 1; font-variant-numeric: tabular-nums;
      }
      .meta { font-family: var(--mono); font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-2); }
      .label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-2); margin: 0 0 20px; }

      /* Top bar */
      .bar { display: flex; align-items: center; justify-content: space-between; height: 72px; border-bottom: 1px solid var(--line); }
      .logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 650; font-size: 18px; letter-spacing: -0.02em; color: var(--ink); text-decoration: none; }
      .logo-mark { width: 18px; height: 18px; border-radius: 50%; background: repeating-radial-gradient(circle, var(--ink) 0 2px, transparent 2px 4px); }
      .bar nav { display: flex; gap: 32px; }
      .bar nav a { color: var(--ink-2); text-decoration: none; font-size: 14px; }
      .bar nav a:hover { color: var(--ink); }
      .onair { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; }
      .bars { display: inline-flex; align-items: flex-end; gap: 2px; height: 12px; }
      .bars i { width: 2px; height: 100%; background: var(--signal); transform-origin: bottom; animation: eq 1.1s ease-in-out infinite; }
      .bars i:nth-child(2) { animation-delay: -0.3s; }
      .bars i:nth-child(3) { animation-delay: -0.6s; }
      .bars i:nth-child(4) { animation-delay: -0.9s; }
      @keyframes eq { 0%, 100% { transform: scaleY(0.3); } 50% { transform: scaleY(1); } }

      /* Section frame: number in a fixed gutter rail, ruled down the section */
      .sec { display: grid; grid-template-columns: 72px minmax(0, 1fr); }
      .rail { position: relative; border-right: 1px solid var(--line); padding-top: 40px; }
      .rail .num { position: sticky; top: 24px; display: block; }
      .body { padding: 40px 0 96px 40px; min-width: 0; }
      .sec + .sec .body, .sec + .sec .rail { border-top: 1px solid var(--line); }
      .sec + .sec .rail { margin-right: -1px; }

      /* Hero */
      .hero .body { padding-bottom: 72px; }
      .hero-top { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 48px; align-items: end; margin-bottom: 48px; }
      h1 { font-size: clamp(44px, 6.4vw, 92px); line-height: 0.95; letter-spacing: -0.045em; font-weight: 600; margin: 0; text-wrap: balance; }
      h1 em { font-style: normal; color: var(--signal); }
      .hero-side p { margin: 0 0 24px; font-size: 16px; line-height: 1.55; color: var(--ink-2); max-width: 40ch; }
      .ctas { display: flex; flex-wrap: wrap; gap: 10px; }
      .btn { display: inline-flex; align-items: center; height: 44px; padding: 0 20px; border-radius: 999px; background: var(--ink); color: var(--paper); text-decoration: none; font-size: 14px; font-weight: 550; transition: transform 0.2s, background 0.2s; }
      .btn:hover { transform: translateY(-1px); }
      .btn.ghost { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); }
      .btn.light { background: var(--paper); color: var(--ink); }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--cobalt); outline-offset: 3px; }

      .shows { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 40px; border-top: 1px solid var(--line); }
      .show { position: relative; padding: 16px 0 4px; min-width: 0; }
      .show + .show::before { content: ''; position: absolute; left: -20px; top: 0; bottom: 0; width: 1px; background: var(--line); }
      .show-head { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
      .show-head .rule { flex: 1; height: 1px; background: var(--line); }
      .show .num { transition: color 0.25s; }
      .show:hover .num { color: var(--ink); }
      .cover { aspect-ratio: 16 / 10; border-radius: 6px; position: relative; overflow: hidden; display: flex; align-items: flex-end; padding: 14px; box-sizing: border-box; transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1); }
      .show:hover .cover { transform: translateY(-3px); }
      .cover span { position: relative; z-index: 1; font-weight: 650; font-size: clamp(18px, 1.7vw, 24px); line-height: 1; letter-spacing: -0.03em; max-width: 9ch; }
      .cover-rings { background: var(--signal); color: var(--ink); }
      .cover-rings::before { content: ''; position: absolute; width: 150%; aspect-ratio: 1; right: -70%; top: -60%; background: repeating-radial-gradient(circle, rgb(23 23 26 / 0.85) 0 1.5px, transparent 1.5px 14px); }
      .cover-stems { background: var(--lime); color: var(--ink); }
      .cover-stems::before { content: ''; position: absolute; inset: 0 0 0 45%; background: repeating-linear-gradient(90deg, rgb(23 23 26 / 0.8) 0 2px, transparent 2px 12px); -webkit-mask: linear-gradient(to top, #000 10%, transparent 95%); mask: linear-gradient(to top, #000 10%, transparent 95%); }
      .cover-dots { background: var(--cobalt); color: var(--paper); }
      .cover-dots::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle, rgb(240 237 229 / 0.55) 1.4px, transparent 1.6px) 0 0 / 14px 14px; -webkit-mask: linear-gradient(135deg, transparent 40%, #000); mask: linear-gradient(135deg, transparent 40%, #000); }
      .cover-lines { background: var(--ink); color: var(--paper); }
      .cover-lines::before { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(0deg, rgb(240 237 229 / 0.22) 0 1px, transparent 1px 9px); }
      .cover-lines::after { content: ''; position: absolute; width: 38%; aspect-ratio: 1; right: 12%; top: 18%; border-radius: 50%; background: var(--signal); }
      .show h2 { font-size: 19px; letter-spacing: -0.02em; font-weight: 600; margin: 16px 0 6px; }
      .show p { font-size: 14px; line-height: 1.5; color: var(--ink-2); margin: 0 0 12px; }

      /* Section headings */
      .h2 { font-size: clamp(30px, 3.6vw, 52px); line-height: 1.02; letter-spacing: -0.035em; font-weight: 600; margin: 0 0 48px; max-width: 20ch; text-wrap: balance; }

      /* Process: numbers sit on a timeline rail */
      .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0 24px; }
      .step { position: relative; padding-top: 28px; }
      .step::before { content: ''; position: absolute; top: 5px; left: 0; right: -24px; height: 1px; background: var(--line); }
      .step:last-child::before { right: 0; }
      .step::after { content: ''; position: absolute; top: 2px; left: 28px; width: 7px; height: 7px; border-radius: 50%; background: var(--paper); box-shadow: inset 0 0 0 1px var(--mute); }
      .step .num { position: absolute; top: 0; left: 0; background: var(--paper); padding-right: 8px; }
      .step h3 { font-size: 22px; letter-spacing: -0.025em; font-weight: 600; margin: 0 0 10px; }
      .step p { font-size: 15px; line-height: 1.55; color: var(--ink-2); margin: 0; max-width: 30ch; }

      /* Episodes: numbers beside headings */
      .eps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
      .ep { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto 44px; align-items: center; gap: 20px; padding: 20px 0; border-bottom: 1px solid var(--line); transition: background 0.25s; }
      .ep .num { align-self: start; padding-top: 7px; }
      .ep h3 { font-size: clamp(18px, 1.8vw, 24px); letter-spacing: -0.025em; font-weight: 550; margin: 0 0 4px; line-height: 1.2; }
      .ep-text .meta { color: var(--mute); }
      .ep-len { font-variant-numeric: tabular-nums; }
      .ep.playing .num, .ep:hover .num { color: var(--ink); }
      .ep.playing h3 { color: var(--signal); }
      .play { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line); background: transparent; color: var(--ink); display: grid; place-items: center; cursor: pointer; transition: background 0.2s, color 0.2s; }
      .play svg { width: 14px; height: 14px; fill: currentColor; }
      .play .i-pause { display: none; }
      .play[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
      .play[aria-pressed='true'] .i-play { display: none; }
      .play[aria-pressed='true'] .i-pause { display: inline; }
      .play:hover { border-color: var(--ink); }

      /* Pitch */
      .pitch { background: var(--ink); color: var(--paper); border-radius: 10px; padding: clamp(32px, 5vw, 72px); position: relative; overflow: hidden; }
      .pitch::after { content: ''; position: absolute; width: 520px; aspect-ratio: 1; right: -180px; bottom: -260px; background: repeating-radial-gradient(circle, rgb(255 90 31 / 0.55) 0 1.5px, transparent 1.5px 16px); pointer-events: none; }
      .pitch .label { color: rgb(240 237 229 / 0.6); }
      .pitch h2 { font-size: clamp(32px, 4.6vw, 64px); line-height: 1; letter-spacing: -0.04em; font-weight: 600; margin: 0 0 20px; max-width: 16ch; position: relative; }
      .pitch p:not(.label) { color: rgb(240 237 229 / 0.72); max-width: 46ch; line-height: 1.55; margin: 0 0 28px; position: relative; }
      .pitch .btn { position: relative; }
      .foot { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-block: 28px 80px; border-top: 1px solid var(--line); font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--mute); }

      /* Reveal */
      .reveal { opacity: 0; transform: translateY(14px); transition: opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms), transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms); }
      .reveal.in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1; transform: none; transition: none; }
        .bars i { animation: none; transform: scaleY(0.6); }
        .cover, .btn { transition: none; }
      }

      /* Responsive */
      @media (max-width: 1100px) {
        .bar nav { display: none; }
        .hero-top { grid-template-columns: 1fr; gap: 28px; }
        .shows { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .show:nth-child(3)::before { display: none; }
        .show:nth-child(n + 3) { border-top: 1px solid var(--line); margin-top: 8px; }
        .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 32px; }
        .step::before { right: 0; }
      }
      @media (max-width: 640px) {
        .wrap { padding-inline: 16px; }
        .sec { grid-template-columns: 28px minmax(0, 1fr); }
        .rail { padding-top: 32px; }
        .body { padding: 32px 0 64px 16px; }
        .hero .body { padding-bottom: 48px; }
        .onair { padding: 6px 10px; }
        .shows { grid-template-columns: 1fr; }
        .show { padding: 16px 0 8px; }
        .show + .show::before { display: none; }
        .show + .show { border-top: 1px solid var(--line); margin-top: 8px; }
        .steps { grid-template-columns: 1fr; gap: 32px; }
        .ep { grid-template-columns: 28px minmax(0, 1fr) 44px; gap: 12px; }
        .ep-len { display: none; }
        .h2 { margin-bottom: 32px; }
      }
    </style>
  </body>
</html>
