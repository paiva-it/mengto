  blockquote { margin: 26px 0 10px; padding: 18px 0 0; border-top: 1px solid var(--rule); }
  blockquote p { font-family: var(--serif-d); font-style: italic; font-size: clamp(26px, 2.6vw, 38px) !important; line-height: 1.1 !important; color: var(--accent); margin: 0 0 10px !important; }
  blockquote cite { font-style: normal; color: var(--ink-2); font-size: 9.5px; }
  .notes { display: grid; gap: 22px; align-content: start; padding-top: 8px; }
  .facts { margin: 0; border-top: 1px solid var(--rule); }
  .facts div { display: flex; justify-content: space-between; padding: 9px 0; border-bottom: 1px solid var(--rule); color: var(--ink-2); }
  .facts dd { margin: 0; color: var(--ink); font-size: 12px; }

  .colophon { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 60px; padding-bottom: 40px; }
  .colophon > div > .mono { color: var(--accent-soft); }
  .req { margin-top: 28px; max-width: 460px; }
  .req label { color: var(--shell-dim); display: block; margin-bottom: 8px; }
  .req-row { display: flex; border: 1px solid var(--line-2); }
  .req input { flex: 1; min-width: 0; background: transparent; border: 0; padding: 13px 14px; color: #f0e3c8; font: 17px var(--serif); outline: none; }
  .req input::placeholder { color: var(--shell-dim); }
