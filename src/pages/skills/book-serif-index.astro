  .crease { position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; transform: translateX(-1px); background: linear-gradient(rgb(60 38 18 / 0.15), rgb(60 38 18 / 0.45) 50%, rgb(60 38 18 / 0.15)); pointer-events: none; }

  .page-head { display: flex; justify-content: space-between; gap: 12px; color: var(--ink-2); font-size: 9.5px; padding-bottom: 10px; border-bottom: 1px solid var(--rule); position: relative; z-index: 1; }
