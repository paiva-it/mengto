</style>

<script>
  const spreads = [...document.querySelectorAll<HTMLElement>('[data-spread]')];
  const sessionBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-goto]')];
  let current = 0;

  const show = (i: number) => {
    current = (i + spreads.length) % spreads.length;
    spreads.forEach((s, k) => {
      const on = k === current;
      s.hidden = !on;
      s.classList.toggle('is-active', on);
    });
    sessionBtns.forEach((b, k) => b.setAttribute('aria-pressed', String(k === current)));
  };

  sessionBtns.forEach((b) =>
    b.addEventListener('click', () => {
      show(Number(b.dataset.goto));
      document.getElementById('reading')?.scrollIntoView({ block: 'start' });
    }),
  );
  document.querySelectorAll<HTMLButtonElement>('[data-turn]').forEach((b) =>
    b.addEventListener('click', () => show(current + Number(b.dataset.turn))),
  );
  addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement).closest('input')) return;
    if (e.key === 'ArrowRight') show(current + 1);
    if (e.key === 'ArrowLeft') show(current - 1);
  });

  // Rail active state follows the part in view.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-rail]')].map((a) => [a.dataset.rail!, a]));
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a, id) => a.classList.toggle('is-current', id === e.target.id));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  links.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) io.observe(el);
  });
  links.get('reading')?.classList.add('is-current');

  document.getElementById('req')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const msg = document.querySelector('.req-msg');
    if (msg) msg.textContent = 'Noted in the visitors’ book. We will write to confirm a Thursday.';
  });
</script>
