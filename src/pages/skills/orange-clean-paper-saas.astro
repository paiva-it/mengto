---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

// Topographic contours around two summits, drawn once at build time.
const contour = (cx: number, cy: number, r: number, k: number, sx = 1, sy = 1) => {
  const pts: string[] = [];
  for (let i = 0; i <= 72; i++) {
    const t = (i / 72) * Math.PI * 2;
    const w = 1 + 0.13 * Math.sin(3 * t + k * 0.7) + 0.06 * Math.sin(5 * t - k) + 0.03 * Math.cos(7 * t + k * 1.3);
    pts.push(`${(cx + Math.cos(t) * r * w * sx).toFixed(1)},${(cy + Math.sin(t) * r * w * sy).toFixed(1)}`);
  }
  return `M${pts.join('L')}Z`;
};
const topoA = Array.from({ length: 9 }, (_, i) => contour(220, 250, 26 + i * 30, i, 1.15, 0.9));
const topoB = Array.from({ length: 6 }, (_, i) => contour(470, 150, 20 + i * 26, i + 4, 0.95, 1.1));

const towers = [
  { x: 175, y: 385, name: 'Pine Ridge · T4' },
  { x: 495, y: 305, name: 'Cedar Gap · T7' },
  { x: 430, y: 110, name: 'Hollow Peak · T2' },
];
const plume = { x: 330, y: 205 };

const districts = ['Upper Kettle FPD', 'Sawtooth Volunteer Fire', 'Wren Valley Rangers', 'Three Forks County', 'Marrow Creek Watch', 'Alder Basin Fire Co.'];

const timeline = [
  { t: '14:02:10', title: 'Pixel change on T4', body: 'The Pine Ridge camera sees a grey column rise 3 % against the ridge haze. Confidence 0.41 — not enough to page anyone yet.' },
  { t: '14:03:05', title: 'A lookout looks', body: 'Mara, on shift at Cedar Gap, gets a quiet nudge with the crop. She confirms smoke, not dust, and drops her bearing: 304°.' },
  { t: '14:04:40', title: 'Bearings cross', body: 'Two bearings meet over the north slope of Hollow Peak. Firecrest draws a 900 m ellipse and pulls the parcel, fuel model and road access.' },
  { t: '14:06:18', title: 'Dispatch has it', body: 'One packet to the county CAD: location, wind, nearest water, photos from two angles. Four minutes and eight seconds from first pixel.' },
];

const plans = [
  { name: 'Lookout', price: 'Free', per: 'for volunteers', body: 'Join a district roster, confirm sightings from your phone, log hours toward certification.', items: ['Sighting app (iOS, Android, web)', 'Bearing compass with offline maps', 'Shift reminders'], cta: 'Join a roster', featured: false },
  { name: 'District', price: '$420', per: 'per tower / month', body: 'Camera ingestion, smoke detection and a lookout network wired straight into your dispatch.', items: ['Up to 12 towers', 'Triangulation + CAD packet', 'Fire-weather overlays', 'Season-end report for the board'], cta: 'Start the season', featured: true },
  { name: 'Region', price: 'Custom', per: 'multi-agency', body: 'Shared views across counties and land managers, with mutual-aid rules that route each plume.', items: ['Unlimited towers', 'Cross-agency routing', 'Dedicated fire-season desk'], cta: 'Talk to the desk', featured: false },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Firecrest — forest fire watch for every ridge</title>
    <meta name="description" content="Firecrest connects tower cameras and volunteer lookouts so a plume is confirmed, located and dispatched in minutes." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Inter+Tight:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="fc">
    <div class="page">
      <!-- ============ HERO: master container, split onboarding card ============ -->
      <header class="shell" id="top">
        <div class="hero">
          <section class="form-side" aria-labelledby="hero-title">
            <nav class="nav" aria-label="Primary">
              <a href="#top" class="brand"><span class="brand-dot" aria-hidden="true"></span>Firecrest</a>
              <div class="nav-links">
                <a href="#how">Platform</a>
                <a href="#timeline">Response</a>
                <a href="#plans">Plans</a>
              </div>
            </nav>

            <div class="steps" aria-label="Onboarding progress">
              <span class="step on"><b>1</b>Your ridge</span>
              <span class="step-line" aria-hidden="true"></span>
              <span class="step"><b>2</b>Towers</span>
              <span class="step-line" aria-hidden="true"></span>
              <span class="step"><b>3</b>Lookouts</span>
            </div>

            <h1 id="hero-title" class="display">
              <span class="mask"><span>Watch every ridge</span></span>
              <span class="mask"><span>before the smoke</span></span>
              <span class="mask"><span>reaches the road.</span></span>
            </h1>
            <p class="lede">
              Firecrest pairs your tower cameras with the people who know the hills. A plume is seen, confirmed and
              placed on the map in minutes — not when someone on the highway calls it in.
            </p>

            <form class="form" onsubmit="return false" novalidate>
              <div class="row2">
                <label class="field">
                  <span>Watch area</span>
                  <input type="text" name="area" value="Kettle Range north slope" autocomplete="off" />
                </label>
                <label class="field">
                  <span>Fire season</span>
                  <select name="season">
                    <option>May – October</option>
                    <option>June – September</option>
                    <option>Year-round</option>
                  </select>
                </label>
              </div>
              <label class="field">
                <span>Work e-mail</span>
                <input type="email" name="email" placeholder="chief@upperkettle-fpd.org" autocomplete="email" />
              </label>
              <label class="check">
                <input type="checkbox" checked />
                <span class="box" aria-hidden="true"></span>
                <span>Invite our volunteer lookouts too</span>
              </label>
              <div class="actions">
                <button type="submit" class="btn-primary">Start watching <span aria-hidden="true">→</span></button>
                <a href="#timeline" class="btn-quiet">See a live plume</a>
              </div>
            </form>
          </section>

          <!-- Product illustration: topo map, towers, crossing bearings -->
          <section class="visual" aria-label="Firecrest live map of the Kettle Range">
            <div class="map">
              <svg viewBox="0 0 640 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true" class="topo">
                <defs>
                  <radialGradient id="fc-plume" cx="50%" cy="50%" r="50%">
                    <stop offset="0" stop-color="#E4612A" stop-opacity=".55" />
                    <stop offset=".55" stop-color="#F0956A" stop-opacity=".18" />
                    <stop offset="1" stop-color="#F0956A" stop-opacity="0" />
                  </radialGradient>
                  <linearGradient id="fc-bear" x1="0" x2="1">
                    <stop offset="0" stop-color="#E4612A" stop-opacity=".1" />
                    <stop offset="1" stop-color="#E4612A" stop-opacity=".9" />
                  </linearGradient>
                </defs>
                <g class="drift" fill="none" stroke="#C9B9A6" stroke-width="1">
                  {topoA.map((d, i) => <path d={d} opacity={0.35 + (8 - i) * 0.06} />)}
                  {topoB.map((d, i) => <path d={d} opacity={0.3 + (5 - i) * 0.08} />)}
                </g>
                <path d="M-10 470 C 90 430 160 455 250 420 S 420 380 520 450 S 640 430 660 440" fill="none" stroke="#B9CBB5" stroke-width="10" stroke-linecap="round" opacity=".55" />
                <path d="M40 520 C 120 470 170 330 300 300 S 520 230 650 260" fill="none" stroke="#fff" stroke-width="3" stroke-dasharray="2 7" stroke-linecap="round" opacity=".9" />
                <circle cx={plume.x} cy={plume.y} r="70" fill="url(#fc-plume)" />
                <line class="bearing" x1={towers[0].x} y1={towers[0].y} x2={plume.x} y2={plume.y} stroke="url(#fc-bear)" stroke-width="1.6" stroke-dasharray="5 5" />
                <line class="bearing b2" x1={towers[1].x} y1={towers[1].y} x2={plume.x} y2={plume.y} stroke="url(#fc-bear)" stroke-width="1.6" stroke-dasharray="5 5" />
                <ellipse cx={plume.x} cy={plume.y} rx="34" ry="22" fill="none" stroke="#E4612A" stroke-width="1.4" />
                <circle cx={plume.x} cy={plume.y} r="5" fill="#E4612A" />
                <circle class="ping" cx={plume.x} cy={plume.y} r="5" fill="none" stroke="#E4612A" stroke-width="1.5" />
                {towers.map((t) => (
                  <g>
                    <circle cx={t.x} cy={t.y} r="13" fill="#FFFCF8" stroke="#E7DCCD" />
                    <path d={`M${t.x - 5} ${t.y - 3} L${t.x} ${t.y - 7} L${t.x + 5} ${t.y - 3} Z M${t.x - 3.5} ${t.y - 3} V${t.y + 1} H${t.x + 3.5} V${t.y - 3} M${t.x - 2.5} ${t.y + 1} L${t.x - 4} ${t.y + 7} M${t.x + 2.5} ${t.y + 1} L${t.x + 4} ${t.y + 7}`} stroke="#3A332D" stroke-width="1.3" fill="none" stroke-linejoin="round" stroke-linecap="round" />
                  </g>
                ))}
              </svg>
              <div class="sweep" style={`left:${(towers[0].x / 640) * 100}%;top:${(towers[0].y / 520) * 100}%`} aria-hidden="true"></div>

              <!-- floating product cards -->
              <div class="float card-alert" style="--d:0s">
                <div class="alert-head"><span class="live" aria-hidden="true"></span>Possible plume</div>
                <p class="alert-place">Hollow Peak · north slope</p>
                <div class="alert-meta">
                  <span>2 bearings</span><span>±450 m</span><span class="hot">Confirmed</span>
                </div>
              </div>

              <div class="float card-tower" style="--d:-2.4s">
                <div class="cam">
                  <svg viewBox="0 0 200 90" aria-hidden="true">
                    <defs><linearGradient id="fc-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F7E3D1" /><stop offset="1" stop-color="#FBF4EC" /></linearGradient></defs>
                    <rect width="200" height="90" fill="url(#fc-sky)" />
                    <path d="M0 70 L30 52 L52 60 L84 38 L112 56 L140 44 L172 58 L200 50 V90 H0Z" fill="#D9CDBE" />
                    <path d="M0 80 L40 66 L76 74 L120 62 L160 72 L200 64 V90 H0Z" fill="#C3B4A2" />
                    <path class="smoke" d="M128 44 C 122 34 132 28 126 18 C 122 10 130 4 128 0" stroke="#A89A8C" stroke-width="5" fill="none" stroke-linecap="round" opacity=".55" />
                    <rect x="110" y="0" width="40" height="50" fill="none" stroke="#E4612A" stroke-width="1.5" rx="3" />
                  </svg>
                  <span class="cam-tag">T4 · 304°</span>
                </div>
                <div class="tower-row">
                  <div><b>Pine Ridge</b><span>360° sweep · every 90 s</span></div>
                  <span class="pill">0.41</span>
                </div>
              </div>

              <div class="float card-wx" style="--d:-1.2s">
                <span class="k">Fire weather</span>
                <div class="wx-big">High<small> · 64</small></div>
                <div class="wx-bar" aria-hidden="true"><i style="width:64%"></i></div>
                <div class="wx-meta"><span>NW 14 km/h</span><span>RH 22 %</span></div>
              </div>

              <div class="float card-chip" style="--d:-3.1s">
                <span class="avatar" aria-hidden="true">M</span>
                <span><b>Mara O.</b> confirmed from Cedar Gap</span>
              </div>
            </div>
          </section>
        </div>
      </header>

      <!-- ============ TRUST STRIP ============ -->
      <section class="trust" aria-label="Districts on Firecrest">
        <p>Watching 2.1 million acres with 140 fire districts</p>
        <ul>{districts.map((d) => <li>{d}</li>)}</ul>
      </section>

      <!-- ============ BENTO ============ -->
      <section id="how" class="block">
        <div class="head reveal">
          <span class="eyebrow">Platform</span>
          <h2 class="h2">Cameras notice. People decide.<br /><span class="mute">Firecrest keeps them talking.</span></h2>
        </div>

        <div class="bento">
          <article class="tile t-a reveal">
            <div class="tile-top"><span class="k">Pillar</span><span class="num">01</span></div>
            <h3>Towers that sweep, not stare.</h3>
            <p>Any PTZ or fixed camera on the ridge. Firecrest sets the sweep, keeps a clean-sky baseline per heading and flags change, not motion.</p>
            <div class="mini-sweep" aria-hidden="true"><i></i><b></b></div>
          </article>

          <article class="tile t-b reveal">
            <div class="tile-top"><span class="k">Pillar</span><span class="num">02</span></div>
            <h3>Lookouts on call.</h3>
            <p>Volunteers and retired crews confirm crops from their phones. Shifts follow the fire-weather forecast, so nobody watches a wet Tuesday.</p>
            <ul class="roster">
              <li><span class="avatar">M</span>Mara O.<em>Cedar Gap</em><i class="on">On shift</i></li>
              <li><span class="avatar alt">J</span>Jonah R.<em>Pine Ridge</em><i>18:00</i></li>
              <li><span class="avatar alt2">E</span>Eli V.<em>Hollow Peak</em><i>Tomorrow</i></li>
            </ul>
          </article>

          <article class="tile t-c stat reveal">
            <span class="k">Median, 2025 season</span>
            <div class="stat-num">4<small>m</small> 12<small>s</small></div>
            <p>from the first pixel of smoke to a packet on the dispatcher's screen.</p>
            <div class="spark" aria-hidden="true">
              <svg viewBox="0 0 240 60" preserveAspectRatio="none"><path d="M0 12 L30 18 L60 15 L90 26 L120 30 L150 38 L180 42 L210 47 L240 50" fill="none" stroke="#E4612A" stroke-width="2" /><path d="M0 12 L30 18 L60 15 L90 26 L120 30 L150 38 L180 42 L210 47 L240 50 V60 H0Z" fill="#E4612A" opacity=".08" /></svg>
            </div>
          </article>

          <article class="tile t-d reveal">
            <div class="tile-top"><span class="k">Pillar</span><span class="num">03</span></div>
            <h3>Two bearings, one place.</h3>
            <p>Each confirmation carries a heading. Where they cross, Firecrest draws the ellipse and pulls parcel, fuel model and the nearest gate.</p>
          </article>

          <article class="tile t-e reveal">
            <span class="k">Fire-weather index · today</span>
            <div class="fwi" role="img" aria-label="Fire-weather index bands, today High at 64">
              <span>Low</span><span>Moderate</span><span class="cur">High</span><span>Very high</span><span>Extreme</span>
            </div>
            <div class="fwi-foot"><span>Shifts scheduled: <b>6 lookouts</b></span><span>Sweep: <b>every 60 s</b></span></div>
          </article>

          <article class="tile t-f reveal">
            <div class="tile-top"><span class="k">Integrations</span><span class="num">04</span></div>
            <h3>Lands in the tools you already run.</h3>
            <div class="chips">
              <span>County CAD</span><span>ArcGIS</span><span>Radio patch</span><span>SMS paging</span><span>NWS red-flag</span>
            </div>
          </article>
        </div>
      </section>

      <!-- ============ TIMELINE ============ -->
      <section id="timeline" class="block">
        <div class="split">
          <div class="head reveal sticky-head">
            <span class="eyebrow">Response</span>
            <h2 class="h2">A plume, minute by minute.</h2>
            <p class="lede">From Hollow Peak, 14 August 2025. Real sequence, names changed. No 911 call had come in when the engine rolled.</p>
            <div class="clock">
              <span class="k">First pixel → dispatch</span>
              <b>04:08</b>
            </div>
          </div>
          <ol class="tl">
            {timeline.map((s, i) => (
              <li class="reveal" style={`--i:${i}`}>
                <span class="tl-dot" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div class="tl-card">
                  <time>{s.t}</time>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- ============ PLANS ============ -->
      <section id="plans" class="block">
        <div class="head center reveal">
          <span class="eyebrow">Plans</span>
          <h2 class="h2">Priced per tower, free for the people on the hill.</h2>
        </div>
        <div class="plans">
          {plans.map((p) => (
            <article class={`plan reveal ${p.featured ? 'featured' : ''}`}>
              <div class="plan-top">
                <h3>{p.name}</h3>
                {p.featured && <span class="badge">Most districts</span>}
              </div>
              <div class="price">{p.price}<small>{p.per}</small></div>
              <p>{p.body}</p>
              <ul>{p.items.map((it) => <li>{it}</li>)}</ul>
              <a href="#top" class={p.featured ? 'btn-primary full' : 'btn-soft full'}>{p.cta}</a>
            </article>
          ))}
        </div>
      </section>

      <!-- ============ CTA ============ -->
      <section class="cta reveal">
        <div>
          <span class="eyebrow">Season opens in 34 days</span>
          <h2 class="h2">Put a second pair of eyes on the ridge.</h2>
          <p class="lede">Most districts are watching within a week of their first call. We bring the mounts, you bring the lookouts.</p>
        </div>
        <form class="cta-form" onsubmit="return false" novalidate>
          <label class="sr" for="cta-email">Work e-mail</label>
          <input id="cta-email" type="email" placeholder="Work e-mail" />
          <button type="submit" class="btn-primary">Book a ridge walk <span aria-hidden="true">→</span></button>
        </form>
      </section>

      <footer class="foot">
        <a href="#top" class="brand"><span class="brand-dot" aria-hidden="true"></span>Firecrest</a>
        <span>Fire watch for districts, rangers and the volunteers who climb the towers.</span>
        <span class="mute">© 2026 Firecrest Systems · a fictional company</span>
      </footer>
    </div>
    <BackPill />

    <script>
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      }
      // Pause ambient loops while the hero is off-screen.
      const hero = document.querySelector('.visual');
      if (hero && 'IntersectionObserver' in window) {
        new IntersectionObserver(([e]) => hero.classList.toggle('paused', !e.isIntersecting)).observe(hero);
      }
    </script>
  </body>
</html>

<style is:global>
  .fc {
    --paper: #f3efe8;
    --shell: #faf7f2;
    --card: #fdfbf7;
    --stone: #ebe4d9;
    --line: #e6ddd0;
    --ink: #1d1916;
    --ink2: #4a423b;
    --mute: #8a8077;
    --or: #e0612a;
    --or-d: #c9501d;
    --or-soft: #fbe2d1;
    margin: 0;
    color: var(--ink);
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-weight: 400;
    background:
      radial-gradient(1200px 700px at 70% -10%, #fbf3ea 0%, transparent 60%),
      radial-gradient(900px 600px at 0% 40%, #f6efe6 0%, transparent 55%),
      var(--paper);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
</style>

<style>
  .page { max-width: 1320px; margin: 0 auto; padding: 24px 24px 40px; }
  a { color: inherit; text-decoration: none; }
  .mute { color: var(--mute); }
  .k { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--mute); font-weight: 500; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  /* ---- master container with gradient border ---- */
  .shell {
    position: relative; border-radius: 40px; padding: 14px;
    background: linear-gradient(180deg, #fffdfa, var(--shell));
    box-shadow: 0 1px 0 #fff inset, 0 30px 80px -40px rgb(140 80 30 / .28), 0 2px 6px rgb(60 40 20 / .04);
  }
  .shell::before {
    content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px; pointer-events: none;
    background: linear-gradient(160deg, #fff, #eadfce 40%, #f3c7a6 75%, #fff);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
  }
  .hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 14px; min-height: 832px; }

  .form-side {
    border-radius: 28px; padding: 32px 40px 40px; display: flex; flex-direction: column;
    background: linear-gradient(170deg, #fffdf9 0%, #f9f3eb 100%);
    border: 1px solid #efe7dc;
  }
  .nav { display: flex; align-items: center; justify-content: space-between; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 15px; letter-spacing: -.01em; }
  .brand-dot { width: 16px; height: 16px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #f5a172, var(--or) 60%, var(--or-d)); box-shadow: 0 2px 8px rgb(224 97 42 / .4); }
  .nav-links { display: flex; gap: 22px; font-size: 13.5px; color: var(--ink2); }
  .nav-links a { transition: color .2s; }
  .nav-links a:hover { color: var(--or); }

  .steps { display: flex; align-items: center; gap: 10px; margin-top: 56px; font-size: 12.5px; color: var(--mute); }
  .step { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; }
  .step b { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; font-size: 11px; font-weight: 600; border: 1px solid var(--line); background: var(--card); color: var(--mute); }
  .step.on { color: var(--ink); font-weight: 500; }
  .step.on b { background: var(--or); border-color: var(--or); color: #fff; box-shadow: 0 0 0 4px var(--or-soft); }
  .step-line { flex: 1; max-width: 40px; height: 1px; background: var(--line); }

  .display { font-family: 'Inter Tight', 'Inter', sans-serif; font-weight: 500; font-size: clamp(36px, 3.8vw, 56px); line-height: 1.02; letter-spacing: -.035em; margin: 28px 0 0; }
  .mask { display: block; overflow: hidden; padding-bottom: .06em; }
  .mask > span { display: block; animation: rise 1s cubic-bezier(.2, .7, .1, 1) both; }
  .mask:nth-child(2) > span { animation-delay: .1s; }
  .mask:nth-child(3) > span { animation-delay: .2s; }
  @keyframes rise { from { transform: translateY(105%); } }
  .lede { font-size: 15.5px; line-height: 1.6; color: var(--ink2); font-weight: 300; max-width: 46ch; margin: 18px 0 0; }

  .form { margin-top: auto; padding-top: 32px; display: grid; gap: 14px; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .field { display: grid; gap: 7px; font-size: 12px; color: var(--ink2); font-weight: 500; }
  .field input, .field select, .cta-form input {
    font: inherit; font-size: 14.5px; font-weight: 400; color: var(--ink); width: 100%; box-sizing: border-box;
    height: 48px; padding: 0 16px; border-radius: 14px; border: 1px solid var(--line);
    background: linear-gradient(180deg, #fbf7f1, #fffdfa); box-shadow: 0 1px 2px rgb(60 40 20 / .04) inset;
