---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

const broths = [
  { id: 'shio', label: 'Shio', note: 'Clear chicken & kombu' },
  { id: 'tonkotsu', label: 'Tonkotsu', note: '18 h pork bone' },
  { id: 'miso', label: 'Miso', note: 'Red miso, chilli oil' },
];

const stats = [
  ['Seats', '14', 'one counter, no tables'],
  ['Broth', '18 h', 'rolling boil, never reheated'],
  ['Noodle', '90 s', 'cut that afternoon, boiled to order'],
  ['Open', '18–03', 'Tuesday to Sunday'],
];

const bowls = [
  {
    n: '01',
    name: 'Black Garlic Tonkotsu',
    body: 'Pork bone broth emulsified for eighteen hours, finished with mayu we burn in sesame oil until it goes jet black.',
    meta: [['Broth', 'Tonkotsu'], ['Noodle', 'Thin, straight'], ['Heat', '0 / 3']],
    price: '€16',
    tag: 'House pot',
  },
  {
    n: '02',
    name: 'Yuzu Shio Clear',
    body: 'Chicken and kombu stock you can read a ticket through, salted with Okinawan sea salt and a twist of yuzu peel.',
    meta: [['Broth', 'Shio'], ['Noodle', 'Wavy, medium'], ['Heat', '0 / 3']],
    price: '€15',
    tag: 'Lightest',
  },
  {
    n: '03',
    name: 'Red Miso Static',
    body: 'Three-year red miso whisked into the bone broth, ground pork, sansho and a chilli oil that hums rather than bites.',
    meta: [['Broth', 'Miso'], ['Noodle', 'Thick, curly'], ['Heat', '2 / 3']],
    price: '€17',
    tag: 'Late favourite',
  },
  {
    n: '04',
    name: 'Cold Dip Tsukemen',
    body: 'Chilled thick noodles beside a reduced, almost syrupy dipping broth. When you are done, we top it up with dashi to drink.',
    meta: [['Broth', 'Reduced'], ['Noodle', 'Extra thick'], ['Heat', '1 / 3']],
    price: '€17',
    tag: 'After 01:00',
  },
];

const system = [
  {
    n: '01',
    title: 'Frame',
    lede: 'The ticket machine',
    body: 'Order at the vending machine by the door, hand the ticket over the counter. No menus on the bar, nothing between you and the pot.',
  },
  {
    n: '02',
    title: 'Rhythm',
    lede: 'Ninety seconds',
    body: 'Every bowl leaves the pass ninety seconds after the noodles hit the water. Fourteen seats turn every twenty-five minutes, all night.',
  },
  {
    n: '03',
    title: 'Signal',
    lede: 'The lantern',
    body: 'When the paper lantern over the door turns purple, the last pot is open. When it goes dark, the broth is gone until tomorrow.',
  },
];

const times = ['22:30', '23:00', '23:30', '00:00', '00:30', '01:00', '01:30'];
const ring = 'USHIMITSU · BROTH AFTER MIDNIGHT · 18 HOUR POT · COUNTER OF 14 · ';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ushimitsu — Broth after midnight</title>
    <meta name="description" content="Ushimitsu is a fourteen-seat late-night ramen counter under the U1 in Kreuzberg." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-broth="tonkotsu">
    <BackPill />

    <div class="page">
      <div class="shell">
        <span class="cq tl" aria-hidden="true"></span><span class="cq tr" aria-hidden="true"></span>
        <span class="cq bl" aria-hidden="true"></span><span class="cq br" aria-hidden="true"></span>

        <!-- Header -->
        <header class="nav">
          <a href="#top" class="brand">
            <span class="brand-dot" aria-hidden="true"></span>
            <span>Ushimitsu</span>
            <span class="micro brand-sub">Ramen bar · Kreuzberg</span>
          </a>
          <nav aria-label="Primary" class="nav-links">
            <a href="#bowls">Bowls</a>
            <a href="#counter">Counter</a>
            <a href="#drop">Last pot</a>
          </nav>
          <span class="status micro"><span class="pulse" aria-hidden="true"></span>Pot open · 37 bowls left</span>
        </header>

        <!-- Hero -->
        <section class="hero" id="top" aria-labelledby="hero-title">
          <div class="hero-grid" aria-hidden="true"></div>
          <div class="hero-bloom" aria-hidden="true"></div>

          <div class="hero-copy">
            <p class="micro eyebrow"><span class="sq" aria-hidden="true"></span>Counter 08 · Skalitzer Str. 88 · under the U1</p>
            <h1 id="hero-title" class="display">
              <span class="ln"><span>Broth after</span></span>
              <span class="ln"><span><em>midnight.</em></span></span>
            </h1>
            <p class="lede">
              Fourteen stools, one pot that has been rolling since breakfast, and noodles cut the same afternoon.
              Open until three, or until the broth runs out.
            </p>

            <form class="seatbar" aria-label="Hold seats at the counter" id="seatbar">
              <label class="seg">
                <span class="micro">Party</span>
                <select name="party" aria-label="Party size">
                  <option>1 guest</option>
                  <option selected>2 guests</option>
                  <option>3 guests</option>
                  <option>4 guests</option>
                </select>
              </label>
              <label class="seg">
                <span class="micro">Arrive</span>
                <select name="time" aria-label="Arrival time">
                  {times.map((t) => <option selected={t === '23:30'}>{t}</option>)}
                </select>
              </label>
              <fieldset class="seg broth">
                <legend class="micro">Broth</legend>
                <div class="broth-pills">
                  {
                    broths.map((b) => (
                      <label class="pill">
                        <input type="radio" name="broth" value={b.id} checked={b.id === 'tonkotsu'} />
                        <span>{b.label}</span>
                      </label>
                    ))
                  }
                </div>
              </fieldset>
              <button type="submit" class="go">
                Hold seats
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg>
              </button>
            </form>
            <p class="micro seat-note" id="seat-note" aria-live="polite">Seats held for 10 minutes · walk-ins always welcome</p>
          </div>

          <div class="focal" aria-hidden="true">
            <div class="floor"></div>
            <div class="orbit o1"></div>
            <div class="orbit o2"></div>
            <svg class="txt-ring" viewBox="0 0 200 200">
              <defs><path id="ringpath" d="M100,100 m-86,0 a86,86 0 1,1 172,0 a86,86 0 1,1 -172,0" /></defs>
              <text><textPath href="#ringpath" textLength="536">{ring}</textPath></text>
            </svg>
            <div class="orb"><span class="orb-yolk"></span><span class="orb-sheen"></span></div>

            <div class="float-card fc-main">
              <div class="fc-inner">
                <p class="micro fc-label"><span class="sq" aria-hidden="true"></span>Tonight's pot</p>
                <p class="fc-title" id="fc-title">Black Garlic Tonkotsu</p>
                <div class="fc-meter"><span id="fc-bar"></span></div>
                <dl class="fc-meta">
                  <div><dt class="micro">Simmer</dt><dd id="fc-simmer">18 h 40 m</dd></div>
                  <div><dt class="micro">Left</dt><dd id="fc-left">37 bowls</dd></div>
                </dl>
              </div>
            </div>
            <div class="float-chip">
              <span class="micro">Counter</span>
              <span class="chip-seats">
                {Array.from({ length: 14 }, (_, i) => <i class={i < 9 ? 'on' : ''} />)}
              </span>
              <span class="micro chip-num">9 / 14 free</span>
            </div>
          </div>
        </section>

        <!-- Stats rail -->
        <section class="stats" aria-label="The counter in numbers">
          {
            stats.map(([k, v, d]) => (
              <div class="stat">
                <p class="micro">{k}</p>
                <p class="stat-v">{v}</p>
                <p class="stat-d">{d}</p>
              </div>
            ))
          }
        </section>

        <!-- Bowls -->
        <section class="sect" id="bowls" aria-labelledby="bowls-title">
          <div class="block-head">
            <p class="micro eyebrow"><span class="sq" aria-hidden="true"></span>02 · The bowls</p>
            <h2 id="bowls-title" class="h2">Four bowls. <span class="dim">Nothing else on the machine.</span></h2>
          </div>
          <div class="bowls">
            {
              bowls.map((b) => (
                <article class="bowl">
                  <div class="bowl-top">
                    <span class="bowl-n">{b.n}</span>
                    <span class="tag micro">{b.tag}</span>
                  </div>
                  <h3 class="bowl-name">{b.name}</h3>
                  <p class="bowl-body">{b.body}</p>
                  <dl class="bowl-meta">
                    {b.meta.map(([k, v]) => (
                      <div>
                        <dt class="micro">{k}</dt>
                        <dd>{v}</dd>
                      </div>
                    ))}
                  </dl>
                  <div class="bowl-foot">
                    <span class="price">{b.price}</span>
                    <span class="micro">Ticket · B{b.n}</span>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <!-- Counter system -->
        <section class="sect counter" id="counter" aria-labelledby="counter-title">
          <div class="block-head split">
            <div>
              <p class="micro eyebrow"><span class="sq" aria-hidden="true"></span>03 · How the counter runs</p>
              <h2 id="counter-title" class="h2">Three rules, <span class="dim">kept since the first night.</span></h2>
            </div>
            <p class="side-note">
              We opened in a former U-Bahn kiosk in 2019 with one burner and a borrowed stockpot. The room got bigger. The rules did not.
            </p>
          </div>
          <div class="rules">
            {
              system.map((s) => (
                <article class="rule">
                  <div class="rule-head">
                    <span class="rule-n">{s.n}</span>
                    <span class="micro">{s.title}</span>
                  </div>
                  <h3 class="rule-lede">{s.lede}</h3>
                  <p class="rule-body">{s.body}</p>
                  <span class="rule-line" aria-hidden="true" />
                </article>
              ))
            }
          </div>
        </section>

        <!-- Footer action bar -->
        <section class="drop" id="drop" aria-labelledby="drop-title">
          <div class="drop-glow" aria-hidden="true"></div>
          <div class="drop-copy">
            <p class="micro eyebrow"><span class="sq" aria-hidden="true"></span>04 · The 02:00 text</p>
            <h2 id="drop-title" class="h2">Know when the last pot opens.</h2>
            <p class="lede small">One message a night, only when the lantern turns purple. Reply STOP and the lantern stays on without you.</p>
          </div>
          <form class="dropbar" id="dropbar" aria-label="Get the last pot text">
            <label class="seg grow">
              <span class="micro">Mobile</span>
              <input type="tel" name="phone" placeholder="+49 151 0000 0000" autocomplete="tel" aria-label="Mobile number" />
            </label>
            <button type="submit" class="go">
              Text me
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg>
            </button>
          </form>
          <p class="micro drop-note" id="drop-note" aria-live="polite"></p>
        </section>

        <footer class="foot">
          <span class="micro">© 2026 Ushimitsu Ramen</span>
          <span class="micro">Skalitzer Str. 88 · 10997 Berlin</span>
          <span class="micro">Tue–Sun · 18:00–03:00</span>
        </footer>
      </div>
    </div>

    <style>
      @property --a1 { syntax: '<color>'; inherits: true; initial-value: #d946ef; }
      @property --a2 { syntax: '<color>'; inherits: true; initial-value: #7c3aed; }
      @property --a3 { syntax: '<color>'; inherits: true; initial-value: #3b82f6; }

      :root {
        --bg: #07060b;
        --panel: #0d0b14;
        --panel-2: #121019;
        --line: rgb(255 255 255 / 0.09);
        --line-2: rgb(255 255 255 / 0.16);
        --ink: #f4f1fa;
        --mute: #a19bb3;
        --dim: #6c6680;
        --r-shell: 28px;
        --r-card: 22px;
        --sans: 'Inter Tight', ui-sans-serif, system-ui, sans-serif;
        --mono: 'JetBrains Mono', ui-monospace, monospace;
      }
      /* Broth picks the purple mood: cooler violet, electric fuchsia, hot magenta. */
      body {
        --a1: #d946ef; --a2: #7c3aed; --a3: #3b82f6;
        transition: --a1 0.8s ease, --a2 0.8s ease, --a3 0.8s ease;
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      body[data-broth='shio'] { --a1: #a78bfa; --a2: #5b21b6; --a3: #38bdf8; }
      body[data-broth='miso'] { --a1: #f472d0; --a2: #a21caf; --a3: #6366f1; }

      .micro {
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--mute);
        margin: 0;
      }
      .sq { display: inline-block; width: 6px; height: 6px; background: var(--a1); margin-right: 10px; vertical-align: 1px; box-shadow: 0 0 10px var(--a1); }
      .dim { color: var(--dim); }
      a { color: inherit; }
      :focus-visible { outline: 2px solid var(--a1); outline-offset: 3px; }

      /* ---------- Master shell ---------- */
      .page { padding: 20px; max-width: 1440px; margin: 0 auto; }
      .shell {
        position: relative;
        border: 1px solid var(--line);
        border-radius: var(--r-shell);
        background:
          linear-gradient(var(--line), var(--line)) 72px 0 / 1px 100% no-repeat,
          linear-gradient(var(--line), var(--line)) calc(100% - 72px) 0 / 1px 100% no-repeat,
          var(--panel);
        overflow: clip;
      }
      .cq { position: absolute; width: 7px; height: 7px; background: var(--bg); border: 1px solid var(--line-2); z-index: 5; }
      .cq.tl { top: 14px; left: 68px; } .cq.tr { top: 14px; right: 68px; }
      .cq.bl { bottom: 14px; left: 68px; } .cq.br { bottom: 14px; right: 68px; }

      /* ---------- Nav ---------- */
      .nav {
        position: relative; z-index: 4;
        display: flex; align-items: center; justify-content: space-between; gap: 24px;
        padding: 26px 104px;
        border-bottom: 1px solid var(--line);
      }
      .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; font-weight: 600; letter-spacing: -0.02em; font-size: 17px; }
      .brand-dot { width: 12px; height: 12px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #fff, var(--a1) 45%, var(--a2)); box-shadow: 0 0 14px var(--a1); }
      .brand-sub { padding-left: 12px; border-left: 1px solid var(--line-2); }
      .nav-links { display: flex; gap: 6px; padding: 5px; border: 1px solid var(--line); border-radius: 999px; background: rgb(255 255 255 / 0.02); }
      .nav-links a { font-size: 13.5px; text-decoration: none; color: var(--mute); padding: 8px 16px; border-radius: 999px; transition: color 0.2s, background 0.2s; }
      .nav-links a:hover { color: var(--ink); background: rgb(255 255 255 / 0.06); }
      .status { display: inline-flex; align-items: center; gap: 10px; }
      .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--a1); box-shadow: 0 0 0 0 var(--a1); animation: pulse 2.4s ease-out infinite; }
      @keyframes pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--a1) 60%, transparent); } 100% { box-shadow: 0 0 0 10px transparent; } }

      /* ---------- Hero ---------- */
      .hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        gap: 24px;
        padding: 72px 104px 80px;
        min-height: 690px;
        border-bottom: 1px solid var(--line);
        isolation: isolate;
      }
      .hero-grid {
        position: absolute; inset: 0; z-index: -2;
        background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
        background-size: 56px 56px;
        background-position: 36px -1px;
        mask-image: radial-gradient(ellipse 60% 70% at 72% 50%, #000 10%, transparent 75%);
        opacity: 0.6;
      }
      .hero-bloom {
        position: absolute; z-index: -1; right: -10%; top: -20%; width: 80%; height: 140%;
        background: radial-gradient(closest-side, color-mix(in srgb, var(--a2) 32%, transparent), transparent 70%);
        filter: blur(20px);
        animation: breathe 7s ease-in-out infinite;
      }
      @keyframes breathe { 50% { opacity: 0.65; } }
      .hero-copy { display: flex; flex-direction: column; justify-content: center; min-width: 0; }
      .eyebrow { margin-bottom: 28px; }
      .display {
        margin: 0;
        font-weight: 600;
        font-size: clamp(56px, 8.4vw, 132px);
        line-height: 0.9;
        letter-spacing: -0.055em;
      }
      .display em {
        font-style: normal;
        background: linear-gradient(100deg, #fff 0%, var(--a1) 45%, var(--a3) 100%);
        -webkit-background-clip: text; background-clip: text; color: transparent;
        padding-right: 0.06em;
      }
      .ln { display: block; overflow: hidden; padding-bottom: 0.08em; }
      .ln > span { display: inline-block; animation: rise 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
      .ln:nth-child(2) > span { animation-delay: 0.12s; }
      @keyframes rise { from { transform: translateY(105%); } }
      .lede { color: var(--mute); font-size: 17px; line-height: 1.55; max-width: 470px; margin: 26px 0 36px; }
      .lede.small { font-size: 15.5px; margin: 18px 0 0; max-width: 420px; }

      /* Segmented bar with a gradient edge */
      .seatbar, .dropbar {
        --edge: linear-gradient(110deg, color-mix(in srgb, var(--a1) 70%, transparent), rgb(255 255 255 / 0.08) 35%, rgb(255 255 255 / 0.06) 65%, color-mix(in srgb, var(--a3) 60%, transparent));
        display: flex; align-items: stretch; gap: 4px;
        padding: 6px;
        border-radius: 999px;
        border: 1px solid transparent;
        background: linear-gradient(#0f0c17, #0f0c17) padding-box, var(--edge) border-box;
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.05), inset 0 -12px 24px rgb(0 0 0 / 0.35), 0 30px 60px -30px color-mix(in srgb, var(--a2) 70%, transparent);
        max-width: 640px;
      }
      .seg {
        display: flex; flex-direction: column; justify-content: center; gap: 3px;
        padding: 8px 18px; border: 0; margin: 0; min-width: 0;
        border-right: 1px solid var(--line);
      }
      .seg .micro, .seg legend { font-size: 9.5px; color: var(--dim); padding: 0; }
      .seg select, .seg input {
        appearance: none; background: transparent; border: 0; color: var(--ink);
        font: 500 14.5px var(--sans); padding: 0; cursor: pointer; outline-offset: 4px;
      }
      .seg select option { background: #15121d; color: var(--ink); }
      .seg input { cursor: text; width: 100%; }
      .seg input::placeholder { color: var(--dim); }
      .broth { border-right: 0; flex: 1; }
      .broth legend { float: left; width: 100%; margin-bottom: 4px; }
      .broth-pills { display: flex; gap: 2px; clear: both; }
      .pill { position: relative; cursor: pointer; }
      .pill input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
      .pill span { display: block; font-size: 13px; font-weight: 500; padding: 4px 10px; border-radius: 999px; color: var(--mute); transition: background 0.3s, color 0.3s; }
      .pill:hover span { color: var(--ink); }
      .pill input:checked + span { color: #fff; background: color-mix(in srgb, var(--a1) 28%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--a1) 55%, transparent); }
      .pill input:focus-visible + span { outline: 2px solid var(--a1); outline-offset: 2px; }
      .go {
        display: inline-flex; align-items: center; gap: 10px; flex-shrink: 0;
        padding: 0 22px; border: 0; border-radius: 999px; cursor: pointer;
        font: 600 14px var(--sans); color: #fff;
        background: linear-gradient(120deg, var(--a1), var(--a2) 70%);
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.35), 0 8px 24px -8px var(--a1);
        transition: transform 0.2s, box-shadow 0.2s;
      }
      .go:hover { transform: translateY(-1px); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.35), 0 12px 32px -6px var(--a1); }
      .go svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.6; transition: transform 0.2s; }
      .go:hover svg { transform: translateX(3px); }
      .seat-note { margin-top: 16px; padding-left: 22px; color: var(--dim); }

      /* ---------- Focal object ---------- */
      .focal { position: relative; display: grid; place-items: center; min-height: 520px; }
      .orb {
        position: relative;
        width: clamp(200px, 24vw, 340px); aspect-ratio: 1; border-radius: 50%;
        background: radial-gradient(circle at 34% 28%, #fff 0%, color-mix(in srgb, var(--a1) 35%, #fff) 7%, var(--a1) 30%, var(--a2) 62%, #14061f 92%);
        box-shadow:
          0 0 90px 10px color-mix(in srgb, var(--a1) 45%, transparent),
          0 0 220px 40px color-mix(in srgb, var(--a2) 35%, transparent),
          inset -28px -36px 70px rgb(10 0 25 / 0.75),
          inset 10px 10px 40px rgb(255 255 255 / 0.15);
        animation: float 8s ease-in-out infinite;
      }
      .orb-yolk {
        position: absolute; inset: 30% 30% 30% 30%; border-radius: 50%;
        background: radial-gradient(circle at 40% 35%, color-mix(in srgb, var(--a3) 40%, #fff), transparent 70%);
        mix-blend-mode: screen; opacity: 0.35; filter: blur(8px);
      }
      .orb-sheen {
        position: absolute; left: 18%; top: 12%; width: 34%; height: 18%; border-radius: 50%;
        background: linear-gradient(180deg, rgb(255 255 255 / 0.7), transparent);
        filter: blur(4px); transform: rotate(-24deg);
      }
      @keyframes float { 50% { transform: translateY(-14px); } }
      .txt-ring { position: absolute; width: clamp(310px, 36vw, 510px); aspect-ratio: 1; animation: spin 40s linear infinite; }
      .txt-ring text { font: 500 8.4px var(--mono); letter-spacing: 0.32em; fill: rgb(255 255 255 / 0.62); }
      @keyframes spin { to { transform: rotate(360deg); } }
      .orbit { position: absolute; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--a1) 30%, transparent); }
      .o1 { width: clamp(360px, 44vw, 620px); aspect-ratio: 2.6; transform: rotate(-14deg); border-color: color-mix(in srgb, var(--a3) 30%, transparent); }
      .o2 { width: clamp(260px, 32vw, 450px); aspect-ratio: 1; border-style: dashed; opacity: 0.35; animation: spin 90s linear infinite reverse; }
      .floor {
        position: absolute; bottom: 2%; width: 90%; height: 90px; border-radius: 50%;
        background: radial-gradient(closest-side, color-mix(in srgb, var(--a1) 55%, transparent), transparent);
        filter: blur(18px); animation: breathe 5s ease-in-out infinite;
      }

      .float-card {
        position: absolute; right: 0; bottom: 34px; width: 248px;
        padding: 1px; border-radius: var(--r-card);
        background: linear-gradient(140deg, var(--a1), rgb(255 255 255 / 0.08) 40%, rgb(255 255 255 / 0.04) 60%, var(--a3));
        box-shadow: 0 40px 80px -20px rgb(0 0 0 / 0.8), 0 0 40px -10px color-mix(in srgb, var(--a1) 50%, transparent);
        animation: float 9s ease-in-out -3s infinite;
      }
      .fc-inner { border-radius: calc(var(--r-card) - 1px); padding: 18px 18px 16px; background: rgb(14 11 22 / 0.88); backdrop-filter: blur(14px); }
      .fc-label { font-size: 9.5px; }
      .fc-title { margin: 10px 0 14px; font-size: 18px; font-weight: 600; letter-spacing: -0.02em; }
      .fc-meter { height: 4px; border-radius: 4px; background: rgb(255 255 255 / 0.07); overflow: hidden; }
      .fc-meter span { display: block; height: 100%; width: 64%; background: linear-gradient(90deg, var(--a2), var(--a1)); border-radius: 4px; transition: width 0.8s cubic-bezier(0.2, 0.8, 0.2, 1); }
      .fc-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 14px 0 0; }
      .fc-meta dt { font-size: 9px; color: var(--dim); }
      .fc-meta dd { margin: 3px 0 0; font: 500 13.5px var(--mono); }

      .float-chip {
        position: absolute; left: 2%; top: 60px;
        display: flex; flex-direction: column; gap: 8px;
        padding: 12px 14px; border-radius: 16px;
        border: 1px solid var(--line-2); background: rgb(14 11 22 / 0.75); backdrop-filter: blur(10px);
        animation: float 10s ease-in-out -6s infinite;
      }
      .float-chip .micro { font-size: 9px; }
      .chip-seats { display: grid; grid-template-columns: repeat(7, 9px); gap: 4px; }
      .chip-seats i { width: 9px; height: 9px; border-radius: 2px; background: rgb(255 255 255 / 0.1); }
      .chip-seats i.on { background: var(--a1); box-shadow: 0 0 6px var(--a1); }
      .chip-num { color: var(--ink) !important; }

      /* ---------- Stats rail ---------- */
      .stats { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--line); padding: 0 72px; }
      .stat { padding: 30px 32px; border-left: 1px solid var(--line); }
      .stat:last-child { border-right: 1px solid var(--line); }
      .stat-v { margin: 12px 0 6px; font-size: 40px; font-weight: 600; letter-spacing: -0.04em; line-height: 1; }
      .stat-d { margin: 0; font-size: 13.5px; color: var(--dim); }

      /* ---------- Blocks ---------- */
      .sect { padding: 96px 104px; border-bottom: 1px solid var(--line); }
      .block-head { margin-bottom: 48px; }
      .block-head.split { display: flex; justify-content: space-between; align-items: end; gap: 48px; }
      .h2 { margin: 0; font-size: clamp(32px, 4.2vw, 58px); font-weight: 600; letter-spacing: -0.045em; line-height: 1; max-width: 760px; }
      .side-note { color: var(--mute); max-width: 340px; font-size: 15px; line-height: 1.6; margin: 0; }

      .bowls { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
      .bowl {
        position: relative; display: flex; flex-direction: column;
        padding: 22px; border-radius: var(--r-card);
        border: 1px solid transparent;
        background: linear-gradient(var(--panel-2), var(--panel-2)) padding-box, linear-gradient(160deg, var(--line-2), var(--line) 50%, var(--line-2)) border-box;
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04);
        transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.35s;
      }
      .bowl:hover {
        transform: translateY(-4px);
        background: linear-gradient(var(--panel-2), var(--panel-2)) padding-box, linear-gradient(160deg, var(--a1), var(--line) 50%, var(--a3)) border-box;
      }
      .bowl-top { display: flex; justify-content: space-between; align-items: center; }
      .bowl-n { font: 500 30px var(--sans); letter-spacing: -0.04em; color: var(--a1); }
      .tag { font-size: 9px; padding: 5px 9px; border-radius: 999px; border: 1px solid var(--line-2); }
      .bowl-name { margin: 46px 0 12px; font-size: 21px; font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; }
      .bowl-body { margin: 0 0 22px; color: var(--mute); font-size: 14px; line-height: 1.55; flex: 1; }
      .bowl-meta { margin: 0; border-top: 1px solid var(--line); }
      .bowl-meta div { display: flex; justify-content: space-between; padding: 9px 0; border-bottom: 1px solid var(--line); }
      .bowl-meta dt { font-size: 9.5px; }
      .bowl-meta dd { margin: 0; font-size: 13px; }
      .bowl-foot { display: flex; justify-content: space-between; align-items: baseline; margin-top: 16px; }
      .price { font: 500 22px var(--mono); }

      .rules { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--line); border-radius: var(--r-card); overflow: hidden; }
      .rule { position: relative; padding: 32px 30px 40px; border-right: 1px solid var(--line); background: rgb(255 255 255 / 0.012); }
      .rule:last-child { border-right: 0; }
      .rule-head { display: flex; align-items: center; gap: 14px; }
      .rule-n { font: 500 12px var(--mono); color: var(--a1); padding: 6px 9px; border: 1px solid color-mix(in srgb, var(--a1) 40%, transparent); border-radius: 8px; }
      .rule-lede { margin: 64px 0 12px; font-size: 28px; font-weight: 600; letter-spacing: -0.035em; }
      .rule-body { margin: 0; color: var(--mute); font-size: 14.5px; line-height: 1.6; }
      .rule-line { position: absolute; left: 0; bottom: 0; height: 2px; width: 100%; background: linear-gradient(90deg, transparent, var(--a1), transparent); transform: scaleX(0); transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); }
      .rule:hover .rule-line { transform: scaleX(1); }

      .drop { position: relative; display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 40px; padding: 96px 104px; isolation: isolate; overflow: hidden; }
      .drop-glow { position: absolute; z-index: -1; left: 50%; bottom: -220px; width: 900px; height: 360px; transform: translateX(-50%); border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--a2) 55%, transparent), transparent); filter: blur(30px); }
      .dropbar { flex: 1; min-width: 300px; max-width: 520px; }
      .grow { flex: 1; border-right: 0; }
      .drop-note { position: absolute; right: 104px; bottom: 60px; color: var(--a1); }

      .foot { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 26px 104px 34px; border-top: 1px solid var(--line); }
      .foot .micro { color: var(--dim); }

      /* ---------- Responsive ---------- */
      @media (max-width: 1180px) {
        .bowls { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .nav-links { display: none; }
      }
      @media (max-width: 980px) {
        .shell { background: var(--panel); }
        .cq.tl, .cq.bl { left: 14px; } .cq.tr, .cq.br { right: 14px; }
        .nav, .hero, .sect, .drop, .foot { padding-left: 32px; padding-right: 32px; }
        .hero { grid-template-columns: 1fr; padding-top: 48px; min-height: 0; }
        .focal { min-height: 440px; }
        .stats { grid-template-columns: repeat(2, 1fr); padding: 0; }
        .stat { border-bottom: 1px solid var(--line); }
        .stat:nth-child(odd) { border-left: 0; }
        .stat:last-child { border-right: 0; }
        .rules { grid-template-columns: 1fr; }
        .rule { border-right: 0; border-bottom: 1px solid var(--line); }
        .rule-lede { margin-top: 32px; }
        .block-head.split { flex-direction: column; align-items: start; gap: 20px; }
        .drop-note { position: static; width: 100%; }
      }
      @media (max-width: 640px) {
        .page { padding: 10px; }
        .shell { --r-shell: 22px; }
        .nav, .hero, .sect, .drop, .foot { padding-left: 20px; padding-right: 20px; }
        .nav { padding-top: 20px; padding-bottom: 20px; }
        .brand-sub, .status { display: none; }
        .hero { padding-top: 36px; padding-bottom: 40px; }
        .display { font-size: 58px; }
        .lede { font-size: 15.5px; margin: 20px 0 26px; }
        .seatbar { flex-wrap: wrap; border-radius: 24px; gap: 0; }
        .seatbar .seg { flex: 1 1 40%; padding: 10px 14px; }
        .seatbar .seg:nth-child(2) { border-right: 0; }
        .seatbar .broth { flex-basis: 100%; border-top: 1px solid var(--line); }
        .seatbar .go { flex-basis: 100%; justify-content: center; padding: 14px; margin-top: 4px; }
        .seat-note { padding-left: 4px; }
        .focal { min-height: 400px; margin-top: 10px; }
        .orb { width: 190px; }
        .txt-ring { width: 300px; }
        .float-card { width: 210px; right: -4px; bottom: 0; }
        .float-chip { left: -4px; top: 12px; }
        .stat { padding: 22px 20px; }
        .stat-v { font-size: 32px; }
        .sect { padding-top: 64px; padding-bottom: 64px; }
        .bowls { grid-template-columns: 1fr; }
        .bowl-name { margin-top: 28px; }
        .drop { padding-top: 64px; padding-bottom: 64px; gap: 28px; }
        .dropbar { min-width: 0; width: 100%; }
        .dropbar .seg { padding: 8px 14px; }
        .foot { flex-direction: column; gap: 8px; }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition: none !important; }
      }
    </style>

    <script>
      const pots: Record<string, { title: string; simmer: string; left: number }> = {
        shio: { title: 'Yuzu Shio Clear', simmer: '9 h 15 m', left: 22 },
        tonkotsu: { title: 'Black Garlic Tonkotsu', simmer: '18 h 40 m', left: 37 },
        miso: { title: 'Red Miso Static', simmer: '18 h 40 m', left: 14 },
      };
      const $ = (id: string) => document.getElementById(id);

      const seatbar = $('seatbar') as HTMLFormElement | null;
      seatbar?.addEventListener('change', (e) => {
        const t = e.target as HTMLInputElement;
        if (t.name !== 'broth') {
          return;
        }
        const pot = pots[t.value];
        document.body.dataset.broth = t.value;
        $('fc-title')!.textContent = pot.title;
        $('fc-simmer')!.textContent = pot.simmer;
        $('fc-left')!.textContent = `${pot.left} bowls`;
        ($('fc-bar') as HTMLElement).style.width = `${Math.round((pot.left / 58) * 100)}%`;
      });
      seatbar?.addEventListener('submit', (e) => {
        e.preventDefault();
        const f = new FormData(seatbar);
        const pot = pots[String(f.get('broth'))];
        $('seat-note')!.textContent = `Held: ${f.get('party')} at ${f.get('time')} · ${pot.title} · show this at the door`;
      });

      const dropbar = $('dropbar') as HTMLFormElement | null;
      dropbar?.addEventListener('submit', (e) => {
        e.preventDefault();
        const phone = String(new FormData(dropbar).get('phone') ?? '').trim();
        $('drop-note')!.textContent = phone ? 'You are on the list · first text tonight around 02:00' : 'Add a mobile number first';
      });
    </script>
  </body>
</html>
