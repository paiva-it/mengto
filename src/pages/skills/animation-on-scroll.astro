---
import '../../styles/global.css';
import '../../components/skills/animation-on-scroll/tw.css';
import BackPill from '../../components/BackPill.astro';

// Four-part hero timeline: each step names the delay its elements use.
const steps = [
  { n: '01', label: 'Eyebrow', d: '0.10s' },
  { n: '02', label: 'Headline', d: '0.25s' },
  { n: '03', label: 'Specimen', d: '0.60s' },
  { n: '04', label: 'Details', d: '0.85s' },
];

const weights = [
  { w: 200, name: 'ExtraLight', sample: 'Quiet proofs at dawn' },
  { w: 300, name: 'Light', sample: 'Margins left to breathe' },
  { w: 400, name: 'Regular', sample: 'Body copy, set to last' },
  { w: 500, name: 'Medium', sample: 'Captions with a spine' },
  { w: 600, name: 'SemiBold', sample: 'Signage across the hall' },
  { w: 700, name: 'Bold', sample: 'Headlines that hold' },
  { w: 800, name: 'ExtraBold', sample: 'Posters, loudly' },
];

const glyphs = [
  ['A', 'U+0041'], ['g', 'U+0067'], ['&', 'U+0026'], ['ß', 'U+00DF'],
  ['R', 'U+0052'], ['¶', 'U+00B6'], ['7', 'U+0037'], ['?', 'U+003F'],
  ['@', 'U+0040'], ['€', 'U+20AC'], ['ñ', 'U+00F1'], ['ø', 'U+00F8'],
];

const licenses = [
  { name: 'Desktop', price: '€60', unit: 'per 5 seats', body: 'Install the family for layout, branding and print work. Add seats any time.' },
  { name: 'Web', price: '€90', unit: 'per 250k views / month', body: 'Self-hosted WOFF2 with the variable axes intact. No tracking, no CDN lock-in.' },
  { name: 'App', price: '€240', unit: 'per app title', body: 'Embed Sorrel in iOS, Android or desktop software, including future updates.' },
];

// Shared Tailwind class from the skill; per-element delay comes from --d.
const reveal = 'animate-on-scroll [animation:animationIn_0.8s_ease-out_var(--d,0s)_both]';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Platen Type Co. — Sorrel Grotesk</title>
    <meta name="description" content="Platen is an independent type foundry. Sorrel Grotesk: seven weights, a width axis and optical sizes from caption to billboard." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Skill: keyframes first … -->
    <style is:inline>
      @keyframes animationIn {
        0% { opacity: 0; transform: translateY(30px); filter: blur(8px); }
        100% { opacity: 1; transform: translateY(0); filter: blur(0px); }
      }
      @keyframes glyphIn {
        0% { opacity: 0; transform: translateY(18px) scale(0.92); filter: blur(10px); }
        100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0px); }
      }
      @keyframes barFill {
        0% { transform: scaleX(0); }
        100% { transform: scaleX(1); }
      }
    </style>

    <!-- … then the IntersectionObserver trigger. `once` lives on window so the page toggle can flip it. -->
    <script is:inline>
      (function () {
        const style = document.createElement('style');
        style.textContent = `
          .animate-on-scroll { animation-play-state: paused !important; }
          .animate-on-scroll.animate { animation-play-state: running !important; }
        `;
        document.head.appendChild(style);

        const opts = (window.__aos = window.__aos || { once: true });

        // Rewind an element to frame 0 (paused, hidden by the `both` fill).
        window.resetInView = function (el) {
          el.classList.remove('animate');
          el.style.animation = 'none';
          void el.offsetWidth;
          el.style.removeProperty('animation');
        };

        if (!window.__inViewIO) {
          window.__inViewIO = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('animate');
                if (opts.once) window.__inViewIO.unobserve(entry.target);
              } else if (!opts.once && entry.target.classList.contains('animate')) {
                window.resetInView(entry.target);
              }
            });
          }, { threshold: 0.2, rootMargin: '0px 0px -10% 0px' });
        }

        window.initInViewAnimations = function (selector = '.animate-on-scroll') {
          document.querySelectorAll(selector).forEach((el) => window.__inViewIO.observe(el));
        };

        document.addEventListener('DOMContentLoaded', () => initInViewAnimations());
      })();
    </script>

    <style is:inline>
      :root {
        --paper: #efede6;
        --paper-2: #e6e3d9;
        --ink: #121212;
        --muted: #66645e;
        --line: #d3cfc3;
        --cobalt: #2e3bff;
        --cobalt-ink: #1b25c9;
      }
      @media (prefers-reduced-motion: reduce) {
        .animate-on-scroll { animation: none !important; opacity: 1 !important; transform: none !important; filter: none !important; }
      }
    </style>
  </head>
  <body class="bg-[var(--paper)] text-[var(--ink)] antialiased [font-family:'Bricolage_Grotesque',ui-sans-serif,system-ui,sans-serif] overflow-x-clip">
    <!-- NAV -->
    <header class="sticky top-0 z-40 border-b border-[var(--line)] bg-[var(--paper)]/85 backdrop-blur">
      <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-4 px-4 py-3 sm:px-8">
        <a href="#top" class="flex items-center gap-2.5 font-bold tracking-tight">
          <span class="grid size-7 place-items-center rounded-[6px] bg-[var(--cobalt)] text-[15px] font-extrabold text-[var(--paper)]">P</span>
          <span class="whitespace-nowrap text-[17px]">Platen<span class="hidden sm:inline"> Type Co.</span></span>
        </a>
        <nav class="hidden items-center gap-7 text-[14px] text-[var(--muted)] lg:flex" aria-label="Primary">
          <a class="hover:text-[var(--ink)]" href="#family">Typefaces</a>
          <a class="hover:text-[var(--ink)]" href="#glyphs">Glyphs</a>
          <a class="hover:text-[var(--ink)]" href="#notes">Field notes</a>
          <a class="hover:text-[var(--ink)]" href="#licensing">Licensing</a>
        </nav>
        <div class="flex items-center gap-2">
          <button id="repeat" type="button" aria-pressed="false" class="ctl hidden sm:inline-flex">
            <span class="dot" aria-hidden="true"></span>Repeat on re-entry
          </button>
          <button id="replay" type="button" class="ctl ctl-solid">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /></svg>
            <span>Replay<span class="hidden sm:inline"> sequence</span></span>
          </button>
        </div>
      </div>
    </header>

    <main id="top">
      <!-- HERO: four-part sequence -->
      <section class="mx-auto max-w-[1440px] px-4 pb-10 pt-8 sm:px-8 lg:pt-10">
        <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
          <div class="flex flex-col lg:col-span-7">
            <p class={`${reveal} mono flex items-center gap-2 text-[var(--muted)]`} style="--d:0.10s">
              <span class="inline-block size-2 rounded-full bg-[var(--cobalt)]"></span>
              New release — Sorrel Grotesk, Vol. 02
            </p>
            <h1 class="mt-5 text-[clamp(50px,7.3vw,112px)] font-extrabold leading-[0.9] tracking-[-0.045em] [font-variation-settings:'opsz'_96]">
              <span class={`${reveal} block`} style="--d:0.25s">Type should</span>
              <span class={`${reveal} block`} style="--d:0.35s">arrive in the</span>
              <span class={`${reveal} block`} style="--d:0.45s">order you <span class="text-[var(--cobalt)]">read it.</span></span>
            </h1>
            <div class={`${reveal} mt-8 grid gap-6 sm:grid-cols-[1fr_auto] sm:items-end lg:mt-auto lg:pt-10`} style="--d:0.85s">
              <p class="max-w-[46ch] text-[17px] leading-[1.55] text-[var(--muted)]">
                Sorrel is a grotesk with a slightly crooked spine: seven weights, a width axis from 75 to 100, and optical
                sizes drawn separately for 12-point captions and 96-point billboards.
              </p>
              <div class="flex flex-wrap gap-2">
                <a href="#licensing" class="ctl ctl-cobalt">Download trial fonts</a>
                <a href="#family" class="ctl">Read the specimen →</a>
              </div>
            </div>
          </div>

          <figure class={`${reveal} relative flex min-h-[420px] flex-col lg:min-h-[600px] overflow-hidden rounded-[20px] bg-[var(--cobalt)] text-[var(--paper)] lg:col-span-5`} style="--d:0.60s" aria-label="Specimen of the glyphs A and g in Sorrel ExtraBold">
            <div class="mono flex items-center justify-between gap-4 px-5 pt-5 text-white/70">
              <span>Sorrel · 800 · opsz 96</span><span>U+0041 U+0067</span>
            </div>
            <!-- Guides sit in em of the glyph size, so they stay on the letterforms at every width. -->
            <div class="relative mx-5 my-auto h-[1.08em] text-[clamp(170px,22vw,320px)]">
              <div class="guide top-[0.153em]"><span>Cap height 700</span></div>
              <div class="guide top-[0.274em]"><span>x-height 520</span></div>
              <div class="guide top-[0.826em] !border-white/70"><span>Baseline 0</span></div>
              <div class="guide top-[0.968em]"><span>Descender −210</span></div>
              <p class="absolute left-0 top-0 select-none font-extrabold leading-none tracking-[-0.06em] [font-variation-settings:'opsz'_96]" aria-hidden="true">Ag</p>
            </div>
            <figcaption class="mono flex flex-wrap gap-1.5 px-5 pb-5 pt-4">
              {weights.map((w) => (
                <span class={`rounded-full border px-2.5 py-1 ${w.w === 800 ? 'border-white bg-white text-[var(--cobalt)]' : 'border-white/30 text-white/80'}`}>{w.w}</span>
              ))}
            </figcaption>
          </figure>
        </div>

        <!-- Timeline legend -->
        <ol class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-[var(--line)] pt-5 md:grid-cols-4" aria-label="Reveal timeline">
          {steps.map((s) => (
            <li>
              <div class="mono flex items-baseline justify-between text-[var(--muted)]">
                <span><span class="text-[var(--ink)]">{s.n}</span> {s.label}</span>
                <span>+{s.d}</span>
              </div>
              <div class="mt-2.5 h-[3px] overflow-hidden rounded-full bg-[var(--paper-2)]">
                <div class="animate-on-scroll [animation:barFill_0.8s_ease-out_var(--d)_both] h-full origin-left bg-[var(--cobalt)]" style={`--d:${s.d}`}></div>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- WEIGHTS -->
      <section id="family" class="mx-auto max-w-[1440px] px-4 py-20 sm:px-8 lg:py-28">
        <div class="grid gap-6 lg:grid-cols-12">
          <p class={`${reveal} mono text-[var(--muted)] lg:col-span-3`}>§ 01 — The family</p>
          <div class="lg:col-span-9">
            <h2 class={`${reveal} text-[clamp(36px,4.6vw,68px)] font-bold leading-[0.98] tracking-[-0.035em]`} style="--d:0.1s">
              Seven weights, each one drawn — not interpolated into place.
            </h2>
          </div>
        </div>
        <ul class="mt-12 border-t border-[var(--ink)]">
          {weights.map((w, i) => (
            <li class={`${reveal} grid grid-cols-[auto_1fr] items-baseline gap-x-6 border-b border-[var(--line)] py-4 md:grid-cols-[180px_1fr_auto]`} style={`--d:${(i * 0.07).toFixed(2)}s`}>
              <span class="mono text-[var(--muted)]">{w.w} <span class="hidden sm:inline">— {w.name}</span></span>
              <span class="min-w-0 truncate text-[clamp(26px,4.2vw,60px)] leading-[1.1] tracking-[-0.03em]" style={`font-weight:${w.w}`}>{w.sample}</span>
              <span class="mono hidden text-[var(--muted)] md:block">Aa · {w.name}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- GLYPHS -->
      <section id="glyphs" class="bg-[var(--ink)] text-[var(--paper)]">
        <div class="mx-auto max-w-[1440px] px-4 py-20 sm:px-8 lg:py-28">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <div>
              <p class={`${reveal} mono text-white/55`}>§ 02 — Character set</p>
              <h2 class={`${reveal} mt-4 max-w-[16ch] text-[clamp(36px,4.6vw,68px)] font-bold leading-[0.98] tracking-[-0.035em]`} style="--d:0.1s">684 glyphs, every one of them argued over.</h2>
            </div>
            <p class={`${reveal} max-w-[38ch] text-[16px] leading-[1.55] text-white/60`} style="--d:0.2s">
              Latin Extended-A, tabular and oldstyle figures, small caps, and an ampersand we kept even though nobody voted for it.
            </p>
          </div>
          <ul class="mt-12 grid grid-cols-3 gap-px overflow-hidden rounded-[16px] border border-white/10 bg-white/10 sm:grid-cols-4 lg:grid-cols-6">
            {glyphs.map(([g, code], i) => (
              <li
                class={`animate-on-scroll [animation:glyphIn_0.9s_cubic-bezier(.2,.7,.2,1)_var(--d)_both] flex aspect-square flex-col justify-between p-3 sm:p-4 ${i === 2 ? 'bg-[var(--cobalt)]' : 'bg-[var(--ink)]'}`}
                style={`--d:${((i % 6) * 0.06 + Math.floor(i / 6) * 0.12).toFixed(2)}s`}
              >
                <span class="mono text-white/45">{code}</span>
                <span class="text-center text-[clamp(52px,7vw,104px)] font-semibold leading-none tracking-[-0.04em]" aria-hidden="true">{g}</span>
                <span class="sr-only">{g}</span>
                <span class="h-3"></span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- FIELD NOTES -->
      <section id="notes" class="mx-auto max-w-[1440px] px-4 py-20 sm:px-8 lg:py-28">
        <p class={`${reveal} mono text-[var(--muted)]`}>§ 03 — Field notes</p>
        <blockquote class="mt-6 max-w-[22ch] text-[clamp(34px,5.4vw,84px)] font-semibold leading-[1] tracking-[-0.04em] [font-variation-settings:'wdth'_88]">
          <span class={`${reveal} block`} style="--d:0.05s">“We redrew the lowercase</span>
          <span class={`${reveal} block`} style="--d:0.15s"><span class="text-[var(--cobalt)]">g</span> eleven times. The twelfth</span>
          <span class={`${reveal} block`} style="--d:0.25s">finally sat on the line</span>
          <span class={`${reveal} block`} style="--d:0.35s">like it meant it.”</span>
        </blockquote>
        <p class={`${reveal} mono mt-6 text-[var(--muted)]`} style="--d:0.45s">— Ines Varga, type designer, Platen</p>
        <dl class="mt-16 grid divide-y divide-[var(--line)] overflow-hidden rounded-[16px] border border-[var(--line)] sm:grid-cols-3 sm:divide-x sm:divide-y-0">
          {[
            ['684', 'glyphs per weight'],
            ['140+', 'languages supported'],
            ['5 yrs', 'from first sketch to v2'],
          ].map(([n, l], i) => (
            <div class={`${reveal} bg-[var(--paper)] p-6 sm:p-8`} style={`--d:${(i * 0.1).toFixed(2)}s`}>
              <dt class="mono text-[var(--muted)]">{l}</dt>
              <dd class="mt-3 text-[clamp(44px,5vw,72px)] font-bold leading-none tracking-[-0.04em]">{n}</dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- LICENSING -->
      <section id="licensing" class="border-t border-[var(--line)] bg-[var(--paper-2)]">
        <div class="mx-auto max-w-[1440px] px-4 py-20 sm:px-8 lg:py-28">
          <div class="grid gap-6 lg:grid-cols-12">
            <p class={`${reveal} mono text-[var(--muted)] lg:col-span-3`}>§ 04 — Licensing</p>
            <h2 class={`${reveal} text-[clamp(36px,4.6vw,68px)] font-bold leading-[0.98] tracking-[-0.035em] text-balance lg:col-span-9`} style="--d:0.1s">
              Try it free for a month. Pay when it ships.
            </h2>
          </div>
          <div class="mt-12 grid gap-4 md:grid-cols-3">
            {licenses.map((l, i) => (
              <article class={`${reveal} flex flex-col rounded-[18px] border border-[var(--line)] bg-[var(--paper)] p-6 sm:p-7`} style={`--d:${(0.1 + i * 0.12).toFixed(2)}s`}>
                <h3 class="mono text-[var(--muted)]">{l.name} licence</h3>
                <p class="mt-6 text-[56px] font-bold leading-none tracking-[-0.04em]">{l.price}</p>
                <p class="mono mt-2 text-[var(--muted)]">{l.unit}</p>
                <p class="mt-6 flex-1 text-[16px] leading-[1.55]">{l.body}</p>
                <a href="#top" class={`ctl mt-8 justify-center ${i === 1 ? 'ctl-cobalt' : ''}`}>Choose {l.name.toLowerCase()}</a>
              </article>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="overflow-hidden bg-[var(--cobalt)] text-[var(--paper)]">
      <div class="mx-auto max-w-[1440px] px-4 pb-20 pt-16 sm:px-8 sm:pb-10">
        <div class="mono flex flex-wrap justify-between gap-4 text-white/70">
          <span>Platen Type Co. — independent type foundry, Ghent. Est. 2019.</span>
          <span>hello@platen.type</span>
        </div>
        <p class={`${reveal} mt-10 text-[clamp(96px,22vw,340px)] font-extrabold leading-[0.8] tracking-[-0.06em]`} aria-hidden="true">Sorrel</p>
      </div>
    </footer>

    <BackPill />

    <style is:global>
      @layer components {
      .mono {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 12px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .ctl {
        display: inline-flex; align-items: center; gap: 8px;
        height: 40px; padding: 0 16px; border-radius: 999px;
        border: 1px solid var(--line); background: var(--paper);
        font-size: 14px; font-weight: 500; color: var(--ink);
        transition: background 0.2s, border-color 0.2s, color 0.2s;
        white-space: nowrap; cursor: pointer;
      }
      .ctl:hover { border-color: var(--ink); }
      .ctl-solid { background: var(--ink); border-color: var(--ink); color: var(--paper); }
      .ctl-solid:hover { background: #000; }
      .ctl-cobalt { background: var(--cobalt); border-color: var(--cobalt); color: #fff; }
      .ctl-cobalt:hover { background: var(--cobalt-ink); border-color: var(--cobalt-ink); }
      .ctl:focus-visible, a:focus-visible { outline: 2px solid var(--cobalt); outline-offset: 3px; }
      .ctl .dot { width: 8px; height: 8px; border-radius: 999px; border: 1.5px solid var(--muted); }
      .ctl[aria-pressed='true'] { border-color: var(--cobalt); color: var(--cobalt); }
      .ctl[aria-pressed='true'] .dot { background: var(--cobalt); border-color: var(--cobalt); }
      }
      .guide {
        position: absolute; left: 0; right: 0; border-top: 1px dashed rgb(255 255 255 / 0.28);
      }
      .guide span {
        position: absolute; right: 0; top: 4px;
        font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 10px;
        letter-spacing: 0.06em; text-transform: uppercase; color: rgb(255 255 255 / 0.6);
      }
    </style>

    <script>
      type AosWindow = Window & {
        __aos: { once: boolean };
        __inViewIO: IntersectionObserver;
        resetInView: (el: Element) => void;
        initInViewAnimations: (selector?: string) => void;
      };
      const w = window as unknown as AosWindow;
      const all = () => document.querySelectorAll('.animate-on-scroll');

      // Rewind everything, then re-observe: whatever is in view replays, the rest waits for scroll.
      document.getElementById('replay')?.addEventListener('click', () => {
        all().forEach((el) => {
          w.resetInView(el);
          w.__inViewIO.unobserve(el); // unobserve + observe forces a fresh intersection callback
          w.__inViewIO.observe(el);
        });
      });

      const repeat = document.getElementById('repeat');
      repeat?.addEventListener('click', () => {
        w.__aos.once = !w.__aos.once;
        repeat.setAttribute('aria-pressed', String(!w.__aos.once));
        w.initInViewAnimations(); // re-observe elements `once` already let go of
      });
    </script>
  </body>
</html>
