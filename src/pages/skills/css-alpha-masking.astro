---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

const img = (f: string) => `/skills/css-alpha-masking/${f}`;

// Glasshouse zones — the compact control. Each one swaps the large surface.
const zones = [
  { id: 'palm', name: 'Palm House', src: img('palm.jpg'), pos: '50% 45%', temp: '27.4', rh: 84, caption: 'Forty metres of wrought-iron rib over the oldest palms in the north.', next: '11:40' },
  { id: 'fern', name: 'Fernery', src: img('fern.jpg'), pos: '50% 50%', temp: '19.8', rh: 91, caption: 'A sunken ravine of tree ferns, kept wet by a fog line every forty minutes.', next: '11:20' },
  { id: 'arid', name: 'Arid Wing', src: img('cacti.jpg'), pos: '50% 70%', temp: '31.2', rh: 22, caption: 'South-facing glass, gravel beds and three centuries of patient succulents.', next: '—' },
  { id: 'under', name: 'Understorey', src: img('understorey.jpg'), pos: '50% 40%', temp: '24.6', rh: 88, caption: 'The shade layer: aroids, gingers and the leaves that never see the roof.', next: '12:05' },
  { id: 'topiary', name: 'Topiary Walk', src: img('topiary.jpg'), pos: '50% 30%', temp: '16.1', rh: 63, caption: 'Clipped bay and box between the two houses, shaped by hand each May.', next: '—' },
  { id: 'prop', name: 'Propagation', src: img('seedlings.jpg'), pos: '50% 50%', temp: '22.0', rh: 79, caption: 'Behind the scenes: 4,200 seedlings on heat mats, raised for the beds above.', next: '11:55' },
  { id: 'shed', name: 'Potting Shed', src: img('potting.jpg'), pos: '40% 50%', temp: '18.3', rh: 58, caption: 'Loam, grit and leaf mould, mixed to order for every plant we grow.', next: '—' },
];
const first = zones[0];

// 24 hourly humidity readings for the metric card (Palm House, yesterday).
const hours = [78, 80, 81, 83, 84, 86, 88, 87, 85, 82, 79, 77, 76, 78, 81, 84, 86, 89, 90, 88, 86, 85, 84, 84];

// Specimen register — the vertical fade.
const register = [
  { acc: 'HG-1962-003', latin: 'Encephalartos woodii', common: "Wood's cycad", zone: 'Palm House' },
  { acc: 'HG-1987-014', latin: 'Victoria amazonica', common: 'Giant waterlily', zone: 'Lily Tank' },
  { acc: 'HG-1911-201', latin: 'Dicksonia antarctica', common: 'Soft tree fern', zone: 'Fernery' },
  { acc: 'HG-1974-058', latin: 'Welwitschia mirabilis', common: 'Tree tumbo', zone: 'Arid Wing' },
  { acc: 'HG-2003-117', latin: 'Nepenthes rajah', common: 'Giant pitcher plant', zone: 'Orchid Loft' },
  { acc: 'HG-1998-040', latin: 'Amorphophallus titanum', common: 'Titan arum', zone: 'Palm House' },
  { acc: 'HG-1955-009', latin: 'Lodoicea maldivica', common: 'Coco de mer', zone: 'Palm House' },
  { acc: 'HG-2011-302', latin: 'Wollemia nobilis', common: 'Wollemi pine', zone: 'Temperate' },
  { acc: 'HG-1936-076', latin: 'Angiopteris evecta', common: 'King fern', zone: 'Fernery' },
  { acc: 'HG-2019-411', latin: 'Saxifraga longifolia', common: 'Pyrenean saxifrage', zone: 'Alpine Bench' },
];

const flowering = [
  { name: 'Titan arum', where: 'Palm House, bed 4', when: 'Opening — day 2 of 3' },
  { name: 'Jade vine', where: 'Lily Tank arch', when: 'Peak until 14 Oct' },
  { name: 'Queen of the night', where: 'Arid Wing', when: 'Tonight, after 21:00' },
  { name: 'Corpse lily seedlings', where: 'Propagation', when: 'Pricked out Tuesday' },
  { name: 'Slipper orchids', where: 'Orchid Loft', when: 'Twelve in bloom' },
];

const gallery = [
  { src: img('fern.jpg'), title: 'Fernery', note: 'Fog line, every 40 min' },
  { src: img('topiary.jpg'), title: 'Topiary Walk', note: 'Clipped each May' },
  { src: img('cacti.jpg'), title: 'Arid Wing', note: '22 % humidity' },
  { src: img('seedlings.jpg'), title: 'Propagation', note: '4,200 on heat mats' },
  { src: img('understorey.jpg'), title: 'Understorey', note: 'Never sees the roof' },
  { src: img('palm.jpg'), title: 'Palm House', note: 'Raised 1868' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Halden Glasshouse — CSS Alpha Masking</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href={first.src} />
  </head>
  <body>
    <div class="page">
      <header class="nav wrap">
        <a class="brand" href="#top"><span class="dot" aria-hidden="true"></span>Halden Glasshouse</a>
        <p class="nav-meta"><span class="hide-sm">Palm House </span><span>Open 09:00–18:00</span><span class="hide-sm"> · Misting live</span></p>
      </header>

      <main id="top">
        <!-- ======================== FIRST VIEWPORT ======================== -->
        <section class="hero wrap" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow">Botanical conservatory · est. 1868</p>
            <h1 id="hero-title">Every edge<br /><span class="fade-word">dissolves</span> into leaf.</h1>
          </div>
          <div class="hero-side">
            <p class="lede">Halden is a Victorian glasshouse where the jungle, the fog and the iron all blur into one another. So does this page: one alpha mask, tuned below, softens the canopy, the readings and the zone picker alike.</p>
            <form class="inspector" aria-label="Mask inspector" onsubmit="return false">
              <label class="field">
                <span class="field-row"><span>Fade depth</span><output id="depth-out" for="depth">15%</output></span>
                <input id="depth" type="range" min="0" max="40" step="1" value="15" />
              </label>
              <div class="seg-group">
                <div class="seg" role="group" aria-label="Fade direction">
                  <button type="button" data-dir="to right" aria-pressed="true">↔ Sides</button>
                  <button type="button" data-dir="to bottom" aria-pressed="false">↕ Top &amp; base</button>
                </div>
                <div class="seg" role="group" aria-label="Fade strength">
                  <button type="button" data-edge="transparent" aria-pressed="true">Full</button>
                  <button type="button" data-edge="rgba(0, 0, 0, 0.2)" aria-pressed="false">Soft</button>
                </div>
              </div>
            </form>
          </div>
        </section>

        <section class="stage wrap" aria-label="Glasshouse zones">
          <div class="stage-main">
            <!-- Compact control: horizontally scrolling zone picker, edges masked -->
            <div class="zones mask-x" role="group" aria-label="Choose a zone">
              <div class="zones-track">
                {zones.map((z, i) => (
                  <button
                    type="button"
                    class="zone"
                    aria-pressed={i === 0 ? 'true' : 'false'}
                    data-src={z.src}
                    data-pos={z.pos}
                    data-temp={z.temp}
                    data-rh={z.rh}
                    data-caption={z.caption}
                    data-next={z.next}
                    data-name={z.name}
                  >{z.name}</button>
                ))}
              </div>
            </div>

            <!-- Large surface: the canopy photo carries the mask; copy sits in the faded margin -->
            <article class="surface">
              <div class="surface-photo mask-live" aria-hidden="true">
                <img id="zone-img" src={first.src} alt="" style={`object-position:${first.pos}`} width="1400" height="934" />
              </div>
              <div class="surface-copy">
                <p class="label">Now viewing</p>
                <h2 id="zone-name">{first.name}</h2>
                <p id="zone-caption">{first.caption}</p>
              </div>
              <p class="surface-tag mono" aria-hidden="true"><span id="tag-dir">to right</span> · <span id="tag-stop">15%</span></p>
            </article>
          </div>

          <aside class="stage-side">
            <!-- Compact metric card: the bar strip carries the same mask -->
            <article class="card metric">
              <div class="card-head">
                <p class="label">Relative humidity</p>
                <p class="mono muted" id="metric-zone">{first.name}</p>
              </div>
              <p class="metric-num"><span id="rh">{first.rh}</span><small>%</small></p>
              <div class="bars mask-live" aria-hidden="true">
                {hours.map((h) => <span style={`--h:${(h - 60) * 3.2}%`}></span>)}
              </div>
              <dl class="metric-foot">
                <div><dt>Air</dt><dd><span id="temp">{first.temp}</span> °C</dd></div>
                <div><dt>Next misting</dt><dd id="next">{first.next}</dd></div>
              </dl>
            </article>

            <article class="card flowering">
              <p class="label">In flower this week</p>
              <div class="flower-window mask-y">
                <ul class="flower-track">
                  {[...flowering, ...flowering].map((f, i) => (
                    <li aria-hidden={i >= flowering.length ? 'true' : undefined}>
                      <strong>{f.name}</strong>
                      <span>{f.where}</span>
                      <em>{f.when}</em>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          </aside>
        </section>

        <!-- ======================== BELOW THE FOLD ======================== -->
        <section class="register wrap" aria-labelledby="register-title">
          <div class="register-copy">
            <p class="eyebrow">Specimen register</p>
            <h2 id="register-title">Labels that drift in and out of the mist.</h2>
            <p>Eleven thousand accessions, from a cycad that has no living wild relatives to seedlings pricked out last week. The register scrolls forever; a vertical mask lets each line arrive from the fog and leave into it, so the list never has a hard top or bottom.</p>
            <pre class="snippet" aria-label="Vertical mask in use"><code><span class="k">mask-image</span>: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
<span class="k">-webkit-mask-image</span>: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);</code></pre>
          </div>
          <div class="register-window mask-y-deep">
            <ol class="register-track">
              {[...register, ...register].map((r, i) => (
                <li aria-hidden={i >= register.length ? 'true' : undefined}>
                  <span class="mono acc">{r.acc}</span>
                  <span class="latin">{r.latin}</span>
                  <span class="common">{r.common}</span>
                  <span class="mono zone-tag">{r.zone}</span>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <section class="walk" aria-labelledby="walk-title">
          <div class="wrap walk-head">
            <p class="eyebrow">The walk, end to end</p>
            <h2 id="walk-title">Six houses, one unbroken path.</h2>
          </div>
          <div class="walk-window mask-x-wide">
            <ul class="walk-track">
              {[...gallery, ...gallery].map((g, i) => (
                <li aria-hidden={i >= gallery.length ? 'true' : undefined}>
                  <img src={g.src} alt={i < gallery.length ? g.title : ''} loading="lazy" width="1400" height="934" />
                  <p><strong>{g.title}</strong><span>{g.note}</span></p>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <section class="spec wrap" aria-labelledby="spec-title">
          <div>
            <p class="eyebrow">The one rule behind the page</p>
            <h2 id="spec-title">Your current mask.</h2>
            <p class="muted">Copied live from the inspector. Keep both lines — Safari still reads only the prefixed property.</p>
          </div>
          <pre class="snippet big"><code id="live-snippet"></code></pre>
        </section>
      </main>

      <footer class="foot wrap">
        <p><span class="dot" aria-hidden="true"></span>Halden Glasshouse · Riverside Gardens, Halden</p>
        <p class="muted">Open daily 09:00–18:00 · Last entry 17:15 · Fictional institution</p>
      </footer>
    </div>
    <BackPill />

    <script>
      const root = document.documentElement;
      const depth = document.getElementById('depth') as HTMLInputElement;
      const depthOut = document.getElementById('depth-out')!;
      const snippet = document.getElementById('live-snippet')!;
      const tagDir = document.getElementById('tag-dir')!;
      const tagStop = document.getElementById('tag-stop')!;

      const state = { stop: 15, dir: 'to right', edge: 'transparent' };

      const render = () => {
        root.style.setProperty('--fade', `${state.stop}%`);
        root.style.setProperty('--dir', state.dir);
        root.style.setProperty('--edge', state.edge);
        depthOut.textContent = `${state.stop}%`;
        tagDir.textContent = state.dir;
        tagStop.textContent = `${state.stop}%`;
        const g = `linear-gradient(${state.dir}, ${state.edge}, black ${state.stop}%, black ${100 - state.stop}%, ${state.edge})`;
        snippet.textContent = `mask-image: ${g};\n-webkit-mask-image: ${g};`;
      };

      depth.addEventListener('input', () => {
        state.stop = Number(depth.value);
        render();
      });

      // Segmented controls: one pressed button per group.
      const bindSeg = (attr: 'dir' | 'edge') => {
        const buttons = document.querySelectorAll<HTMLButtonElement>(`[data-${attr}]`);
        buttons.forEach((b) =>
          b.addEventListener('click', () => {
            buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
            state[attr] = b.dataset[attr]!;
            render();
          }),
        );
      };
      bindSeg('dir');
      bindSeg('edge');

      // Zone picker swaps the large surface and the metric card.
      const zoneImg = document.getElementById('zone-img') as HTMLImageElement;
      const set = (id: string, v: string) => (document.getElementById(id)!.textContent = v);
      const zoneButtons = document.querySelectorAll<HTMLButtonElement>('.zone');
      zoneButtons.forEach((b) => {
        b.addEventListener('focus', () => b.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' }));
        b.addEventListener('click', () => {
          zoneButtons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          const d = b.dataset;
          zoneImg.classList.add('swap');
          setTimeout(() => {
            zoneImg.src = d.src!;
            zoneImg.style.objectPosition = d.pos!;
            zoneImg.classList.remove('swap');
          }, 180);
          set('zone-name', d.name!);
          set('zone-caption', d.caption!);
          set('metric-zone', d.name!);
          set('rh', d.rh!);
          set('temp', d.temp!);
          set('next', d.next!);
        });
      });

      render();
    </script>

    <style is:global>
      /* Animatable mask knobs: registered so slider and toggles ease rather than jump. */
      @property --fade { syntax: '<percentage>'; inherits: true; initial-value: 15%; }
      @property --edge { syntax: '<color>'; inherits: true; initial-value: transparent; }

      :root {
        --bg: #0a0e0d;
        --bg-2: #0f1513;
        --surface: #131b19;
        --line: rgb(255 255 255 / 0.08);
        --line-2: rgb(255 255 255 / 0.14);
        --ink: #eef3f0;
        --muted: #8a9d96;
        --mint: #7df0c3;
        --mint-dim: rgb(125 240 195 / 0.14);
        --dir: to right;
        --fade: 15%;
        --edge: transparent;
        transition: --fade 0.35s ease, --edge 0.35s ease;
        color-scheme: dark;
      }

      html { background: var(--bg); }
      body {
        margin: 0;
        background:
          radial-gradient(60rem 36rem at 72% -6%, rgb(84 170 135 / 0.18), transparent 70%),
          radial-gradient(40rem 30rem at 0% 40%, rgb(40 90 72 / 0.14), transparent 70%),
          var(--bg);
        color: var(--ink);
        font-family: 'Geist', ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow-x: clip;
      }
      .mono, .label, .eyebrow, output { font-family: 'Geist Mono', ui-monospace, monospace; }
      .muted { color: var(--muted); }

      .wrap { width: min(100% - 32px, 1360px); margin-inline: auto; }
      @media (min-width: 768px) { .wrap { width: min(100% - 64px, 1360px); } }

      /* ---------- the masks (skill core: always both properties) ---------- */
      .mask-live {
        mask-image: linear-gradient(var(--dir), var(--edge), black var(--fade), black calc(100% - var(--fade)), var(--edge));
        -webkit-mask-image: linear-gradient(var(--dir), var(--edge), black var(--fade), black calc(100% - var(--fade)), var(--edge));
      }
      .mask-x {
        mask-image: linear-gradient(to right, var(--edge), black var(--fade), black calc(100% - var(--fade)), var(--edge));
        -webkit-mask-image: linear-gradient(to right, var(--edge), black var(--fade), black calc(100% - var(--fade)), var(--edge));
      }
      .mask-y {
        mask-image: linear-gradient(to bottom, var(--edge), black var(--fade), black calc(100% - var(--fade)), var(--edge));
        -webkit-mask-image: linear-gradient(to bottom, var(--edge), black var(--fade), black calc(100% - var(--fade)), var(--edge));
      }
      .mask-y-deep {
        mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
        -webkit-mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
      }
      .mask-x-wide {
        mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
        -webkit-mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
      }

      /* ---------- nav ---------- */
      .nav {
        display: flex; align-items: center; justify-content: space-between; gap: 16px;
        height: 64px; border-bottom: 1px solid var(--line);
      }
      .brand {
        display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none;
        font-weight: 600; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase;
      }
      .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 12px var(--mint); display: inline-block; }
      .nav-meta { margin: 0; font: 500 11px/1.2 'Geist Mono', monospace; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }

      /* ---------- hero ---------- */
      .hero {
        display: grid; gap: 24px; padding-block: 28px 20px;
        grid-template-columns: 1fr; align-items: end;
      }
      @media (min-width: 1024px) { .hero { grid-template-columns: 1.5fr 1fr; gap: 56px; padding-block: 36px 24px; } }
      .eyebrow { margin: 0 0 14px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
      h1 {
        margin: 0; font-weight: 600; letter-spacing: -0.055em; line-height: 0.92;
        font-size: clamp(46px, 5.5vw, 84px);
      }
      /* Text use of the same mask: the word itself fades into the dark. */
      .fade-word {
        display: inline-block; color: var(--mint); padding-right: 0.06em;
        mask-image: linear-gradient(to right, black 35%, transparent);
        -webkit-mask-image: linear-gradient(to right, black 35%, transparent);
      }
      .lede { margin: 0 0 18px; max-width: 46ch; color: #b6c5bf; font-size: 15px; line-height: 1.55; }

      .inspector { display: grid; gap: 14px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 14px; background: rgb(19 27 25 / 0.6); }
      .field { display: grid; gap: 8px; }
      .field-row { display: flex; justify-content: space-between; font: 500 11px/1 'Geist Mono', monospace; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
      .field-row output { color: var(--mint); }
      input[type='range'] { width: 100%; accent-color: var(--mint); margin: 0; }
      .seg-group { display: flex; flex-wrap: wrap; gap: 10px; }
      .seg { display: inline-flex; padding: 3px; border: 1px solid var(--line); border-radius: 999px; background: var(--bg-2); }
      .seg button, .zone {
        appearance: none; border: 0; cursor: pointer; font: 500 13px/1 'Geist', sans-serif; color: var(--muted);
        background: transparent; border-radius: 999px; padding: 8px 14px; white-space: nowrap;
        transition: color 0.2s, background 0.2s;
      }
      .seg button:hover, .zone:hover { color: var(--ink); }
      .seg button[aria-pressed='true'], .zone[aria-pressed='true'] { color: #04140d; background: var(--mint); }
      :is(.seg button, .zone, input, a):focus-visible { outline: 2px solid var(--mint); outline-offset: 2px; }

      /* ---------- stage ---------- */
      .stage { display: grid; gap: 16px; grid-template-columns: 1fr; padding-bottom: 96px; }
      @media (min-width: 1024px) { .stage { grid-template-columns: minmax(0, 2.1fr) minmax(0, 1fr); } }
      .stage-main { display: grid; gap: 12px; min-width: 0; }

      .zones { overflow-x: auto; scrollbar-width: none; border: 1px solid var(--line); border-radius: 999px; background: var(--bg-2); }
      .zones::-webkit-scrollbar { display: none; }
      /* Padding keeps focus rings and the first/last chip clear of the clip. */
      .zones-track { display: flex; gap: 4px; padding: 5px 48px; width: max-content; }

      .surface {
        position: relative; overflow: hidden; border-radius: 22px; border: 1px solid var(--line);
        /* Glasshouse ribs and transoms: only visible where the mask lets the photo go. */
        background:
          repeating-linear-gradient(90deg, rgb(125 240 195 / 0.09) 0 1px, transparent 1px 56px),
          linear-gradient(0deg, transparent calc(38% - 1px), rgb(125 240 195 / 0.09) calc(38% - 1px) 38%, transparent 38%),
          linear-gradient(160deg, #15201d, #0a100e);
        min-height: 360px; height: clamp(360px, 52vh, 480px);
        box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.8), inset 0 1px 0 rgb(255 255 255 / 0.05);
      }
      .surface-photo { position: absolute; inset: 0; }
      .surface-photo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: opacity 0.18s ease; }
      .surface-photo img.swap { opacity: 0; }
      .surface-copy {
        position: absolute; left: 0; bottom: 0; padding: 24px; max-width: 420px;
        text-shadow: 0 1px 18px rgb(0 0 0 / 0.6);
      }
      .surface-copy h2 { margin: 6px 0 8px; font-size: clamp(30px, 3.6vw, 52px); letter-spacing: -0.04em; font-weight: 600; line-height: 1; }
      .surface-copy p { margin: 0; color: #d2ddd8; font-size: 14px; line-height: 1.5; }
      @media (min-width: 768px) { .surface-copy { padding: 32px; } }
      .surface::after {
        content: ''; position: absolute; inset: 0; pointer-events: none;
        background: linear-gradient(to top, rgb(6 10 9 / 0.82), rgb(6 10 9 / 0.35) 34%, transparent 58%);
      }
      .surface-copy { z-index: 1; }
      .surface-tag {
        position: absolute; top: 16px; right: 16px; z-index: 1; margin: 0; padding: 6px 10px; border-radius: 999px;
        font-size: 11px; letter-spacing: 0.08em; color: var(--mint); background: rgb(6 10 9 / 0.7); border: 1px solid var(--line-2);
      }
      .label { margin: 0; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }

      .stage-side { display: grid; gap: 16px; align-content: start; min-width: 0; }
      @media (min-width: 640px) and (max-width: 1023px) { .stage-side { grid-template-columns: 1fr 1fr; } }
      .card {
        border: 1px solid var(--line); border-radius: 18px; padding: 18px;
        background: linear-gradient(180deg, rgb(255 255 255 / 0.035), rgb(255 255 255 / 0.01)), var(--surface);
      }
      .card-head { display: flex; justify-content: space-between; gap: 8px; }
      .card-head .mono { margin: 0; font-size: 11px; }
      .metric-num { margin: 10px 0 12px; font-size: 64px; font-weight: 600; letter-spacing: -0.06em; line-height: 0.9; }
      .metric-num small { font-size: 26px; color: var(--muted); margin-left: 4px; letter-spacing: 0; }
      .bars { display: flex; align-items: end; gap: 3px; height: 64px; }
      .bars span { flex: 1; height: var(--h); border-radius: 3px 3px 1px 1px; background: linear-gradient(180deg, var(--mint), rgb(125 240 195 / 0.25)); }
      .metric-foot { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 14px 0 0; padding-top: 12px; border-top: 1px solid var(--line); }
      .metric-foot dt { font: 500 10px/1 'Geist Mono', monospace; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
      .metric-foot dd { margin: 6px 0 0; font-size: 18px; font-weight: 500; letter-spacing: -0.02em; }

      .flower-window { height: 150px; overflow: hidden; margin-top: 10px; }
      .flower-track { list-style: none; margin: 0; padding: 0; animation: rise 22s linear infinite; }
      .flower-track li { display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; padding: 10px 0; border-bottom: 1px solid var(--line); }
      .flower-track strong { font-weight: 500; font-size: 14px; }
      .flower-track span { grid-row: 2; color: var(--muted); font-size: 12px; }
      .flower-track em { grid-row: 1 / 3; grid-column: 2; align-self: center; font-style: normal; font: 500 11px/1.3 'Geist Mono', monospace; color: var(--mint); text-align: right; max-width: 18ch; }
      .flowering:hover .flower-track, .register-window:hover .register-track, .walk-window:hover .walk-track { animation-play-state: paused; }

      @keyframes rise { to { transform: translateY(-50%); } }
      @keyframes slide { to { transform: translateX(-50%); } }

      /* ---------- register ---------- */
      .register { display: grid; gap: 40px; padding-block: 96px; border-top: 1px solid var(--line); }
      @media (min-width: 1024px) { .register { grid-template-columns: 1fr 1.2fr; gap: 72px; align-items: center; } }
      .register h2, .walk h2, .spec h2 { margin: 0 0 18px; font-size: clamp(32px, 4vw, 56px); letter-spacing: -0.045em; line-height: 0.98; font-weight: 600; }
      .register-copy > p:not(.eyebrow) { color: #b6c5bf; line-height: 1.6; max-width: 52ch; }
      .snippet {
        margin: 24px 0 0; padding: 16px 18px; border-radius: 12px; border: 1px solid var(--line); background: #070a09;
        font: 12.5px/1.7 'Geist Mono', monospace; color: #c9d6d1; overflow-x: auto; white-space: pre-wrap; word-break: break-word;
      }
      .snippet .k { color: var(--mint); }
      .register-window { height: 440px; overflow: hidden; border-left: 1px solid var(--line); }
      .register-track { list-style: none; margin: 0; padding: 0; animation: rise 40s linear infinite; }
      .register-track li {
        display: grid; grid-template-columns: auto 1fr; gap: 4px 20px; align-items: baseline;
        padding: 18px 0 18px 24px; border-bottom: 1px solid var(--line);
      }
      .acc { font-size: 11px; color: var(--muted); letter-spacing: 0.06em; }
      .latin { font-size: clamp(20px, 2.2vw, 28px); font-style: italic; letter-spacing: -0.02em; font-weight: 400; }
      .common { grid-column: 2; color: var(--muted); font-size: 14px; }
      .zone-tag { grid-column: 1; grid-row: 2; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mint); }

      /* ---------- walk (horizontal marquee) ---------- */
      .walk { padding-block: 96px; border-top: 1px solid var(--line); }
      .walk-window { overflow: hidden; }
      .walk-track { list-style: none; margin: 0; padding: 0; display: flex; gap: 16px; width: max-content; animation: slide 50s linear infinite; }
      .walk-track li { width: clamp(240px, 26vw, 360px); margin: 0; }
      .walk-track img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 16px; display: block; border: 1px solid var(--line); }
      .walk-track p { display: flex; justify-content: space-between; gap: 8px; margin: 12px 2px 0; font-size: 14px; }
      .walk-track p span { color: var(--muted); font: 500 11px/1.6 'Geist Mono', monospace; }

      /* ---------- spec + footer ---------- */
      .spec { display: grid; gap: 24px; padding-block: 96px; border-top: 1px solid var(--line); }
      @media (min-width: 1024px) { .spec { grid-template-columns: 1fr 1.4fr; gap: 72px; align-items: center; } }
      .spec .snippet.big { font-size: 14px; padding: 22px 24px; margin: 0; }
      .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding-block: 28px 80px; border-top: 1px solid var(--line); font-size: 13px; }
      .foot p { margin: 0; display: inline-flex; align-items: center; gap: 10px; }

      @media (max-width: 639px) {
        .hide-sm { display: none; }
        .surface { height: 340px; min-height: 0; }
        .metric-num { font-size: 52px; }
        .register-window { height: 380px; }
        .register-track li { padding-left: 16px; }
      }

      @media (prefers-reduced-motion: reduce) {
        :root { transition: none; }
        .flower-track, .register-track, .walk-track { animation: none; }
        .walk-window { overflow-x: auto; }
        .surface-photo img { transition: none; }
      }
    </style>
  </body>
</html>
