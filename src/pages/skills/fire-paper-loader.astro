    /* the first frame that is seen starts from nothing — no ember yet — and
       it grows from there, however far the build has got (it eases in) */
    if (fresh){ fresh = false; sV = vS = vW = 0; uNow = uPrev = 0; velS = 0; lastNow = now + OFF; }
    if (FT.length < 6000) FT.push(now + OFF);
    paint(now + OFF);
    if (afterPaint) afterPaint();
  }
  /* Every pipeline the fire draws with is built before anything is seen: a
     real frame's draws of both programs, into one pixel, waited on. A first
     draw builds its Metal pipeline (30-130 ms), which made the first visible
     frames the slowest of the load */
  function warmUp(){
    if (!gl) return;
    warming = true;
    try { paint(pnow()); } finally { warming = false; }
    gl.viewport(0, 0, cv.width, cv.height);
    gl.readPixels(0, 0, 1, 1, gl.RGBA, gl.UNSIGNED_BYTE, new Uint8Array(4));
  }
  const showPct = IN_W ? v => postMessage({kb:'pct', v}) : v => { num.textContent = v; label.setAttribute('aria-valuenow', v); };
  const ctl = {
    set(p){ target = Math.max(target, p); },
    /* into the hand-off, from the moment done() was called */
    done(at, onHand){
      lastPct = 100;
      const tab = tabNow(), vH = V_HAND*(sOf(HAND + 0.002, tab) - sOf(HAND - 0.002, tab))/0.004;   /* the intro's speed, in S */
      doneS1 = sOf(HAND, tab); doneFrom = Math.min(sOf(uNow, tab), doneS1); doneAt = at;
      /* long enough for the label to be nearly gone at the hand-off: the
         ring reaches it a fifth of a second later */
      /* leaving at the creep's speed and arriving at the intro's, as long
         as that allows without overshooting (Hermite end slopes under 3x
         the chord) */
      const du = Math.max(0.005, doneS1 - doneFrom), ds = Math.min(1.2, Math.max(0.30, 2.8*du/vH));
      doneDur = ds*1000;
      /* leaving at exactly the speed it had (the spring's), so it never lurches into the run */
      doneM0 = Math.min(Math.max(vS, 0), 1.5*du/ds)*ds; doneM1 = Math.min(vH*ds, 2.9*du);
      finish = onHand;
      setTimeout(() => { if (finish){ handAt = pnow(); const f = finish; finish = null; f(); } }, doneDur + 400);   /* rAF stalled */
    }
  };

  /* In the worker: draw on the canvas the page handed over, on this
     thread's own frames, and take the page's word for the progress. */
  if (IN_W){
    initGL();
    if (!gl){ postMessage({kb:'fail'}); return; }
    warmUp();
    target = WI.target || 0;
    let mirror = false, synced = true;   /* it draws alone from its first frame */
    self.onmessage = e => {
      const m = e.data || {};
      if (m.kb === 'sync'){ if (mirror){ [target, shown, lim, uNow, uPrev, lastNow, velS, gW, vW] = m.st; synced = true; } }
      else if (m.kb === 'take'){ mirror = false; lastPct = -1; }
      else if (m.kb === 'set') ctl.set(m.p);
      else if (m.kb === 'view') view = m.view;
      else if (m.kb === 'follow') followU = m.u;
      else if (m.kb === 'done') ctl.done(m.at, () => postMessage({kb:'hand', at:handAt, vel:velS}));
      else if (m.kb === 'stop'){
        /* no more draws; its last frame stays up while the page fades it */
        alive = false;
        postMessage({kb:'stopped', ft:FT});
      }
      else if (m.kb === 'free'){ const x = gl.getExtension('WEBGL_lose_context'); if (x) x.loseContext(); }
    };
    /* ready to take over once a frame drawn from the page's own state is up */
    afterPaint = () => { if (synced){ afterPaint = null; postMessage({kb:'up'}); } };
    here = true;
    requestAnimationFrame(loop);
    return;
  }

  /* On the page: the build blocks this thread for up to a second at a time,
     and no frame can be drawn here then (the compositor scale above only
     stretched the last one). So a worker is started on a second canvas
     under this one, drawing the same fire in step with it, and the moment
     it has a frame up this canvas is taken away and the worker carries on
     alone. Its WebGL context can only be made when this thread is free, so
     until then — and wherever there is no such worker — the fire is drawn
     here, as before. */
  const viewNow = () => ({w: Math.max(1, innerWidth || screen.width), h: Math.max(1, innerHeight || screen.height), d: Math.min(1.5, devicePixelRatio || 1)});
  const onResize = () => { if (worker) worker.postMessage({kb:'view', view:viewNow()}); };
  let wDone = null, velW = V_HAND, doneCalled = false, cvW = null, tSwap = 0, wReady = null;
  const readyNow = () => { if (wReady){ const r = wReady; wReady = null; r(); } };
  const dropWorker = () => {
    if (!worker) return;
    worker.terminate(); worker = null;
    removeEventListener('resize', onResize);
    if (cvW) cvW.remove();
    readyNow();
    if (!here){   /* draw here instead: on a new canvas if the worker's had been shown */
      if (tSwap){ const c = document.createElement('canvas'); c.id = 'kindle-gl'; c.setAttribute('aria-hidden', 'true');
        root.insertBefore(c, root.firstChild); cv = c; }
      gl = null; here = true; sparkSets = []; sU = {};
      initGL(); warmUp(); requestAnimationFrame(loop);
      if (wDone){ const r = wDone; wDone = null; if (gl) ctl.done(performance.now(), () => { window.__kbLoad.handAt = handAt; r(); }); else r(); }
    }
  };
  /* in a frame of this thread, so the canvas goes in the same commit */
  function takeOver(){
    here = false; tSwap = window.__kbLoaderSwap = performance.now();
    if (grow){ grow.cancel(); grow = null; }
    /* its context goes now, while a wait on the GPU only holds up the build */
    const x = gl && gl.getExtension('WEBGL_lose_context'); if (x) x.loseContext();
    cv.remove(); cvW.id = 'kindle-gl'; gl = null;
    worker.postMessage({kb:'take'});
    if (lastPct >= 0) showPct(lastPct);
    readyNow();
  }
  /* started in the <head>, where this thread is still free for it (see there) */
  const PRE = window.__kbPre; window.__kbPre = null;
  if (SRC && !window.__kbNoWorker && typeof Worker === 'function' && typeof OffscreenCanvas === 'function' && !(PRE && PRE.failed)){
    let off = null, url = '';
    try {
      if (PRE){ worker = PRE.worker; cvW = PRE.canvas; url = PRE.url; }
      else {
        cvW = document.createElement('canvas');
        if (!cvW.transferControlToOffscreen || !window.__kbBoot) throw 0;
        url = URL.createObjectURL(new Blob([window.__kbBoot], {type:'text/javascript'}));
        worker = new Worker(url);
        off = cvW.transferControlToOffscreen();
      }
      cvW.setAttribute('aria-hidden', 'true');
      root.insertBefore(cvW, cv);
      worker.onmessage = e => {
        const m = e.data || {};
        if (m.kb === 'pct'){ if (!here && !doneCalled) showPct(m.v); }
        else if (m.kb === 'hand'){ velW = m.vel; window.__kbLoad.handAt = m.at; if (wDone){ const r = wDone; wDone = null; r(); } }
        else if (m.kb === 'up'){ URL.revokeObjectURL(url); if (!tSwap) takeOver(); }
        else if (m.kb === 'stopped'){
          window.__kbLoaderFrames = FT.filter(t => !tSwap || t < tSwap).concat(m.ft.filter(t => tSwap && t >= tSwap));
        }
        else if (m.kb === 'fail') dropWorker();
      };
      worker.onerror = e => { e.preventDefault(); dropWorker(); };
      /* the worker alone draws the fire: nothing is drawn here (a second
         fire drawn here first cost its compile and pipelines in the first
         visible frames, and the worker's own landed on them too) */
      here = false;
      worker.postMessage({kbInit:1, src:SRC, canvas:off, t0, origin:performance.timeOrigin, reduced, view:viewNow(), target}, off ? [off] : []);
      addEventListener('resize', onResize);
    } catch (e) {
      if (worker) worker.terminate();
      worker = null;
      if (cvW) cvW.remove();
    }
  }
  /* no worker: drawn here, after the same warm-up */
  if (here){ initGL(); warmUp(); requestAnimationFrame(loop); }

  /* Slow connections: say so rather than burning quietly forever. */
  const slow = setTimeout(() => { if (alive && target < 0.4) label.querySelector('span').textContent = 'Still warming'; }, 12000);

  window.__kbLoad = {
    t0,
    /* when the rim reached the hand-off, on this thread's clock: the intro
       resumes from exactly then, however late the word got here */
    handAt: 0,
    velocity(){ const v = here ? velS : velW; return Number.isFinite(v) ? v : V_HAND; },
    /* resolves once the worker draws the fire, typically 0.15-0.3 s (at
       most 1.2): it can start, and make its WebGL context, only while this
       thread is free, so the build waits for it rather than holding it off
       for a second or more while the fire stands still */
    ready(){ return new Promise(r => { if (!worker || tSwap || document.hidden) return r(); wReady = r; setTimeout(readyNow, 1200); }); },
    set(p){ target = Math.max(target, p); if (!alive) return; if (worker) worker.postMessage({kb:'set', p:target}); },
    /* after the hand-off the page reports its intro's progress each frame
       until this has faded, and the rim is drawn there */
    follow(u){ if (!alive) return; lastFollow = u; if (here) followU = u; else if (worker) worker.postMessage({kb:'follow', u}); },
    /* a yield the build awaits between stations, so the ember keeps moving;
       only when a frame is due, and never in a hidden tab, where rAF waits.
       Once the worker draws it, only the count needs one, and less often */
    step(p){
      this.set(p);
      const now = performance.now();
      if (document.hidden || now - lastYield < (here ? 45 : 90)) return Promise.resolve();
      return new Promise(r => requestAnimationFrame(() => setTimeout(() => { lastYield = performance.now(); r(); }, 0)));
    },
    /* resolves the moment the rim reaches the hand-off size */
    done(){
      this.set(1);
      doneCalled = true;
      /* the count lands on 100 now; the label holds it a beat and fades (CSS) */
      num.textContent = lastPct = 100; label.setAttribute('aria-valuenow', 100);
      root.classList.add('lit');
      return new Promise(res => {
        if (document.hidden || (here ? !gl : !worker)){ return res(); }
        if (!here){
          wDone = res;
          worker.postMessage({kb:'done', at:performance.now()});
          /* it hands over within 1.6 s; should it have gone quiet, so do we */
          setTimeout(() => { if (wDone === res){ wDone = null; res(); } }, 2400);
          return;
        }
        ctl.done(performance.now(), () => { this.handAt = handAt; res(); });
      });
    },
    close(){
      clearTimeout(slow);
      /* the intro's rim is now drawn exactly where this one is, so a short
         fade only has to hand over the dark inside to the workshop — kept
         short, as through a slow one the lit paper showed before the room */
      /* One WebGL context draws the hand-off. The page has drawn the intro
         under this, so the fire stops drawing now — drawn on through the
         fade, the two contexts shared the GPU and the fade's frames ran to
         35-67 ms — and its last frame fades out on the compositor, scaled
         as the intro's ring grows (the intro's own curve, on the clock it
         runs on) so it stays on the page's rim while it goes */
      alive = false;
      removeEventListener('resize', onResize);
      if (worker) worker.postMessage({kb:'stop'});
      else window.__kbLoaderFrames = FT;
      const FADE = reduced ? 250 : 120, t1 = performance.now();
      if (!reduced){
        const [w, h] = vwh(), a = w/h, hA = window.__kbLoad.handAt || t1;
        const uAt = t => introBurn(Math.min(1, RH + (t - hA)/1000/DUR));
        const u0 = lastFollow !== null ? lastFollow : uAt(t1), r0 = seenPx(u0, h, a), keys = [];
        for (let k = 0; k <= 8; k++) keys.push({transform: `scale(${(seenPx(uAt(t1 + FADE*k/8), h, a)/r0).toFixed(4)})`, offset: k/8});
        for (const c of root.querySelectorAll('canvas')){ try { c.animate(keys, {duration: FADE, fill: 'forwards'}); } catch (e) {} }
      }
      root.style.transition = `opacity ${FADE/1000}s linear`;
      root.classList.add('out');
      setTimeout(() => {
        /* no loseContext on this thread: it waits for all the GPU work
           queued — the intro's first frames with it — and held it 100 ms */
        gl = null;
        root.remove();
        const w = worker;
        if (w){
          /* its context goes now; the worker itself when the page is hidden
             or left: terminating it held this thread 55-240 ms at any time
             while the page is on screen (after the intro too), and an idle
             worker with no context costs next to nothing */
          w.postMessage({kb:'free'});
          const end = () => { if (document.hidden){ w.terminate(); removeEventListener('visibilitychange', end); removeEventListener('pagehide', end); } };
          addEventListener('visibilitychange', end); addEventListener('pagehide', end);
        }
      }, FADE + 180);
    }
  };
})();
</script>

