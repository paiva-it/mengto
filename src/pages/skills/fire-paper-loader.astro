  html.no-hero-gl .beneath{clip-path:circle(var(--hole) at 50% 50%)}
  html.no-hero-gl .porthole-fallback{display:block;background:radial-gradient(circle at 50% 50%,transparent calc(var(--hole) - 3px),#ffb547 calc(var(--hole) - 1px),#ea5a1c calc(var(--hole) + 3px),#5a0e04 calc(var(--hole) + 9px),#000 calc(var(--hole) + 22px))}

  .reveal{opacity:0;transform:translateY(10px);transition:opacity .9s ease,transform 1.1s cubic-bezier(.2,.7,.2,1)}
  html.open .reveal{opacity:1;transform:none}
  html.open .hero-left{transition-delay:.15s}
  html.open .hero-right{transition-delay:.3s}
  html.open .hero-strip{transition-delay:.55s}
  @media (prefers-reduced-motion:reduce){ .reveal{transform:none;transition:opacity .4s linear} .beneath img{transition:none;transform:none} }

  .topbar{position:absolute;z-index:3;left:0;right:0;top:0;display:flex;align-items:center;gap:24px;padding:18px var(--pad)}
  .brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:var(--on-black);
    font:700 17px/1 var(--grot);font-stretch:85%;letter-spacing:.01em;text-transform:uppercase}
  .brand em{font-style:normal;font-weight:400;color:var(--dim);margin-left:.35em}
  .topbar nav{display:flex;gap:26px}
  .topbar .brand{margin-right:auto}
  .topbar nav a{font:400 11px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--dim);text-decoration:none;padding:6px 0}
  .topbar nav a:hover{color:var(--on-black)}

  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 22px;
    font:600 13px/1 var(--grot);letter-spacing:.06em;text-transform:uppercase;text-decoration:none;border-radius:0;cursor:pointer;
    border:1px solid transparent;transition:background .2s,border-color .2s,color .2s}
  .btn-sm{min-height:36px;padding:0 16px;font-size:12px}
  .btn-ember{background:var(--ember);color:#160702}
  .btn-ember:hover{background:var(--gold)}
  .btn-ghost{border-color:var(--hair);color:var(--on-black);background:transparent}
  .btn-ghost:hover{border-color:var(--gold)}
  .btn-ghost-dark{border-color:var(--hair);color:var(--on-black);background:transparent;min-height:40px;padding:0 16px;font-size:12px;font-family:var(--grot)}
  .btn-ghost-dark:hover{border-color:var(--ember)}
  .link-btn{background:none;border:0;color:var(--dim);font:400 11px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;cursor:pointer;padding:8px 0}
  .link-btn:hover{color:var(--gold)}

  .kicker{display:flex;align-items:center;gap:10px;margin:0 0 16px;font:400 11px/1.4 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--dim)}
  .dot{width:7px;height:7px;border-radius:50%;background:var(--ember);box-shadow:0 0 10px 1px rgba(234,90,28,.7);flex:none}
  h1{margin:0;font:800 clamp(36px,4.7vw,78px)/.9 var(--grot);font-stretch:66%;letter-spacing:-.005em;text-transform:uppercase;color:var(--on-black);text-wrap:balance}
  h1 .hot{color:var(--gold);background:linear-gradient(180deg,#ffd27a 0%,#f2a43a 40%,#ea5a1c 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .lede{margin:0;font:400 clamp(15px,1.15vw,17px)/1.55 var(--grot);color:var(--dim);max-width:36ch}
  .lede b{color:var(--on-black);font-weight:600}
  .ctas{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}
  .readout{margin:28px 0 0;display:grid;grid-template-columns:1fr auto;border-top:1px solid var(--hair);max-width:340px}
  .readout div{display:contents}
  .readout dt,.readout dd{margin:0;padding:9px 0;border-bottom:1px solid var(--hair);font:400 11px/1.3 var(--mono);letter-spacing:.08em;text-transform:uppercase}
  .readout dt{color:var(--dim)}
  .readout dd{text-align:right;color:var(--on-black);font-variant-numeric:tabular-nums}
  .readout .warm{color:var(--gold)}
  .hero-strip{position:absolute;z-index:3;left:0;right:0;bottom:0;display:flex;justify-content:space-between;align-items:center;gap:16px;
    padding:14px var(--pad) 18px;font:400 11px/1.3 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:rgba(236,230,219,.45)}

  /* stacked (phones, portrait): copy above and below the ring, never over it */
  .hero-left,.hero-right{position:absolute;z-index:3;left:var(--pad);right:var(--pad)}
  .hero-left{top:64px;height:calc(var(--vh)/2 - var(--hole) - 64px - 18px);display:flex;flex-direction:column;justify-content:flex-end}
  .hero-right{top:calc(var(--vh)/2 + var(--hole) + 26px)}
  .hero-right .readout,.hero-strip span,.topbar nav{display:none}
  .hero{min-height:max(var(--vh), calc(var(--vh)/2 + var(--hole) + 300px))}
  @media (max-width:520px){ .ctas .btn{padding:0 15px;font-size:12px;min-height:44px} .ctas{gap:8px} }
  @media (min-width:700px){ .topbar nav{display:flex} }

  /* side by side: copy in the black either side of the porthole */
  @media (min-width:900px) and (min-aspect-ratio:6/5){
    .hero{min-height:var(--vh)}
    .hero-left,.hero-right{top:0;bottom:0;height:auto;display:flex;flex-direction:column;justify-content:center;
      width:calc(50vw - var(--hole) - var(--pad) - 64px)}
    .hero-left{left:var(--pad);right:auto}
    .hero-right{right:var(--pad);left:auto;align-items:flex-start;padding-top:40px}
    .hero-right .readout{display:grid;width:100%}
    .hero-strip span{display:inline}
    h1{font-size:clamp(40px,min(5.4vw,9vh),92px)}
  }

  /* ---- the page beneath: ash paper, ink, ember and cold sea ---- */
  main{position:relative;z-index:2}
  .wrap{max-width:1240px;margin:0 auto;padding:0 var(--pad)}
  .fever,.refuges,.give{background:var(--ash);color:var(--ink)}
  .fever{padding:clamp(72px,10vw,140px) 0 clamp(56px,7vw,96px);
    background-image:radial-gradient(rgba(22,18,14,.05) 1px,transparent 1.2px);background-size:5px 5px}
  .eyebrow{margin:0 0 18px;font:500 11px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--ember)}
  h2{margin:0;font:800 clamp(34px,5.2vw,72px)/.92 var(--grot);font-stretch:70%;text-transform:uppercase;letter-spacing:-.005em;text-wrap:balance;max-width:16ch}
  .sec-head{display:grid;gap:0;margin-bottom:clamp(36px,5vw,64px)}
  .sec-lede{margin:22px 0 0;max-width:56ch;font:400 clamp(15px,1.3vw,18px)/1.55 var(--grot);color:var(--ink-2)}

  .stripes-fig{margin:0}
  .stripes{display:flex;height:clamp(150px,22vw,280px);gap:2px}
  .stripes span{flex:1;background:var(--c);transition:transform .25s ease}
  .stripes span:hover{transform:scaleY(1.04)}
  .stripes-fig figcaption{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:12px;
    font:400 11px/1.4 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink-2);flex-wrap:wrap}
  .scale{display:inline-flex;align-items:center;gap:8px;flex-wrap:wrap}
  @media (max-width:640px){ .scale{order:3;width:100%} }
  .scale i{display:inline-block;width:14px;height:10px;background:var(--c);margin-left:6px}
  .stats{display:grid;grid-template-columns:1fr;gap:28px;margin-top:clamp(48px,6vw,80px);border-top:1px solid var(--hair-ink);padding-top:32px}
  .stats p{margin:0;font:400 15px/1.5 var(--grot);color:var(--ink-2);max-width:34ch}
  .stats .big{font:800 clamp(56px,7vw,104px)/.9 var(--grot);font-stretch:62%;color:var(--ink);margin-bottom:12px;letter-spacing:-.01em}
  .stats .big small{font:500 12px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ember);margin-left:10px;vertical-align:top;position:relative;top:.6em}
  @media (min-width:800px){ .stats{grid-template-columns:repeat(3,1fr);gap:40px} }

  .refuges{padding:clamp(64px,8vw,120px) 0;background:var(--ash-2)}
  .cards{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr;gap:20px}
  @media (min-width:860px){ .cards{grid-template-columns:repeat(3,1fr);gap:24px} }
  .card{background:var(--ash);display:flex;flex-direction:column;border:1px solid var(--hair-ink)}
  .card-img{aspect-ratio:4/3;overflow:hidden;background:#0a2a30}
  .card-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .8s cubic-bezier(.2,.7,.2,1)}
  .card:hover .card-img img{transform:scale(1.04)}
  .card-body{padding:22px 22px 24px;display:flex;flex-direction:column;flex:1}
  .card-n{margin:0 0 14px;font:500 11px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--sea)}
  .card-n span{color:var(--ember);margin-right:12px}
  .card h3{margin:0 0 10px;font:750 26px/1 var(--grot);font-stretch:75%;text-transform:uppercase}
  .card p{margin:0;font:400 15px/1.55 var(--grot);color:var(--ink-2)}
  .card .card-fig{margin-top:auto;padding-top:18px;font:500 12px/1 var(--mono);letter-spacing:.08em;color:var(--sea);text-transform:uppercase}

  .voice{background:var(--sea);color:#e9f1ef;padding:clamp(72px,9vw,130px) 0;position:relative;overflow:hidden}
  .voice::before{content:"";position:absolute;inset:auto -10% -60% -10%;height:120%;
    background:radial-gradient(ellipse at 50% 100%,rgba(234,90,28,.28),transparent 60%)}
  .voice blockquote{margin:0;position:relative;max-width:1000px}
  .voice blockquote p{margin:0;font:700 clamp(26px,3.6vw,50px)/1.08 var(--grot);font-stretch:78%;letter-spacing:-.005em;text-wrap:balance}
  .voice footer{margin-top:28px;font:400 12px/1.4 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:rgba(233,241,239,.7)}
  .voice footer b{color:var(--gold);font-weight:500}

  .how{background:#000;color:var(--on-black);padding:clamp(72px,9vw,130px) 0;border-top:1px solid var(--hair)}
  .how h2{color:var(--on-black)}
  .how-grid{display:grid;grid-template-columns:1fr;gap:40px}
  .how-copy p:not(.eyebrow){margin:22px 0 0;max-width:58ch;font:400 16px/1.65 var(--grot);color:var(--dim)}
  .how b{color:var(--on-black);font-weight:600}
  .how code{font:400 .9em var(--mono);color:var(--gold)}
  .meter{border:1px solid var(--hair);padding:28px;align-self:start;background:linear-gradient(180deg,rgba(234,90,28,.06),transparent 60%)}
  .meter p{margin:0}
  .meter-k{font:400 11px/1.5 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--dim)}
  .meter-v{font:800 clamp(64px,8vw,112px)/1 var(--grot);font-stretch:62%;color:var(--gold);margin:14px 0 6px !important;font-variant-numeric:tabular-nums}
  .meter-s{font:400 12px/1.4 var(--mono);letter-spacing:.08em;color:rgba(236,230,219,.45);text-transform:uppercase}
  .meter-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}
  @media (min-width:900px){ .how-grid{grid-template-columns:1.3fr 1fr;gap:72px;align-items:center} }

  .give{padding:clamp(72px,9vw,130px) 0}
  .tiers{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr;gap:12px}
  @media (min-width:800px){ .tiers{grid-template-columns:repeat(3,1fr);gap:16px} }
  .tier{display:flex;flex-direction:column;gap:12px;min-height:220px;padding:24px;text-decoration:none;background:#fff8ee;border:1px solid var(--hair-ink);transition:background .25s,color .25s,border-color .25s}
  .tier-eur{font:800 56px/.9 var(--grot);font-stretch:62%;color:var(--ink)}
  .tier-what{font:400 15px/1.5 var(--grot);color:var(--ink-2);max-width:30ch}
  .tier-go{margin-top:auto;font:500 12px/1 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ember)}
  .tier:hover,.tier:focus-visible{background:#000;border-color:#000}
  .tier:hover .tier-eur,.tier:focus-visible .tier-eur{color:var(--gold)}
  .tier:hover .tier-what,.tier:focus-visible .tier-what{color:var(--dim)}
  .tiers li:last-child .tier{background:var(--ink)}
  .tiers li:last-child .tier-eur{color:var(--gold)}
  .tiers li:last-child .tier-what{color:var(--dim)}

  .foot{background:#000;color:var(--dim);padding:48px 0 80px;border-top:1px solid var(--hair)}
  .foot-grid{display:grid;gap:18px;grid-template-columns:1fr}
  .foot p{margin:0;font:400 13px/1.6 var(--grot);max-width:70ch}
  .foot-brand{font-size:17px}
  @media (min-width:800px){ .foot-grid{grid-template-columns:auto 1fr;gap:56px;align-items:start} }
</style>
</body>
</html>
