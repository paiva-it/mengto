---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

// 32 ions in the chain. Per-ion two-qubit gate fidelity (%), measured overnight — drives the
// readout bars and the hero chain. Ion 19 is the one being recalibrated.
const fidelity = [
  99.96, 99.95, 99.97, 99.94, 99.96, 99.93, 99.95, 99.97, 99.96, 99.94, 99.95, 99.96, 99.97, 99.92,
  99.95, 99.96, 99.94, 99.95, 99.81, 99.96, 99.97, 99.95, 99.93, 99.96, 99.94, 99.95, 99.97, 99.96,
  99.94, 99.95, 99.96, 99.93,
];

const telemetry = [
  ['Ions held', '32', 'Ca⁴⁰ chain, linear Paul trap'],
  ['2-qubit fidelity', '99.94 %', 'median, last 24 h'],
  ['Coherence T₂', '1.8 s', 'optical qubit, dynamical decoupling'],
  ['Trap', '4.2 K', 'cryo-pumped, 10⁻¹² mbar'],
];

const machine = [
  {
    n: '01',
    tag: 'Hold',
    title: 'A chain you could count by eye',
    body: 'Thirty-two calcium ions float in a line 180 µm long, pinned by radio-frequency fields inside a cryogenic vacuum. Nothing touches them. They repel each other into perfect spacing and wait.',
    stat: '5.6 µm',
    label: 'between neighbours',
  },
  {
    n: '02',
    tag: 'Address',
    title: 'One beam, steered to a single atom',
    body: 'A 729 nm laser, narrower than the gap between ions, is swept along the chain by acousto-optic deflectors. Each pulse rotates exactly one qubit; pairs are entangled through their shared motion.',
    stat: '1.9 µm',
    label: 'beam waist at the ion',
  },
  {
    n: '03',
    tag: 'Read',
    title: 'Bright means one, dark means zero',
    body: 'At the end of a circuit a 397 nm pulse makes every ion in state zero fluoresce. A cooled camera counts the photons. An ion that stays dark is a one. The answer is a row of lights.',
    stat: '99.99 %',
    label: 'state-detection fidelity',
  },
];

const queue = [
  ['QL-2210', 'Hubbard model, 4×4 lattice', 'Univ. of Lund', 'running', '00:14:07'],
  ['QL-2211', 'Catalyst ground state, VQE', 'Brightwater Chem', 'queued', '00:22:00'],
  ['QL-2212', 'Error-correction cycle, [[7,1,3]]', 'Quell internal', 'queued', '00:09:30'],
  ['QL-2213', 'Portfolio QAOA, 24 assets', 'Meridian Capital', 'queued', '00:31:15'],
  ['QL-2214', 'Randomised benchmarking', 'Calibration', 'held', '00:06:00'],
];

const calibration = [
  ['Carrier frequency, 729 nm', '411 042 129.7 MHz', 'locked'],
  ['Beam pointing drift', '0.08 µm / h', 'nominal'],
  ['Axial mode, COM', '1.212 MHz', 'nominal'],
  ['Ion 19 · Rabi rate', '−0.6 % from target', 'retuning'],
  ['Magnetic field', '4.115 G ± 0.2 mG', 'nominal'],
];

const pulses = [
  ['Cool', '3 ms', 'Doppler and sideband cooling bring the chain to its motional ground state — colder than anything in the room by a factor of a billion.'],
  ['Prepare', '40 µs', 'Optical pumping sets every ion to zero. The register is blank and identical, every time.'],
  ['Compute', '≈ 9 ms', 'The beam walks the chain: single-qubit rotations and Mølmer–Sørensen entangling gates, compiled to the native pulse set.'],
  ['Read', '400 µs', 'Fluorescence imaging. 32 bits leave the vacuum, and the chain is recooled for the next shot.'],
];

const access = [
  {
    name: 'Shot credits',
    price: '€0.42',
    unit: 'per 1 000 shots',
    lines: ['Queue through the Quell API', 'Pulse-level or circuit-level jobs', 'Results with per-ion calibration data'],
    cta: 'Get an API key',
    featured: false,
  },
  {
    name: 'Dedicated beam time',
    price: '€2 900',
    unit: 'per hour, minimum 4',
    lines: ['The whole chain, nobody else in the queue', 'A Quell physicist on the call', 'Custom gate calibration before your run'],
    cta: 'Book a window',
    featured: true,
  },
  {
    name: 'Residency',
    price: 'By application',
    unit: 'three months, in Ghent',
    lines: ['Desk in the lab, badge for the trap room', 'Co-authorship on what we build together', 'Two cohorts a year'],
    cta: 'Read the call',
    featured: false,
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quell — Trapped-ion quantum lab</title>
    <meta name="description" content="Quell runs Stillwater, a 32-ion trapped-ion quantum computer addressed by a single 729 nm laser." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Fixed dithered field + laser haze (WebGL). Purely decorative. -->
    <canvas id="field" aria-hidden="true"></canvas>
    <div class="field-fallback" aria-hidden="true"></div>

    <header class="nav-wrap">
      <nav class="nav shell" aria-label="Primary">
        <a href="#top" class="brand" aria-label="Quell home">
          <span class="brand-mark" aria-hidden="true"><i></i></span>
          Quell
        </a>
        <ul class="nav-links">
          <li><a href="#machine">Machine</a></li>
          <li><a href="#console">Live trap</a></li>
          <li><a href="#pulses">Circuit</a></li>
          <li><a href="#access">Access</a></li>
        </ul>
        <span class="chip"><span class="dot" aria-hidden="true"></span>Trap 03 · online</span>
        <a href="#access" class="btn btn-accent btn-sm">Request beam time</a>
      </nav>
    </header>

    <main id="top">
      <!-- HERO -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-frame">
          <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
        </div>

        <div class="hero-copy">
          <p class="eyebrow mono"><span class="tick"></span>Stillwater · 32-qubit trapped-ion processor</p>
          <h1 id="hero-title">Thirty-two atoms,<br />held still enough<br />to <span class="accent-word">think.</span></h1>
        </div>

        <!-- The laser: a thin white-hot core with an accent halo, plus the ion chain it addresses -->
        <div class="beam" aria-hidden="true">
          <div class="beam-halo"></div>
          <div class="beam-core"></div>
          <div class="beam-pulse"></div>
          <div class="chain">
            {fidelity.map((_, i) => <span class="ion" style={`--i:${i}`}></span>)}
          </div>
          <div class="beam-label mono beam-label-l">729 nm · 1.9 µm waist</div>
          <div class="beam-label mono beam-label-r">ion 19 · retuning</div>
        </div>

        <div class="hero-lower">
          <div class="hero-lede">
            <p>
              Quell is a quantum lab in Ghent. We hold a chain of calcium ions in a vacuum colder than deep
              space and compute with them, one laser pulse at a time. Researchers book the machine by the
              shot or by the hour.
            </p>
            <div class="hero-ctas">
              <a href="#access" class="btn btn-accent">Request beam time <span aria-hidden="true">→</span></a>
              <a href="#machine" class="btn btn-ghost">How the trap works</a>
            </div>
          </div>

          <dl class="telemetry panel">
            <div class="panel-head mono">
              <span>Telemetry · Trap 03</span><span class="live"><span class="dot" aria-hidden="true"></span>live</span>
            </div>
            {
              telemetry.map(([k, v, s]) => (
                <div class="tele-row">
                  <dt class="mono">{k}</dt>
                  <dd>
                    <span class="tele-v">{v}</span>
                    <span class="tele-s">{s}</span>
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <!-- MACHINE -->
      <section id="machine" class="section" aria-labelledby="machine-title">
        <div class="section-head">
          <p class="eyebrow mono"><span class="tick"></span>01 — The machine</p>
          <h2 id="machine-title">Hold. Address. Read.</h2>
          <p class="section-lede">
            Stillwater has no chip. The qubits are atoms, identical by nature, and the wiring is light. Three
            things happen to them, again and again, thousands of times a second.
          </p>
        </div>
        <div class="machine-grid">
          {
            machine.map((m) => (
              <article class="card">
                <span class="corner tl" /><span class="corner br" />
                <div class="card-top mono">
                  <span>{m.n}</span>
                  <span class="tag">{m.tag}</span>
                </div>
                <h3>{m.title}</h3>
                <p>{m.body}</p>
                <div class="card-stat">
                  <span class="stat">{m.stat}</span>
                  <span class="mono stat-label">{m.label}</span>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- CONSOLE -->
      <section id="console" class="section" aria-labelledby="console-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow mono"><span class="tick"></span>02 — Live from Trap 03</p>
            <h2 id="console-title">The machine, as the night shift sees it.</h2>
          </div>
          <p class="section-lede">
            Every job carries the calibration it ran under. This is the same console our physicists watch, with
            customer names shown by permission.
          </p>
        </div>

        <div class="console panel">
          <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
          <div class="console-bar">
            <div class="tabs" role="tablist" aria-label="Console views">
              <button role="tab" id="tab-fid" aria-selected="true" aria-controls="pane-fid" class="tab">Gate fidelity</button>
              <button role="tab" id="tab-queue" aria-selected="false" aria-controls="pane-queue" class="tab" tabindex="-1">Queue</button>
              <button role="tab" id="tab-cal" aria-selected="false" aria-controls="pane-cal" class="tab" tabindex="-1">Calibration</button>
            </div>
            <span class="mono console-meta">UTC 02:41 · shot 18 204 117</span>
          </div>

          <div role="tabpanel" id="pane-fid" aria-labelledby="tab-fid" class="pane">
            <div class="fid-head">
              <div>
                <span class="stat big">99.94 %</span>
                <span class="mono stat-label">median two-qubit gate fidelity, per ion</span>
              </div>
              <div class="legend mono">
                <span><i class="sw sw-n"></i>within spec</span>
                <span><i class="sw sw-a"></i>retuning</span>
              </div>
            </div>
            <div class="bars" role="img" aria-label="Gate fidelity for each of 32 ions, all between 99.92 and 99.97 percent except ion 19 at 99.81 percent, which is being retuned.">
              {
                fidelity.map((f, i) => (
                  <span
                    class:list={['bar', { low: f < 99.9 }]}
                    style={`--h:${Math.max(0.08, (f - 99.74) / 0.26)}`}
                    title={`Ion ${i + 1}: ${f} %`}
                  />
                ))
              }
            </div>
            <div class="bars-axis mono"><span>ion 1</span><span>16</span><span>32</span></div>
          </div>

          <div role="tabpanel" id="pane-queue" aria-labelledby="tab-queue" class="pane" hidden>
            <table class="tbl">
              <thead>
                <tr><th scope="col">Job</th><th scope="col">Circuit</th><th scope="col" class="hide-sm">Owner</th><th scope="col">State</th><th scope="col" class="num">Est.</th></tr>
              </thead>
              <tbody>
                {
                  queue.map(([id, c, o, s, t]) => (
                    <tr>
                      <td class="mono">{id}</td>
                      <td>{c}</td>
                      <td class="hide-sm muted">{o}</td>
                      <td><span class:list={['state', s]}>{s}</span></td>
                      <td class="mono num">{t}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <div role="tabpanel" id="pane-cal" aria-labelledby="tab-cal" class="pane" hidden>
            <table class="tbl">
              <thead>
                <tr><th scope="col">Parameter</th><th scope="col">Value</th><th scope="col">Status</th></tr>
              </thead>
              <tbody>
                {
                  calibration.map(([p, v, s]) => (
                    <tr>
                      <td>{p}</td>
                      <td class="mono">{v}</td>
                      <td><span class:list={['state', s]}>{s}</span></td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- PULSES -->
      <section id="pulses" class="section" aria-labelledby="pulses-title">
        <div class="section-head">
          <p class="eyebrow mono"><span class="tick"></span>03 — One shot</p>
          <h2 id="pulses-title">A circuit, in four pulses.</h2>
        </div>
        <ol class="pulses">
          {
            pulses.map(([name, dur, body], i) => (
              <li class="pulse">
                <div class="pulse-rail" aria-hidden="true"><span class="pulse-node" /></div>
                <div class="pulse-top mono"><span>0{i + 1}</span><span>{dur}</span></div>
                <h3>{name}</h3>
                <p>{body}</p>
              </li>
            ))
          }
        </ol>
        <p class="pulses-foot mono">≈ 12.4 ms per shot · 80 shots a second · the chain is never reloaded unless an ion is lost</p>
      </section>

      <!-- ACCESS -->
      <section id="access" class="section" aria-labelledby="access-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow mono"><span class="tick"></span>04 — Access</p>
            <h2 id="access-title">Book the beam.</h2>
          </div>
          <p class="section-lede">Three ways in, from a single API call to a desk beside the vacuum chamber. Academic groups pay half.</p>
        </div>
        <div class="access-grid">
          {
            access.map((a) => (
              <article class:list={['card', 'tier', { featured: a.featured }]}>
                <span class="corner tl" /><span class="corner br" />
                {a.featured && <span class="tier-beam" aria-hidden="true" />}
                <div class="card-top mono">
                  <span>{a.name}</span>
                  {a.featured && <span class="tag tag-accent">most booked</span>}
                </div>
                <div class="tier-price">
                  <span class="stat">{a.price}</span>
                  <span class="mono stat-label">{a.unit}</span>
                </div>
                <ul>
                  {a.lines.map((l) => <li>{l}</li>)}
                </ul>
                <a href="#top" class:list={['btn', a.featured ? 'btn-accent' : 'btn-ghost']}>{a.cta}</a>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="footer-beam" aria-hidden="true"><i></i></div>
      <div class="footer-inner">
        <p class="footer-word">Quell</p>
        <div class="footer-cols">
          <p>Quell Quantum Laboratory<br />Technologiepark 21, 9052 Ghent</p>
          <p class="mono">beam@quell.lab<br />+32 9 000 72 90</p>
          <p class="mono muted">Fictional lab · a design study<br />© 2026</p>
        </div>
      </div>
    </footer>

    <BackPill />

    <style is:global>
      :root {
        --bg: #060606;
        --panel: rgb(14 14 15 / 0.72);
        --panel-solid: #0d0d0e;
        --line: rgb(255 255 255 / 0.08);
        --line-2: rgb(255 255 255 / 0.14);
        --text: #ececec;
        --muted: #8b8b90;
        --dim: #5a5a5f;
        /* 729 nm — the calcium qubit transition. Every glow below derives from this. */
        --accent: #ff3b2a;
        --accent-rgb: 255 59 42;
        --core: #fff4f1;
        --beam-y: 56%;
        --sans: 'Geist', ui-sans-serif, system-ui, sans-serif;
        --mono: 'Geist Mono', ui-monospace, monospace;
        color-scheme: dark;
      }
      html { background: var(--bg); scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        font-weight: 400;
        -webkit-font-smoothing: antialiased;
        overflow-x: clip;
      }
      ::selection { background: rgb(var(--accent-rgb) / 0.35); }
      .mono { font-family: var(--mono); }
      .muted { color: var(--muted); }

      #field {
        position: fixed; inset: 0; width: 100%; height: 100%;
        z-index: 0; pointer-events: none; image-rendering: pixelated;
      }
      .field-fallback {
        position: fixed; inset: 0; z-index: -1; pointer-events: none;
        background:
          radial-gradient(60% 18% at 50% 56%, rgb(var(--accent-rgb) / 0.12), transparent 70%),
          var(--bg);
      }
      main, footer, .nav-wrap { position: relative; z-index: 1; }

      a { color: inherit; text-decoration: none; }
      :focus-visible { outline: 1px solid var(--accent); outline-offset: 3px; }

      /* ---------- shells & controls ---------- */
      .shell {
        background: rgb(10 10 11 / 0.62);
        backdrop-filter: blur(14px) saturate(120%);
        -webkit-backdrop-filter: blur(14px) saturate(120%);
        border: 1px solid var(--line);
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04), 0 20px 40px -20px rgb(0 0 0 / 0.8);
      }
      .panel {
        position: relative;
        background: var(--panel);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid transparent;
        border-radius: 4px;
        background-clip: padding-box;
      }
      /* one-pixel gradient border */
      .panel::before, .card::before {
        content: ''; position: absolute; inset: -1px; border-radius: inherit; padding: 1px; pointer-events: none;
        background: linear-gradient(160deg, rgb(255 255 255 / 0.16), rgb(255 255 255 / 0.04) 40%, rgb(255 255 255 / 0.02) 70%, rgb(var(--accent-rgb) / 0.22));
        -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
        -webkit-mask-composite: xor; mask-composite: exclude;
      }
      .corner { position: absolute; width: 9px; height: 9px; border-color: rgb(255 255 255 / 0.4); border-style: solid; border-width: 0; pointer-events: none; }
      .corner.tl { top: -1px; left: -1px; border-top-width: 1px; border-left-width: 1px; }
      .corner.tr { top: -1px; right: -1px; border-top-width: 1px; border-right-width: 1px; }
      .corner.bl { bottom: -1px; left: -1px; border-bottom-width: 1px; border-left-width: 1px; }
      .corner.br { bottom: -1px; right: -1px; border-bottom-width: 1px; border-right-width: 1px; }

      .btn {
        display: inline-flex; align-items: center; gap: 10px;
        height: 44px; padding: 0 18px; border-radius: 3px;
        font: 500 14px/1 var(--sans); letter-spacing: -0.005em;
        transition: background 0.25s, box-shadow 0.25s, border-color 0.25s, color 0.25s;
        white-space: nowrap;
      }
      .btn-sm { height: 34px; padding: 0 14px; font-size: 13px; }
      .btn-accent {
        color: #170403; background: var(--accent);
        box-shadow: 0 0 0 1px rgb(var(--accent-rgb) / 0.6), 0 0 24px -4px rgb(var(--accent-rgb) / 0.55), inset 0 1px 0 rgb(255 255 255 / 0.35);
      }
      .btn-accent:hover { background: #ff5a4a; box-shadow: 0 0 0 1px rgb(var(--accent-rgb) / 0.8), 0 0 34px -2px rgb(var(--accent-rgb) / 0.7), inset 0 1px 0 rgb(255 255 255 / 0.4); }
      .btn-ghost { color: var(--text); border: 1px solid var(--line-2); background: rgb(255 255 255 / 0.02); }
      .btn-ghost:hover { border-color: rgb(255 255 255 / 0.3); background: rgb(255 255 255 / 0.05); }

      .chip, .tag {
        display: inline-flex; align-items: center; gap: 8px;
        font: 500 11px/1 var(--mono); letter-spacing: 0.04em; text-transform: uppercase;
        color: var(--muted); padding: 6px 9px; border: 1px solid var(--line); border-radius: 2px; background: rgb(255 255 255 / 0.02);
        white-space: nowrap;
      }
      .tag-accent { color: var(--accent); border-color: rgb(var(--accent-rgb) / 0.35); background: rgb(var(--accent-rgb) / 0.06); }
      .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px var(--accent); animation: blink 2.4s ease-in-out infinite; }
      @keyframes blink { 50% { opacity: 0.35; } }

      .eyebrow { display: flex; align-items: center; gap: 12px; margin: 0; font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
      .tick { width: 22px; height: 1px; background: linear-gradient(90deg, var(--accent), transparent); box-shadow: 0 0 6px var(--accent); }

      /* ---------- nav ---------- */
      .nav-wrap { position: fixed; top: 16px; left: 0; right: 0; z-index: 20; display: flex; justify-content: center; padding: 0 16px; pointer-events: none; }
      .nav {
        pointer-events: auto; display: flex; align-items: center; gap: 28px;
        width: min(1240px, 100%); padding: 8px 8px 8px 18px; border-radius: 6px;
      }
      .brand { display: flex; align-items: center; gap: 10px; font: 600 16px/1 var(--sans); letter-spacing: -0.02em; }
      .brand-mark { position: relative; width: 22px; height: 22px; border: 1px solid var(--line-2); border-radius: 50%; display: grid; place-items: center; }
      .brand-mark::before { content: ''; position: absolute; left: -4px; right: -4px; top: 50%; height: 1px; background: linear-gradient(90deg, transparent, var(--accent), transparent); }
      .brand-mark i { width: 5px; height: 5px; border-radius: 50%; background: var(--core); box-shadow: 0 0 6px var(--accent), 0 0 12px var(--accent); }
      .nav-links { display: flex; gap: 4px; list-style: none; margin: 0 auto 0 12px; padding: 0; }
      .nav-links a { display: block; padding: 8px 12px; font-size: 13.5px; color: var(--muted); border-radius: 3px; transition: color 0.2s, background 0.2s; }
      .nav-links a:hover { color: var(--text); background: rgb(255 255 255 / 0.04); }

      /* ---------- hero ---------- */
      .hero {
        position: relative; min-height: max(100svh, 760px);
        display: grid; grid-template-rows: 1fr auto; padding: 120px clamp(16px, 4vw, 56px) 40px;
        box-sizing: border-box;
      }
      .hero-frame { position: absolute; inset: 88px clamp(8px, 2vw, 28px) 20px; border-left: 1px solid var(--line); border-right: 1px solid var(--line); pointer-events: none; }
      .hero-frame .corner { width: 12px; height: 12px; }
      .hero-copy { position: relative; z-index: 2; max-width: 1240px; width: 100%; margin: 0 auto; padding-top: clamp(8px, 3vh, 40px); }
      h1 {
        margin: 22px 0 0; font-weight: 500; letter-spacing: -0.045em; line-height: 0.95;
        font-size: clamp(44px, 7.4vw, 112px); max-width: 12ch;
        background: linear-gradient(180deg, #fff 30%, #b9b9bd);
        -webkit-background-clip: text; background-clip: text; color: transparent;
      }
      .accent-word { background: linear-gradient(180deg, #fff 0%, #ffd2cc 35%, var(--accent) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }

      .beam { position: absolute; left: 0; right: 0; top: var(--beam-y); height: 0; z-index: 1; pointer-events: none; }
      .beam-core {
        position: absolute; left: 0; right: 0; top: -0.5px; height: 1px;
        background: linear-gradient(90deg, transparent 0%, rgb(var(--accent-rgb) / 0.7) 10%, var(--core) 35%, #fff 50%, var(--core) 65%, rgb(var(--accent-rgb) / 0.7) 90%, transparent 100%);
        box-shadow: 0 0 2px #fff, 0 0 6px rgb(var(--accent-rgb) / 0.9);
      }
      .beam-halo {
        position: absolute; left: 0; right: 0; top: -14px; height: 28px;
        background: linear-gradient(90deg, transparent, rgb(var(--accent-rgb) / 0.35) 25%, rgb(var(--accent-rgb) / 0.5) 50%, rgb(var(--accent-rgb) / 0.35) 75%, transparent);
        filter: blur(10px); opacity: 0.8;
        -webkit-mask: linear-gradient(180deg, transparent, #000 45%, #000 55%, transparent);
        mask: linear-gradient(180deg, transparent, #000 45%, #000 55%, transparent);
      }
      .beam-pulse {
        position: absolute; top: -3px; left: 0; width: 180px; height: 6px; border-radius: 50%;
        background: radial-gradient(closest-side, #fff, rgb(var(--accent-rgb) / 0.8) 40%, transparent);
        filter: blur(1px);
        animation: sweep 5.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
      }
      @keyframes sweep { from { transform: translateX(calc(24vw - 90px)); opacity: 0; } 8% { opacity: 1; } 92% { opacity: 1; } to { transform: translateX(calc(76vw - 90px)); opacity: 0; } }
      .chain { position: absolute; left: 25vw; right: 25vw; top: 0; display: flex; justify-content: space-between; }
      .ion {
        width: 5px; height: 5px; margin-top: -2.5px; border-radius: 50%;
        background: #ffe9e5; box-shadow: 0 0 4px rgb(var(--accent-rgb) / 0.9), 0 0 10px rgb(var(--accent-rgb) / 0.5);
        animation: ion 5.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
        animation-delay: calc(var(--i) * 0.141s - 0.1s);
      }
      .ion:nth-child(19) { background: var(--accent); }
      @keyframes ion {
        0%, 100% { transform: scale(1); box-shadow: 0 0 4px rgb(var(--accent-rgb) / 0.9), 0 0 10px rgb(var(--accent-rgb) / 0.5); }
        6% { transform: scale(1.7); box-shadow: 0 0 6px #fff, 0 0 18px var(--accent), 0 0 36px rgb(var(--accent-rgb) / 0.6); }
        16% { transform: scale(1); }
      }
      .beam-label { position: absolute; top: 14px; padding: 4px 7px; background: rgb(6 6 6 / 0.82); border: 1px solid var(--line); border-radius: 2px; font-size: 10.5px; letter-spacing: 0.06em; color: var(--muted); white-space: nowrap; }
      .beam-label::before { content: ''; position: absolute; left: -1px; top: -15px; width: 1px; height: 10px; background: rgb(255 255 255 / 0.3); }
      .beam-label-l { left: 25vw; }
      .beam-label-r { left: calc(25vw + 50vw * 18 / 31); color: rgb(var(--accent-rgb) / 0.95); }

      .hero-lower {
        position: relative; z-index: 2; max-width: 1240px; width: 100%; margin: 0 auto;
        display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 48px; align-items: end;
      }
      .hero-lede p { margin: 0; max-width: 46ch; font-size: 16.5px; line-height: 1.6; color: #b4b4b9; }
      .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

      .telemetry { margin: 0; padding: 0; }
      .panel-head { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--line); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
      .live { display: inline-flex; align-items: center; gap: 7px; color: var(--accent); }
      .tele-row { display: grid; grid-template-columns: 120px 1fr; gap: 12px; padding: 11px 16px; border-bottom: 1px solid rgb(255 255 255 / 0.05); align-items: baseline; }
      .tele-row:last-child { border-bottom: 0; }
      .tele-row dt { font-size: 11px; color: var(--muted); letter-spacing: 0.02em; }
      .tele-row dd { margin: 0; display: flex; flex-direction: column; gap: 3px; }
      .tele-v { font-size: 19px; font-weight: 500; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
      .tele-s { font-size: 12px; color: var(--dim); }

      /* ---------- sections ---------- */
      .section { max-width: 1240px; margin: 0 auto; padding: clamp(80px, 12vw, 150px) clamp(16px, 4vw, 56px) 0; box-sizing: content-box; }
      .section-head { display: grid; gap: 20px; margin-bottom: 48px; }
      .section-head.split { grid-template-columns: 1fr minmax(0, 420px); align-items: end; gap: 48px; }
      h2 { margin: 0; font-weight: 500; font-size: clamp(34px, 4.6vw, 64px); letter-spacing: -0.04em; line-height: 1; color: #f3f3f3; max-width: 18ch; }
      .section-lede { margin: 0; max-width: 54ch; color: var(--muted); font-size: 16px; line-height: 1.6; }
      h3 { margin: 0; font-weight: 500; font-size: 21px; letter-spacing: -0.02em; line-height: 1.2; }

      .card { position: relative; border-radius: 4px; background: var(--panel); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); padding: 24px; display: flex; flex-direction: column; gap: 16px; }
      .card p { margin: 0; color: var(--muted); font-size: 14.5px; line-height: 1.65; }
      .card-top { display: flex; min-height: 24px; justify-content: space-between; align-items: center; font-size: 11.5px; color: var(--muted); letter-spacing: 0.04em; text-transform: uppercase; }
      .card-stat { margin-top: auto; padding-top: 20px; border-top: 1px dashed var(--line-2); display: flex; flex-direction: column; gap: 6px; }
      .stat { font-size: 30px; font-weight: 500; letter-spacing: -0.035em; font-variant-numeric: tabular-nums; }
      .stat.big { font-size: clamp(40px, 5vw, 60px); line-height: 1; }
      .stat-label { font-size: 11px; color: var(--muted); letter-spacing: 0.03em; }
      .machine-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
      .machine-grid .card { min-height: 360px; }

      /* console */
      .console { border-radius: 6px; }
      .console-bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 10px 12px 10px 10px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
      .tabs { display: flex; gap: 2px; padding: 3px; border: 1px solid var(--line); border-radius: 4px; background: rgb(0 0 0 / 0.3); }
      .tab { appearance: none; border: 0; background: transparent; color: var(--muted); font: 500 13px/1 var(--sans); padding: 9px 14px; border-radius: 2px; cursor: pointer; position: relative; transition: color 0.2s, background 0.2s; }
      .tab:hover { color: var(--text); }
      .tab[aria-selected='true'] { color: var(--text); background: rgb(255 255 255 / 0.06); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06); }
      .tab[aria-selected='true']::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 2px; height: 1px; background: var(--accent); box-shadow: 0 0 6px var(--accent); }
      .console-meta { font-size: 11px; color: var(--dim); letter-spacing: 0.04em; }
      .pane { padding: clamp(18px, 3vw, 32px); }
      .fid-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 28px; }
      .fid-head > div:first-child { display: flex; flex-direction: column; gap: 8px; }
      .legend { display: flex; gap: 18px; font-size: 11px; color: var(--muted); }
      .legend span { display: inline-flex; align-items: center; gap: 7px; }
      .sw { width: 10px; height: 10px; border-radius: 1px; display: inline-block; }
      .sw-n { background: #d9d9dc; }
      .sw-a { background: var(--accent); box-shadow: 0 0 6px var(--accent); }
      .bars {
        height: 220px; display: grid; grid-template-columns: repeat(32, minmax(0, 1fr)); gap: clamp(2px, 0.5vw, 6px); align-items: end;
        border-bottom: 1px solid var(--line-2); position: relative;
        background-image: repeating-linear-gradient(0deg, rgb(255 255 255 / 0.05) 0 1px, transparent 1px 55px);
      }
      .bar {
        height: calc(var(--h) * 100%); border-radius: 1px 1px 0 0;
        background: linear-gradient(180deg, rgb(232 232 234 / 0.78), rgb(232 232 234 / 0.08));
        transform-origin: bottom; transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
      }
      .bar.low { background: linear-gradient(180deg, var(--accent), rgb(var(--accent-rgb) / 0.25)); box-shadow: 0 0 14px rgb(var(--accent-rgb) / 0.55); }
      .bars-axis { display: flex; justify-content: space-between; margin-top: 10px; font-size: 10.5px; color: var(--dim); letter-spacing: 0.05em; text-transform: uppercase; }
      .tbl { width: 100%; border-collapse: collapse; font-size: 14px; }
      .tbl th { text-align: left; font: 500 10.5px/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--dim); padding: 0 12px 14px 0; border-bottom: 1px solid var(--line-2); }
      .tbl td { padding: 14px 12px 14px 0; border-bottom: 1px solid rgb(255 255 255 / 0.05); vertical-align: middle; }
      .tbl td.mono { font-size: 12.5px; color: #c9c9cd; }
      .tbl .num { text-align: right; padding-right: 0; }
      .state { font: 500 10.5px/1 var(--mono); letter-spacing: 0.05em; text-transform: uppercase; padding: 5px 8px; border-radius: 2px; border: 1px solid var(--line); color: var(--muted); white-space: nowrap; }
      .state.running, .state.retuning { color: var(--accent); border-color: rgb(var(--accent-rgb) / 0.4); background: rgb(var(--accent-rgb) / 0.07); }
      .state.locked { color: var(--text); border-color: var(--line-2); }

      /* pulses */
      .pulses { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--line); }
      .pulse { position: relative; padding: 32px 24px 8px 0; display: flex; flex-direction: column; gap: 12px; }
      .pulse + .pulse { padding-left: 24px; border-left: 1px solid var(--line); }
      .pulse-rail { position: absolute; top: -1px; left: 0; right: 0; height: 1px; }
      .pulse-node { position: absolute; top: -3px; left: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--core); box-shadow: 0 0 8px var(--accent), 0 0 18px rgb(var(--accent-rgb) / 0.6); }
      .pulse + .pulse .pulse-node { left: -4px; }
      .pulse-top { display: flex; justify-content: space-between; font-size: 11.5px; color: var(--muted); letter-spacing: 0.04em; }
      .pulse-top span:last-child { color: var(--accent); }
      .pulse p { margin: 0; font-size: 14.5px; line-height: 1.65; color: var(--muted); }
      .pulses { position: relative; }
      .pulses::after {
        content: ''; position: absolute; top: -1px; left: 0; height: 1px; width: 100%;
        background: linear-gradient(90deg, transparent, var(--core) 50%, transparent); box-shadow: 0 0 8px var(--accent);
        transform-origin: left; animation: rail 6s ease-in-out infinite; opacity: 0.9;
      }
      @keyframes rail { 0% { transform: scaleX(0); opacity: 0; } 15% { opacity: 1; } 70% { transform: scaleX(1); opacity: 1; } 100% { transform: scaleX(1); opacity: 0; } }
      .pulses-foot { margin: 32px 0 0; font-size: 11.5px; color: var(--muted); letter-spacing: 0.04em; }

      /* access */
      .access-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: stretch; }
      .tier { gap: 24px; padding: 28px; overflow: hidden; }
      .tier-price { display: flex; flex-direction: column; gap: 8px; }
      .tier ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; flex: 1; }
      .tier li { font-size: 14.5px; color: #b4b4b9; padding-left: 18px; position: relative; line-height: 1.5; }
      .tier li::before { content: ''; position: absolute; left: 0; top: 0.72em; width: 8px; height: 1px; background: var(--dim); }
      .tier.featured li::before { background: var(--accent); box-shadow: 0 0 4px var(--accent); }
      .tier .btn { justify-content: center; }
      .tier.featured { background: linear-gradient(180deg, rgb(var(--accent-rgb) / 0.07), rgb(14 14 15 / 0.75) 45%); }
      .tier-beam { position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--core), transparent); box-shadow: 0 0 6px var(--accent), 0 0 18px var(--accent); }

      /* footer */
      .footer { margin-top: clamp(100px, 14vw, 180px); position: relative; overflow: hidden; }
      .footer-beam { position: relative; height: 1px; }
      .footer-beam i { position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgb(var(--accent-rgb) / 0.7) 20%, var(--core) 50%, rgb(var(--accent-rgb) / 0.7) 80%, transparent); box-shadow: 0 0 10px var(--accent); }
      .footer-beam::after { content: ''; position: absolute; left: 10%; right: 10%; top: -40px; height: 80px; background: radial-gradient(50% 50% at 50% 50%, rgb(var(--accent-rgb) / 0.18), transparent); filter: blur(8px); }
      .footer-inner { max-width: 1240px; margin: 0 auto; padding: 40px clamp(16px, 4vw, 56px) 80px; box-sizing: content-box; }
      .footer-word {
        margin: 0; font-weight: 500; letter-spacing: -0.07em; line-height: 0.8; font-size: clamp(96px, 24vw, 360px);
        background: linear-gradient(180deg, rgb(255 255 255 / 0.85), rgb(255 255 255 / 0.04) 85%);
        -webkit-background-clip: text; background-clip: text; color: transparent;
      }
      .footer-cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); line-height: 1.6; }
      .footer-cols p { margin: 0; }
      .footer-cols .mono { font-size: 12px; }

      /* ---------- responsive ---------- */
      @media (max-width: 1080px) {
        .nav-links { display: none; }
        .nav .chip { margin-left: auto; }
        .hero-lower { grid-template-columns: minmax(0, 1fr); gap: 32px; }
        .telemetry { max-width: 520px; }
        .machine-grid, .access-grid { grid-template-columns: minmax(0, 1fr); }
        .machine-grid .card { min-height: 0; }
        .pulses { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .pulse:nth-child(3) { padding-left: 0; border-left: 0; }
        .pulse:nth-child(3) .pulse-node { left: 0; }
        .section-head.split { grid-template-columns: minmax(0, 1fr); gap: 20px; }
      }
      @media (max-width: 720px) {
        :root { --beam-y: 46%; }
        .nav { gap: 12px; padding-left: 14px; }
        .nav .chip { display: none; }
        .nav .btn { margin-left: auto; }
        .hero { padding-top: 104px; min-height: 0; grid-template-rows: auto auto; gap: 200px; }
        .hero-frame { inset: 80px 6px 10px; }
        .beam { top: 395px; }
        .chain { left: 8vw; right: 8vw; }
        .ion:nth-child(even) { display: none; }
        .beam-label-l { left: 8vw; }
        .beam-label-r { left: auto; right: 8vw; }
        .beam-label-r::before { left: auto; right: -1px; }
        @keyframes sweep { from { transform: translateX(calc(6vw - 90px)); opacity: 0; } 8% { opacity: 1; } 92% { opacity: 1; } to { transform: translateX(calc(94vw - 90px)); opacity: 0; } }
        .tele-row { grid-template-columns: 104px 1fr; }
        .pulses { grid-template-columns: minmax(0, 1fr); }
        .pulse, .pulse + .pulse { padding: 24px 0 16px; border-left: 0; border-top: 1px solid var(--line); }
        .pulse-node, .pulse + .pulse .pulse-node { left: 0; }
        .bars { height: 160px; }
        .hide-sm { display: none; }
        .tbl { font-size: 13px; }
        .footer-cols { grid-template-columns: minmax(0, 1fr); }
        .console-meta { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .beam-pulse, .ion, .dot, .pulses::after { animation: none !important; }
        .beam-pulse { display: none; }
      }
    </style>

    <script>
      // ---------- tabs (roving tabindex, arrow keys) ----------
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const select = (t: HTMLButtonElement) => {
        for (const o of tabs) {
          const on = o === t;
          o.setAttribute('aria-selected', String(on));
          o.tabIndex = on ? 0 : -1;
          document.getElementById(o.getAttribute('aria-controls')!)!.hidden = !on;
        }
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(t));
        t.addEventListener('keydown', (e) => {
          const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!d) return;
          const n = tabs[(i + d + tabs.length) % tabs.length];
          select(n);
          n.focus();
        });
      });

      // ---------- dithered field + laser haze ----------
      // Rendered at 1/PIXEL resolution and upscaled with nearest-neighbour, so every Bayer cell
      // is a visible PIXEL×PIXEL square. The crisp 1px beam core lives in the DOM on top.
      const PIXEL = 3; // ponytail: dither cell size in css px — the main density knob
      const canvas = document.getElementById('field') as HTMLCanvasElement;
      const gl = canvas.getContext('webgl', { antialias: false, premultipliedAlpha: false });
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (gl) {
        document.querySelector<HTMLElement>('.field-fallback')!.style.display = 'none';
        const vs = `attribute vec2 p; void main(){ gl_Position = vec4(p,0.,1.); }`;
        const fs = `
          precision highp float;
          uniform vec2 uRes; uniform float uTime; uniform float uBeam; uniform float uPix; uniform vec3 uAccent;
          float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7))) * 43758.5453); }
          float noise(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f);
            return mix(mix(hash(i),hash(i+vec2(1,0)),f.x), mix(hash(i+vec2(0,1)),hash(i+vec2(1,1)),f.x), f.y); }
          float fbm(vec2 p){ float v=0., a=.5; for(int i=0;i<5;i++){ v+=a*noise(p); p=p*2.03+vec2(1.7,9.2); a*=.5; } return v; }
          // 8x8 Bayer threshold, built from the 2x2 recurrence
          float bayer2(vec2 a){ a=floor(a); return fract(a.x*.5 + a.y*a.y*.75); }
          float bayer8(vec2 a){ return (bayer2(a*.25)*.25 + bayer2(a*.5))*.25 + bayer2(a); }
          float dither(float v, float levels, float t){ return floor(v*levels + t) / levels; }
          void main(){
            vec2 px = gl_FragCoord.xy;               // canvas pixels (= dither cells)
            vec2 css = vec2(px.x, uRes.y - px.y) * uPix; // css px, y down
            vec2 vp = uRes * uPix;
            vec2 uv = css / vp.y;
            float t = uTime;
            float th = bayer8(px) ;

            // slow smoky field
            vec2 q = uv * 2.2 + vec2(t*.012, -t*.008);
            float smoke = fbm(q + fbm(q*1.3 + t*.02)*1.4);
            float base = max(smoke * smoke * smoke * .24 - .01, 0.);

            // laser haze: distance to the beam line, tapered toward the edges of the screen
            float dy = abs(css.y - uBeam);
            float xc = css.x / vp.x;
            float taper = smoothstep(0., .25, xc) * smoothstep(1., .75, xc);
            float hot = smoothstep(.2, .8, 1. - abs(xc - .5) * 2.);
            float halo = exp(-dy*dy / (2600.)) * (.55 + .45*hot);
            float wide = exp(-dy / 130.) * .3;
            float haze = (halo + wide * (.6 + smoke)) * taper;
            // a slow drifting pocket of smoke lit by the beam
            haze *= .75 + .5 * fbm(vec2(css.x/260. - t*.05, css.y/90.));

            float vign = smoothstep(1.25, .25, length((css/vp - .5) * vec2(1., 1.3)));
            float neutral = dither(base * vign + haze*.06, 7., th);
            float acc = dither(haze * .45, 6., th);
            vec3 col = vec3(neutral) * vec3(.6,.6,.63) + uAccent * acc;
            gl_FragColor = vec4(col, 1.);
          }`;
        const sh = (type: number, src: string) => {
          const s = gl.createShader(type)!;
          gl.shaderSource(s, src);
          gl.compileShader(s);
          if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) console.error(gl.getShaderInfoLog(s));
          return s;
        };
        const prog = gl.createProgram()!;
        gl.attachShader(prog, sh(gl.VERTEX_SHADER, vs));
        gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, fs));
        gl.linkProgram(prog);
        gl.useProgram(prog);
        gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
        const loc = gl.getAttribLocation(prog, 'p');
        gl.enableVertexAttribArray(loc);
        gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
        const u = (n: string) => gl.getUniformLocation(prog, n);
        const uRes = u('uRes'), uTime = u('uTime'), uBeam = u('uBeam'), uPix = u('uPix');
        const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent-rgb').trim().split(/\s+/).map((n) => +n / 255);
        gl.uniform3f(u('uAccent'), accent[0], accent[1], accent[2]);
        gl.uniform1f(uPix, PIXEL);

        const beamEl = document.querySelector<HTMLElement>('.beam')!;
        const resize = () => {
          canvas.width = Math.ceil(innerWidth / PIXEL);
          canvas.height = Math.ceil(innerHeight / PIXEL);
          gl.viewport(0, 0, canvas.width, canvas.height);
          gl.uniform2f(uRes, canvas.width, canvas.height);
        };
        resize();
        addEventListener('resize', () => { resize(); if (reduce) draw(0); });

        const start = performance.now();
        const draw = (now: number) => {
          gl.uniform1f(uTime, reduce ? 12 : (now - start) / 1000 + 12);
          gl.uniform1f(uBeam, beamEl.getBoundingClientRect().top); // follows the hero beam as it scrolls
          gl.drawArrays(gl.TRIANGLES, 0, 3);
        };
        if (reduce) {
          draw(0);
          addEventListener('scroll', () => draw(0), { passive: true });
        } else {
          const loop = (now: number) => {
            if (!document.hidden) draw(now);
            requestAnimationFrame(loop);
          };
          requestAnimationFrame(loop);
        }
      }
    </script>
  </body>
</html>
