---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';
import { ChartroomThread, OrbLegend, PassageConsole, StateGallery } from '../../components/skills/thinking-orbs/Halyard';
---
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Halyard — passage planning that shows its thinking</title>
    <meta name="description" content="Halyard plans small-boat passages from tides, weather and your crew, and tells you honestly what it is doing while it works." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="ho-page">
      <header class="ho-nav">
        <a href="#top" class="ho-logo" aria-label="Halyard home">
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M11 2v18M11 3l7 13H11M11 6L5 16h6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
          Halyard
        </a>
        <nav aria-label="Primary">
          <a href="#states">States</a>
          <a href="#chartroom">Chartroom</a>
          <a href="#principles">Principles</a>
        </nav>
        <a href="#chartroom" class="ho-nav-cta">Join the crew list</a>
      </header>

      <main id="top">
        <section class="ho-hero">
          <div class="ho-chart" aria-hidden="true">
            <svg viewBox="0 0 800 800" preserveAspectRatio="xMidYMid slice">
              <g stroke="currentColor" fill="none">
                {Array.from({ length: 32 }, (_, i) => (
                  <line x1="400" y1="400" x2={400 + 520 * Math.cos((i * Math.PI) / 16)} y2={400 + 520 * Math.sin((i * Math.PI) / 16)} stroke-opacity={i % 4 === 0 ? 0.16 : 0.06} />
                ))}
                <circle cx="400" cy="400" r="150" stroke-opacity="0.12" stroke-dasharray="2 6" />
                <circle cx="400" cy="400" r="260" stroke-opacity="0.08" />
                <circle cx="400" cy="400" r="360" stroke-opacity="0.06" stroke-dasharray="1 8" />
              </g>
            </svg>
          </div>

          <div class="ho-hero-copy">
            <p class="ho-mono ho-brass">Passage planning for small boats · Beta, autumn ’26</p>
            <h1>Your passage,<br /><em>thought through.</em></h1>
            <p class="ho-lede">
              Tell Halyard where you want to be and who is aboard. It reads the tides, the forecast and the
              notices to mariners, then hands you a one-page brief, and while it works it tells you
              exactly what it is doing. Not how far along. What.
            </p>
            <div class="ho-hero-actions">
              <a href="#states" class="ho-btn">See the six states</a>
              <span class="ho-mono ho-dim">No progress bars. No fake percentages.</span>
            </div>
            <OrbLegend client:load />
          </div>

          <div class="ho-hero-console">
            <PassageConsole client:load />
          </div>
        </section>

        <section id="states" class="ho-section">
          <div class="ho-section-head">
            <p class="ho-mono ho-brass">01 · Six honest states</p>
            <h2>One orb per kind of work, <em>never a guess.</em></h2>
            <p>
              Every activity in Halyard maps to exactly one state. When we are not sure which, we show <span class="ho-mono">working</span>, because a truthful generic signal beats an
              interesting wrong one.
            </p>
          </div>
          <StateGallery client:visible />
        </section>

        <section id="chartroom" class="ho-paper" data-theme="light">
          <div class="ho-paper-inner">
            <div class="ho-section-head">
              <p class="ho-mono">02 · The chartroom</p>
              <h2>Same orb, <em>printed on paper.</em></h2>
              <p>
                The chartroom view is light, for reading below decks at noon. Nothing is reconfigured: every
                orb is set to <span class="ho-mono">auto</span> and picks up the surface it sits on, so the dots
                turn to ink here and back to light on the night console.
              </p>
            </div>
            <ChartroomThread client:visible />
          </div>
        </section>

        <section id="principles" class="ho-section">
          <div class="ho-section-head">
            <p class="ho-mono ho-brass">03 · House rules</p>
            <h2>What the orb is <em>not allowed</em> to do.</h2>
          </div>
          <ol class="ho-rules">
            <li><span class="ho-mono ho-brass">i</span><h3>Pretend to know how long.</h3><p>The orb is indeterminate. Tides don’t care about progress bars, and neither does the forecast model.</p></li>
            <li><span class="ho-mono ho-brass">ii</span><h3>Outstay the work.</h3><p>When the brief is ready, or the request fails, the orb is gone and the answer or the retry is in its place.</p></li>
            <li><span class="ho-mono ho-brass">iii</span><h3>Speak twice.</h3><p>Status text is announced once, politely. The orb itself is hidden from screen readers when the words already say it.</p></li>
            <li><span class="ho-mono ho-brass">iv</span><h3>Move when you’ve asked it not to.</h3><p>With reduced motion on, each state settles to a single still frame that still tells you what kind of work is happening.</p></li>
          </ol>
        </section>
      </main>

      <footer class="ho-foot">
        <p class="ho-logo">Halyard</p>
        <p class="ho-dim">Made on a Westerly 28 out of Mylor. Not a substitute for a proper watch, a paper chart, or common sense.</p>
      </footer>
    </div>
    <BackPill />
  </body>
</html>

<style is:global>
  :root {
    --ink: #0b0d10;
    --ink-2: #12151a;
    --bone: #ece6d9;
    --dim: rgb(236 230 217 / 0.56);
    --line: rgb(236 230 217 / 0.1);
    --brass: #c9ab70;
    --paper: #efe9dc;
    --paper-ink: #1b1a17;
    --serif: 'Instrument Serif', Georgia, serif;
    --sans: 'Inter', ui-sans-serif, system-ui, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
  }
  html { background: var(--ink); color-scheme: dark; }
  body { margin: 0; background: var(--ink); color: var(--bone); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
  .ho-page { overflow-x: clip; }
  .ho-page h1, .ho-page h2, .ho-page h3, .ho-page p { margin: 0; }
  .ho-page em { font-style: italic; color: var(--brass); }
  .ho-mono { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; }
  .ho-dim { color: var(--dim); }
  .ho-brass { color: var(--brass); }
  .ho-right { text-align: right; }

  /* nav */
  .ho-nav { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; gap: 24px; max-width: 1320px; margin: 0 auto; padding: 22px 32px; }
  .ho-logo { display: inline-flex; align-items: center; gap: 10px; font-family: var(--serif); font-size: 26px; color: var(--bone); text-decoration: none; }
  .ho-nav nav { display: flex; gap: 32px; }
  .ho-nav nav a { color: var(--dim); text-decoration: none; font-size: 14px; }
  .ho-nav nav a:hover { color: var(--bone); }
  .ho-nav-cta { font-size: 14px; color: var(--bone); text-decoration: none; padding: 9px 16px; border: 1px solid var(--line); border-radius: 999px; }
  .ho-nav-cta:hover { border-color: rgb(236 230 217 / 0.3); }

  /* hero */
  .ho-hero { position: relative; max-width: 1320px; margin: 0 auto; padding: 48px 32px 96px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 560px); gap: 72px; align-items: center; min-height: calc(100vh - 80px); box-sizing: border-box; }
  .ho-chart { position: absolute; inset: -120px -200px 0 30%; color: var(--bone); pointer-events: none; z-index: 0; mask-image: radial-gradient(closest-side, #000 30%, transparent); }
  .ho-chart svg { width: 100%; height: 100%; }
  .ho-hero-copy, .ho-hero-console { position: relative; z-index: 1; }
  .ho-hero h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(54px, 7.4vw, 112px); line-height: 0.94; letter-spacing: -0.02em; margin: 22px 0 28px; }
  .ho-lede { max-width: 30rem; font-size: 17px; line-height: 1.6; color: var(--dim); }
  .ho-legend { list-style: none; margin: 44px 0 0; padding: 22px 0 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(6, 64px); justify-content: space-between; max-width: 34rem; }
  .ho-legend li { display: grid; justify-items: center; gap: 8px; }
  .ho-legend .ho-mono { font-size: 9.5px; color: var(--dim); }
  .ho-hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; margin-top: 36px; }

  .ho-btn { display: inline-flex; align-items: center; gap: 10px; font: 500 14px/1 var(--sans); color: var(--ink); background: var(--bone); border: 1px solid var(--bone); padding: 13px 20px; border-radius: 999px; text-decoration: none; cursor: pointer; transition: background 0.2s, color 0.2s, border-color 0.2s; }
  .ho-btn:hover { background: #fff; }
  .ho-btn:disabled { opacity: 0.4; cursor: default; }
  .ho-btn:focus-visible, .ho-nav a:focus-visible, .ho-logo:focus-visible { outline: 2px solid var(--brass); outline-offset: 3px; }
  .ho-btn-ghost { color: var(--bone); background: transparent; border-color: var(--line); }
  .ho-btn-ghost:hover { background: rgb(236 230 217 / 0.06); }

  /* console */
  .ho-console { background: linear-gradient(180deg, rgb(255 255 255 / 0.045), rgb(255 255 255 / 0.015)), var(--ink-2); border: 1px solid var(--line); border-radius: 28px; padding: 26px; box-shadow: 0 40px 100px -30px rgb(0 0 0 / 0.8), inset 0 1px 0 rgb(255 255 255 / 0.06); }
  .ho-console-head { display: flex; justify-content: space-between; gap: 16px; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
  .ho-route { font-family: var(--serif); font-size: 26px; margin-top: 6px !important; }
  .ho-now { display: flex; gap: 22px; align-items: center; padding: 26px 0; min-height: 132px; }
  .ho-well { flex: none; width: 112px; height: 112px; border-radius: 50%; display: grid; place-items: center; background: radial-gradient(circle, rgb(255 255 255 / 0.05), transparent 70%); border: 1px solid var(--line); box-shadow: inset 0 0 30px rgb(0 0 0 / 0.5); }
  .ho-done-mark { color: var(--brass); display: grid; place-items: center; }
  .ho-now-text { min-width: 0; display: grid; gap: 8px; }
  .ho-now-title { font-family: var(--serif); font-size: 30px; line-height: 1.05; }
  .ho-now-detail { font-size: 14px; line-height: 1.5; color: var(--dim); }
  .ho-steps { list-style: none; margin: 0; padding: 6px 0 0; border-top: 1px solid var(--line); }
  .ho-step { display: grid; grid-template-columns: 20px minmax(0, 1fr) auto; align-items: center; gap: 14px; padding: 12px 0; font-size: 14px; color: var(--dim); transition: color 0.3s; }
  .ho-step + .ho-step { border-top: 1px dashed rgb(236 230 217 / 0.07); }
  .ho-step.is-active, .ho-step.is-done { color: var(--bone); }
  .ho-step.is-done .ho-step-title { color: var(--dim); }
  .ho-step-icon { width: 20px; height: 20px; display: grid; place-items: center; }
  .ho-pending { width: 6px; height: 6px; border-radius: 50%; border: 1px solid rgb(236 230 217 / 0.3); }
  .ho-step-meta { font-size: 10.5px; }
  .ho-console-foot { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .ho-console-foot .ho-btn { padding: 11px 16px; font-size: 13px; }

  /* sections */
  .ho-section { max-width: 1320px; margin: 0 auto; padding: 120px 32px; box-sizing: border-box; }
  .ho-section-head { display: grid; gap: 18px; max-width: 46rem; margin-bottom: 56px; }
  .ho-section-head h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(40px, 5vw, 68px); line-height: 1; letter-spacing: -0.015em; }
  .ho-section-head p:last-child { font-size: 16px; line-height: 1.6; color: var(--dim); }
  .ho-section-head p .ho-mono { font-size: 0.85em; color: var(--bone); }

  .ho-gallery { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 24px; overflow: hidden; }
  .ho-card { background: var(--ink); padding: 32px; display: grid; gap: 10px; align-content: start; }
  .ho-card-orb { width: 96px; height: 96px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--line); margin-bottom: 18px; }
  .ho-card-title { font-family: var(--serif); font-weight: 400; font-size: 30px; }
  .ho-card-note { font-size: 14px; line-height: 1.55; color: var(--dim); min-height: 3.1em; }
  .ho-inline { display: inline-flex; align-items: center; gap: 10px; margin-top: 14px !important; padding: 8px 14px 8px 10px; border-radius: 999px; background: rgb(236 230 217 / 0.05); border: 1px solid var(--line); font-size: 13px; justify-self: start; }

  /* paper */
  .ho-paper { background: var(--paper); color: var(--paper-ink); background-image: linear-gradient(rgb(27 26 23 / 0.05) 1px, transparent 1px), linear-gradient(90deg, rgb(27 26 23 / 0.05) 1px, transparent 1px); background-size: 48px 48px; }
  .ho-paper-inner { max-width: 1320px; margin: 0 auto; padding: 120px 32px; box-sizing: border-box; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 560px); gap: 72px; align-items: center; }
  .ho-paper .ho-section-head { margin: 0; }
  .ho-paper em { color: #8a6a2c; }
  .ho-paper .ho-section-head p:last-child { color: rgb(27 26 23 / 0.66); }
  .ho-paper .ho-section-head p .ho-mono { color: var(--paper-ink); }
  .ho-thread { display: grid; gap: 16px; padding: 28px; background: #f8f4ea; border: 1px solid rgb(27 26 23 / 0.12); border-radius: 24px; box-shadow: 0 30px 60px -30px rgb(60 45 20 / 0.35); }
  .ho-msg p { font-size: 15px; line-height: 1.55; }
  .ho-msg-you { justify-self: end; max-width: 80%; background: var(--paper-ink); color: var(--paper); padding: 14px 18px; border-radius: 18px 18px 4px 18px; }
  .ho-msg-halyard { display: flex; gap: 16px; align-items: flex-start; }
  .ho-avatar { flex: none; width: 64px; height: 64px; display: grid; place-items: center; }
  .ho-avatar-h { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: var(--paper-ink); color: var(--paper); font-family: var(--serif); font-size: 26px; }
  .ho-msg-body { display: grid; gap: 6px; padding-top: 10px; min-height: 64px; }
  .ho-msg-body .ho-mono { color: #8a6a2c; }
  .ho-btn-paper { justify-self: start; background: var(--paper-ink); border-color: var(--paper-ink); color: var(--paper); }
  .ho-btn-paper:hover { background: #000; }
  .ho-paper .ho-btn:focus-visible { outline-color: #8a6a2c; }

  /* rules */
  .ho-rules { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; }
  .ho-rules li { display: grid; gap: 12px; align-content: start; padding-top: 22px; border-top: 1px solid var(--line); }
  .ho-rules h3 { font-family: var(--serif); font-weight: 400; font-size: 26px; line-height: 1.1; }
  .ho-rules p { font-size: 14px; line-height: 1.6; color: var(--dim); }

  .ho-foot { max-width: 1320px; margin: 0 auto; padding: 40px 32px 96px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; border-top: 1px solid var(--line); font-size: 13px; }

  @media (max-width: 1080px) {
    .ho-hero, .ho-paper-inner { grid-template-columns: minmax(0, 1fr); gap: 48px; min-height: 0; }
    .ho-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ho-rules { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ho-chart { inset: -80px -40% 40% 0; }
  }
  @media (max-width: 640px) {
    .ho-nav { padding: 18px 16px; }
    .ho-nav nav { display: none; }
    .ho-hero { padding: 20px 16px 72px; gap: 36px; }
    .ho-hero h1 { margin: 16px 0 20px; }
    .ho-lede { font-size: 16px; }
    .ho-legend { grid-template-columns: repeat(3, 64px); row-gap: 20px; justify-content: space-around; }
    .ho-chart { opacity: 0.45; }
    .ho-console { padding: 20px; border-radius: 22px; }
    .ho-route { font-size: 22px; }
    .ho-now { gap: 16px; padding: 20px 0; }
    .ho-well { width: 84px; height: 84px; }
    .ho-now-title { font-size: 24px; }
    .ho-section, .ho-paper-inner { padding: 80px 16px; }
    .ho-gallery, .ho-rules { grid-template-columns: minmax(0, 1fr); }
    .ho-card { padding: 26px 22px; }
    .ho-thread { padding: 20px; }
    .ho-msg-you { max-width: 92%; }
    .ho-foot { padding: 32px 16px 96px; }
  }
</style>
