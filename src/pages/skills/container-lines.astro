---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

const u = (id: string, w = 1400) => `https://images.unsplash.com/photo-${id}?w=${w}&q=75&auto=format&fit=crop`;

const readout = [
  ['Lot', '24-117'],
  ['Garden', 'Okuhara, JP'],
  ['Elevation', '410 m'],
  ['Picked', '08 May 2026'],
  ['Landed', '29 May 2026'],
];

const stats = [
  ['38', 'gardens bought from directly, no brokers'],
  ['11', 'origins, from Shizuoka to Ilam'],
  ['≤ 21 d', 'from final firing to our bonded store'],
  ['0', 'blends, flavourings or anonymous grades'],
];

const lots = [
  ['24-117', 'Asamushi sencha', 'Shizuoka, JP', '410 m', '08 May', 'Steamed', '€14.80'],
  ['24-122', 'Gokou tencha (for matcha)', 'Uji, JP', '180 m', '14 May', 'Shaded 24 d', '€31.00'],
  ['24-131', 'Castleton first flush', 'Darjeeling, IN', '1 370 m', '22 Mar', 'Light', '€22.40'],
  ['24-140', 'Dong Ding, charcoal-roasted', 'Nantou, TW', '740 m', '19 Apr', '35 %', '€18.60'],
  ['24-146', 'Old-tree Dian Hong', 'Fengqing, CN', '1 900 m', '02 Apr', 'Full', '€12.90'],
  ['24-153', 'Jun Chiyabari spring white', 'Dhankuta, NP', '1 800 m', '30 Mar', 'Withered', '€19.70'],
];

const gardens = [
  {
    src: u('1563822249548-9a72b6353cd1', 900),
    alt: 'Spoons of loose tea leaves arranged in a circle on stone',
    name: 'The cupping table',
    body: 'Every lot is cupped three times: at the garden, on landing, and again before it ships. Anything that drifts goes back.',
  },
  {
    src: u('1582793988951-9aed5509eb97', 900),
    alt: 'Matcha powder, a bamboo whisk and a bowl of whisked tea on dark wood',
    name: 'Stone-milled in Uji',
    body: 'Tencha is held whole in nitrogen and milled to order, 40 g an hour, so the matcha you open is never older than a fortnight.',
  },
  {
    src: u('1563911892437-1feda0179e1b', 900),
    alt: 'Glass jars of loose tea seen from above',
    name: 'The bonded store',
    body: 'Fourteen degrees, forty per cent humidity, no light. Each tin carries its lot, its garden and the day it was fired.',
  },
];

const brews = [
  { id: 'sencha', name: 'Sencha', temp: 70, grams: 5, secs: 60, inf: 3, note: 'Cool water keeps the sweetness in front of the bitterness. Second infusion: 10 seconds.' },
  { id: 'darjeeling', name: 'First flush', temp: 85, grams: 2.5, secs: 180, inf: 2, note: 'Under-leaf it rather than over-steep it. The muscat note goes flat above 90 °C.' },
  { id: 'oolong', name: 'Dong Ding', temp: 95, grams: 7, secs: 45, inf: 6, note: 'Rinse once, then short infusions. The roast opens up on the third.' },
  { id: 'matcha', name: 'Matcha', temp: 75, grams: 2, secs: 20, inf: 1, note: '2 g, 60 ml, whisked in a fast W until the foam is fine and tight.' },
  { id: 'dianhong', name: 'Dian Hong', temp: 95, grams: 3, secs: 150, inf: 3, note: 'Forgiving and malty. Takes milk well, though it rarely needs it.' },
];

const steps = [
  ['01', 'Garden', 'We buy one plot, one picking. The farmer signs the lot sheet with us.'],
  ['02', 'Firing', 'Final firing at origin; we seal in foil under nitrogen the same day.'],
  ['03', 'Landing', 'Air or reefer to Rotterdam, then 72 hours resting before the second cupping.'],
  ['04', 'Your counter', 'Wholesale tins from 1 kg, retail from 50 g. Lot sheet in every box.'],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Leafhold — Single-estate tea importers</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <BackPill />
    <main class="container-lines page">
      <!-- NAV -->
      <header class="band">
        <div class="content-container corner-squares nav">
          <span class="corner top-left"></span><span class="corner top-right"></span>
          <a href="#top" class="logo" aria-label="Leafhold home"><span class="logo-mark" aria-hidden="true"></span>Leafhold</a>
          <nav aria-label="Primary">
            <a href="#arrivals">Arrivals</a>
            <a href="#gardens">Gardens</a>
            <a href="#brewing">Brewing</a>
            <a href="#wholesale">Wholesale</a>
          </nav>
          <div class="nav-cta">
            <a href="#wholesale" class="link-quiet">Trade login</a>
            <a href="#wholesale" class="btn btn-ink">Request samples</a>
          </div>
        </div>
      </header>

      <!-- MEASURE -->
      <div class="band band-thin" aria-hidden="true">
        <div class="content-container corner-squares measure">
          <span class="corner top-left"></span><span class="corner top-right"></span>
          <span class="measure-line"></span>
          <span class="measure-label mono">container <b data-measure>1120</b> px · autumn catalogue 2026</span>
        </div>
      </div>

      <!-- HERO -->
      <section id="top" class="band">
        <div class="content-container corner-squares hero">
          <span class="corner top-left"></span><span class="corner top-right"></span>
          <div class="hero-copy">
            <p class="eyebrow mono"><span class="dot"></span>Single-estate tea importers · Rotterdam · since 2011</p>
            <h1>Tea, measured from the garden to the cup.</h1>
            <p class="lede">Leafhold buys one picking from one plot, seals it at the farm, and lands it in Rotterdam inside three weeks. Every tin tells you exactly where, when and how high.</p>
            <div class="hero-actions">
              <a href="#arrivals" class="btn btn-ink">See autumn arrivals</a>
              <a href="#brewing" class="btn btn-line">Brewing parameters</a>
            </div>
          </div>
          <figure class="hero-figure">
            <img src={u('1558160074-4d7d8bdf4256', 1600)} alt="A clay teapot and a glass of amber tea on a wooden tray in soft daylight" fetchpriority="high" />
            <figcaption class="readout mono">
              <dl>
                {readout.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
              </dl>
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- STATS -->
      <section class="band" aria-label="Leafhold in numbers">
        <div class="content-container corner-squares stats">
          <span class="corner top-left"></span><span class="corner top-right"></span>
          {stats.map(([n, l]) => (
            <div class="stat"><p class="stat-n">{n}</p><p class="stat-l">{l}</p></div>
          ))}
        </div>
      </section>

      <!-- ARRIVALS -->
      <section id="arrivals" class="band">
        <div class="content-container corner-squares section">
          <span class="corner top-left"></span><span class="corner top-right"></span>
          <div class="section-head">
            <p class="eyebrow mono">02 — Autumn arrivals</p>
            <h2>Six lots landed this season. When they are gone, they are gone.</h2>
          </div>
          <div class="table-wrap">
            <table class="lots">
              <thead class="mono">
                <tr><th>Lot</th><th>Tea</th><th>Origin</th><th class="opt">Elevation</th><th class="opt">Picked</th><th class="opt">Process</th><th class="num">100 g</th></tr>
              </thead>
              <tbody>
                {lots.map(([lot, tea, origin, el, picked, proc, price]) => (
                  <tr>
                    <td class="mono lot">{lot}</td>
                    <td class="tea">{tea}</td>
                    <td>{origin}</td>
                    <td class="opt mono">{el}</td>
                    <td class="opt mono">{picked}</td>
                    <td class="opt">{proc}</td>
                    <td class="num mono">{price}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- GARDENS -->
      <section id="gardens" class="band">
        <div class="content-container corner-squares section">
          <span class="corner top-left"></span><span class="corner top-right"></span>
          <div class="section-head split">
            <p class="eyebrow mono">03 — How a lot is kept</p>
            <h2>Freshness is a logistics problem. We treat it like one.</h2>
          </div>
          <div class="gardens">
            {gardens.map((g) => (
              <article class="garden">
                <img src={g.src} alt={g.alt} loading="lazy" />
                <h3>{g.name}</h3>
                <p>{g.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- BREWING (dark band, same line positions) -->
      <section id="brewing" class="band dark container-lines">
        <div class="content-container corner-squares section">
          <span class="corner top-left"></span><span class="corner top-right"></span>
          <div class="section-head split">
            <p class="eyebrow mono">04 — Brewing parameters</p>
            <h2>The lot sheet ends with numbers, not adjectives.</h2>
          </div>
          <div class="brew">
            <div class="brew-tabs" role="tablist" aria-label="Choose a tea">
              {brews.map((b, i) => (
                <button type="button" role="tab" class="brew-tab" id={`tab-${b.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-brew={JSON.stringify(b)}>
                  <span class="mono">0{i + 1}</span>{b.name}
                </button>
              ))}
            </div>
            <div class="brew-panel" role="tabpanel" aria-live="polite" aria-labelledby="tab-sencha">
              <div class="brew-cell"><p class="mono">Water</p><p class="brew-n"><span data-k="temp">70</span><small>°C</small></p></div>
              <div class="brew-cell"><p class="mono">Leaf / 100 ml</p><p class="brew-n"><span data-k="grams">5</span><small>g</small></p></div>
              <div class="brew-cell"><p class="mono">First steep</p><p class="brew-n"><span data-k="secs">60</span><small>s</small></p></div>
              <div class="brew-cell"><p class="mono">Infusions</p><p class="brew-n"><span data-k="inf">3</span><small>×</small></p></div>
              <div class="brew-bar" aria-hidden="true"><span data-bar></span></div>
              <p class="brew-note" data-k="note">Cool water keeps the sweetness in front of the bitterness. Second infusion: 10 seconds.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- PROCESS -->
      <section class="band">
        <div class="content-container corner-squares section">
          <span class="corner top-left"></span><span class="corner top-right"></span>
          <div class="section-head split">
            <p class="eyebrow mono">05 — Route</p>
            <h2>Four stops, one sheet of paper following the leaf.</h2>
          </div>
          <ol class="steps">
            {steps.map(([n, t, d]) => (
              <li><span class="mono step-n">{n}</span><h3>{t}</h3><p>{d}</p></li>
            ))}
          </ol>
        </div>
      </section>

      <!-- WHOLESALE -->
      <section id="wholesale" class="band">
        <div class="content-container corner-squares cta">
          <span class="corner top-left"></span><span class="corner top-right"></span>
          <img src={u('1564890369478-c89ca6d9cde9', 1400)} alt="A white teapot and a cup of tea on a dark wooden table" loading="lazy" />
          <div class="cta-copy">
            <p class="eyebrow mono">06 — Trade</p>
            <h2>Samples leave Rotterdam every Tuesday.</h2>
            <p>For cafés, restaurants and shops: six 10 g sample tins of the current lots, lot sheets included. Free for trade accounts in the EU and UK.</p>
            <a href="mailto:trade@leafhold.example" class="btn btn-ink">trade@leafhold.example</a>
          </div>
        </div>
      </section>

      <!-- FOOTER -->
      <footer class="band">
        <div class="content-container corner-squares footer">
          <span class="corner top-left"></span><span class="corner top-right"></span>
          <span class="corner bottom-left"></span><span class="corner bottom-right"></span>
          <div class="footer-cols">
            <div><p class="mono">Warehouse</p><p>Maasboulevard 140<br />3011 TX Rotterdam</p></div>
            <div><p class="mono">Open</p><p>Tue–Sat, 09:00–17:00<br />Cupping Fridays at 15:00</p></div>
            <div><p class="mono">Elsewhere</p><p><a href="#top">Lot archive</a><br /><a href="#top">Journal</a></p></div>
          </div>
          <p class="wordmark" aria-hidden="true">Leafhold</p>
          <p class="legal mono">© 2026 Leafhold B.V. — a fictional importer, for demonstration.</p>
        </div>
      </footer>
    </main>

    <script>
      // Measured width readout: the number under the nav is the real container width.
      const label = document.querySelector<HTMLElement>('[data-measure]');
      const box = label?.closest<HTMLElement>('.content-container');
      if (label && box) {
        const ro = new ResizeObserver(() => (label.textContent = String(Math.round(box.getBoundingClientRect().width))));
        ro.observe(box);
      }

      // Brewing tabs (roving tabindex, arrow keys).
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('.brew-tab')];
      const panel = document.querySelector<HTMLElement>('.brew-panel');
      const bar = document.querySelector<HTMLElement>('[data-bar]');
      const select = (tab: HTMLButtonElement, focus = false) => {
        const b = JSON.parse(tab.dataset.brew ?? '{}');
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
        });
        panel?.setAttribute('aria-labelledby', tab.id);
        panel?.querySelectorAll<HTMLElement>('[data-k]').forEach((el) => (el.textContent = String(b[el.dataset.k!])));
        if (bar) bar.style.transform = `scaleX(${Math.min(b.secs / 180, 1)})`;
        if (focus) tab.focus();
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(t));
        t.addEventListener('keydown', (e) => {
          const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
          if (!d) return;
          e.preventDefault();
          select(tabs[(i + d + tabs.length) % tabs.length], true);
        });
      });
      if (tabs[0]) select(tabs[0]);
    </script>

    <style is:global>
      :root {
        --container-max: 1120px;
        --container-pad: clamp(20px, 4vw, 48px);
        --line-color: rgba(24, 24, 27, 0.14);
        --line-strong: rgba(24, 24, 27, 0.28);
        --corner-size: 6px;
        --inset: clamp(16px, 2.2vw, 28px);
        --paper: #f2f0e9;
        --paper-2: #e9e6dc;
        --ink: #18181b;
        --muted: #66655d;
        --leaf: #56643a;
        --sans: 'Geist', ui-sans-serif, system-ui, sans-serif;
        --mono: 'Geist Mono', ui-monospace, monospace;
      }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
        overflow-x: clip;
      }
      a { color: inherit; }
      .mono { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.04em; text-transform: uppercase; }

      /* ---- The line system (from the skill, verbatim positions) ---- */
      .container-lines { position: relative; isolation: isolate; }
      .container-lines::before,
      .container-lines::after {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        z-index: -1;
        width: 1px;
        background: var(--line-color);
        pointer-events: none;
        transform-origin: top;
        animation: draw 1.4s cubic-bezier(0.65, 0, 0.35, 1) both;
      }
      /* 100% instead of 100vw so a classic scrollbar never shifts the guides off the content edge. */
      .container-lines::before { left: max(var(--container-pad), calc((100% - var(--container-max)) / 2)); }
      .container-lines::after { right: max(var(--container-pad), calc((100% - var(--container-max)) / 2)); }

      .content-container { width: min(100% - (var(--container-pad) * 2), var(--container-max)); margin-inline: auto; }

      .corner-squares { position: relative; }
      .corner-squares > .corner {
        position: absolute;
        width: var(--corner-size);
        height: var(--corner-size);
        background: var(--line-strong);
        pointer-events: none;
        z-index: 2;
        animation: pop 0.5s ease-out 0.9s both;
      }
      .corner.top-left { top: 0; left: 0; transform: translate(-50%, -50%); }
      .corner.top-right { top: 0; right: 0; transform: translate(50%, -50%); }
      .corner.bottom-left { bottom: 0; left: 0; transform: translate(-50%, 50%); }
      .corner.bottom-right { right: 0; bottom: 0; transform: translate(50%, 50%); }

      /* Each band opens with one full-bleed hairline; the squares mark where it crosses the guides. */
      .band { border-top: 1px solid var(--line-color); }
      .page > .band:first-child { border-top: 0; }
      .page > .band:first-child .corner { display: none; }
      .page { padding-bottom: 40px; }
      footer.band { border-bottom: 1px solid var(--line-color); }

      @keyframes draw { from { transform: scaleY(0); } to { transform: scaleY(1); } }
      @keyframes pop { from { opacity: 0; scale: 0.2; } to { opacity: 1; scale: 1; } }
      @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
      @keyframes measure { from { transform: scaleX(0); } to { transform: scaleX(1); } }

      /* ---- Nav ---- */
      .nav { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 68px; padding-inline: var(--inset); box-sizing: border-box; }
      .logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 17px; letter-spacing: -0.02em; text-decoration: none; }
      .logo-mark { width: 14px; height: 14px; background: var(--leaf); border-radius: 0 50% 0 50%; }
      nav { display: flex; gap: 28px; font-size: 14px; }
      nav a, .link-quiet { text-decoration: none; color: var(--muted); transition: color 0.2s; }
      nav a:hover, .link-quiet:hover { color: var(--ink); }
      .nav-cta { display: flex; align-items: center; gap: 20px; font-size: 14px; }
      .btn {
        display: inline-flex; align-items: center; justify-content: center; height: 40px; padding: 0 18px;
        font: 500 14px/1 var(--sans); text-decoration: none; border-radius: 2px; transition: background 0.2s, color 0.2s, border-color 0.2s;
      }
      .btn-ink { background: var(--ink); color: var(--paper); }
      .btn-ink:hover { background: var(--leaf); }
      .btn-line { border: 1px solid var(--line-strong); }
      .btn-line:hover { border-color: var(--ink); }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--leaf); outline-offset: 3px; }

      /* ---- Measure strip ---- */
      .band-thin { height: 30px; }
      .measure { height: 30px; display: flex; align-items: center; justify-content: center; }
      .measure-line { position: absolute; inset: 50% 0 auto; height: 1px; background: var(--line-color); transform-origin: center; animation: measure 1.2s cubic-bezier(0.65, 0, 0.35, 1) 0.6s both; }
      .measure-line::before, .measure-line::after { content: ''; position: absolute; top: -4px; width: 1px; height: 9px; background: var(--line-strong); }
      .measure-line::before { left: 0; }
      .measure-line::after { right: 0; }
      .measure-label { position: relative; background: var(--paper); padding: 0 12px; color: var(--muted); font-size: 10.5px; white-space: nowrap; }
      .measure-label b { color: var(--ink); font-weight: 500; }

      /* ---- Hero ---- */
      .hero { display: grid; grid-template-columns: 1fr 1fr; min-height: min(620px, calc(100svh - 250px)); }
      .hero-copy { padding: clamp(36px, 5vw, 64px) var(--inset) clamp(36px, 4vw, 48px); display: flex; flex-direction: column; animation: rise 0.9s ease-out 0.3s both; }
      .eyebrow { display: flex; align-items: center; gap: 10px; color: var(--muted); margin: 0 0 28px; }
      .dot { width: 6px; height: 6px; background: var(--leaf); }
      h1 { font-size: clamp(44px, 5.6vw, 80px); line-height: 0.98; letter-spacing: -0.045em; font-weight: 500; margin: 0; max-width: 11ch; text-wrap: balance; }
      .lede { color: var(--muted); font-size: clamp(16px, 1.25vw, 18px); line-height: 1.55; max-width: 44ch; margin: 28px 0 0; }
      .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: auto; padding-top: 32px; }
      .hero-figure { position: relative; margin: 0; border-left: 1px solid var(--line-color); overflow: hidden; }
      .hero-figure img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 62% 60%; filter: saturate(0.85) contrast(1.02); }
      .readout { position: absolute; left: 0; right: 0; bottom: 0; background: rgba(242, 240, 233, 0.9); backdrop-filter: blur(10px); border-top: 1px solid var(--line-color); }
      .readout dl { display: grid; grid-template-columns: repeat(5, 1fr); margin: 0; }
      .readout div { padding: 12px 14px; border-left: 1px solid var(--line-color); }
      .readout div:first-child { border-left: 0; }
      .readout dt { color: var(--muted); font-size: 9.5px; margin-bottom: 4px; }
      .readout dd { white-space: nowrap; margin: 0; text-transform: none; letter-spacing: 0; font-size: 12px; color: var(--ink); }

      /* ---- Stats ---- */
      .stats { display: grid; grid-template-columns: repeat(4, 1fr); }
      .stat { padding: 26px var(--inset) 28px; border-left: 1px solid var(--line-color); }
      .stat:first-of-type { border-left: 0; }
      .stat-n { font-size: clamp(30px, 3vw, 40px); letter-spacing: -0.04em; font-weight: 500; margin: 0 0 6px; }
      .stat-l { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.45; max-width: 24ch; }

      /* ---- Sections ---- */
      .section { padding: clamp(56px, 8vw, 104px) 0; }
      .section-head { padding: 0 var(--inset); margin-bottom: clamp(32px, 4vw, 56px); }
      .section-head.split { display: grid; grid-template-columns: repeat(3, 1fr); padding: 0; align-items: start; }
      .section-head.split > * { padding-inline: var(--inset); }
      .section-head.split h2 { grid-column: span 2; }
      .section-head .eyebrow { margin-bottom: 18px; }
      h2 { font-size: clamp(28px, 3.4vw, 46px); line-height: 1.05; letter-spacing: -0.035em; font-weight: 500; margin: 0; max-width: 22ch; text-wrap: balance; }
      h3 { font-size: 18px; font-weight: 500; letter-spacing: -0.02em; margin: 0 0 8px; }

      .table-wrap { border-top: 1px solid var(--line-color); }
      .lots { width: 100%; border-collapse: collapse; font-size: 15px; }
      .lots th { text-align: left; font-weight: 400; color: var(--muted); font-size: 10.5px; padding: 14px var(--inset); }
      .lots td { padding: 18px var(--inset); border-top: 1px solid var(--line-color); }
      .lots tbody tr { transition: background 0.2s; }
      .lots tbody tr:hover { background: var(--paper-2); }
      .lots .lot { color: var(--leaf); white-space: nowrap; }
      .lots .tea { font-weight: 500; }
      .lots .num { text-align: right; }
      .lots td.mono { text-transform: none; font-size: 13px; }

      .gardens { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line-color); }
      .garden { padding: var(--inset); border-left: 1px solid var(--line-color); }
      .garden:first-child { border-left: 0; }
      .garden img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; margin-bottom: 20px; filter: saturate(0.85); }
      .garden p { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.55; }

      /* ---- Dark band: same guides, lighter ink ---- */
      .dark {
        --line-color: rgba(242, 240, 233, 0.13);
        --line-strong: rgba(242, 240, 233, 0.34);
        background: #1d1e19;
        color: var(--paper);
        border-top-color: rgba(24, 24, 27, 0.14);
      }
      .dark .eyebrow, .dark .brew-cell .mono { color: rgba(242, 240, 233, 0.55); }
      .brew { border-top: 1px solid var(--line-color); }
      .brew-tabs { display: flex; flex-wrap: wrap; border-bottom: 1px solid var(--line-color); }
      .brew-tab {
        flex: 1 1 0; min-width: 120px; display: flex; flex-direction: column; gap: 6px; align-items: flex-start;
        padding: 18px var(--inset); background: none; border: 0; border-left: 1px solid var(--line-color);
        color: rgba(242, 240, 233, 0.6); font: 500 16px/1.1 var(--sans); cursor: pointer; text-align: left; transition: color 0.2s, background 0.2s;
      }
      .brew-tab:first-child { border-left: 0; }
      .brew-tab:hover { color: var(--paper); }
      .brew-tab[aria-selected='true'] { color: var(--paper); background: rgba(242, 240, 233, 0.06); box-shadow: inset 0 -2px 0 #a9b97a; }
      .brew-tab .mono { font-size: 10px; opacity: 0.6; }
      .brew-panel { display: grid; grid-template-columns: repeat(4, 1fr); }
      .brew-cell { padding: 28px var(--inset) 24px; border-left: 1px solid var(--line-color); }
      .brew-cell:first-child { border-left: 0; }
      .brew-cell .mono { margin: 0 0 14px; }
      .brew-n { margin: 0; font-size: clamp(44px, 6vw, 88px); line-height: 0.9; letter-spacing: -0.05em; font-weight: 400; font-variant-numeric: tabular-nums; }
      .brew-n small { font-size: 0.32em; letter-spacing: 0; margin-left: 4px; color: rgba(242, 240, 233, 0.55); }
      .brew-bar { grid-column: 1 / -1; height: 1px; background: var(--line-color); position: relative; }
      .brew-bar span { position: absolute; inset: 0; background: #a9b97a; transform-origin: left; transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1); }
      .brew-note { grid-column: 1 / -1; margin: 0; padding: 22px var(--inset) 0; color: rgba(242, 240, 233, 0.7); font-size: 16px; line-height: 1.5; max-width: 60ch; }

      .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line-color); }
      .steps li { padding: 24px var(--inset) 8px; border-left: 1px solid var(--line-color); }
      .steps li:first-child { border-left: 0; }
      .step-n { display: block; color: var(--leaf); margin-bottom: 40px; }
      .steps p { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.55; }

      .cta { display: grid; grid-template-columns: 1fr 1fr; }
      .cta img { width: 100%; height: 100%; min-height: 380px; object-fit: cover; display: block; filter: saturate(0.85); }
      .cta-copy { padding: clamp(40px, 5vw, 72px) var(--inset); border-left: 1px solid var(--line-color); display: flex; flex-direction: column; gap: 22px; align-items: flex-start; justify-content: center; }
      .cta-copy .eyebrow { margin: 0; }
      .cta-copy p:not(.eyebrow) { margin: 0; color: var(--muted); line-height: 1.55; max-width: 44ch; }

      .footer { padding: 48px 0 28px; }
      .footer-cols { display: grid; grid-template-columns: repeat(3, 1fr); padding: 0 var(--inset); gap: 24px; font-size: 14px; line-height: 1.6; }
      .footer-cols .mono { color: var(--muted); margin: 0 0 8px; }
      .footer-cols p { margin: 0; }
      .wordmark { font-size: clamp(64px, 17.4vw, 248px); letter-spacing: -0.065em; font-weight: 500; line-height: 0.8; margin: 56px 0 0; text-align: center; color: var(--ink); overflow: hidden; }
      .legal { color: var(--muted); padding: 24px var(--inset) 0; margin: 0; font-size: 10.5px; }

      @media (max-width: 960px) {
        nav { display: none; }
        .hero { grid-template-columns: 1fr; min-height: 0; }
        .hero-figure { border-left: 0; border-top: 1px solid var(--line-color); aspect-ratio: 4 / 3; }
        .readout dl { grid-template-columns: repeat(3, 1fr); }
        .readout div:nth-child(n + 4) { display: none; }
        .stats { grid-template-columns: repeat(2, 1fr); }
        .stat:nth-of-type(3) { border-left: 0; }
        .stat:nth-of-type(n + 3) { border-top: 1px solid var(--line-color); }
        .section-head.split { grid-template-columns: 1fr; }
        .section-head.split h2 { grid-column: auto; }
        .gardens, .steps { grid-template-columns: 1fr; }
        .garden, .steps li { border-left: 0; border-top: 1px solid var(--line-color); }
        .garden:first-child, .steps li:first-child { border-top: 0; }
        .step-n { margin-bottom: 16px; }
        .steps li { padding-bottom: 24px; }
        .brew-panel { grid-template-columns: repeat(2, 1fr); }
        .brew-cell:nth-child(3) { border-left: 0; }
        .brew-cell:nth-child(n + 3) { border-top: 1px solid var(--line-color); }
        .cta { grid-template-columns: 1fr; }
        .cta img { min-height: 0; aspect-ratio: 16 / 10; }
        .cta-copy { border-left: 0; border-top: 1px solid var(--line-color); }
        .footer-cols { grid-template-columns: 1fr 1fr; }
        .lots .opt { display: none; }
      }
      @media (max-width: 560px) {
        .link-quiet { display: none; }
        .nav .btn { height: 36px; padding: 0 14px; font-size: 13px; }
        .measure-label span, .measure-label { font-size: 9.5px; }
        .lots { font-size: 14px; }
        .lots thead th:nth-child(3), .lots td:nth-child(3) { display: none; }
        .brew-tab { min-width: 33%; padding-block: 14px; font-size: 14px; }
        .brew-tab:nth-child(4) { border-left: 0; }
        .brew-tabs .brew-tab:nth-child(n + 4) { border-top: 1px solid var(--line-color); }
        .footer-cols { grid-template-columns: 1fr; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition: none !important; }
        html { scroll-behavior: auto; }
      }
    </style>
  </body>
</html>
