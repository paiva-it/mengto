---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

// Rack illustration: 5 tiers × 9 plants. Height/rotation jitter is fixed so SSR and replays match.
const tiers = [
  { id: 'T05', crop: 'Pea shoots' },
  { id: 'T04', crop: 'Butterhead' },
  { id: 'T03', crop: 'Genovese basil' },
  { id: 'T02', crop: 'Butterhead' },
  { id: 'T01', crop: 'Red mustard' },
];
const plant = (t: number, p: number) => ({
  s: 0.72 + (((t * 7 + p * 13) % 9) / 9) * 0.34,
  r: (((t * 5 + p * 11) % 7) - 3) * 3,
});

const beats = [
  { n: '01', label: 'Rack', t: '0 – 900 ms', note: 'Hero visual first' },
  { n: '02', label: 'Headline', t: '500 – 1150 ms', note: '3 lines, 70 ms stagger' },
  { n: '03', label: 'Readout', t: '1000 – 1500 ms', note: 'Numbers settle' },
  { n: '04', label: 'Action', t: '1350 – 1750 ms', note: 'CTA arrives last' },
];

const durations = [
  { name: 'micro', ms: 160, use: 'Hover, press, focus' },
  { name: 'state', ms: 220, use: 'Toggle, select, tab' },
  { name: 'pop', ms: 280, use: 'Toast, popover' },
  { name: 'section', ms: 600, use: 'Scroll entrances' },
  { name: 'hero', ms: 1400, use: 'Timeline, four beats' },
];

const curves = [
  { name: 'out', v: [0.22, 1, 0.36, 1], use: 'Default for anything entering. Quick start, long soft settle.' },
  { name: 'emphasis', v: [0.16, 1, 0.3, 1], use: 'Hero beats and the tab indicator. A touch more decisive.' },
  { name: 'in', v: [0.55, 0, 0.75, 0.06], use: 'Exits only, and 30 % shorter than the matching entrance.' },
];
const curvePath = ([a, b, c, d]: number[]) =>
  `M0,100 C${a * 100},${100 - b * 100} ${c * 100},${100 - d * 100} 100,0`;

const crops = [
  { key: 'basil', label: 'Basil', tier: 'Tier 03', day: 14, cycle: 21, ppfd: 285, harvest: 'Thu 06:40', yield: '41 kg', path: 'M0,58 C20,56 30,50 45,44 C60,38 72,26 88,20 L120,12' },
  { key: 'butterhead', label: 'Butterhead', tier: 'Tier 02 + 04', day: 23, cycle: 32, ppfd: 240, harvest: 'Sat 05:15', yield: '118 heads', path: 'M0,60 C18,58 34,54 50,46 C66,38 80,34 96,24 L120,18' },
  { key: 'pea', label: 'Pea shoots', tier: 'Tier 05', day: 8, cycle: 11, ppfd: 310, harvest: 'Tomorrow 07:00', yield: '19 kg', path: 'M0,62 C14,54 28,40 44,30 C60,20 80,14 100,10 L120,8' },
];

const rules = [
  { n: '01', title: 'Hero, then words, then the button', body: 'The rack lights before the headline moves; the call to action lands last. Motion sets the reading order before anyone reads.' },
  { n: '02', title: 'Reveal once, at a quarter in view', body: 'Sections enter when 25 % of them is on screen, rise 16 px over 600 ms and never replay on a small scroll back.' },
  { n: '03', title: 'Hover lifts 4 px, never more', body: 'Cards rise and the shadow deepens in 160 ms. The glow is the grow light, not a decoration bolted on.' },
  { n: '04', title: 'Everything settles and stops', body: 'No idle loops. When a timeline finishes, nothing on the page is asking the GPU for frames.' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tiergarden OS — Motion spec</title>
    <meta name="description" content="The motion system behind Tiergarden's vertical-farm grow console: tokens, choreography, and reduced motion." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <BackPill />

    <header class="nav wrap">
      <a class="brand" href="#top" aria-label="Tiergarden home">
        <span class="mark" aria-hidden="true"><i></i><i></i><i></i></span>
        Tiergarden
      </a>
      <nav aria-label="Sections">
        <a href="#spec">Spec</a>
        <a href="#console">Console</a>
        <a href="#rules">Choreography</a>
        <a href="#access">Access</a>
      </nav>
      <span class="ver mono">Motion v2.3</span>
    </header>

    <main id="top">
      <!-- HERO -->
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow mono" data-beat="headline">Tiergarden OS · grow console</p>
          <h1 id="hero-title">
            <span class="line" data-beat="headline">Every tier</span>
            <span class="line" data-beat="headline">wakes in</span>
            <span class="line accent" data-beat="headline">its own order.</span>
          </h1>
          <p class="lede" data-beat="headline">
            Fourteen racks of basil, butterhead and pea shoots under a former tram depot in Leipzig. The console that
            runs them moves by one rule: light first, then words, then the thing you can press.
          </p>
          <div class="cta-row" data-beat="cta">
            <a class="btn primary" href="#console">Open the grow console</a>
            <a class="btn ghost" href="#spec">Read the motion spec</a>
          </div>
        </div>

        <div class="rack-wrap">
          <div class="rack" role="img" aria-label="Five grow tiers switching on from bottom to top while seedlings rise under magenta LED light">
            {tiers.map((t, ti) => (
              <div class="tier" data-tier={4 - ti}>
                <div class="led"><span class="cone"></span></div>
                <div class="tray">
                  {Array.from({ length: 9 }, (_, p) => {
                    const { s, r } = plant(ti, p);
                    return (
                      <span class="plant" style={`--s:${s.toFixed(2)};--r:${r}deg`}>
                        <i></i><i></i><b></b>
                      </span>
                    );
                  })}
                </div>
                <span class="tier-id mono">{t.id}</span>
              </div>
            ))}
          </div>
          <div class="chip chip-a mono" data-beat="readout">
            <span class="dot"></span>PPFD <strong data-count="285">285</strong> µmol/m²/s
          </div>
          <div class="chip chip-b mono" data-beat="readout">
            Next harvest · T03 basil · <strong>Thu 06:40</strong>
          </div>
          <div class="chip chip-c mono" data-beat="readout">
            Water reuse <strong data-count="96">96</strong>%
          </div>
        </div>

        <div class="timeline" aria-label="Hero timeline">
          <ol class="beats">
            {beats.map((b, i) => (
              <li class="beat" data-i={i}>
                <span class="beat-bar"><span class="beat-fill"></span></span>
                <span class="beat-head mono"><span>{b.n}</span> {b.label}</span>
                <span class="beat-meta mono">{b.t}</span>
                <span class="beat-note">{b.note}</span>
              </li>
            ))}
          </ol>
          <button class="btn replay" id="replay" type="button">
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M4 10a6 6 0 1 0 1.8-4.3M4 3.5v3h3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Replay sequence
          </button>
          <p class="sr-only" aria-live="polite" id="tl-status"></p>
        </div>
      </section>

      <!-- SPEC -->
      <section id="spec" class="section wrap">
        <div class="sec-head" data-reveal>
          <p class="eyebrow mono">01 · Tokens</p>
          <h2>Five durations. Three curves.<br />One stagger.</h2>
          <p class="sec-lede">Every moving thing in the console borrows from this table. If a new screen needs a value that isn't here, the screen is wrong, not the table.</p>
        </div>

        <div class="spec-grid">
          <div class="panel durations" data-reveal>
            <div class="panel-head">
              <h3>Duration</h3>
              <button class="btn small" type="button" id="run-durations">Run all</button>
            </div>
            <ul>
              {durations.map((d) => (
                <li class="dur" style={`--ms:${d.ms}ms`}>
                  <span class="mono dur-name">--dur-{d.name}</span>
                  <span class="dur-track"><span class="dur-fill"></span></span>
                  <span class="mono dur-ms">{d.ms} ms</span>
                  <span class="dur-use">{d.use}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="curves">
            {curves.map((c) => (
              <button class="panel curve" type="button" data-reveal style={`--e:cubic-bezier(${c.v.join(',')})`} aria-label={`Run the ${c.name} easing curve`}>
                <span class="curve-top">
                  <span class="mono curve-name">--ease-{c.name}</span>
                  <span class="mono curve-play">Run ▸</span>
                </span>
                <svg viewBox="-4 -4 108 108" class="curve-svg" aria-hidden="true">
                  <path d="M0,100 L100,0" class="diag" />
                  <path d={curvePath(c.v)} class="cv" />
                </svg>
                <span class="curve-lane" aria-hidden="true"><span class="puck"></span></span>
                <span class="mono curve-val">cubic-bezier({c.v.join(', ')})</span>
                <span class="curve-use">{c.use}</span>
              </button>
            ))}
          </div>

          <div class="panel offsets" data-reveal>
            <h3>Offset</h3>
            <div class="offs">
              {[8, 16, 24].map((o) => (
                <div class="off">
                  <span class="off-box" style={`--o:${o}px`}><span></span></span>
                  <span class="mono">{o} px</span>
                </div>
              ))}
            </div>
            <p class="small-note">8 for micro shifts, 16 for cards and copy, 24 for hero lines.</p>
          </div>

          <div class="panel stagger" data-reveal>
            <div class="panel-head">
              <h3>Stagger</h3>
              <button class="btn small" type="button" id="run-stagger">Run</button>
            </div>
            <div class="stag-row" aria-hidden="true">
              {Array.from({ length: 8 }, (_, i) => <span style={`--i:${i}`}></span>)}
            </div>
            <p class="small-note"><span class="mono">60 ms</span> per item on desktop, <span class="mono">40 ms</span> under 640 px. Capped at eight items; the ninth arrives with the eighth.</p>
          </div>
        </div>
      </section>

      <!-- CONSOLE -->
      <section id="console" class="section wrap">
        <div class="sec-head" data-reveal>
          <p class="eyebrow mono">02 · In the product</p>
          <h2>The console, at working speed.</h2>
          <p class="sec-lede">Tabs morph, toggles confirm, toasts pop and leave faster than they came. Try it — every interaction below uses a token from the table above.</p>
        </div>

        <div class="console panel" data-reveal>
          <div class="console-top">
            <div class="tabs" role="tablist" aria-label="Crop">
              <span class="tab-ind" aria-hidden="true"></span>
              {crops.map((c, i) => (
                <button class="tab" role="tab" id={`tab-${c.key}`} aria-controls={`pane-${c.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} type="button">{c.label}</button>
              ))}
            </div>
            <label class="switch-row">
              <span>Night cycle</span>
              <button class="switch" role="switch" aria-checked="false" type="button" id="night" aria-label="Night cycle"><span></span></button>
            </label>
          </div>

          {crops.map((c, i) => (
            <div class="pane" role="tabpanel" id={`pane-${c.key}`} aria-labelledby={`tab-${c.key}`} hidden={i !== 0}>
              <div class="stats">
                <div class="stat"><span class="k">Location</span><span class="v">{c.tier}</span></div>
                <div class="stat"><span class="k">Cycle</span><span class="v">Day {c.day} <em>/ {c.cycle}</em></span></div>
                <div class="stat"><span class="k">Light</span><span class="v">{c.ppfd} <em>µmol</em></span></div>
                <div class="stat"><span class="k">Projected</span><span class="v">{c.yield}</span></div>
              </div>
              <div class="pane-foot">
                <svg viewBox="0 0 120 70" class="spark" preserveAspectRatio="none" aria-hidden="true">
                  <path d={c.path} />
                </svg>
                <div class="harvest">
                  <span class="k">Harvest window</span>
                  <span class="v">{c.harvest}</span>
                  <button class="btn primary book" type="button" data-crop={c.label} data-when={c.harvest}>Schedule harvest</button>
                </div>
              </div>
            </div>
          ))}
          <div class="night-wash" aria-hidden="true"></div>
        </div>

        <div class="cards">
          {[
            { k: 'Tier health', v: '14 / 14', d: 'All racks within 0.4 °C of setpoint.' },
            { k: 'Light hours today', v: '16 h 20 m', d: 'Shifted 40 min later for the tariff dip.' },
            { k: 'Nutrient dose', v: 'EC 1.8', d: 'Basil loop topped up at 04:12.' },
          ].map((c) => (
            <article class="card" data-reveal tabindex="0">
              <span class="k">{c.k}</span>
              <span class="v">{c.v}</span>
              <span class="d">{c.d}</span>
            </article>
          ))}
        </div>
      </section>

      <!-- RULES -->
      <section id="rules" class="section wrap">
        <div class="sec-head" data-reveal>
          <p class="eyebrow mono">03 · Choreography</p>
          <h2>Four rules the whole team can quote.</h2>
        </div>
        <ol class="rules">
          {rules.map((r) => (
            <li class="rule" data-reveal>
              <span class="mono rule-n">{r.n}</span>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- ACCESS -->
      <section id="access" class="section wrap">
        <div class="access panel" data-reveal>
          <div>
            <p class="eyebrow mono">04 · Reduced motion</p>
            <h2>A mode, not an afterthought.</h2>
            <p class="sec-lede">With <span class="mono">prefers-reduced-motion</span> set, every entrance becomes an instant state with a 120 ms opacity fade. Content is never hidden behind an animation that won't run. Try it on this page:</p>
            <div class="switch-row big">
              <span id="rm-label">Preview reduced motion</span>
              <button class="switch" role="switch" aria-checked="false" aria-labelledby="rm-label" type="button" id="rm"><span></span></button>
            </div>
          </div>
          <ul class="perf">
            <li><strong>Only transform and opacity.</strong> The tab indicator is measured once per change, then moved with translate and scale.</li>
            <li><strong>No layout reads in a frame.</strong> Scroll entrances use one IntersectionObserver and unobserve after firing.</li>
            <li><strong>No idle work.</strong> The hero timeline ends at 1.75 s and the page goes quiet.</li>
            <li><strong>Blur stays small.</strong> The grow-light cones are gradients, not filters.</li>
          </ul>
        </div>
      </section>
    </main>

    <footer class="foot wrap">
      <div data-reveal>
        <h2>Come and see the racks wake up.</h2>
        <p>Depot tours on Saturday mornings, Leipzig-Plagwitz. 14 tiers, no pesticides, 38 kitchens within 6 km.</p>
      </div>
      <a class="btn primary" href="#top" data-reveal>Book a depot tour</a>
      <p class="mono fine">Tiergarden is a fictional farm. Motion spec v2.3 — Oct 2026.</p>
    </footer>

    <div class="toast" id="toast" role="status" aria-live="polite" hidden>
      <span class="toast-dot"></span><span id="toast-text"></span>
    </div>

    <style is:global>
      :root {
        --paper: #f2f3ee;
        --surface: #ffffff;
        --ink: #0c0f0e;
        --muted: #5a615e;
        --line: #dcdfd7;
        --grow: #e0368c;
        --violet: #8b5cf6;
        --leaf: #74c96c;
        --night: #0e0f14;

        /* Motion tokens */
        --dur-micro: 160ms;
        --dur-state: 220ms;
        --dur-pop: 280ms;
        --dur-section: 600ms;
        --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
        --ease-emph: cubic-bezier(0.16, 1, 0.3, 1);
        --ease-in: cubic-bezier(0.55, 0, 0.75, 0.06);
        --off-1: 8px;
        --off-2: 16px;
        --off-3: 24px;
        --stagger: 60ms;
      }
      @media (max-width: 640px) { :root { --stagger: 40ms; } }

      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: 'Geist', ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      .mono { font-family: 'Geist Mono', ui-monospace, monospace; }
      .wrap { width: 100%; max-width: 1320px; margin: 0 auto; padding: 0 40px; box-sizing: border-box; }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      :focus-visible { outline: 2px solid var(--grow); outline-offset: 3px; border-radius: 8px; }

      /* NAV */
      .nav { display: flex; align-items: center; justify-content: space-between; height: 72px; border-bottom: 1px solid var(--line); }
      .brand { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 17px; letter-spacing: -0.02em; color: var(--ink); text-decoration: none; }
      .mark { display: grid; gap: 3px; }
      .mark i { display: block; width: 18px; height: 3px; border-radius: 2px; background: var(--ink); }
      .mark i:first-child { background: var(--grow); }
      .nav nav { display: flex; gap: 28px; }
      .nav nav a { color: var(--muted); text-decoration: none; font-size: 14px; transition: color var(--dur-micro) var(--ease-out); }
      .nav nav a:hover { color: var(--ink); }
      .ver { font-size: 12px; color: var(--muted); padding: 6px 10px; border: 1px solid var(--line); border-radius: 999px; }

      /* BUTTONS */
      .btn {
        display: inline-flex; align-items: center; gap: 8px; height: 46px; padding: 0 20px; border-radius: 999px;
        font: 500 15px/1 'Geist', sans-serif; letter-spacing: -0.01em; text-decoration: none; cursor: pointer;
        border: 1px solid var(--line); background: var(--surface); color: var(--ink);
        transition: transform var(--dur-micro) var(--ease-out), box-shadow var(--dur-micro) var(--ease-out), background-color var(--dur-micro) var(--ease-out);
      }
      .btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px -10px rgb(12 15 14 / 0.35); }
      .btn:active { transform: translateY(0) scale(0.98); transition-duration: 90ms; }
      .btn.primary { background: var(--ink); color: #fff; border-color: var(--ink); }
      .btn.primary:hover { box-shadow: 0 10px 28px -10px rgb(224 54 140 / 0.65); }
      .btn.ghost { background: transparent; }
      .btn.small { height: 32px; padding: 0 14px; font-size: 13px; }

      /* HERO */
      .hero {
        display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 48px 56px;
        padding-top: 52px; padding-bottom: 40px; align-items: center;
      }
      .eyebrow { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin: 0 0 22px; }
      h1 { margin: 0; font-weight: 600; font-size: clamp(52px, 6.6vw, 100px); line-height: 0.94; letter-spacing: -0.055em; }
      h1 .line { display: block; padding-bottom: 0.04em; }
      .accent {
        background: linear-gradient(92deg, var(--grow) 10%, var(--violet) 95%);
        -webkit-background-clip: text; background-clip: text; color: transparent;
      }
      .lede { max-width: 480px; margin: 28px 0 0; font-size: 17px; line-height: 1.55; color: var(--muted); }
      .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }

      .rack-wrap { position: relative; }
      .rack {
        position: relative; display: grid; gap: 14px; padding: 30px 28px 24px; border-radius: 22px;
        background:
          radial-gradient(120% 70% at 50% 0%, rgb(139 92 246 / 0.18), transparent 60%),
          linear-gradient(180deg, #14151c, var(--night));
        box-shadow: 0 40px 80px -40px rgb(14 15 20 / 0.55), inset 0 0 0 1px rgb(255 255 255 / 0.06);
        overflow: hidden;
      }
      .tier { position: relative; height: 74px; border-bottom: 1px solid rgb(255 255 255 / 0.09); }
      .led {
        position: absolute; left: 0; right: 40px; top: 0; height: 4px; border-radius: 4px;
        background: linear-gradient(90deg, #ff4fa3, #b468ff 50%, #ff4fa3);
        box-shadow: 0 0 14px 1px rgb(255 79 163 / 0.7);
        transform-origin: left center;
      }
      .cone {
        position: absolute; left: 0; right: 0; top: 4px; height: 66px; pointer-events: none;
        background: linear-gradient(180deg, rgb(255 79 163 / 0.26), rgb(180 104 255 / 0.08) 60%, transparent);
      }
      .tray { position: absolute; left: 0; right: 40px; bottom: 0; height: 40px; display: flex; justify-content: space-between; align-items: flex-end; padding: 0 6px; }
      .tray::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 5px; border-radius: 2px; background: #2a2c35; }
      .plant { position: relative; width: 26px; height: 34px; scale: var(--s); rotate: var(--r); transform-origin: 50% 100%; }
      .plant i { position: absolute; bottom: 10px; width: 14px; height: 22px; border-radius: 100% 0; background: linear-gradient(160deg, #a5e39b, var(--leaf) 55%, #3f8d48); }
      .plant i:first-child { left: -1px; transform: rotate(-38deg); transform-origin: 100% 100%; }
      .plant i:nth-child(2) { right: -1px; transform: rotate(38deg) scaleX(-1); transform-origin: 0 100%; }
      .plant b { position: absolute; left: 12px; bottom: 4px; width: 2px; height: 12px; background: #4c9b4f; border-radius: 1px; }
      .tier-id { position: absolute; right: 0; top: 50%; transform: translateY(-50%); font-size: 11px; color: rgb(255 255 255 / 0.45); }

      .chip {
        position: absolute; display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 12px;
        font-size: 12px; color: var(--ink); background: rgb(255 255 255 / 0.92); backdrop-filter: blur(6px);
        box-shadow: 0 14px 30px -14px rgb(12 15 14 / 0.45), inset 0 0 0 1px rgb(12 15 14 / 0.06); white-space: nowrap;
      }
      .chip strong { font-weight: 500; }
      .chip .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--grow); box-shadow: 0 0 0 4px rgb(224 54 140 / 0.18); }
      .chip-a { top: -16px; left: -22px; }
      .chip-b { bottom: 150px; right: -18px; }
      .chip-c { bottom: -16px; left: 36px; }

      .timeline { grid-column: 1 / -1; display: flex; align-items: flex-end; gap: 28px; padding-top: 28px; border-top: 1px solid var(--line); }
      .beats { flex: 1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; list-style: none; margin: 0; padding: 0; }
      .beat { display: grid; gap: 6px; }
      .beat-bar { display: block; height: 3px; border-radius: 3px; background: var(--line); overflow: hidden; margin-bottom: 6px; }
      .beat-fill { display: block; height: 100%; background: var(--ink); transform: scaleX(0); transform-origin: left; }
      .beat.on .beat-fill { background: linear-gradient(90deg, var(--grow), var(--violet)); }
      .beat-head { font-size: 13px; font-weight: 500; }
      .beat-head span { color: var(--grow); }
      .beat-meta { font-size: 11px; color: var(--muted); }
      .beat-note { font-size: 13px; color: var(--muted); }
      .replay { flex: none; }
      .replay svg { transition: transform var(--dur-state) var(--ease-out); }
      .replay:hover svg { transform: rotate(-90deg); }

      /* JS-enabled initial hero states (GSAP takes over) */
      .js [data-beat], .js .plant, .js .led, .js .cone { opacity: 0; }

      /* SECTIONS */
      .section { padding-top: 120px; }
      .sec-head { max-width: 760px; margin-bottom: 44px; }
      h2 { margin: 0; font-weight: 600; font-size: clamp(34px, 4.2vw, 56px); line-height: 1.02; letter-spacing: -0.045em; }
      .sec-lede { margin: 18px 0 0; font-size: 17px; line-height: 1.55; color: var(--muted); max-width: 600px; }
      .panel { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 26px; box-sizing: border-box; }
      h3 { margin: 0; font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
      .panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }

      .spec-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; }
      .durations { grid-column: span 7; }
      .durations ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
      .dur { display: grid; grid-template-columns: 130px minmax(0, 1fr) 70px; grid-template-areas: 'n t m' 'u u u'; column-gap: 16px; row-gap: 2px; padding: 12px 0; border-top: 1px solid var(--line); align-items: center; }
      .dur-name { grid-area: n; font-size: 13px; }
      .dur-track { grid-area: t; position: relative; height: 8px; border-radius: 8px; background: #eceee8; overflow: hidden; }
      .dur-fill { position: absolute; inset: 0; border-radius: 8px; background: linear-gradient(90deg, var(--grow), var(--violet)); transform: scaleX(0); transform-origin: left; }
      .dur.run .dur-fill { transform: scaleX(1); transition: transform var(--ms) var(--ease-out); }
      .dur-ms { grid-area: m; text-align: right; font-size: 13px; }
      .dur-use { grid-area: u; font-size: 13px; color: var(--muted); }

      .curves { grid-column: span 5; display: grid; gap: 16px; }
      .curve {
        display: grid; grid-template-columns: 92px minmax(0, 1fr); grid-template-areas: 'top top' 'svg lane' 'svg val' 'use use';
        gap: 8px 18px; text-align: left; font: inherit; color: inherit; cursor: pointer; padding: 20px;
        transition: transform var(--dur-micro) var(--ease-out), box-shadow var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out);
      }
      .curve:hover { transform: translateY(-3px); border-color: #cfd2c9; box-shadow: 0 18px 36px -24px rgb(224 54 140 / 0.5); }
      .curve-top { grid-area: top; display: flex; justify-content: space-between; font-size: 13px; }
      .curve-play { color: var(--grow); }
      .curve-svg { grid-area: svg; width: 92px; height: 92px; overflow: visible; }
      .curve-svg .diag { stroke: var(--line); stroke-dasharray: 3 4; fill: none; }
      .curve-svg .cv { stroke: var(--ink); stroke-width: 2.4; fill: none; stroke-linecap: round; }
      .curve-lane { grid-area: lane; position: relative; height: 28px; border-radius: 8px; background: #f0f1ec; align-self: end; }
      .puck { position: absolute; left: 4px; top: 4px; width: 20px; height: 20px; border-radius: 6px; background: var(--ink); transition: transform 900ms var(--e); }
      .curve.run .puck { transform: translateX(var(--lane, 200px)); background: var(--grow); }
      .curve-val { grid-area: val; font-size: 11.5px; color: var(--muted); align-self: start; }
      .curve-use { grid-area: use; font-size: 13.5px; line-height: 1.45; color: var(--muted); }

      .offsets { grid-column: span 5; }
      .offs { display: flex; gap: 26px; margin: 20px 0 16px; }
      .off { display: grid; gap: 10px; justify-items: center; font-size: 12px; }
      .off-box { position: relative; width: 56px; height: 56px; border-radius: 12px; border: 1px dashed #c7cbc2; }
      .off-box span { position: absolute; inset: 0; border-radius: 12px; background: var(--ink); transform: translateY(0); transition: transform var(--dur-section) var(--ease-out); }
      .offsets:hover .off-box span, .offsets:focus-within .off-box span { transform: translateY(calc(var(--o) * -1)); }
      .small-note { margin: 0; font-size: 13.5px; line-height: 1.5; color: var(--muted); }
      .stagger { grid-column: span 7; }
      .stag-row { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 8px; height: 64px; margin-bottom: 16px; align-items: end; }
      .stag-row span { display: block; height: 100%; border-radius: 8px; background: linear-gradient(180deg, var(--violet), var(--grow)); transform-origin: bottom; }
      .stag-row.run span { animation: stag var(--dur-section) var(--ease-out) both; animation-delay: calc(var(--i) * var(--stagger)); }
      @keyframes stag { from { opacity: 0; transform: translateY(var(--off-2)) scaleY(0.4); } }

      /* CONSOLE */
      .console { position: relative; overflow: hidden; padding: 0; }
      .console-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 22px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
      .tabs { position: relative; display: flex; padding: 4px; border-radius: 12px; background: #eff0eb; }
      .tab { position: relative; z-index: 1; border: 0; background: none; font: 500 14px/1 'Geist', sans-serif; padding: 10px 16px; border-radius: 9px; cursor: pointer; color: var(--muted); transition: color var(--dur-state) var(--ease-out); }
      .tab[aria-selected='true'] { color: var(--ink); }
      .tab-ind { position: absolute; top: 4px; left: 0; height: calc(100% - 8px); width: 100px; border-radius: 9px; background: var(--surface); box-shadow: 0 2px 8px -2px rgb(12 15 14 / 0.18); transform-origin: left; transition: transform var(--dur-state) var(--ease-emph); }
      .switch-row { display: inline-flex; align-items: center; gap: 12px; font-size: 14px; color: var(--muted); }
      .switch { position: relative; width: 44px; height: 26px; border-radius: 999px; border: 0; padding: 0; background: #d5d8d0; cursor: pointer; transition: background-color var(--dur-state) var(--ease-out); }
      .switch span { position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgb(0 0 0 / 0.25); transition: transform var(--dur-state) var(--ease-out); }
      .switch[aria-checked='true'] { background: var(--grow); }
      .switch[aria-checked='true'] span { transform: translateX(18px); }
      .switch:active span { transform: scale(0.92); }
      .switch[aria-checked='true']:active span { transform: translateX(18px) scale(0.92); }

      .pane { padding: 28px 22px 24px; }
      .pane.enter > * { animation: rise var(--dur-pop) var(--ease-out) both; }
      .pane.enter > *:nth-child(2) { animation-delay: var(--stagger); }
      @keyframes rise { from { opacity: 0; transform: translateY(12px); } }
      .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
      .stat, .harvest { display: grid; gap: 6px; }
      .k { font-size: 12px; color: var(--muted); font-family: 'Geist Mono', monospace; text-transform: uppercase; letter-spacing: 0.06em; }
      .v { font-size: clamp(22px, 2.4vw, 32px); font-weight: 600; letter-spacing: -0.035em; }
      .v em { font-style: normal; color: var(--muted); font-weight: 400; font-size: 0.6em; letter-spacing: 0; }
      .pane-foot { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 24px; margin-top: 28px; align-items: end; }
      .spark { width: 100%; height: 110px; border-radius: 14px; background: linear-gradient(180deg, rgb(224 54 140 / 0.06), transparent); }
      .spark path { fill: none; stroke: var(--grow); stroke-width: 2; vector-effect: non-scaling-stroke; }
      .harvest .btn { margin-top: 10px; justify-content: center; }
      .night-wash { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgb(14 15 20 / 0.04), rgb(70 50 140 / 0.12)); opacity: 0; transition: opacity var(--dur-section) var(--ease-out); }
      .console.night .night-wash { opacity: 1; }

      .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }
      .card {
        display: grid; gap: 8px; padding: 24px; border-radius: 20px; background: var(--surface); border: 1px solid var(--line); outline: none;
        transition: transform var(--dur-micro) var(--ease-out), box-shadow var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out);
      }
      .card:hover, .card:focus-visible { transform: translateY(-4px); border-color: rgb(224 54 140 / 0.35); box-shadow: 0 22px 40px -26px rgb(224 54 140 / 0.6), 0 2px 6px -2px rgb(12 15 14 / 0.08); }
      .card .v { font-size: 30px; }
      .card .d { font-size: 14px; color: var(--muted); line-height: 1.45; }

      /* RULES */
      .rules { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
      .rule { padding: 24px 0 0; border-top: 2px solid var(--ink); }
      .rule-n { font-size: 12px; color: var(--grow); }
      .rule h3 { font-size: 20px; letter-spacing: -0.025em; margin: 14px 0 10px; line-height: 1.15; }
      .rule p { margin: 0; font-size: 14.5px; line-height: 1.55; color: var(--muted); }

      /* ACCESS */
      .access { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 48px; padding: 40px; }
      .switch-row.big { margin-top: 26px; color: var(--ink); font-weight: 500; }
      .perf { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; align-content: start; }
      .perf li { padding: 16px 0; border-top: 1px solid var(--line); font-size: 14.5px; line-height: 1.5; color: var(--muted); }
      .perf strong { color: var(--ink); font-weight: 600; }

      /* FOOTER */
      .foot { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px 40px; align-items: end; padding-top: 140px; padding-bottom: 96px; }
      .foot p { color: var(--muted); font-size: 16px; line-height: 1.5; margin: 14px 0 0; max-width: 520px; }
      .foot .fine { grid-column: 1 / -1; font-size: 12px; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line); max-width: none; }

      /* TOAST */
      .toast {
        position: fixed; right: 24px; bottom: 24px; z-index: 50; display: flex; align-items: center; gap: 10px;
        padding: 14px 18px; border-radius: 14px; background: var(--ink); color: #fff; font-size: 14px;
        box-shadow: 0 20px 40px -18px rgb(12 15 14 / 0.6);
        opacity: 0; transform: translateY(var(--off-1)) scale(0.98);
        transition: opacity 196ms var(--ease-in), transform 196ms var(--ease-in);
      }
      .toast.show { opacity: 1; transform: none; transition: opacity var(--dur-pop) var(--ease-out), transform var(--dur-pop) var(--ease-out); }
      .toast-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--leaf); }

      /* SCROLL REVEAL (only once JS is up, so content is never trapped hidden) */
      .js [data-reveal] { opacity: 0; transform: translateY(var(--off-2)); }
      .js [data-reveal].in {
        opacity: 1; transform: none;
        transition: opacity var(--dur-section) var(--ease-out), transform var(--dur-section) var(--ease-out);
        transition-delay: calc(var(--n, 0) * var(--stagger));
      }
      .js .card[data-reveal].in { transition-property: opacity, transform, box-shadow, border-color; }
      .js .card[data-reveal].in:hover { transition-delay: 0ms; transition-duration: var(--dur-micro); }
      .js .curve[data-reveal].in:hover { transition-delay: 0ms; transition-duration: var(--dur-micro); }

      /* REDUCED MOTION: real preference or the page toggle */
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation-duration: 1ms !important; animation-delay: 0ms !important; transition-duration: 120ms !important; transition-delay: 0ms !important; transition-property: opacity, background-color, color !important; }
        .js [data-reveal] { transform: none; }
      }
      .rm *, .rm *::before, .rm *::after { animation-duration: 1ms !important; animation-delay: 0ms !important; transition-duration: 120ms !important; transition-delay: 0ms !important; transition-property: opacity, background-color, color !important; }
      .rm .js [data-reveal], .js.rm [data-reveal] { transform: none; }

      /* RESPONSIVE */
      @media (max-width: 1080px) {
        .durations, .curves, .offsets, .stagger { grid-column: 1 / -1; }
        .curves { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .curve { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'top' 'svg' 'lane' 'val' 'use'; }
        .rules { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 16px; }
      }
      @media (max-width: 900px) {
        .hero { grid-template-columns: minmax(0, 1fr); padding-top: 36px; }
        .rack-wrap { margin: 0 12px; }
        .access { grid-template-columns: minmax(0, 1fr); padding: 28px; }
        .cards { grid-template-columns: minmax(0, 1fr); }
        .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .pane-foot { grid-template-columns: minmax(0, 1fr); }
      }
      @media (max-width: 760px) {
        .nav nav { display: none; }
        .curves { grid-template-columns: minmax(0, 1fr); }
        .curve { grid-template-columns: 80px minmax(0, 1fr); grid-template-areas: 'top top' 'svg lane' 'svg val' 'use use'; }
        .curve-svg { width: 80px; height: 80px; }
      }
      @media (max-width: 640px) {
        .wrap { padding-inline: 16px; }
        .nav { height: 60px; }
        h1 { font-size: clamp(48px, 14vw, 64px); }
        .eyebrow { margin-bottom: 16px; }
        .lede { font-size: 16px; margin-top: 20px; }
        .cta-row { margin-top: 24px; }
        .rack { padding: 22px 16px 18px; gap: 10px; border-radius: 18px; }
        .tier { height: 58px; }
        .tray { height: 32px; right: 30px; padding: 0 2px; }
        .led { right: 30px; }
        .plant { width: 20px; height: 28px; }
        .plant:nth-child(n + 8) { display: none; }
        .chip { font-size: 11px; padding: 8px 10px; }
        .chip-a { left: -8px; top: -14px; }
        .chip-b { right: -8px; bottom: 48px; }
        .chip-c { display: none; }
        .rack-wrap { margin: 0 4px; }
        .timeline { flex-direction: column; align-items: stretch; gap: 20px; }
        .beats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 14px; }
        .replay { justify-content: center; }
        .section { padding-top: 88px; }
        .dur { grid-template-columns: 110px minmax(0, 1fr) 58px; column-gap: 10px; }
        .panel { padding: 20px; }
        .console { padding: 0; }
        .tabs { width: 100%; }
        .tab { flex: 1; padding: 10px 6px; font-size: 13px; }
        .rules { grid-template-columns: minmax(0, 1fr); }
        .foot { grid-template-columns: minmax(0, 1fr); padding-top: 100px; }
        .foot .btn { justify-self: start; }
        .toast { left: 16px; right: 16px; bottom: 16px; }
      }
    </style>

    <script>
      import gsap from 'gsap';
      // Follow the wall clock: a slow first frame must not stretch the hero past its 1.75 s budget.
      gsap.ticker.lagSmoothing(0);

      const root = document.documentElement;
      const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
      const reduced = () => mq.matches || root.classList.contains('rm');
      const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => el.querySelector<T>(s)!;
      const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => [...el.querySelectorAll<T>(s)];

      // Motion tokens mirrored for GSAP (seconds). CSS custom properties hold the same values.
      const T = { out: 'expo.out', emph: 'power3.out', section: 0.6, stagger: innerWidth < 640 ? 0.04 : 0.06 };

      /* ---------- HERO: one timeline, four labelled beats ---------- */
      const tiersBottomUp = $$('.tier').sort((a, b) => +a.dataset.tier! - +b.dataset.tier!);
      const beatEls = $$('.beat');
      const fills = $$('.beat-fill');
      const status = $('#tl-status');
      const counters = $$('[data-count]');
      const windows: [number, number][] = [[0, 0.9], [0.5, 1.15], [1.0, 1.5], [1.35, 1.75]];

      const build = () => {
        const tl = gsap.timeline({
          paused: true,
          defaults: { ease: T.out },
          onUpdate() {
            const t = this.time();
            windows.forEach(([a, b], i) => {
              const p = gsap.utils.clamp(0, 1, (t - a) / (b - a));
              fills[i].style.transform = `scaleX(${p})`;
              beatEls[i].classList.toggle('on', p > 0 && p < 1);
            });
          },
          onComplete() {
            beatEls.forEach((b) => b.classList.remove('on'));
            status.textContent = 'Sequence complete.';
          },
        });

        tl.addLabel('rack', 0);
        tiersBottomUp.forEach((tier, i) => {
          const at = 'rack+=' + i * 0.11;
          tl.fromTo($('.led', tier), { opacity: 0, scaleX: 0 }, { opacity: 1, scaleX: 1, duration: 0.5 }, at)
            .fromTo($('.cone', tier), { opacity: 0 }, { opacity: 1, duration: 0.5, ease: 'power2.out' }, at + '+=0.12')
            .fromTo($$('.plant', tier), { opacity: 0, y: 8, scale: 0.6 }, {
              opacity: 1, y: 0, scale: 1, duration: 0.42, stagger: 0.02, ease: T.emph,
            }, at + '+=0.14');
        });

        tl.addLabel('headline', 0.5)
          .fromTo('[data-beat="headline"]', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.65, stagger: 0.07, ease: T.emph }, 'headline');

        tl.addLabel('readout', 1.0)
          .fromTo('[data-beat="readout"]', { opacity: 0, y: 8, scale: 0.98 }, { opacity: 1, y: 0, scale: 1, duration: 0.32, stagger: 0.08 }, 'readout');
        counters.forEach((el) => {
          const target = +el.dataset.count!;
          const o = { v: target * 0.7 };
          tl.to(o, { v: target, duration: 0.5, ease: 'power2.out', onUpdate: () => (el.textContent = String(Math.round(o.v))) }, 'readout');
        });

        tl.addLabel('cta', 1.35)
          .fromTo('[data-beat="cta"]', { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.4 }, 'cta');
        return tl;
      };

      const hero = build();
      const play = () => {
        status.textContent = '';
        if (reduced()) {
          // Instant end state with a soft fade — no travel, no scrub.
          hero.progress(1).pause();
          gsap.fromTo('.hero-copy, .rack-wrap', { opacity: 0.4 }, { opacity: 1, duration: 0.12 });
          status.textContent = 'Sequence shown without motion.';
          return;
        }
        hero.restart();
      };
      // Small delay so the first frame paints before the hero starts.
      gsap.delayedCall(0.15, play);
      $('#replay').addEventListener('click', play);

      /* ---------- SCROLL REVEAL: once, at 25 % visible ---------- */
      const groups = new Map<Element, number>();
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add('in');
            io.unobserve(e.target);
          });
        },
        { threshold: 0.25 },
      );
      $$('[data-reveal]').forEach((el) => {
        const parent = el.parentElement!;
        const n = groups.get(parent) ?? 0;
        groups.set(parent, n + 1);
        el.style.setProperty('--n', String(Math.min(n, 7)));
        io.observe(el);
      });

      /* ---------- TOKENS: duration bars, easing pucks, stagger ---------- */
      const rerun = (el: Element) => {
        el.classList.remove('run');
        void (el as HTMLElement).offsetWidth; // restart CSS transition
        el.classList.add('run');
      };
      $('#run-durations').addEventListener('click', () => $$('.dur').forEach(rerun));
      $('#run-stagger').addEventListener('click', () => rerun($('.stag-row')));
      $$<HTMLButtonElement>('.curve').forEach((btn) => {
        btn.addEventListener('click', () => {
          const lane = $('.curve-lane', btn);
          btn.style.setProperty('--lane', `${lane.clientWidth - 28}px`);
          if (btn.classList.contains('run')) btn.classList.remove('run');
          else rerun(btn);
        });
      });
      // Demo the tokens once when they scroll into view.
      new IntersectionObserver((entries, obs) => {
        if (!entries[0].isIntersecting) return;
        obs.disconnect();
        $$('.dur').forEach(rerun);
        rerun($('.stag-row'));
      }, { threshold: 0.4 }).observe($('.durations'));

      /* ---------- CONSOLE: morphing tab indicator, panes, switch, toast ---------- */
      const tabs = $$<HTMLButtonElement>('.tab');
      const ind = $('.tab-ind');
      const moveInd = (tab: HTMLElement) => {
        // Measured once per change; moved with transform only.
        ind.style.width = '100px';
        ind.style.transform = `translateX(${tab.offsetLeft}px) scaleX(${tab.offsetWidth / 100})`;
      };
      const select = (tab: HTMLButtonElement) => {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          const pane = $(`#${t.getAttribute('aria-controls')}`);
          pane.hidden = !on;
          if (on) rerunPane(pane);
        });
        moveInd(tab);
      };
      const rerunPane = (pane: HTMLElement) => {
        pane.classList.remove('enter');
        void pane.offsetWidth;
        pane.classList.add('enter');
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(t));
        t.addEventListener('keydown', (e) => {
          const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!d) return;
          e.preventDefault();
          const next = tabs[(i + d + tabs.length) % tabs.length];
          next.focus();
          select(next);
        });
      });
      // Position without a transition on first paint and after resize.
      const snap = () => {
        ind.style.transition = 'none';
        moveInd(tabs.find((t) => t.getAttribute('aria-selected') === 'true')!);
        void ind.offsetWidth;
        ind.style.transition = '';
      };
      document.fonts.ready.then(snap);
      snap();
      window.addEventListener('resize', snap);

      const toggle = (btn: HTMLElement, fn: (on: boolean) => void) =>
        btn.addEventListener('click', () => {
          const on = btn.getAttribute('aria-checked') !== 'true';
          btn.setAttribute('aria-checked', String(on));
          fn(on);
        });
      toggle($('#night'), (on) => $('.console').classList.toggle('night', on));
      toggle($('#rm'), (on) => {
        root.classList.toggle('rm', on);
        play();
      });

      const toast = $('#toast');
      const toastText = $('#toast-text');
      let hideTimer = 0;
      $$('.book').forEach((b) =>
        b.addEventListener('click', () => {
          toastText.textContent = `${b.dataset.crop} harvest booked · ${b.dataset.when}`;
          toast.hidden = false;
          toast.classList.remove('show');
          void toast.offsetWidth;
          toast.classList.add('show');
          clearTimeout(hideTimer);
          hideTimer = window.setTimeout(() => {
            toast.classList.remove('show');
            window.setTimeout(() => (toast.hidden = true), 220);
          }, 2600);
        }),
      );
    </script>
  </body>
</html>
