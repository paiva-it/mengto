---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

type P = [number, number];
type Model = {
  id: string;
  name: string;
  use: string;
  sheet: string;
  stack: number;
  reach: number;
  hta: string;
  sta: string;
  tyre: string;
  pts: { r: P; bb: P; f: P; st: P; ht: P; hb: P };
  tyreW: number;
  fenders?: boolean;
  bar: 'drop' | 'flare' | 'swept';
};

const models: Model[] = [
  {
    id: 'ronde', name: 'Ronde', use: 'Road', sheet: '0417', stack: 578, reach: 389, hta: '72.5°', sta: '73.5°', tyre: '30 mm',
    pts: { r: [98, 214], bb: [206, 228], f: [398, 214], st: [186, 94], ht: [340, 98], hb: [354, 150] }, tyreW: 6, bar: 'drop',
  },
  {
    id: 'kasseien', name: 'Kasseien', use: 'Gravel', sheet: '0422', stack: 601, reach: 382, hta: '71.0°', sta: '73.0°', tyre: '45 mm',
    pts: { r: [92, 212], bb: [204, 232], f: [404, 212], st: [184, 102], ht: [336, 104], hb: [352, 160] }, tyreW: 10, bar: 'flare',
  },
  {
    id: 'avond', name: 'Avond', use: 'Randonneur', sheet: '0426', stack: 612, reach: 374, hta: '72.0°', sta: '73.0°', tyre: '38 mm',
    pts: { r: [96, 214], bb: [204, 230], f: [400, 214], st: [182, 90], ht: [332, 86], hb: [348, 144] }, tyreW: 8, fenders: true, bar: 'swept',
  },
];

const WR = 88;
const j = (p: P) => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`;
const draw = (m: Model) => {
  const { r, bb, f, st, ht, hb } = m.pts;
  const len = Math.hypot(st[0] - bb[0], st[1] - bb[1]);
  const dir: P = [(st[0] - bb[0]) / len, (st[1] - bb[1]) / len];
  const sp: P = [st[0] + dir[0] * 30, st[1] + dir[1] * 30];
  const hl = Math.hypot(ht[0] - hb[0], ht[1] - hb[1]);
  const hd: P = [(ht[0] - hb[0]) / hl, (ht[1] - hb[1]) / hl];
  const steer: P = [ht[0] + hd[0] * 12, ht[1] + hd[1] * 12];
  const stemEnd: P = [steer[0] + 30, steer[1] - 4];
  const bars = {
    drop: `M ${j(stemEnd)} q 20 0 20 18 q 0 22 -18 28`,
    flare: `M ${j(stemEnd)} q 22 0 22 20 q 2 22 -14 30`,
    swept: `M ${j(stemEnd)} q 10 -2 4 -10 q -10 -6 -26 -4`,
  }[m.bar];
  const fender = (c: P) => `M ${c[0] - 96} ${c[1] + 6} A 97 97 0 0 1 ${c[0] + 92} ${c[1] - 30}`;
  return {
    frame: `M ${j(bb)} L ${j(st)} L ${j(ht)} L ${j(hb)} Z M ${j(st)} L ${j(r)} L ${j(bb)}`,
    fork: `M ${j(hb)} Q ${hb[0] - hd[0] * 46} ${hb[1] - hd[1] * 46} ${j(f)}`, // ponytail: one quadratic stands in for blade rake
    cockpit: `M ${j(st)} L ${j(sp)} M ${sp[0] - 22} ${sp[1] - 1} L ${sp[0] + 16} ${sp[1] + 1} M ${j(ht)} L ${j(steer)} L ${j(stemEnd)} ${bars}`,
    fenders: m.fenders ? `${fender(r)} ${fender(f)}` : '',
    r, f, bb, ht,
  };
};

const steps = [
  ['01', 'Fit', 'Two hours on the jig bike with a tape, a plumb line and a pot of coffee. We measure how you ride, not just how tall you are.', 'Week 1'],
  ['02', 'Drawing', 'A 1:1 drawing of your frame, every angle and tube wall written down. You sign it before a single tube is cut.', 'Week 2'],
  ['03', 'Brazing', 'Silver-brazed lugs where a lug fits, fillet brass where it does not. Around 38 hours at the bench, one frame at a time.', 'Weeks 3–11'],
  ['04', 'Paint & first ride', 'Wet paint in our own booth, then a build with your parts and a first 40 km loop out to the Leie and back with us.', 'Weeks 12–14'],
];

const u = (id: string, w = 900) => `https://images.unsplash.com/photo-${id}?w=${w}&q=72&auto=format&fit=crop`;
const lineup = [
  {
    name: 'Ronde', kind: 'Road', img: u('1485965120184-e220f721d03e'), alt: 'A white lugged steel road bike with orange decals and brown saddle against a dark wall',
    body: 'Low, quick and quiet. Built for the cobbled climbs south of Oudenaarde and the long flat way home.',
    specs: [['Tyre', '≤ 32 mm'], ['Weight', '1.82 kg'], ['From', '€3,450']],
  },
  {
    name: 'Kasseien', kind: 'Gravel', img: u('1511994298241-608e28f14fde'), alt: 'A loaded bikepacking gravel bike at sunset above a valley',
    body: 'Long front centre, room for 50 mm tyres and three bottles. Stable when the road gives up halfway.',
    specs: [['Tyre', '≤ 50 mm'], ['Weight', '2.04 kg'], ['From', '€3,780']],
  },
  {
    name: 'Avond', kind: 'Randonneur', img: u('1507035895480-2b3156c31fc8'), alt: 'A periwinkle blue steel bike with orange tyres leaning on a white brick wall',
    body: 'Eyelets for fenders, a dynamo light and a front rack that belongs to the frame. For 200 km brevets and Tuesday groceries.',
    specs: [['Tyre', '≤ 42 mm'], ['Weight', '2.21 kg'], ['From', '€3,920']],
  },
];

const stats = [
  ['41', 'frames brazed in 2025, each one by the same two pairs of hands'],
  ['14', 'weeks from fitting to first ride, quoted before you pay a deposit'],
  ['0', 'stock sizes. No S, M or L; every drawing starts blank'],
  ['9 yr', 'average age of a Lugwork frame still on the road today'],
];

const slots = [
  ['06 Nov', 'Thu · 09:30', false],
  ['13 Nov', 'Thu · 09:30', true],
  ['20 Nov', 'Thu · 14:00', false],
  ['04 Dec', 'Thu · 09:30', false],
] as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lugwork — Steel frames built around the rider</title>
    <meta name="description" content="Lugwork is a two-person steel bicycle frame workshop in Ghent. Custom road, gravel and randonneur frames, fitted, drawn and brazed one at a time." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="frame">
      <!-- Band 1: nav + hero -->
      <header class="band band--top">
        <span class="mk mk--tl" aria-hidden="true"></span><span class="mk mk--tr" aria-hidden="true"></span>
        <nav class="nav" aria-label="Primary">
          <a class="logo" href="#top" aria-label="Lugwork home">
            <svg viewBox="0 0 28 28" aria-hidden="true"><circle cx="14" cy="14" r="12" /><path d="M7 18 L14 8 L21 18 Z" /></svg>
            <span>Lugwork</span>
          </a>
          <ul class="nav__links">
            <li><a href="#process">Process</a></li>
            <li><a href="#frames">Frames</a></li>
            <li><a href="#riders">Riders</a></li>
          </ul>
          <a class="btn btn--white btn--sm" href="#fitting">Book a fitting</a>
        </nav>
      </header>

      <section class="band" id="top" aria-labelledby="hero-title">
        <div class="l2 hero">
          <div class="hero__bloom" aria-hidden="true"></div>
          <div class="hero__dots" aria-hidden="true"></div>
          <span class="tag tag--light">01 / Workshop · Ghent</span>

          <div class="hero__copy">
            <p class="eyebrow eyebrow--light">Steel frames, brazed one at a time since 2011</p>
            <h1 id="hero-title">Built around the rider, <em>not the size chart.</em></h1>
            <p class="hero__lede">
              Lugwork is two framebuilders and one brazing hearth on the Coupure. We fit you, draw you a frame, and build exactly that frame — nothing off a shelf, nothing rounded to the nearest size.
            </p>
            <div class="hero__cta">
              <a class="btn btn--white" href="#fitting">Book a fitting</a>
              <a class="btn btn--ghost" href="#process">How a frame is made</a>
            </div>
            <p class="hero__meta"><span class="dot" aria-hidden="true"></span> Next open fitting: Thursday 06 November · 3 of 41 slots left for 2026</p>
          </div>

          <!-- Level 3: the build sheet sits inset inside the hero frame -->
          <div class="l3 sheet">
            <div class="sheet__head">
              <span class="mono">Build sheet</span>
              <span class="pill"><span class="pill__dot" aria-hidden="true"></span>On the jig</span>
            </div>
            <div class="tabs" role="tablist" aria-label="Frame model">
              {models.map((m, i) => (
                <button
                  role="tab"
                  id={`tab-${m.id}`}
                  aria-controls={`panel-${m.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                >
                  {m.name}<span>{m.use}</span>
                </button>
              ))}
            </div>
            {models.map((m, i) => {
              const d = draw(m);
              return (
                <div class="sheet__panel" role="tabpanel" id={`panel-${m.id}`} aria-labelledby={`tab-${m.id}`} hidden={i !== 0}>
                  <svg class="geo" viewBox="0 0 540 316" role="img" aria-label={`${m.name} geometry drawing: stack ${m.stack} millimetres, reach ${m.reach} millimetres`}>
                    <g class="geo__grid">
                      {Array.from({ length: 11 }, (_, k) => <line x1={k * 54} y1="0" x2={k * 54} y2="316" />)}
                      {Array.from({ length: 6 }, (_, k) => <line x1="0" y1={k * 63.2} x2="540" y2={k * 63.2} />)}
                    </g>
                    <g class="geo__wheel">
                      <circle cx={d.r[0]} cy={d.r[1]} r={WR} />
                      <circle cx={d.r[0]} cy={d.r[1]} r={WR - m.tyreW} />
                      <circle cx={d.f[0]} cy={d.f[1]} r={WR} />
                      <circle cx={d.f[0]} cy={d.f[1]} r={WR - m.tyreW} />
                    </g>
                    {d.fenders && <path class="geo__fender" d={d.fenders} />}
                    <circle class="geo__ring" cx={d.bb[0]} cy={d.bb[1]} r="19" />
                    <path class="geo__dim" d={`M ${d.bb[0]} ${d.ht[1] - 28} H ${d.ht[0]} M ${d.bb[0]} ${d.ht[1] - 34} v 12 M ${d.ht[0]} ${d.ht[1] - 34} v 12`} />
                    <path class="geo__dim" d={`M ${d.ht[0]} ${d.ht[1]} H 520 M ${d.bb[0]} ${d.bb[1]} H 520 M 512 ${d.ht[1]} V ${d.bb[1]}`} />
                    <text class="geo__label" x={(d.bb[0] + d.ht[0]) / 2} y={d.ht[1] - 36} text-anchor="middle">reach {m.reach}</text>
                    <text class="geo__label" x="504" y={(d.ht[1] + d.bb[1]) / 2} text-anchor="middle" transform={`rotate(-90 504 ${(d.ht[1] + d.bb[1]) / 2})`}>stack {m.stack}</text>
                    <path class="geo__frame" d={d.frame} pathLength="1" />
                    <path class="geo__fork" d={d.fork} />
                    <path class="geo__cockpit" d={d.cockpit} />
                    <circle class="geo__node" cx={d.bb[0]} cy={d.bb[1]} r="4.5" />
                    <circle class="geo__node" cx={d.ht[0]} cy={d.ht[1]} r="4.5" />
                  </svg>
                  <dl class="readout">
                    <div><dt>Stack</dt><dd>{m.stack}<small>mm</small></dd></div>
                    <div><dt>Reach</dt><dd>{m.reach}<small>mm</small></dd></div>
                    <div><dt>Head</dt><dd>{m.hta}</dd></div>
                    <div><dt>Seat</dt><dd>{m.sta}</dd></div>
                  </dl>
                  <p class="sheet__foot mono">№ {m.sheet} · 8/5/8 butted chromoly · silver-brazed lugs · {m.tyre} clearance</p>
                </div>
              );
            })}
          </div>
        </div>
      </section>

      <!-- Band 2: process -->
      <section class="band" id="process" aria-labelledby="process-title">
        <span class="mk mk--tl" aria-hidden="true"></span><span class="mk mk--tr" aria-hidden="true"></span>
        <div class="l2 l2--paper">
          <span class="tag">02 / Process</span>
          <div class="sec-head rv">
            <h2 id="process-title">Fourteen weeks, <em>four sittings</em>, one frame.</h2>
            <p>Every Lugwork frame goes through the same four stages in the same order. You are in the room for the first and the last; the drawing comes to you in between.</p>
          </div>
          <ol class="steps">
            {steps.map(([n, t, b, w]) => (
              <li class="rv">
                <span class="mono steps__n">{n}</span>
                <h3>{t}</h3>
                <p>{b}</p>
                <span class="mono steps__w">{w}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- Band 3: frames -->
      <section class="band" id="frames" aria-labelledby="frames-title">
        <span class="mk mk--tl" aria-hidden="true"></span><span class="mk mk--tr" aria-hidden="true"></span>
        <div class="frames-head rv">
          <span class="tag">03 / Frames</span>
          <h2 id="frames-title">Three starting points. <em>Every one redrawn.</em></h2>
        </div>
        <div class="lineup">
          {lineup.map((x) => (
            <article class="l2 l2--white model rv">
              <div class="model__img">
                <img src={x.img} alt={x.alt} loading="lazy" width="900" height="640" />
                <span class="model__kind mono">{x.kind}</span>
              </div>
              <div class="model__body">
                <h3>{x.name}</h3>
                <p>{x.body}</p>
                <dl class="model__specs">
                  {x.specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
                </dl>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Band 4: proof -->
      <section class="band" id="riders" aria-labelledby="riders-title">
        <span class="mk mk--tl" aria-hidden="true"></span><span class="mk mk--tr" aria-hidden="true"></span>
        <div class="l2 l2--cobalt proof">
          <span class="tag tag--light">04 / Riders</span>
          <h2 id="riders-title" class="sr-only">What riders say</h2>
          <figure class="proof__quote rv">
            <blockquote>
              “I had ridden a 56 for twenty years because a shop said so. Lugwork drew me a frame with a 612 stack and a 72° head tube, and my lower back has not mentioned it once since.”
            </blockquote>
            <figcaption>
              <span class="avatar" aria-hidden="true">HV</span>
              <span><strong>Hanne Verstraete</strong><br />Avond № 0311 · 31,400 km since 2022</span>
            </figcaption>
          </figure>
          <dl class="stats">
            {stats.map(([n, t]) => <div class="rv"><dt>{n}</dt><dd>{t}</dd></div>)}
          </dl>
        </div>
      </section>

      <!-- Band 5: CTA -->
      <section class="band" id="fitting" aria-labelledby="fitting-title">
        <span class="mk mk--tl" aria-hidden="true"></span><span class="mk mk--tr" aria-hidden="true"></span>
        <div class="l2 hero cta">
          <div class="hero__bloom hero__bloom--cta" aria-hidden="true"></div>
          <div class="hero__dots" aria-hidden="true"></div>
          <span class="tag tag--light">05 / Fitting</span>
          <div class="cta__copy rv">
            <h2 id="fitting-title">Start with two hours <em>on the jig bike.</em></h2>
            <p>The fitting costs €180 and comes off the frame price if you go ahead. Bring the shoes you ride in and the bike you are leaving behind.</p>
            <ul class="cta__list">
              <li>Coupure Links 214, 9000 Gent</li>
              <li>Thursdays only, two riders a day</li>
              <li>Deposit only after you sign the drawing</li>
            </ul>
          </div>
          <form class="l3 slot-form rv" id="slot-form">
            <fieldset>
              <legend class="mono">Choose a fitting slot</legend>
              <div class="slots">
                {slots.map(([d, t, full], i) => (
                  <label class:list={['slot', { 'slot--full': full }]}>
                    <input type="radio" name="slot" value={d} disabled={full} checked={i === 0} />
                    <span class="slot__d">{d}</span>
                    <span class="slot__t">{full ? 'Full' : t}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <label class="field">
              <span>Name</span>
              <input name="name" autocomplete="name" required placeholder="Your name" />
            </label>
            <label class="field">
              <span>E-mail</span>
              <input name="email" type="email" autocomplete="email" required placeholder="you@example.com" />
            </label>
            <button class="btn btn--blue" type="submit">Hold this slot</button>
            <p class="slot-form__msg" role="status" aria-live="polite"></p>
          </form>
        </div>
      </section>

      <footer class="band band--foot">
        <span class="mk mk--tl" aria-hidden="true"></span><span class="mk mk--tr" aria-hidden="true"></span>
        <span class="mk mk--bl" aria-hidden="true"></span><span class="mk mk--br" aria-hidden="true"></span>
        <div class="foot">
          <span class="logo logo--ink">
            <svg viewBox="0 0 28 28" aria-hidden="true"><circle cx="14" cy="14" r="12" /><path d="M7 18 L14 8 L21 18 Z" /></svg>
            <span>Lugwork</span>
          </span>
          <p class="mono">Coupure Links 214 · Gent · Workshop open Thu–Sat</p>
          <p class="mono">© 2026 Lugwork Framebuilders — a fictional workshop</p>
        </div>
      </footer>
    </div>
    <BackPill />
  </body>
</html>

<style>
  :root {
    --page: #e9eef9;
    --paper: #f5f7fd;
    --white: #ffffff;
    --ink: #0f1846;
    --ink-2: #4a5486;
    --line: rgb(36 58 176 / 0.2);
    --line-soft: rgb(36 58 176 / 0.1);
    --blue-1: #7393ea;
    --blue-2: #4566dc;
    --blue-3: #2034ad;
    --cobalt: #18267f;
    --coral: #f3896a;
    --peach: #f7b591;
    --lilac: #a690ee;
    --frame-max: 1320px;
    --inset: clamp(10px, 1.2vw, 18px); /* gap between the outer frame line and every level-2 frame */
    --r2: clamp(20px, 2vw, 30px);
    --r3: clamp(14px, 1.3vw, 20px);
    --pad2: clamp(22px, 4vw, 56px);
    --serif: 'Newsreader', Georgia, serif;
    --sans: 'Inter', ui-sans-serif, system-ui, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
  }
  html { scroll-behavior: smooth; }
  body {
    margin: 0; background: var(--page); color: var(--ink); font-family: var(--sans);
    -webkit-font-smoothing: antialiased; overflow-x: clip;
    background-image: radial-gradient(rgb(36 58 176 / 0.09) 1px, transparent 1.4px);
    background-size: 22px 22px;
  }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .mono { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.04em; text-transform: uppercase; }
  em { font-style: italic; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 400; letter-spacing: -0.015em; margin: 0; }
  h2 em, h1 em { color: inherit; opacity: 0.78; }

  /* ── Level 1: the outer frame. Two hairlines run the full page height. ── */
  .frame { position: relative; max-width: var(--frame-max); margin: 0 auto; }
  .frame::before, .frame::after {
    content: ''; position: absolute; top: 0; bottom: 0; width: 1px; background: var(--line); pointer-events: none; z-index: 2;
  }
  .frame::before { left: 0; }
  .frame::after { right: 0; }
  @media (max-width: 1340px) { .frame { margin: 0 12px; } }

  /* Each band is a row of the outer frame: a seam on top, square markers where seam meets line. */
  .band { position: relative; padding: var(--inset); border-top: 1px solid var(--line-soft); }
  .band--top { border-top: 0; padding-bottom: 0; }
  .mk { position: absolute; width: 7px; height: 7px; background: var(--page); border: 1px solid var(--blue-2); z-index: 3; }
  .mk--tl { top: -4px; left: -4px; } .mk--tr { top: -4px; right: -4px; }
  .mk--bl { bottom: -4px; left: -4px; } .mk--br { bottom: -4px; right: -4px; }
  .band--top .mk { top: 0; }

  /* ── Level 2: inset frames. Own background, border, radius. ── */
  .l2 { position: relative; border-radius: var(--r2); border: 1px solid var(--line-soft); padding: var(--pad2); overflow: hidden; }
  .l2--paper { background: var(--paper); }
  .l2--white { background: var(--white); }
  .l2--cobalt { background: var(--cobalt); color: #e8ecff; border-color: rgb(255 255 255 / 0.08); }

  .tag {
    position: absolute; top: 16px; left: 18px; font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--blue-2); opacity: 0.85;
  }
  .tag--light { color: rgb(255 255 255 / 0.72); }

  /* nav */
  .nav { display: flex; align-items: center; gap: 28px; padding: 14px clamp(6px, 1.4vw, 22px) calc(14px); }
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-family: var(--serif); font-size: 26px; font-style: italic; letter-spacing: -0.02em; }
  .logo svg { width: 26px; height: 26px; fill: none; stroke: var(--blue-2); stroke-width: 1.8; stroke-linejoin: round; }
  .nav__links { display: flex; gap: 26px; list-style: none; margin: 0 0 0 auto; padding: 0; }
  .nav__links a { color: var(--ink-2); text-decoration: none; font-size: 14.5px; font-weight: 500; }
  .nav__links a:hover { color: var(--ink); }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 50px; padding: 0 26px; border-radius: 14px;
    font: 600 15px/1 var(--sans); text-decoration: none; border: 1px solid transparent; cursor: pointer; transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn:focus-visible, .tabs button:focus-visible, .slot input:focus-visible + .slot__d, a:focus-visible { outline: 2px solid var(--coral); outline-offset: 3px; }
  .btn--sm { height: 42px; padding: 0 18px; font-size: 14px; border-radius: 12px; }
  .btn--white { background: var(--white); color: var(--ink); box-shadow: 0 1px 0 rgb(15 24 70 / 0.06), 0 8px 24px -10px rgb(15 24 70 / 0.35); }
  .nav .btn--white { border-color: var(--line-soft); }
  .btn--ghost { color: #fff; border-color: rgb(255 255 255 / 0.4); background: rgb(255 255 255 / 0.06); }
  .btn--ghost:hover { background: rgb(255 255 255 / 0.14); }
  .btn--blue { background: var(--blue-3); color: #fff; width: 100%; }
  .btn--blue:hover { background: var(--cobalt); }

