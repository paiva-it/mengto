---
import '../../styles/global.css';
import '../../components/skills/add-shader-cursor-trail/cursor-trail.css';
import BackPill from '../../components/BackPill.astro';
import CursorTrailGate from '../../components/skills/add-shader-cursor-trail/CursorTrailGate';

// Static first frame for visitors who never get the WebGPU layer (touch, reduced motion, no WebGPU):
// a frozen halftone of the same figure-eight the live trail sweeps, on the graph's own 40-column grid.
const W = 1440;
const H = 900;
const STEP = W / 40;
const curve = Array.from({ length: 240 }, (_, i) => {
  const t = i / 239;
  const w = t * Math.PI * 1.7 - 0.5;
  return { x: W * (0.7 + 0.18 * Math.sin(w)), y: H * (0.4 + 0.17 * Math.sin(2 * w + 0.6)), age: t };
});
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const dots: { x: number; y: number; r: number; o: number }[] = [];
for (let gy = STEP / 2; gy < H; gy += STEP) {
  for (let gx = STEP / 2; gx < W; gx += STEP) {
    let best = 0;
    for (const p of curve) {
      const reach = 70 + 70 * p.age;
      const d = Math.hypot(gx - p.x, gy - p.y);
      if (d < reach) best = Math.max(best, (1 - d / reach) ** 0.7 * (0.12 + 0.88 * p.age ** 1.4));
    }
    const twinkle = 0.45 + 0.55 * rand();
    const r = 11 * best * twinkle;
    if (r > 0.6) dots.push({ x: gx, y: gy, r: +r.toFixed(2), o: +(0.18 + 0.82 * (gx / W + 1 - gy / H) / 2).toFixed(2) });
  }
}
const head = curve[curve.length - 1];

const knobs = [
  { name: 'Density', value: '40', unit: 'cols', body: 'How fine the halftone memory is. Forty columns across the panel, each one a sample-and-hold cell.' },
  { name: 'Twinkle', value: '0.90', unit: '', body: 'Per-cell jitter. At 0.9 no two cells decay alike, so a held voltage shimmers instead of buzzing.' },
  { name: 'Intensity', value: '1.40', unit: '×', body: 'How hard a gesture writes into memory. Above 1 the newest stroke saturates; the tail stays soft.' },
  { name: 'Radius', value: '2.90', unit: 'cm', body: 'The width of the brush. Wide enough that a slow hand smears into neighbouring cells, the way a slew does.' },
  { name: 'Grain', value: '0.10', unit: '', body: 'A whisper of noise on every output, so four channels of the same gesture never phase-lock.' },
];

const specs = [
  ['Width', '12 HP'],
  ['Depth', '28 mm, skiff-friendly'],
  ['Power', '+12 V 38 mA · −12 V 11 mA'],
  ['Outputs', '4 × ±5 V, 16-bit'],
  ['Inputs', 'Gesture, clock, freeze, reset'],
  ['Panel', '2 mm brushed aluminium'],
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Drift-12 — a voltage source with a memory · Ferrous Modular</title>
    <meta name="description" content="Drift-12 is a 12HP Eurorack stochastic voltage source by Ferrous Modular. It records the shape of a gesture into a 40-column halftone memory and lets it decay into four related control voltages." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <section class="cursor-trail-region fx-hero" data-trail-region aria-labelledby="fx-title">
      <svg class="fx-poster" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <g fill="#fff">
          {dots.map((d) => <circle cx={d.x} cy={d.y} r={d.r} fill-opacity={d.o} />)}
        </g>
        <g fill="none" stroke="#fff">
          <circle cx={head.x} cy={head.y} r="46" stroke-opacity="0.22" />
          <circle cx={head.x} cy={head.y} r="92" stroke-opacity="0.1" />
        </g>
      </svg>

      <div class="cursor-trail-layer" aria-hidden="true">
        <CursorTrailGate client:load />
      </div>

      <div class="cursor-trail-content fx-hero-inner">
        <header class="fx-nav">
          <a href="#top" class="fx-logo" aria-label="Ferrous Modular home">
            <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><rect x="1" y="1" width="20" height="20" rx="2" fill="none" stroke="currentColor" stroke-width="1.4" /><circle cx="7" cy="8" r="2" fill="currentColor" /><circle cx="15" cy="8" r="2" fill="currentColor" /><circle cx="11" cy="15" r="2" fill="currentColor" /></svg>
            <span>Ferrous<span class="fx-dim">/modular</span></span>
          </a>
          <nav aria-label="Primary" class="fx-links">
            <a href="#panel">The panel</a>
            <a href="#specs">Specs</a>
            <a href="#batch">Batch 03</a>
          </nav>
          <a href="#batch" class="fx-pill">Reserve · €340</a>
        </header>

        <div class="fx-readout fx-mono" aria-hidden="true">
          <span><i class="fx-led"></i>MEM WRITE</span>
          <span>DENS 40</span><span>TWK 0.90</span><span>INT 1.40</span><span>RAD 2.90</span>
          <span class="fx-readout-hint">Move the cursor to write</span>
        </div>

        <div class="fx-hero-copy" id="top">
          <p class="fx-mono fx-eyebrow">Drift-12 · 12HP stochastic voltage source</p>
          <h1 id="fx-title">Voltage that remembers where your hand has been.</h1>
          <div class="fx-hero-foot">
            <p class="fx-lede">
              Drift-12 records the shape of a gesture into a forty-column halftone memory, then lets it
              decay into four related control voltages. Slow hands make long tides. Quick ones make rain.
            </p>
            <div class="fx-actions">
              <a href="#batch" class="fx-btn">Reserve from batch 03</a>
              <a href="#panel" class="fx-btn fx-btn-ghost">Read the panel</a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <main class="fx-light">
      <section id="panel" class="fx-panel-sec" aria-labelledby="panel-title">
        <figure class="fx-faceplate">
          <svg viewBox="0 0 300 636" role="img" aria-label="Drift-12 front panel: five knobs, three LEDs and eight jacks on a brushed aluminium faceplate">
            <defs>
              <linearGradient id="alu" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#e9e9e6" /><stop offset="0.5" stop-color="#cfcfcb" /><stop offset="1" stop-color="#e2e2de" />
              </linearGradient>
              <pattern id="brush" width="300" height="3" patternUnits="userSpaceOnUse">
                <rect width="300" height="1" fill="#000" fill-opacity="0.035" />
              </pattern>
              <radialGradient id="cap" cx="0.4" cy="0.35" r="0.7">
                <stop offset="0" stop-color="#3a3a3c" /><stop offset="1" stop-color="#0d0d0e" />
              </radialGradient>
            </defs>
            <rect width="300" height="636" rx="3" fill="url(#alu)" />
            <rect width="300" height="636" rx="3" fill="url(#brush)" />
            {[[22, 14], [278, 14], [22, 622], [278, 622]].map(([x, y]) => <ellipse cx={x} cy={y} rx="7" ry="4" fill="#1a1a1b" />)}
            <text x="150" y="52" text-anchor="middle" class="sv-brand">FERROUS</text>
            <text x="150" y="86" text-anchor="middle" class="sv-title">DRIFT-12</text>
            <line x1="40" y1="102" x2="260" y2="102" stroke="#111" stroke-width="1" />

            {[
              { x: 150, y: 178, r: 46, label: 'INTENSITY', a: 40 },
              { x: 82, y: 300, r: 30, label: 'RADIUS', a: 110 },
              { x: 218, y: 300, r: 30, label: 'TWINKLE', a: 75 },
              { x: 82, y: 400, r: 22, label: 'DENSITY', a: -30 },
              { x: 218, y: 400, r: 22, label: 'GRAIN', a: -110 },
            ].map((k) => (
              <g>
                {Array.from({ length: 11 }, (_, i) => {
                  const ang = ((-135 + i * 27) * Math.PI) / 180;
                  return <line x1={k.x + Math.sin(ang) * (k.r + 5)} y1={k.y - Math.cos(ang) * (k.r + 5)} x2={k.x + Math.sin(ang) * (k.r + (i % 5 === 0 ? 12 : 9))} y2={k.y - Math.cos(ang) * (k.r + (i % 5 === 0 ? 12 : 9))} stroke="#111" stroke-width="1.2" />;
                })}
                <circle cx={k.x} cy={k.y} r={k.r} fill="url(#cap)" />
                <circle cx={k.x} cy={k.y} r={k.r * 0.72} fill="none" stroke="#fff" stroke-opacity="0.07" />
                <line x1={k.x} y1={k.y} x2={k.x + Math.sin((k.a * Math.PI) / 180) * k.r * 0.85} y2={k.y - Math.cos((k.a * Math.PI) / 180) * k.r * 0.85} stroke="#f4f4f2" stroke-width="2.4" stroke-linecap="round" />
                <text x={k.x} y={k.y + k.r + 26} text-anchor="middle" class="sv-label">{k.label}</text>
              </g>
            ))}

            {[[110, 'MEM'], [150, 'CLK'], [190, 'FRZ']].map(([x, l], i) => (
              <g>
                <circle cx={x} cy="470" r="4.5" fill={i === 0 ? '#ff3d1f' : '#3b1410'} />
                <text x={x} y="490" text-anchor="middle" class="sv-tiny">{l}</text>
              </g>
            ))}

            <line x1="30" y1="508" x2="270" y2="508" stroke="#111" stroke-opacity="0.5" />
            {[['GEST', 'CLK', 'FRZ', 'RST'], ['A', 'B', 'C', 'D']].map((row, ri) =>
              row.map((l, i) => {
                const x = 60 + i * 60;
                const y = 538 + ri * 62;
                return (
                  <g>
                    {ri === 1 && <rect x={x - 20} y={y - 33} width="40" height="54" rx="5" fill="#141415" />}
                    <circle cx={x} cy={y} r="11" fill="#bdbdb8" stroke="#111" stroke-width="1.5" />
                    <circle cx={x} cy={y} r="5.5" fill="#050505" />
                    <text x={x} y={ri === 0 ? y - 17 : y - 18} text-anchor="middle" class={ri === 1 ? 'sv-tiny sv-out' : 'sv-tiny'}>{l}</text>
                  </g>
                );
              }),
            )}
          </svg>
          <figcaption class="fx-mono">Fig. 1 — Drift-12, 12HP. Outputs are reverse-printed.</figcaption>
        </figure>

        <div class="fx-panel-copy">
          <p class="fx-mono fx-kicker">01 / The panel</p>
          <h2 id="panel-title">Five knobs. One memory. No menus.</h2>
          <p class="fx-body">
            Every control on Drift-12 shapes how a gesture is written and how it fades. Patch an envelope,
            a joystick or a slow LFO into <span class="fx-mono">GEST</span>, and the module draws it into its
            memory field. The four outputs read that field from four different corners, so they move
            together without ever moving the same.
          </p>
          <dl class="fx-knobs">
            {knobs.map((k) => (
              <div class="fx-knob">
                <dt><span class="fx-mono fx-val">{k.value}<small>{k.unit}</small></span><span class="fx-knob-name">{k.name}</span></dt>
                <dd>{k.body}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <section id="specs" class="fx-specs" aria-labelledby="specs-title">
        <div class="fx-specs-head">
          <p class="fx-mono fx-kicker">02 / On the bench</p>
          <h2 id="specs-title">Built like a tool, not a toy.</h2>
        </div>
        <dl class="fx-spec-grid">
          {specs.map(([k, v]) => (
            <div><dt class="fx-mono">{k}</dt><dd>{v}</dd></div>
          ))}
        </dl>
      </section>
    </main>

    <footer id="batch" class="fx-batch" aria-labelledby="batch-title">
      <div class="fx-batch-inner">
        <p class="fx-mono fx-eyebrow">Batch 03 · 140 units · ships February 2027</p>
        <h2 id="batch-title">Hand-assembled in Porto, one tray of twenty at a time.</h2>
        <form class="fx-form" onsubmit="event.preventDefault(); this.querySelector('output').textContent = 'Noted — we will write before the tray is soldered.';">
          <label for="fx-email" class="fx-mono">E-mail for your reservation</label>
          <div class="fx-form-row">
            <input id="fx-email" type="email" required placeholder="you@studio.example" autocomplete="email" />
            <button type="submit" class="fx-btn">Hold one for me</button>
          </div>
          <output class="fx-mono" aria-live="polite"></output>
        </form>
        <p class="fx-mono fx-small">No deposit until your unit passes burn-in. Ferrous Modular is a fictional studio.</p>
      </div>
    </footer>

    <BackPill />
  </body>
</html>

<style is:global>
  :root {
    --ink: #070708;
    --char: #1e1e1f;
    --bone: #ecece9;
    --paper: #f6f6f4;
    --line: rgb(0 0 0 / 0.12);
    --led: #ff3d1f;
    --sans: 'Archivo', ui-sans-serif, system-ui, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
  }
  html { background: var(--ink); }
  body { margin: 0; font-family: var(--sans); color: #f4f4f2; background: var(--ink); -webkit-font-smoothing: antialiased; }
  .fx-mono { font-family: var(--mono); letter-spacing: 0.02em; }
  .fx-dim { opacity: 0.5; }
  a:focus-visible, button:focus-visible, input:focus-visible { outline: 2px solid var(--led); outline-offset: 3px; }

  /* Hero */
  .fx-hero { min-height: max(100svh, 640px); display: flex; }
  .fx-poster { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; transition: opacity 1.4s ease; }
  [data-trail-live] .fx-poster { opacity: 0; }
  .fx-hero-inner { flex: 1; display: grid; grid-template-rows: auto 1fr auto; padding: 24px clamp(16px, 4vw, 56px) clamp(24px, 4vw, 48px); max-width: 1600px; margin: 0 auto; width: 100%; box-sizing: border-box; }
  .fx-nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .fx-logo { display: inline-flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; font-weight: 700; font-stretch: 112%; font-size: 17px; letter-spacing: -0.01em; }
  .fx-links { display: flex; gap: 28px; }
  .fx-links a { color: rgb(255 255 255 / 0.72); text-decoration: none; font-size: 14px; }
  .fx-links a:hover { color: #fff; }
  .fx-pill { color: var(--ink); background: #f4f4f2; text-decoration: none; font-size: 13px; font-weight: 600; padding: 9px 16px; border-radius: 999px; white-space: nowrap; }
  .fx-readout { position: absolute; top: 88px; right: clamp(16px, 4vw, 56px); display: flex; flex-direction: column; align-items: flex-end; gap: 6px; font-size: 11px; color: rgb(255 255 255 / 0.55); pointer-events: none; }
  .fx-readout span:first-child { color: #fff; display: inline-flex; align-items: center; gap: 8px; }
  .fx-led { width: 7px; height: 7px; border-radius: 50%; background: var(--led); box-shadow: 0 0 10px var(--led); animation: fx-blink 1.6s steps(2, jump-none) infinite; }
  @keyframes fx-blink { 50% { opacity: 0.25; } }

  .fx-hero-copy { align-self: end; max-width: 1180px; position: relative; }
  .fx-hero-copy::before { content: ''; position: absolute; inset: -120px -200px -60px -120px; background: radial-gradient(ellipse at 20% 75%, rgb(7 7 8 / 0.82), rgb(7 7 8 / 0) 65%); z-index: -1; pointer-events: none; }
  .fx-eyebrow { font-size: 12px; text-transform: uppercase; color: rgb(255 255 255 / 0.6); margin: 0 0 20px; }
  .fx-hero h1 { margin: 0; font-weight: 760; font-stretch: 118%; font-size: clamp(42px, 7.4vw, 124px); line-height: 0.92; letter-spacing: -0.045em; max-width: 13ch; text-wrap: balance; }
  .fx-hero-foot { display: flex; align-items: end; justify-content: space-between; gap: 32px; margin-top: 32px; flex-wrap: wrap; }
  .fx-lede { max-width: 46ch; margin: 0; font-size: clamp(15px, 1.15vw, 18px); line-height: 1.55; color: rgb(255 255 255 / 0.74); }
  .fx-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .fx-btn { display: inline-flex; align-items: center; justify-content: center; font: 600 15px/1 var(--sans); padding: 15px 22px; border-radius: 999px; background: #f4f4f2; color: var(--ink); text-decoration: none; border: 0; cursor: pointer; white-space: nowrap; }
  .fx-btn:hover { background: #fff; }
  .fx-btn-ghost { background: transparent; color: #fff; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.32); }
  .fx-btn-ghost:hover { background: rgb(255 255 255 / 0.08); }
  .fx-readout { padding: 12px 14px; border-radius: 10px; background: rgb(7 7 8 / 0.62); backdrop-filter: blur(6px); }
  .fx-readout-hint { margin-top: 6px; color: rgb(255 255 255 / 0.85); }

  /* Light sections */
  .fx-light { background: var(--bone); color: var(--ink); }
  .fx-panel-sec { max-width: 1240px; margin: 0 auto; padding: clamp(72px, 10vw, 140px) clamp(16px, 4vw, 56px); display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: clamp(40px, 7vw, 110px); align-items: start; }
  .fx-faceplate { margin: 0; position: sticky; top: 32px; }
  .fx-faceplate svg { width: 100%; height: auto; display: block; filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.18)) drop-shadow(0 2px 3px rgb(0 0 0 / 0.2)); }
  .fx-faceplate figcaption { font-size: 11px; color: rgb(0 0 0 / 0.5); margin-top: 18px; }
  .sv-brand { font: 600 11px var(--mono); letter-spacing: 0.32em; fill: #111; }
  .sv-title { font: 800 26px var(--sans); font-stretch: 120%; letter-spacing: -0.02em; fill: #111; }
  .sv-label { font: 500 10px var(--mono); letter-spacing: 0.14em; fill: #111; }
  .sv-tiny { font: 500 9px var(--mono); letter-spacing: 0.1em; fill: #111; }
  .sv-out { fill: #e9e9e6; }
  .fx-kicker { font-size: 12px; text-transform: uppercase; color: rgb(0 0 0 / 0.5); margin: 0 0 18px; }
  .fx-light h2 { font-weight: 740; font-stretch: 114%; font-size: clamp(34px, 4.4vw, 64px); line-height: 0.98; letter-spacing: -0.035em; margin: 0; max-width: 16ch; text-wrap: balance; }
  .fx-body { font-size: 17px; line-height: 1.6; color: rgb(0 0 0 / 0.7); max-width: 58ch; margin: 28px 0 48px; }
  .fx-knobs { margin: 0; border-top: 1px solid var(--line); }
  .fx-knob { display: grid; grid-template-columns: minmax(0, 220px) minmax(0, 1fr); gap: 24px; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .fx-knob dt { display: flex; align-items: baseline; gap: 14px; }
  .fx-val { font-size: 13px; color: rgb(0 0 0 / 0.5); min-width: 52px; }
  .fx-val small { font-size: 10px; margin-left: 2px; }
  .fx-knob-name { font-weight: 700; font-stretch: 110%; font-size: 22px; letter-spacing: -0.02em; }
  .fx-knob dd { margin: 0; font-size: 15px; line-height: 1.55; color: rgb(0 0 0 / 0.66); }

  .fx-specs { background: var(--paper); border-top: 1px solid var(--line); padding: clamp(64px, 9vw, 120px) clamp(16px, 4vw, 56px); }
  .fx-specs-head, .fx-spec-grid { max-width: 1240px; margin-left: auto; margin-right: auto; }
  .fx-spec-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 48px; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .fx-spec-grid div { padding: 26px 24px 30px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .fx-spec-grid dt { font-size: 11px; text-transform: uppercase; color: rgb(0 0 0 / 0.5); }
  .fx-spec-grid dd { margin: 12px 0 0; font-size: clamp(18px, 1.6vw, 24px); font-weight: 600; letter-spacing: -0.015em; }

  /* Batch footer */
  .fx-batch { background: linear-gradient(45deg, var(--char), var(--ink)); padding: clamp(72px, 10vw, 140px) clamp(16px, 4vw, 56px) 96px; }
  .fx-batch-inner { max-width: 1240px; margin: 0 auto; }
  .fx-batch h2 { font-weight: 740; font-stretch: 116%; font-size: clamp(34px, 5vw, 76px); line-height: 0.96; letter-spacing: -0.04em; margin: 0; max-width: 18ch; text-wrap: balance; }
  .fx-form { margin-top: 48px; max-width: 620px; display: grid; gap: 12px; }
  .fx-form label { font-size: 12px; color: rgb(255 255 255 / 0.6); text-transform: uppercase; }
  .fx-form-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .fx-form input { flex: 1 1 240px; min-width: 0; font: 400 16px var(--sans); color: #fff; background: rgb(255 255 255 / 0.06); border: 1px solid rgb(255 255 255 / 0.2); border-radius: 999px; padding: 14px 20px; }
  .fx-form input::placeholder { color: rgb(255 255 255 / 0.4); }
  .fx-form output { font-size: 13px; color: rgb(255 255 255 / 0.8); min-height: 1em; }
  .fx-small { font-size: 11px; color: rgb(255 255 255 / 0.4); margin-top: 40px; }

  @media (max-width: 900px) {
    .fx-links, .fx-readout { display: none; }
    .fx-panel-sec { grid-template-columns: minmax(0, 1fr); }
    .fx-faceplate { position: static; max-width: 260px; }
    .fx-knob { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .fx-spec-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .fx-spec-grid { grid-template-columns: minmax(0, 1fr); }
    .fx-hero h1 { letter-spacing: -0.035em; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fx-led { animation: none; }
  }
</style>
