---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

// Lowmoss Mushroom Farm — weekly harvest share. Value metric: fresh kilos per week (one metric, all page).
// Yearly = pay 10 months, get 12 ("2 months free", 17 %). Math stays obvious: monthly × 10 / 12.
const WEEKS = 52 / 12;
const plans = [
  {
    id: 'spore', name: 'Spore', monthly: 24, kg: 0.4, varieties: 2,
    who: 'For one or two cooks trying mushrooms beyond the button.',
    unlocks: 'Oyster and shiitake, picked the morning they ship.',
    limits: ['400 g every week', '2 varieties', 'Thursday delivery'],
    bullets: ['Skip any week from your account, no questions', 'A grower’s note in every box: what to cook first'],
    icon: 1,
  },
  {
    id: 'flush', name: 'Flush', monthly: 54, kg: 1, varieties: 4, recommended: true,
    who: 'For households that cook mushrooms twice a week.',
    unlocks: 'Lion’s mane and king oyster join the rotation.',
    limits: ['1 kg every week', '4 rotating varieties', 'Pick your delivery day'],
    bullets: ['Swap any variety up to 48 h before picking', 'Recipe card matched to the week’s flush', 'Skip or pause for holidays in two taps'],
    icon: 3,
  },
  {
    id: 'cellar', name: 'Cellar', monthly: 108, kg: 2.2, varieties: 7,
    who: 'For big tables, preservers and the mushroom-obsessed.',
    unlocks: 'Every variety we grow, plus first call on rare flushes.',
    limits: ['2.2 kg every week', 'All 7 varieties, pick-and-mix', 'Any day, two drops a week'],
    bullets: ['First call on pioppino and chestnut flushes', 'A grow-at-home log every season', 'Drying trays lent free for gluts'],
    icon: 5,
  },
];
const fmt = (n: number, d = 0) =>
  new Intl.NumberFormat('en-IE', { style: 'currency', currency: 'EUR', minimumFractionDigits: d, maximumFractionDigits: d }).format(n);
const yearly = (m: number) => Math.round((m * 10) / 12);
const perKg = (m: number, kg: number) => fmt(m / (kg * WEEKS), 2);

const compare = [
  { group: 'Harvest', rows: [
    ['Fresh mushrooms per week', '400 g', '1 kg', '2.2 kg'],
    ['Varieties in rotation', '2', '4', '7'],
    ['Lion’s mane & king oyster', '—', '✓', '✓'],
    ['Rare flushes (pioppino, chestnut)', '—', 'When surplus', 'First call'],
  ]},
  { group: 'Flexibility', rows: [
    ['Skip a week', '✓', '✓', '✓'],
    ['Swap varieties before picking', '—', '48 h ahead', '24 h ahead'],
    ['Delivery days', 'Thursday', 'Your choice', 'Two per week'],
  ]},
  { group: 'At the farm', rows: [
    ['Grower’s note & storage guide', '✓', '✓', '✓'],
    ['Recipe card per flush', '—', '✓', '✓'],
    ['Tunnel open days', '1 a year', '2 a year', 'Any open day'],
  ]},
  { group: 'Care', rows: [
    ['Bruised or late box replaced', 'Next week', 'Same week', 'Same day'],
    ['Reply from a grower', '2 days', '1 day', 'Same day'],
  ]},
];

const faqs = [
  ['Is the first box really free?', 'Yes. Your first week on any plan costs nothing. We charge from the second box, and you can cancel before it ships without paying a cent.'],
  ['Can I cancel any time?', 'Monthly plans cancel from your account in one step and stop before the next picking. Yearly plans can be cancelled with a refund for every full month you have not received.'],
  ['What happens if I need more one week?', 'Add extra kilos to any box up to Tuesday evening at your plan’s per-kilo price. If you top up three weeks running, we will suggest the next plan, never switch you automatically.'],
  ['What counts as a kilo?', 'Trimmed, ready-to-cook weight at picking. Mushrooms lose a little water on the way, so we pack 5 % over to make sure you get the full weight on your counter.'],
  ['How long do they keep?', 'Five to seven days in a paper bag in the fridge, longer for shiitake. Never in plastic. Every box carries a storage card for that week’s varieties.'],
  ['Where do you deliver?', 'By cargo bike inside the ring road, by chilled van within 60 km of the farm. Further out, collect from one of our 14 grocer pick-up points at the same price.'],
  ['Do you offer discounts?', 'Yearly billing gives you two months free. Students and anyone on a reduced-income scheme get 25 % off Spore and Flush, no paperwork beyond a photo of the card.'],
  ['I run a café or co-op. Can I order wholesale?', 'Yes, from 10 kg a week on a standing order, invoiced monthly with 30-day terms. Write to the growers and one of us replies within one working day.'],
];
const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
});
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pricing — Lowmoss Mushroom Farm | Weekly mushroom shares</title>
    <meta name="description" content="Mushrooms picked at dawn in a railway tunnel and at your door by dinner. Weekly shares start at €24 a month, first box free." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={faqSchema} />
  </head>
  <body>
    <div class="bloom" aria-hidden="true"></div>

    <header class="wrap topbar">
      <a href="#" class="brand"><span class="dot"></span>Lowmoss</a>
      <nav aria-label="Main">
        <a href="#compare">Compare</a>
        <a href="#faq">FAQ</a>
        <a href="#wholesale">Wholesale</a>
      </nav>
      <span class="meta">Grown under Fenwick Hill · Est. 2019</span>
    </header>

    <main>
      <section class="wrap hero" aria-labelledby="h1">
        <div class="hero-copy">
          <p class="eyebrow">Weekly harvest share</p>
          <h1 id="h1">Picked at dawn.<br />At your door by dinner.</h1>
        </div>
        <div class="hero-side">
          <p class="lede">Seven varieties grown on oak and straw in a disused railway tunnel, picked to order and delivered the same day. Start small, move up when your kitchen asks for more.</p>
          <fieldset class="billing" aria-label="Billing period">
            <label><input type="radio" name="billing" value="monthly" checked /><span>Monthly</span></label>
            <label><input type="radio" name="billing" value="yearly" /><span>Yearly <em>2 months free</em></span></label>
          </fieldset>
        </div>
      </section>

      <section class="wrap" aria-label="Plans">
        <div class="ptable">
          <div class="table-bar">
            <span>First box free · skip any week · cancel in one step</span>
            <a href="#compare">Compare every detail ↓</a>
          </div>
          <div class="plans">
            {plans.map((p) => (
              <article class:list={['plan', { rec: p.recommended }]} aria-labelledby={`plan-${p.id}`}>
                <div class="plan-head">
                  <h2 id={`plan-${p.id}`} class="plan-name">{p.name}{p.recommended && <span class="badge">Recommended</span>}</h2>
                  <svg class="caps" viewBox={`0 0 ${18 + (p.icon - 1) * 17} 28`} width={18 + (p.icon - 1) * 17} height="28" aria-hidden="true">
                    {Array.from({ length: p.icon }, (_, i) => {
                      const x = 9 + i * 17; const h = 6 + ((i * 5) % 4);
                      return (<g><path d={`M${x - 8} ${28 - h} q0 -10 8 -10 q8 0 8 10 z`} /><rect x={x - 2.2} y={28 - h} width="4.4" height={h} rx="1.2" /></g>);
                    })}
                  </svg>
                </div>
                <p class="price">
                  <span class="amount" data-monthly={fmt(p.monthly)} data-yearly={fmt(yearly(p.monthly))}>{fmt(p.monthly)}</span>
                  <span class="per">/ month</span>
                </p>
                <p class="billed" data-monthly={`Billed monthly · ${perKg(p.monthly, p.kg)} a kilo`} data-yearly={`${fmt(yearly(p.monthly) * 12)} billed yearly · ${perKg(yearly(p.monthly), p.kg)} a kilo`}>
                  Billed monthly · {perKg(p.monthly, p.kg)} a kilo
                </p>
                <p class="who"><strong>{p.who}</strong> {p.unlocks}</p>
                <a class="cta" href="#start">Start with a free box</a>
                <ul class="limits" aria-label={`${p.name} includes`}>
                  {p.limits.map((l) => <li>{l}</li>)}
                </ul>
                <ul class="bullets">
                  {p.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="wrap proof" aria-label="What members say">
        <figure>
          <blockquote>“The lion’s mane alone is worth Flush. It arrives still cold from the tunnel and fries like scallops.”</blockquote>
          <figcaption>Mairead O., Flush member since 2022</figcaption>
        </figure>
        <dl class="stats">
          <div><dt>Hours from picking to door</dt><dd>9</dd></div>
          <div><dt>Members who skip rather than cancel</dt><dd>84%</dd></div>
          <div><dt>Boxes replaced last year</dt><dd>0.6%</dd></div>
        </dl>
      </section>

      <section id="compare" class="wrap compare" aria-labelledby="compare-h">
        <div class="section-head">
          <p class="eyebrow">Compare plans</p>
          <h2 id="compare-h">What changes as you move up</h2>
          <p class="muted">Every plan is the same mushrooms from the same tunnel. Bigger shares get more varieties, more say over the box, and a lower price per kilo.</p>
        </div>
        <div class="matrix" role="table" aria-label="Plan comparison">
          <div class="mrow mhead" role="row">
            <span role="columnheader"><span class="sr">Feature</span></span>
            {plans.map((p) => <span role="columnheader" class:list={{ rec: p.recommended }}>{p.name}</span>)}
          </div>
          {compare.map((g) => (
            <Fragment>
              <div class="mgroup" role="row"><span role="rowheader">{g.group}</span></div>
              {g.rows.map(([label, ...vals]) => (
                <div class="mrow" role="row">
                  <span role="rowheader" class="mlabel">{label}</span>
                  {vals.map((v, i) => (
                    <span role="cell" class:list={['mcell', { rec: plans[i].recommended, off: v === '—' }]} data-plan={plans[i].name}>
                      {v === '—' ? <span aria-label="Not included">—</span> : v === '✓' ? <span aria-label="Included">✓</span> : v}
                    </span>
                  ))}
                </div>
              ))}
            </Fragment>
          ))}
        </div>
      </section>

      <section id="faq" class="wrap faq" aria-labelledby="faq-h">
        <div class="section-head">
          <p class="eyebrow">Questions</p>
          <h2 id="faq-h">Before your first box</h2>
          <p class="muted">Still unsure? Write to <a href="mailto:growers@lowmoss.farm">growers@lowmoss.farm</a> — a person who picks the mushrooms answers.</p>
        </div>
        <div class="faq-list">
          {faqs.map(([q, a], i) => (
            <details open={i === 0}>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </section>

      <section id="wholesale" class="wrap closing">
        <div class="closing-main" id="start">
          <h2>Your first box is on us.</h2>
          <p>Pick a plan, choose a day, and the next flush is yours. No card charged until box two.</p>
          <a class="cta dark" href="#h1">Start with a free box</a>
        </div>
        <div class="closing-side">
          <p class="eyebrow">Cafés, grocers & co-ops</p>
          <h3>Wholesale from 10 kg a week</h3>
          <ul>
            <li>Standing orders, invoiced monthly on 30-day terms</li>
            <li>Lot number and picking time on every crate</li>
            <li>Registered food business, HACCP plan on request</li>
          </ul>
          <a class="cta ghost" href="mailto:growers@lowmoss.farm">Contact the growers</a>
          <p class="small">A grower replies within one working day.</p>
        </div>
      </section>
    </main>

    <footer class="wrap foot">
      <span>Lowmoss Mushroom Farm · Fenwick Tunnel, Unit 3</span>
      <span>Prices include VAT and delivery.</span>
    </footer>
    <BackPill />

    <script>
      const amounts = document.querySelectorAll<HTMLElement>('[data-monthly]');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll<HTMLInputElement>('input[name="billing"]').forEach((input) =>
        input.addEventListener('change', () => {
          const period = input.value as 'monthly' | 'yearly';
          document.body.dataset.billing = period;
          amounts.forEach((el) => {
            el.textContent = el.dataset[period] ?? '';
            if (!reduced) el.animate([{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 260, easing: 'cubic-bezier(.2,.7,.2,1)' });
          });
        }),
      );
    </script>

    <style is:global>
      :root {
        --bg: #ece9e3; --paper: #f6f4f0; --ink: #17171a; --muted: #6a6761; --line: #d5d1c9;
        --lilac: #5b4bd6; --tint-a: #e1dcf4; --tint-b: #eeebf3;
      }
      html { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body {
        margin: 0; background: var(--bg); color: var(--ink);
        font: 400 16px/1.55 Inter, ui-sans-serif, system-ui, sans-serif; -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      .bloom {
        position: absolute; inset: 0 0 auto; height: 900px; pointer-events: none; z-index: 0;
        background: radial-gradient(42% 46% at 76% 22%, rgb(203 194 238 / .55), transparent 70%),
                    radial-gradient(30% 30% at 12% 6%, rgb(255 255 255 / .6), transparent 70%);
      }
      main, header, footer { position: relative; z-index: 1; }
      .wrap { width: min(1360px, 100% - 40px); margin-inline: auto; }
      a { color: inherit; }
      :focus-visible { outline: 2px solid var(--lilac); outline-offset: 3px; border-radius: 6px; }
      .eyebrow, .meta, .topbar nav a, .table-bar, .badge, .plan-name, .mhead span, .mgroup span, .small, .stats dt {
        font: 600 11px/1.2 Inter, sans-serif; letter-spacing: .14em; text-transform: uppercase;
      }
      .muted { color: var(--muted); }
      .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

      .topbar { display: flex; align-items: center; gap: 32px; padding: 22px 0; border-bottom: 1px solid var(--line); }
      .brand { display: flex; align-items: center; gap: 10px; font: 700 15px/1 'Inter Tight', sans-serif; letter-spacing: .02em; text-decoration: none; text-transform: uppercase; }
      .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--lilac); box-shadow: 0 0 0 4px rgb(91 75 214 / .14); }
      .topbar nav { display: flex; gap: 24px; margin-left: auto; }
      .topbar nav a { text-decoration: none; color: var(--muted); }
      .topbar nav a:hover { color: var(--ink); }
      .meta { color: var(--ink); }

      .hero { display: grid; grid-template-columns: 1.6fr 1fr; gap: 48px; align-items: end; padding: 52px 0 32px; }
      .eyebrow { color: var(--muted); margin: 0 0 14px; }
      h1, h2, h3 { font-family: 'Inter Tight', sans-serif; font-weight: 600; letter-spacing: -.04em; margin: 0; }
      h1 { font-size: clamp(42px, 5.6vw, 80px); line-height: .94; letter-spacing: -.055em; }
      .lede { color: var(--muted); font-size: 17px; margin: 0 0 22px; max-width: 46ch; }
      .billing { display: inline-flex; border: 1px solid var(--line); background: var(--paper); border-radius: 999px; padding: 4px; margin: 0; gap: 2px; }
      .billing label { position: relative; cursor: pointer; }
      .billing input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
      .billing span { display: block; padding: 9px 18px; border-radius: 999px; font-size: 14px; font-weight: 500; color: var(--muted); transition: background .2s, color .2s; }
      .billing em { font-style: normal; font-size: 11px; font-weight: 600; color: var(--lilac); margin-left: 6px; }
      .billing input:checked + span { background: var(--ink); color: #fff; }
      .billing input:checked + span em { color: #c9c1ff; }
      .billing input:focus-visible + span { outline: 2px solid var(--lilac); outline-offset: 2px; }

      .ptable { border: 1px solid var(--line); border-radius: 20px; background: var(--paper); overflow: hidden; box-shadow: 0 1px 0 rgb(255 255 255 / .8) inset, 0 30px 60px -40px rgb(40 30 80 / .25); }
      .table-bar { display: flex; justify-content: space-between; gap: 16px; padding: 16px 24px; border-bottom: 1px solid var(--line); color: var(--muted); }
      .table-bar a { color: var(--ink); text-decoration: none; }
      .plans { display: grid; grid-template-columns: repeat(3, 1fr); }
      .plan { padding: 26px 28px 30px; display: flex; flex-direction: column; border-right: 1px solid var(--line); }
      .plan:last-child { border-right: 0; }
      .plan.rec { background: linear-gradient(160deg, var(--tint-a), var(--tint-b) 70%); box-shadow: inset 0 0 0 1px rgb(91 75 214 / .22); }
      .plan-head { display: flex; justify-content: space-between; align-items: center; }
      .plan-name { margin: 0; color: var(--ink); display: flex; align-items: center; gap: 10px; letter-spacing: .14em; }
      .badge { font-size: 10px; color: var(--lilac); background: rgb(255 255 255 / .7); border: 1px solid rgb(91 75 214 / .25); padding: 5px 8px; border-radius: 999px; }
      .caps { flex: none; fill: #b9b3a8; }
      .rec .caps { fill: var(--lilac); opacity: .75; }
      .price { margin: 20px 0 2px; display: flex; align-items: baseline; gap: 8px; }
      .amount { display: inline-block; font: 700 clamp(48px, 4.6vw, 64px)/1 'Inter Tight', sans-serif; letter-spacing: -.05em; font-variant-numeric: tabular-nums; }
      .per { color: var(--muted); font-size: 15px; }
      .billed { margin: 0; font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; min-height: 1.55em; }
      .who { margin: 16px 0 20px; font-size: 15px; color: var(--muted); max-width: 36ch; }
      .who strong { color: var(--ink); font-weight: 500; display: block; }
      .cta { display: inline-flex; justify-content: center; align-items: center; padding: 13px 18px; border-radius: 12px; font-weight: 600; font-size: 15px; text-decoration: none; background: #fff; border: 1px solid var(--line); transition: transform .15s, background .2s; }
      .cta:hover { transform: translateY(-1px); background: #fbfaf8; }
      .rec .cta, .cta.dark { background: var(--ink); color: #fff; border-color: var(--ink); }
      .rec .cta:hover, .cta.dark:hover { background: #2a2930; }
      .limits, .bullets { list-style: none; margin: 0; padding: 0; }
      .limits { margin-top: 24px; border-top: 1px solid var(--line); }
      .rec .limits { border-color: rgb(91 75 214 / .2); }
      .limits li { padding: 10px 0; border-bottom: 1px solid var(--line); font-weight: 600; font-size: 15px; display: flex; justify-content: space-between; }
      .rec .limits li { border-color: rgb(91 75 214 / .2); }
      .bullets { margin-top: 16px; display: grid; gap: 8px; }
      .bullets li { font-size: 14px; color: var(--muted); padding-left: 20px; position: relative; }
      .bullets li::before { content: ''; position: absolute; left: 2px; top: .62em; width: 8px; height: 4px; border-left: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(-45deg); color: var(--ink); }
      .rec .bullets li::before { color: var(--lilac); }

      .proof { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; padding: 72px 0; }
      .proof figure { margin: 0; }
      blockquote { margin: 0 0 14px; font: 500 clamp(22px, 2.4vw, 32px)/1.2 'Inter Tight', sans-serif; letter-spacing: -.03em; }
      figcaption { color: var(--muted); font-size: 14px; }
      .stats { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; border-top: 1px solid var(--line); }
      .stats div { padding: 18px 16px 0 0; display: flex; flex-direction: column; }
      .stats dt { color: var(--muted); letter-spacing: .1em; line-height: 1.4; }
      .stats dd { margin: auto 0 0; padding-top: 10px; font: 600 40px/1 'Inter Tight', sans-serif; letter-spacing: -.04em; }

      .section-head { max-width: 640px; margin-bottom: 32px; }
      .section-head h2 { font-size: clamp(32px, 4vw, 52px); line-height: 1; }
      .section-head .muted { margin: 14px 0 0; }
      .compare { padding: 40px 0 72px; scroll-margin-top: 24px; }
      .matrix { border: 1px solid var(--line); border-radius: 20px; background: var(--paper); overflow: hidden; }
      .mrow { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); border-top: 1px solid var(--line); }
      .mrow > span { padding: 14px 20px; font-size: 15px; }
      .mhead { border-top: 0; position: sticky; top: 0; background: var(--paper); z-index: 2; }
      .mhead span { padding: 18px 20px; }
      .mhead span.rec { color: var(--lilac); }
      .mgroup { border-top: 1px solid var(--line); background: #efece6; }
      .mgroup span { display: block; padding: 12px 20px; color: var(--muted); }
      .mcell { font-variant-numeric: tabular-nums; font-weight: 500; }
      .mcell.rec { background: rgb(225 220 244 / .55); }
      .mcell.off { color: #b0aca4; }

      .faq { display: grid; grid-template-columns: 1fr 1.4fr; gap: 48px; padding: 40px 0 72px; scroll-margin-top: 24px; }
      .faq-list { border-top: 1px solid var(--line); }
      details { border-bottom: 1px solid var(--line); }
      summary { list-style: none; cursor: pointer; padding: 20px 36px 20px 0; position: relative; font: 600 18px/1.35 'Inter Tight', sans-serif; letter-spacing: -.015em; }
      summary::-webkit-details-marker { display: none; }
      summary::after { content: '+'; position: absolute; right: 4px; top: 16px; font: 400 24px/1 Inter, sans-serif; color: var(--muted); transition: transform .2s; }
      details[open] summary::after { transform: rotate(45deg); }
      details p { margin: 0 0 22px; color: var(--muted); max-width: 62ch; }

      .closing { display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px; padding-bottom: 72px; scroll-margin-top: 24px; }
      .closing-main, .closing-side { border-radius: 20px; padding: 40px; border: 1px solid var(--line); }
      .closing-main { background: linear-gradient(150deg, var(--tint-a), var(--tint-b) 75%); display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; min-height: 300px; }
      .closing-main h2 { font-size: clamp(36px, 4.6vw, 64px); line-height: .98; }
      .closing-main p { color: var(--muted); margin: 14px 0 24px; max-width: 44ch; }
      .closing-side { background: var(--paper); }
      .closing-side h3 { font-size: 26px; margin-bottom: 16px; letter-spacing: -.03em; }
      .closing-side ul { margin: 0 0 24px; padding-left: 18px; color: var(--muted); display: grid; gap: 6px; font-size: 15px; }
      .cta.ghost { background: transparent; }
      .small { color: var(--muted); margin: 14px 0 0; letter-spacing: .08em; }
      .foot { display: flex; justify-content: space-between; gap: 16px; padding: 24px 0 80px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; }

      @media (max-width: 1024px) {
