---
import '../../styles/global.css';
import '../../components/skills/tailwindcss/page.css';
import BackPill from '../../components/BackPill.astro';

// Halvard Drum Works — a fictional two-person snare workshop in Bergen.
// Everything is utility classes; data lives here and is mapped, never string-built into class names.

const woods = [
  { id: 'maple', label: 'Maple', color: '#d6ad7f', note: 'Hard rock maple, steam-bent from one 6 mm ply.', tone: 'Bright, even, very little ring to tame.' },
  { id: 'walnut', label: 'Walnut', color: '#6f4a33', note: 'Black walnut, steam-bent from one 7 mm ply.', tone: 'Warm mids, a soft attack, a dark wash.' },
  { id: 'oak', label: 'Smoked oak', color: '#3c312a', note: 'Fumed white oak, steam-bent from one 7 mm ply.', tone: 'Dry and woody, the shortest decay we make.' },
] as const;

const depths = [
  { id: 'd55', label: '5½″', h: 100, hz: '≈ 220 Hz', feel: 'Crisp and quick off the head.' },
  { id: 'd65', label: '6½″', h: 130, hz: '≈ 196 Hz', feel: 'The all-rounder. Most of our orders.' },
  { id: 'd80', label: '8″', h: 165, hz: '≈ 165 Hz', feel: 'Fat, low, old-record backbeat.' },
] as const;

// Snare geometry (SVG units). Lugs sit on the visible front half of the shell.
const cx = 260, rx = 200, ry = 58, top = 112;
const lugAngles = [26, 58, 122, 154];
const lugs = (h: number) =>
  lugAngles.map((deg) => {
    const a = (deg * Math.PI) / 180;
    const x = cx + rx * Math.cos(a);
    const dy = ry * Math.sin(a);
    const w = 6 + 12 * Math.sin(a);
    return { x, w, dy, y: top + h / 2 + dy - 22, rodTop: top + dy + 6, rodBottom: top + h / 2 + dy - 22 };
  });
const arc = (y: number) => `M${cx - rx},${y} A${rx},${ry} 0 0 0 ${cx + rx},${y}`;
const band = (y: number, h: number) =>
  `M${cx - rx},${y} L${cx - rx},${y + h} A${rx},${ry} 0 0 0 ${cx + rx},${y + h} L${cx + rx},${y} A${rx},${ry} 0 0 1 ${cx - rx},${y} Z`;

const steps = [
  { n: '01', t: 'Season', d: 'Boards rest in the loft above the bench for eighteen months before anyone measures them.', time: '18 mo' },
  { n: '02', t: 'Steam & bend', d: 'One ply, two hours in the steam box, then clamped round a beech form overnight.', time: '14 h' },
  { n: '03', t: 'Cut the edge', d: 'A 45° bearing edge by router, finished by hand and checked flat on a sheet of glass.', time: '3 h' },
  { n: '04', t: 'Tune & sign', d: 'Heads seated, wires set, played for an hour in the room before the badge goes on.', time: '1 h' },
];

const bench = [
  { name: 'Nordlys', spec: 'Maple · 14 × 6½″', price: '€1,480', left: '2 on the bench', tone: 'Bright' },
  { name: 'Fjordbunn', spec: 'Walnut · 14 × 8″', price: '€1,720', left: '1 on the bench', tone: 'Warm' },
  { name: 'Røyk', spec: 'Smoked oak · 13 × 5½″', price: '€1,560', left: 'Next batch in May', tone: 'Dry' },
];

const stats = [
  { v: '1,840', l: 'Shells bent since 2009' },
  { v: '38 h', l: 'Bench time per snare' },
  { v: '2', l: 'Pairs of hands, no subcontractors' },
  { v: '25 yr', l: 'Warranty on every shell' },
];

// Static class maps — full class names so Tailwind's scanner finds them.
const showWood = {
  maple: 'hidden group-has-[#w-maple:checked]:block',
  walnut: 'hidden group-has-[#w-walnut:checked]:block',
  oak: 'hidden group-has-[#w-oak:checked]:block',
};
const showDepth = {
  d55: 'hidden group-has-[#d-d55:checked]:block',
  d65: 'hidden group-has-[#d-d65:checked]:block',
  d80: 'hidden group-has-[#d-d80:checked]:block',
};
const label = 'text-[11px] font-semibold uppercase tracking-[0.18em] text-stone-500';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Halvard Drum Works — steam-bent snares, Bergen</title>
    <meta name="description" content="Halvard Drum Works bends single-ply snare shells by hand in Bergen. Pick a wood and a depth and hear what it does." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen overflow-x-hidden bg-[#ece9e3] font-[Schibsted_Grotesk,ui-sans-serif,system-ui] text-stone-900 antialiased selection:bg-sky-200">
    <!-- soft atmosphere -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-[48rem] overflow-hidden"><div class="absolute right-[-10rem] top-[-12rem] h-[44rem] w-[44rem] rounded-full bg-[radial-gradient(closest-side,rgb(186_214_236/0.55),transparent)]"></div></div>

    <div class="relative mx-auto max-w-[1360px] px-4 sm:px-6">
      <!-- header -->
      <header class="flex items-center justify-between border-b border-stone-400/50 py-5">
        <a href="#top" class="flex items-center gap-2.5 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-500">
          <span class="size-2.5 rounded-full bg-sky-400"></span>
          <span class="text-[13px] font-bold uppercase tracking-[0.16em]">Halvard Drum Works</span>
        </a>
        <nav aria-label="Main" class="hidden items-center gap-8 text-[13px] font-medium text-stone-600 md:flex">
          <a class="hover:text-stone-900 focus-visible:text-stone-900 focus-visible:underline" href="#bench">The bench</a>
          <a class="hover:text-stone-900 focus-visible:text-stone-900 focus-visible:underline" href="#catalogue">This season</a>
          <a class="hover:text-stone-900 focus-visible:text-stone-900 focus-visible:underline" href="#visit">Visit</a>
        </nav>
        <span class="hidden text-[11px] font-semibold uppercase tracking-[0.18em] sm:block md:hidden lg:block">Workshop ledger · Nº 14</span>
      </header>

      <main id="top">
        <!-- hero -->
        <section class="grid gap-6 pb-8 pt-8 sm:pt-12 lg:grid-cols-12 lg:pt-8 lg:items-end lg:gap-10">
          <div class="lg:col-span-8">
            <p class={label}>Hand-built snares / Bergen, since 2009</p>
            <h1 class="mt-3 text-[clamp(3.1rem,8.6vw,7.4rem)] font-semibold leading-[0.86] tracking-[-0.055em] motion-safe:animate-[rise_0.9s_cubic-bezier(.2,.7,.2,1)_both]">
              Shells that<br /> hold a note.
            </h1>
          </div>
          <p class="max-w-md text-[15px] leading-relaxed text-stone-600 lg:col-span-4 lg:pb-3">
            One ply of wood, steamed and bent round a form, glued once. No plies fighting each other — so the shell rings in its own key. Choose a wood and a depth below and see what you'd be ordering.
          </p>
        </section>

        <!-- configurator: the one interaction, pure CSS via group-has + peer-checked -->
        <section aria-labelledby="cfg-title" class="group overflow-hidden rounded-[28px] border border-stone-300/80 bg-[#f8f7f4] shadow-[0_1px_0_rgb(255_255_255/0.8)_inset,0_30px_60px_-40px_rgb(41_37_36/0.35)] [--wood:#d6ad7f] has-[#w-walnut:checked]:[--wood:#6f4a33] has-[#w-oak:checked]:[--wood:#3c312a] lg:grid lg:grid-cols-12">
          <!-- this element is the group; its own has-* variants set the wood var -->
          <div class="relative flex flex-col p-5 sm:p-8 lg:col-span-7 lg:border-r lg:border-stone-300/80">
            <div class="flex items-center justify-between">
              <h2 id="cfg-title" class={label}>Live build · Snare 14″</h2>
              <span class="font-['JetBrains_Mono',ui-monospace] text-[11px] text-stone-500">HDW—{new Date().getFullYear()}—0417</span>
            </div>

            <div class="relative mx-auto mt-4 aspect-[520/410] w-full max-w-[520px] lg:order-last lg:max-w-[470px]">
              {depths.map((d) => {
                const L = lugs(d.h);
                const bottom = top + d.h;
                return (
                  <svg viewBox="0 0 520 410" class={`${showDepth[d.id]} absolute inset-0 size-full`} role="img" aria-label={`Snare drum, ${d.label} deep`}>
                    <defs>
                      <linearGradient id={`shade-${d.id}`} x1="0" x2="1">
                        <stop offset="0" stop-color="#000" stop-opacity="0.45" />
                        <stop offset="0.3" stop-color="#fff" stop-opacity="0.18" />
                        <stop offset="0.55" stop-color="#000" stop-opacity="0" />
                        <stop offset="1" stop-color="#000" stop-opacity="0.5" />
                      </linearGradient>
                      <linearGradient id={`metal-${d.id}`} x1="0" x2="1">
                        <stop offset="0" stop-color="#8d8f93" />
                        <stop offset="0.28" stop-color="#f4f5f6" />
                        <stop offset="0.5" stop-color="#b9bcc0" />
                        <stop offset="0.75" stop-color="#e9eaec" />
                        <stop offset="1" stop-color="#7b7d81" />
                      </linearGradient>
                      <radialGradient id={`head-${d.id}`} cx="0.42" cy="0.38" r="0.7">
                        <stop offset="0" stop-color="#fbfaf7" />
                        <stop offset="1" stop-color="#e4e0d8" />
                      </radialGradient>
                      <filter id={`soft-${d.id}`} x="-20%" y="-50%" width="140%" height="200%"><feGaussianBlur stdDeviation="12" /></filter>
                    </defs>
                    <ellipse cx={cx} cy={bottom + 40} rx={rx + 10} ry={ry - 18} fill="#57534e" opacity="0.28" filter={`url(#soft-${d.id})`} />
                    <!-- shell -->
                    <path d={band(top, d.h)} class="fill-(--wood) transition-[fill] duration-500" />
                    {[0.22, 0.41, 0.63, 0.82].map((f, i) => (
                      <path d={arc(top + d.h * f)} fill="none" stroke="#000" stroke-opacity={i % 2 ? 0.07 : 0.12} stroke-width={i % 2 ? 1 : 1.6} />
                    ))}
                    <path d={band(top, d.h)} fill={`url(#shade-${d.id})`} />
                    <!-- rods -->
                    {L.map((l) => <line x1={l.x} x2={l.x} y1={l.rodTop} y2={l.rodBottom} stroke="#9a9ca0" stroke-width="2.5" />)}
                    {L.map((l) => <line x1={l.x} x2={l.x} y1={l.y + 44} y2={bottom + l.dy} stroke="#9a9ca0" stroke-width="2.5" />)}
                    <!-- lugs -->
                    {L.map((l) => <rect x={l.x - l.w / 2} y={l.y} width={l.w} height="44" rx={l.w / 2} fill={`url(#metal-${d.id})`} stroke="#6b6d70" stroke-width="0.8" />)}
                    <!-- badge -->
                    <g transform={`translate(${cx} ${top + d.h / 2 + ry})`}>
                      <ellipse rx="26" ry="15" fill="#f1efe9" stroke="#8d8f93" stroke-width="1.5" />
                      <text y="3.5" text-anchor="middle" font-size="8.5" font-weight="700" letter-spacing="1.4" fill="#292524" font-family="Schibsted Grotesk, sans-serif">HALVARD</text>
                    </g>
                    <!-- strainer -->
                    <rect x={cx + rx * Math.cos(1.57 + 0.36) - 9} y={top + d.h / 2 + ry * 0.94 - 10} width="18" height="20" rx="3" fill={`url(#metal-${d.id})`} stroke="#6b6d70" stroke-width="0.8" />
                    <!-- hoops -->
                    <path d={band(bottom - 4, 12)} fill={`url(#metal-${d.id})`} stroke="#77797d" stroke-width="0.8" />
                    <path d={band(top - 10, 14)} fill={`url(#metal-${d.id})`} stroke="#77797d" stroke-width="0.8" />
                    <ellipse cx={cx} cy={top - 10} rx={rx} ry={ry} fill={`url(#head-${d.id})`} stroke="#8d8f93" stroke-width="2" />
                    <ellipse cx={cx} cy={top - 10} rx={rx - 12} ry={ry - 4} fill="none" stroke="#000" stroke-opacity="0.06" />
                    <ellipse cx={cx} cy={top - 10} rx="52" ry="15" fill="none" class="stroke-sky-400" stroke-width="1.5" stroke-dasharray="3 5" />
                  </svg>
                );
              })}
            </div>

            <!-- controls -->
            <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:mt-6">
              <fieldset>
                <legend class={label}>Wood</legend>
                <div class="mt-2 flex flex-wrap gap-2">
                  {woods.map((w, i) => (
                    <label class="cursor-pointer">
                      <input type="radio" name="wood" id={`w-${w.id}`} value={w.id} class="peer sr-only" checked={i === 0} />
                      <span class="inline-flex items-center gap-2 rounded-full border border-stone-300 bg-white px-3.5 py-2 text-[13px] font-medium text-stone-700 transition hover:border-stone-500 peer-checked:border-stone-900 peer-checked:bg-stone-900 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-sky-400 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-[#f8f7f4]">
                        <span class="size-3 rounded-full ring-1 ring-black/15" style={`background:${w.color}`}></span>{w.label}
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>
              <fieldset>
                <legend class={label}>Depth</legend>
                <div class="mt-2 inline-flex rounded-full border border-stone-300 bg-white p-1">
                  {depths.map((d, i) => (
                    <label class="cursor-pointer">
                      <input type="radio" name="depth" id={`d-${d.id}`} value={d.id} class="peer sr-only" checked={i === 1} />
                      <span class="block rounded-full px-4 py-1.5 font-['JetBrains_Mono',ui-monospace] text-[13px] text-stone-600 transition hover:text-stone-900 peer-checked:bg-sky-400 peer-checked:text-stone-950 peer-focus-visible:ring-2 peer-focus-visible:ring-sky-600">{d.label}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            </div>
          </div>

          <!-- structural cards -->
          <div class="grid border-t border-stone-300/80 lg:col-span-5 lg:border-t-0">
            <div class="flex items-center justify-between px-5 pt-5 sm:px-8 sm:pt-7">
              <span class={label}>Spec sheet</span>
              <span class={label}>Updates live</span>
            </div>
            {[
              { n: '01', k: 'Shell' },
              { n: '02', k: 'Edge' },
              { n: '03', k: 'Tone' },
            ].map((c) => (
              <article class="mx-3 mb-3 rounded-2xl border border-stone-200 bg-white/70 p-5 shadow-[0_1px_2px_rgb(41_37_36/0.06)] transition hover:-translate-y-0.5 hover:shadow-[0_12px_30px_-18px_rgb(41_37_36/0.35)] motion-reduce:transition-none sm:mx-5 sm:p-6 last:mb-5">
                <div class="flex items-start justify-between gap-4">
                  <span class="text-4xl font-semibold tracking-tight text-sky-400 sm:text-5xl">{c.n}</span>
                  <h3 class="pt-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-stone-700">{c.k}</h3>
                </div>
                <div class="mt-4 text-[15px] leading-snug text-stone-700">
                  {c.k === 'Shell' && woods.map((w) => <p class={showWood[w.id]}>{w.note}</p>)}
                  {c.k === 'Edge' && <p>45° bearing edge with a ⅛″ round-over, cut by hand and checked flat on glass.</p>}
                  {c.k === 'Tone' && depths.map((d) => (
                    <p class={showDepth[d.id]}>
                      <span class="font-['JetBrains_Mono',ui-monospace] text-[13px] text-stone-900">{d.hz}</span> — {d.feel}
                      {woods.map((w) => <span class={`${showWood[w.id]} mt-1 text-stone-500`}>{w.tone}</span>)}
                    </p>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- process -->
        <section id="bench" class="scroll-mt-6 py-20 sm:py-28">
          <div class="grid gap-6 lg:grid-cols-12">
            <p class={`${label} lg:col-span-3`}>The bench</p>
            <h2 class="text-4xl font-semibold leading-[0.95] tracking-[-0.045em] sm:text-6xl lg:col-span-9">From a seasoned board<br class="hidden sm:block" /> to a signed snare.</h2>
          </div>
          <ol class="mt-12 grid border-t border-stone-400/50 sm:grid-cols-2 lg:grid-cols-4">
            {steps.map((s) => (
              <li class="border-b border-stone-400/50 py-7 sm:pr-8 sm:even:pl-8 lg:border-b-0 lg:pl-0 lg:even:pl-0 lg:[&:not(:first-child)]:border-l lg:[&:not(:first-child)]:pl-8">
                <div class="flex items-baseline justify-between">
                  <span class="text-2xl font-semibold text-sky-500">{s.n}</span>
                  <span class="font-['JetBrains_Mono',ui-monospace] text-xs text-stone-500">{s.time}</span>
                </div>
                <h3 class="mt-8 text-xl font-semibold tracking-tight">{s.t}</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-stone-600">{s.d}</p>
              </li>
            ))}
          </ol>
        </section>

        <!-- catalogue -->
        <section id="catalogue" class="scroll-mt-6 pb-20 sm:pb-28">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 class="text-4xl font-semibold tracking-[-0.045em] sm:text-5xl">On the bench this season</h2>
            <p class={label}>Three models · built to order</p>
          </div>
          <div class="mt-10 grid gap-4 md:grid-cols-3">
            {bench.map((b, i) => (
              <article class="group/card flex flex-col rounded-[24px] border border-stone-300/80 bg-[#f8f7f4] p-6 transition hover:border-stone-400 hover:bg-white motion-reduce:transition-none">
                <div class="flex items-center justify-between">
                  <span class="rounded-full bg-stone-900/5 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-stone-600">{b.tone}</span>
                  <span class="font-['JetBrains_Mono',ui-monospace] text-xs text-stone-400">0{i + 1}</span>
                </div>
                <div class="my-10 flex h-24 items-center justify-center" aria-hidden="true">
                  <span class="h-20 w-40 rounded-[50%] border-[6px] border-stone-300 bg-[radial-gradient(circle_at_40%_35%,#fbfaf7,#e1ddd5)] shadow-[0_26px_0_-5px_var(--w)] transition-transform duration-500 group-hover/card:-translate-y-1.5 motion-reduce:transition-none" style={`--w:${woods[i].color}`}></span>
                </div>
                <h3 class="text-2xl font-semibold tracking-tight">{b.name}</h3>
                <p class="mt-1 text-[15px] text-stone-600">{b.spec}</p>
                <div class="mt-6 flex items-center justify-between border-t border-stone-300/80 pt-4">
                  <span class="font-['JetBrains_Mono',ui-monospace] text-[15px]">{b.price}</span>
                  <span class="text-[13px] text-stone-500">{b.left}</span>
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- stats -->
        <section aria-label="Workshop in numbers" class="rounded-[28px] bg-stone-900 px-6 py-12 text-stone-100 sm:px-10 sm:py-16">
          <blockquote class="max-w-3xl text-2xl font-medium leading-snug tracking-tight sm:text-4xl">
            “A plied shell argues with itself. A bent one just answers.”
            <footer class="mt-4 text-[13px] font-normal tracking-normal text-stone-400">— Ingrid Halvard, who bends every one of them</footer>
          </blockquote>
          <dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-8 border-t border-white/15 pt-8 lg:grid-cols-4">
            {stats.map((s) => (
              <div>
                <dt class="text-[13px] text-stone-400">{s.l}</dt>
                <dd class="order-first text-4xl font-semibold tracking-tight text-sky-300 sm:text-5xl">{s.v}</dd>
              </div>
            ))}
          </dl>
        </section>

        <!-- visit -->
        <section id="visit" class="scroll-mt-6 grid gap-10 py-20 sm:py-28 lg:grid-cols-12">
          <div class="lg:col-span-6">
            <p class={label}>Visit the workshop</p>
            <h2 class="mt-3 text-4xl font-semibold leading-[0.95] tracking-[-0.045em] sm:text-6xl">Play them in the room they were tuned in.</h2>
          </div>
          <div class="lg:col-span-5 lg:col-start-8">
            <p class="text-[15px] leading-relaxed text-stone-600">Saturdays, 11:00–15:00, Sandviksveien 41, Bergen. Bring sticks. We'll leave a kit set up and the kettle on — and if you order, we'll book the bending day so you can watch your shell go round the form.</p>
            <form id="visit-form" class="mt-6 flex flex-col gap-3 sm:flex-row">
              <label for="email" class="sr-only">Email address</label>
              <input id="email" type="email" required placeholder="you@example.com" class="min-w-0 flex-1 rounded-xl border border-stone-300 bg-white px-4 py-3 text-[15px] placeholder:text-stone-400 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-400/50" />
              <button class="inline-flex items-center justify-center rounded-xl bg-stone-900 px-5 py-3 text-[15px] font-medium text-white transition hover:bg-stone-700 active:bg-stone-950 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:ring-offset-2 focus-visible:ring-offset-[#ece9e3]">Book a Saturday</button>
            </form>
            <p id="visit-ok" role="status" class="mt-3 min-h-5 text-[13px] text-sky-700"></p>
          </div>
        </section>
      </main>

      <footer class="flex flex-col gap-2 border-t border-stone-400/50 py-6 pb-20 text-[13px] text-stone-500 sm:flex-row sm:justify-between">
        <span>Halvard Drum Works · Bergen, Norway</span>
        <span>Shells bent by hand. Nothing here is plied.</span>
      </footer>
    </div>

    <BackPill />

    <style is:global>
      @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
    </style>
    <script>
      const form = document.getElementById('visit-form') as HTMLFormElement | null;
      const ok = document.getElementById('visit-ok');
      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (ok) ok.textContent = "Noted — we'll write back within a week with a Saturday that works.";
        form.reset();
      });
    </script>
  </body>
</html>
