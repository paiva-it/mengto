---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Last Credit — Arcade Bar, Pier 4</title>
<meta name="description" content="Last Credit, an arcade bar on Pier 4. Its three rooms burn into each other like an old flyer: the next room plays live behind an ember line, the one you leave stays frozen ahead of it.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,800&family=DM+Mono:wght@400&family=Silkscreen&display=swap" rel="stylesheet">
<style is:global>
  :root{
    --ink:#f4efe8;
    --dim:rgba(244,239,232,.68);
    --hair:rgba(244,239,232,.18);
    --chip:rgba(14,9,16,.64);
    --ember:#ee5a1f;
    --gutter:clamp(16px,2.4vw,36px);
    --sans:"Bricolage Grotesque",system-ui,sans-serif;
    --mono:"DM Mono",ui-monospace,monospace;
    --pix:"Silkscreen",ui-monospace,monospace;
  }
  html,body{height:100%}
  body{margin:0;background:#0b0710;color:var(--ink);font-family:var(--sans);overflow:hidden;-webkit-font-smoothing:antialiased}
  #stage{position:fixed;inset:0;display:block;width:100%;height:100%}
  .head{position:fixed;z-index:2;left:var(--gutter);top:var(--gutter);width:min(540px,calc(100vw - 2*var(--gutter)));
    padding:18px 20px;background:var(--chip);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
    outline:1px solid var(--hair);outline-offset:-1px;border-radius:14px}
  .head .stack{display:flex;justify-content:space-between;gap:12px;font:12px/1.2 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ember)}
  .head .stack span:last-child{color:var(--dim)}
  .head h1{display:flex;align-items:baseline;gap:12px;font:800 clamp(30px,3.2vw,42px)/1 var(--sans);letter-spacing:-.035em;margin:10px 0 10px}
  .head h1 small{font:400 13px/1 var(--pix);letter-spacing:.04em;color:var(--ember)}
  .head p{font:400 14px/1.5 var(--sans);color:var(--dim);max-width:54ch;margin:0}
  .head p b{font-weight:400;color:var(--ink)}
  .bar{position:fixed;z-index:2;left:50%;bottom:var(--gutter);transform:translateX(-50%);
    display:flex;align-items:center;gap:14px;padding:10px 12px;max-width:calc(100vw - 2*var(--gutter));
    background:var(--chip);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
    outline:1px solid var(--hair);outline-offset:-1px;border-radius:999px}
  .bar button{white-space:nowrap;font:500 13px/1 var(--mono);color:var(--ink);background:transparent;border:0;outline:1px solid var(--hair);
    outline-offset:-1px;border-radius:999px;min-height:40px;padding:0 18px;cursor:pointer;transition:background .2s,outline-color .2s}
  .bar button:hover{background:rgba(244,239,232,.10);outline-color:rgba(244,239,232,.4)}
  .bar button.next{background:var(--ember);outline-color:transparent;color:#1a0904}
  .bar button.next:hover{background:#ff7438}
  .bar button:focus-visible,.bar input:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
  .dots{display:flex;gap:6px}
  .dots button{min-width:40px;padding:0;font-family:var(--pix);font-size:12px}
  .dots button[aria-current="true"]{background:rgba(244,239,232,.16);outline-color:var(--ink)}
  .speed{display:flex;align-items:center;gap:10px;font:12px/1 var(--mono);color:var(--dim);white-space:nowrap}
  .speed input{width:96px;accent-color:var(--ember);height:40px}
  .speed output{min-width:3.4em;color:var(--ink);font-variant-numeric:tabular-nums}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .fail{position:fixed;inset:0;z-index:3;display:none;place-items:center;text-align:center;padding:32px;
    font:16px/1.5 var(--sans);color:var(--dim);background:#0b0710}
  @media (max-width:640px){
    .head{padding:14px 16px}
    .head p{font-size:13px}
    .head .stack span:last-child{display:none}
    .bar{gap:8px;padding:8px;bottom:68px}
    .bar button{padding:0 14px}
    .bar .lg{display:none}
    .prev{min-width:44px;padding:0}
    .speed{display:none}
  }
  @media (max-height:520px){.head p{display:none}}
</style>
</head>
<body>
<canvas id="stage" aria-label="Three rooms of the Last Credit arcade bar, changing by a burning paper edge" role="img"></canvas>

<header class="head">
  <div class="stack"><span>Arcade bar · Pier 4</span><span>18:00 – 02:00</span></div>
  <h1>Last Credit <small>INSERT COIN</small></h1>
  <p>Three rooms, and every change between them burns like a flyer left on the radiator. <b>The next room plays live behind the ember line</b>; the one you leave stays frozen ahead of it, scorching.</p>
</header>

<div class="bar" role="group" aria-label="Room transition controls">
  <button type="button" class="prev" aria-label="Previous room">&larr;<span class="lg"> Prev</span></button>
  <div class="dots" role="group" aria-label="Rooms">
    <button type="button" data-i="0" aria-label="Room 1, Tickets">1</button>
    <button type="button" data-i="1" aria-label="Room 2, Cabinets">2</button>
    <button type="button" data-i="2" aria-label="Room 3, Carpet">3</button>
  </div>
  <button type="button" class="next" aria-label="Next room">Burn<span class="lg"> to next</span> &rarr;</button>
  <label class="speed">Burn time <input id="dur" type="range" min="1.5" max="5" step="0.1" value="3"><output id="durOut" for="dur">3.0 s</output></label>
</div>
<div class="sr" id="live" aria-live="polite" role="status"></div>
<div class="fail" id="fail" role="alert"></div>
<BackPill />
<script>
  import '../../components/skills/paper-cinder-transition/cinder.js';
</script>
</body>
</html>
