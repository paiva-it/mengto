  .fld > span { font: 500 12px/1 'Geist Mono', monospace; letter-spacing: 0.05em; text-transform: uppercase; color: var(--mute); }
  .fld small { text-transform: none; letter-spacing: 0; }
  .fld input, .fld select, .fld textarea { font: inherit; font-size: 16px; color: var(--ink); background: var(--bone); border: 1px solid var(--line); border-radius: 10px; padding: 14px 14px; min-height: 50px; box-sizing: border-box; width: 100%; transition: border-color 0.2s, background 0.2s, box-shadow 0.2s; }
  .fld textarea { resize: vertical; }
  .fld input:hover, .fld select:hover, .fld textarea:hover { border-color: rgb(17 19 17 / 0.35); }
  .fld input:focus-visible, .fld select:focus-visible, .fld textarea:focus-visible { outline: none; border-color: var(--c-405); background: #fff; box-shadow: 0 0 0 3px rgb(50 71 255 / 0.18); }
  .fld [aria-invalid='true'] { border-color: var(--c-561); background: #fff4f8; }
  .err { font: 400 13px/1.3 'Instrument Sans', sans-serif; color: #c4005a; min-height: 0; }
