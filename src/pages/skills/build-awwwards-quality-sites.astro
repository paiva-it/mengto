  .btn.loading .lbl::after { content: ''; display: inline-block; width: 14px; height: 14px; margin-left: 12px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; vertical-align: -2px; animation: spin 0.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
