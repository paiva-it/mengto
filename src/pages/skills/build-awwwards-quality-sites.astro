    .ctas { order: 1; margin-top: 24px; }
    .stage { order: 2; width: min(100%, 520px); justify-self: center; margin: 22px 0 6px; padding: 22px; box-sizing: border-box; }
    .lede { order: 3; margin: 26px 0 32px; }
    .specs { order: 4; grid-template-columns: 1fr 1fr; }
    .specs > div:nth-child(2) { border-right: 0; }
    .specs > div:nth-child(3) { padding-left: 0; }
    .specs > div:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .instrument, .demo, .wf-head { grid-template-columns: minmax(0, 1fr); }
    .inst-copy { position: static; }
    .inst-media { aspect-ratio: 4 / 3; }
    .days-grid { grid-template-columns: minmax(0, 1fr); align-items: start; gap: 24px; }
    .steps { grid-template-columns: minmax(0, 1fr); gap: 48px; }
    .steps li:nth-child(n) { margin-top: 0; }
    .ph { aspect-ratio: 3 / 2; }
    .ch-list li { grid-template-columns: 80px minmax(0, 1fr); gap: 6px 16px; }
