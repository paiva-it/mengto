  /* footer */
  .foot { background: var(--ink); color: var(--paper); padding: clamp(64px, 9vw, 120px) var(--gut) 28px; }
  .foot .big { font-variation-settings: 'wdth' 75; font-weight: 600; font-size: clamp(64px, 13vw, 200px); line-height: 0.86; letter-spacing: -0.055em; }
  .foot-row { display: grid; grid-template-columns: auto 1fr auto; gap: 24px 48px; align-items: center; margin-top: clamp(48px, 7vw, 96px); padding-top: 24px; border-top: 1px solid rgb(255 255 255 / 0.14); font-size: 14px; color: #9a9f98; }
  .foot .brand { color: var(--paper); font-size: 16px; }
  .totop { color: var(--paper); text-decoration: none; }
  .totop:hover { text-decoration: underline; }

  /* responsive */
  @media (max-width: 1100px) {
    .nav ul { display: none; }
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); padding-top: 84px; min-height: auto; }
