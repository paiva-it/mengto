---
// Vell Halo — a fictional benchtop live-cell imager. Example page for "build-awwwards-quality-sites".
//
// Direction
//   Visual thesis: the microscope is the site. The page is the bench (bone paper, ink, hairlines);
//   the hero is the eyepiece field — label-free phase contrast everywhere, true fluorescence only
//   under the objective you move. Low light, more seeing.
//   Hero focal asset: a WebGL eyepiece over a real confocal micrograph (Three.js, one shader).
//   Type: Instrument Sans (variable width 82 for display, 100 for text) + Geist Mono for readouts.
//   Colour: bone #E9EAE4 / paper #F4F4F0 / ink #111311, plus the three fluorophore channels
//   (cobalt 405, magenta 561, green 488) used only where a channel is actually meant.
//   Sections: hero → statement → instrument → fourteen days (pinned, scrubbed data) → workflow →
//   channels → loan-unit request form → footer.
//   Motion: GSAP intro (iris opens, words rise), Lenis as the only smooth-scroll engine wired to
//   ScrollTrigger, one pinned scrub for the 14-day curve, word-staggered headings elsewhere.
//   Companion skill followed: animation-systems (easing/duration defaults, reduced-motion rules).
//
// Asset provenance (Unsplash licence, copied to /public/skills/build-awwwards-quality-sites/):
//   specimen.jpg   photo-1576086213369-97a306d36557 (confocal micrograph, cropped 1:1)
//   instrument.jpg photo-1606206873764-fd15e242df52 (automated lab instrument)
//   plate.jpg      photo-1532187863486-abf9dbad1b69 (pipetting into a well plate)
//   pipette.jpg    photo-1614935151651-0bea6508db6b (multichannel pipette)
//   lab.jpg        photo-1579154204601-01588f351e67 (laboratory bench row)
//   No avatars, testimonials or customer logos: Vell is fictional and has no honest proof to show.
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';
import { control, halo, path, x, X0, X1, y, Y0, Y1 } from '../../components/skills/build-awwwards-quality-sites/growth';

const A = '/skills/build-awwwards-quality-sites';
const haloPath = path(halo);
const controlPath = path(control);
const gridY = [0, 25, 50, 75, 100];
const gridX = [0, 2, 4, 6, 8, 10, 12, 14];

// Static lens (no-WebGL / reduced-motion poster): centre (cx, cy) of the field, radius r, 1.35× magnification.
const L = { cx: 0.55, cy: 0.52, r: 0.2, m: 1.35 };
const lensImg = `width:${((L.m / (2 * L.r)) * 100).toFixed(2)}%;left:${(50 - (L.cx * L.m) / (2 * L.r) * 100).toFixed(2)}%;top:${(50 - (L.cy * L.m) / (2 * L.r) * 100).toFixed(2)}%`;
const lensBox = `width:${L.r * 200}%;left:${(L.cx - L.r) * 100}%;top:${(L.cy - L.r) * 100}%`;

const channels = [
  { nm: '405', name: 'Nuclear', ex: '405 / 450 nm', use: 'Hoechst, DAPI, NucBlue. Counts and cell-cycle staging.', color: 'var(--c-405)' },
  { nm: '488', name: 'Green', ex: '488 / 525 nm', use: 'GFP, GCaMP, CellEvent caspase. Reporters and calcium.', color: 'var(--c-488)' },
  { nm: '561', name: 'Membrane', ex: '561 / 610 nm', use: 'mCherry, CellMask Orange. Shape, contact, division.', color: 'var(--c-561)' },
  { nm: 'PH', name: 'Phase', ex: 'White LED, Zernike', use: 'Label-free confluence and morphology, at almost no dose.', color: 'var(--ink)' },
];

const notes = [
  { day: 0, text: '3,000 cells per well, 96 wells. Four channels every 20 minutes.' },
  { day: 4, text: 'At a standard widefield dose the control plate stops dividing. Halo wells keep going.' },
  { day: 8, text: 'First wells reach confluence. Autofocus has held within 0.4 µm since seeding.' },
  { day: 13, text: '94 % confluent. 1,008 frames per channel per well, and nothing in the dish noticed.' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Vell Halo — Live-cell imaging at a gentler dose</title>
    <meta name="description" content="Vell Halo is a fictional benchtop live-cell imager that keeps cultures alive for fourteen days of four-channel time-lapse." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Instrument+Sans:wdth,wght@75..100,400..700&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href={`${A}/specimen.jpg`} />
  </head>
  <body>
    <BackPill />
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav" id="top">
      <a class="brand" href="#top" aria-label="Vell, home">
        <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><circle cx="19" cy="14" r="6.5" fill="currentColor"></circle></svg>
        <span>Vell</span>
      </a>
      <nav aria-label="Primary">
        <ul>
          <li><a href="#instrument">Instrument</a></li>
          <li><a href="#days">Fourteen days</a></li>
          <li><a href="#workflow">Workflow</a></li>
          <li><a href="#channels">Channels</a></li>
        </ul>
      </nav>
      <a class="btn btn-ink btn-sm" href="#demo">Book a demo</a>
    </header>

    <main id="main">
      <!-- 1 · Hero -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Halo · benchtop live-cell imager</p>
          <h1 id="hero-title">
            <span class="l1" data-split>Watch a cell for fourteen days.</span>
            <span class="l2" data-split>Without hurting it.</span>
          </h1>
          <div class="ctas">
            <a class="btn btn-ink" href="#demo">Book a bench demo <iconify-icon icon="solar:arrow-right-up-linear" aria-hidden="true"></iconify-icon></a>
            <a class="btn btn-line" href="#days">See the 14-day data</a>
          </div>
          <p class="lede">Halo images four channels inside your incubator at a twelfth of the usual light dose, so the culture lives long enough to show you what it actually does.</p>
        </div>

        <figure class="stage" aria-label="Interactive specimen view">
          <div
            class="field"
            id="field"
            tabindex="0"
            role="group"
            aria-roledescription="specimen viewer"
            aria-label="HeLa cells in phase contrast. The circular objective shows the fluorescence channels; move it with the pointer or the arrow keys."
          >
            <img class="poster-bf" src={`${A}/specimen.jpg`} alt="" width="1600" height="1600" fetchpriority="high" />
            <div class="poster-lens" style={lensBox} aria-hidden="true"><img src={`${A}/specimen.jpg`} alt="" style={lensImg} /></div>
          </div>
          <svg class="reticle" viewBox="0 0 200 200" aria-hidden="true">
            <circle cx="100" cy="100" r="99" fill="none" stroke="currentColor" stroke-width=".25"></circle>
            {Array.from({ length: 72 }, (_, i) => {
              const a = (i * 5 * Math.PI) / 180;
              const l = i % 6 === 0 ? 4 : 1.8;
              return <line x1={100 + Math.cos(a) * 99} y1={100 + Math.sin(a) * 99} x2={100 + Math.cos(a) * (99 - l)} y2={100 + Math.sin(a) * (99 - l)} stroke="currentColor" stroke-width=".3"></line>;
            })}
          </svg>
          <div class="readout r-tl" aria-hidden="true"><b>OBJ</b> 20× / NA 0.45</div>
          <div class="readout r-tr" aria-hidden="true"><b>t</b> <span id="clock">02d 14:06:31</span></div>
          <div class="readout r-bl" aria-hidden="true"><b>XY</b> <span id="xy">412 · 288 µm</span></div>
          <div class="readout r-br" aria-hidden="true"><b>STAGE</b> 37.0 °C · 5 % CO₂</div>
          <figcaption class="channels">
            <span class="sr-only">Channel shown under the objective:</span>
            <div class="seg" role="group" aria-label="Fluorescence channel">
              <button type="button" aria-pressed="true" data-ch="merge"><i style="background:conic-gradient(var(--c-405) 0 33%,var(--c-561) 0 66%,var(--c-488) 0)"></i>Merge</button>
              <button type="button" aria-pressed="false" data-ch="405"><i style="background:var(--c-405)"></i>405</button>
              <button type="button" aria-pressed="false" data-ch="561"><i style="background:var(--c-561)"></i>561</button>
              <button type="button" aria-pressed="false" data-ch="488"><i style="background:var(--c-488)"></i>488</button>
            </div>
          </figcaption>
        </figure>

        <dl class="specs">
          <div><dt>Light per frame</dt><dd>1/12<small>of a standard widefield dose</small></dd></div>
          <div><dt>Lateral resolution</dt><dd>0.6 µm<small>20× air, phase + 3 fluorescence</small></dd></div>
          <div><dt>Runs inside</dt><dd>Your incubator<small>37 °C, 5 % CO₂, 95 % RH rated</small></dd></div>
          <div><dt>Unattended</dt><dd>14 days<small>96 wells, every 20 minutes</small></dd></div>
        </dl>
      </section>

      <!-- 2 · Statement -->
      <section class="statement" aria-labelledby="statement-title">
        <p class="kicker">01 — Why</p>
        <h2 id="statement-title" data-split data-reveal>Most imaging is an autopsy. The light that shows you a cell is the same light that ends it. We built Halo to look less, and see more.</h2>
      </section>

      <!-- 3 · Instrument -->
      <section class="instrument" id="instrument" aria-labelledby="instrument-title">
        <div class="inst-media" data-clip>
          <img src={`${A}/instrument.jpg`} alt="A compact automated imaging instrument lit in cold blue light on a laboratory bench." width="1600" height="1067" loading="lazy" decoding="async" />
          <span class="tag">Fig. 1 — reference bench, not the Halo enclosure</span>
        </div>
        <div class="inst-copy">
          <p class="kicker">02 — The instrument</p>
          <h2 id="instrument-title" data-split data-reveal>One drawer. Four channels. No darkroom.</h2>
          <ol class="parts">
            <li>
              <span class="n">01</span>
              <div><h3>Pulsed LED optics</h3><p>Each channel fires for exactly the exposure, never longer. The camera, not the specimen, does the waiting.</p></div>
              <span class="v">12× less dose</span>
            </li>
            <li>
              <span class="n">02</span>
              <div><h3>Phase-first autofocus</h3><p>Focus is found in label-free phase light, so fluorophores are only ever excited for a frame that counts.</p></div>
              <span class="v">±0.4 µm drift</span>
            </li>
            <li>
              <span class="n">03</span>
              <div><h3>Lives in the incubator</h3><p>A 26 cm footprint slides onto an incubator shelf. Cables leave through the door gasket; the culture never moves.</p></div>
              <span class="v">26 × 31 cm</span>
            </li>
          </ol>
        </div>
      </section>

      <!-- 4 · Fourteen days (pinned + scrubbed) -->
      <section class="days" id="days" aria-labelledby="days-title">
        <div class="days-inner">
          <div class="days-head">
            <p class="kicker">03 — Fourteen days</p>
            <h2 id="days-title">The same cells, the same schedule. Different light.</h2>
          </div>
          <div class="days-grid">
            <div class="counter">
              <p class="day" aria-hidden="true"><span>Day</span> <b id="day-n">14</b></p>
              <dl class="vals">
                <div><dt><i style="background:var(--c-405)"></i>Halo dose</dt><dd id="v-halo">{halo(14).toFixed(0)} %</dd></div>
                <div><dt><i style="background:var(--c-561)"></i>Standard dose</dt><dd id="v-ctrl">{control(14).toFixed(0)} %</dd></div>
              </dl>
              <ol class="notes">
                {notes.map((n) => <li data-day={n.day}><b>Day {String(n.day === 13 ? 14 : n.day).padStart(2, '0')}</b>{n.text}</li>)}
              </ol>
            </div>
            <figure class="chart">
              <svg viewBox="0 0 640 360" role="img" aria-labelledby="chart-t chart-d">
                <title id="chart-t">Confluence over fourteen days</title>
                <desc id="chart-d">Wells imaged with Halo grow from 5 to 94 percent confluence. Wells imaged at a standard widefield dose track them until day four, then decline to about 4 percent.</desc>
                {gridY.map((g) => (
                  <g>
                    <line x1={X0} x2={X1} y1={y(g)} y2={y(g)} class="grid"></line>
                    <text x={X0 - 10} y={y(g) + 4} text-anchor="end" class="ax">{g}</text>
                  </g>
                ))}
                {gridX.map((d) => <text x={x(d)} y={Y0 + 22} text-anchor="middle" class="ax">{d}</text>)}
                <path d={controlPath} class="ghost ghost-c"></path>
                <path d={haloPath} class="ghost ghost-h"></path>
                <clipPath id="drawn"><rect id="drawn-r" x="0" y="0" width={x(14)} height="360"></rect></clipPath>
                <g clip-path="url(#drawn)">
                  <path d={controlPath} class="ln ln-ctrl"></path>
                  <path d={haloPath} class="ln ln-halo"></path>
                </g>
                <line id="cursor" x1={x(14)} x2={x(14)} y1={Y1} y2={Y0} class="cur"></line>
                <circle id="dot-h" cx={x(14)} cy={y(halo(14))} r="5" class="pt pt-h"></circle>
                <circle id="dot-c" cx={x(14)} cy={y(control(14))} r="5" class="pt pt-c"></circle>
              </svg>
              <figcaption>Confluence, % of well area, by day. Illustrative curves for a fictional instrument.</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- 5 · Workflow -->
      <section class="workflow" id="workflow" aria-labelledby="wf-title">
        <div class="wf-head">
          <p class="kicker">04 — Workflow</p>
          <h2 id="wf-title" data-split data-reveal>Seed it. Slide it in. Go home.</h2>
          <p class="sub">Halo was designed around the hours you are not in the lab. Setup is a plate and a protocol; everything after that is the instrument's job.</p>
        </div>
        <ol class="steps">
          <li>
            <div class="ph" data-clip><img src={`${A}/plate.jpg`} alt="A pipette dispensing pink medium into a clear 96-well plate." width="1200" height="800" loading="lazy" decoding="async" /></div>
            <span class="n">Step 1</span>
            <h3>Seed a standard plate</h3>
            <p>Any SBS-format 6 to 384-well plate, glass or polymer bottom. No proprietary consumables, ever.</p>
          </li>
          <li>
            <div class="ph" data-clip><img src={`${A}/pipette.jpg`} alt="A scientist in blue gloves loads a multichannel pipette over a row of tubes." width="1200" height="753" loading="lazy" decoding="async" /></div>
            <span class="n">Step 2</span>
            <h3>Pick a protocol</h3>
            <p>Choose channels and an interval. Halo shows the projected light budget per well before you commit.</p>
          </li>
          <li>
            <div class="ph" data-clip><img src={`${A}/lab.jpg`} alt="A long, bright laboratory with benchtop instruments along both walls." width="1200" height="800" loading="lazy" decoding="async" /></div>
            <span class="n">Step 3</span>
            <h3>Leave</h3>
            <p>Frames stream to your server as OME-TIFF. A message reaches you only if focus, temperature or CO₂ drifts.</p>
          </li>
        </ol>
      </section>

      <!-- 6 · Channels -->
      <section class="chans" id="channels" aria-labelledby="ch-title">
        <div class="ch-head">
          <p class="kicker">05 — Channels</p>
          <h2 id="ch-title" data-split data-reveal>Three colours and a light that costs nothing.</h2>
        </div>
        <ul class="ch-list">
          {channels.map((c) => (
            <li style={`--cc:${c.color}`}>
              <span class="nm">{c.nm}</span>
              <span class="name">{c.name}</span>
              <span class="ex">{c.ex}</span>
              <span class="use">{c.use}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- 7 · Demo request -->
      <section class="demo" id="demo" aria-labelledby="demo-title">
        <div class="demo-copy">
          <p class="kicker">06 — Loan unit</p>
          <h2 id="demo-title" data-split data-reveal>Put Halo on your bench for one experiment.</h2>
          <p class="sub">We ship a loan unit, install it with you in an afternoon, and collect it after your time-lapse ends — not before. No purchase order needed to start.</p>
          <ul class="facts">
            <li><iconify-icon icon="solar:calendar-linear" aria-hidden="true"></iconify-icon>Loans run 3 to 21 days</li>
            <li><iconify-icon icon="solar:box-linear" aria-hidden="true"></iconify-icon>Shipped calibrated, plate adapters included</li>
            <li><iconify-icon icon="solar:shield-check-linear" aria-hidden="true"></iconify-icon>Your images stay on your network</li>
          </ul>
        </div>
        <form class="form" id="form" novalidate>
          <div class="row2">
            <label class="fld"><span>Name</span><input name="name" autocomplete="name" required aria-describedby="e-name" /><em id="e-name" class="err"></em></label>
            <label class="fld"><span>Institution</span><input name="org" autocomplete="organization" required aria-describedby="e-org" /><em id="e-org" class="err"></em></label>
          </div>
          <label class="fld"><span>Work e-mail</span><input name="email" type="email" autocomplete="email" required aria-describedby="e-email" /><em id="e-email" class="err"></em></label>
          <label class="fld">
            <span>Assay</span>
            <select name="assay" required aria-describedby="e-assay">
              <option value="">Choose one</option>
              <option>Proliferation & confluence</option>
              <option>Apoptosis / cytotoxicity</option>
              <option>Organoids & spheroids</option>
              <option>Migration & wound healing</option>
              <option>Something else</option>
            </select>
            <em id="e-assay" class="err"></em>
          </label>
          <label class="fld"><span>What should Halo watch? <small>(optional)</small></span><textarea name="msg" rows="3"></textarea></label>
          <button class="btn btn-ink btn-wide" type="submit"><span class="lbl">Request a loan unit</span><iconify-icon icon="solar:arrow-right-linear" aria-hidden="true"></iconify-icon></button>
          <p class="status" id="status" role="status" aria-live="polite"></p>
        </form>
      </section>
    </main>

    <footer class="foot">
      <p class="big" aria-hidden="true">Look less.<br />See more.</p>
      <div class="foot-row">
        <a class="brand" href="#top" aria-label="Vell, back to top">
          <svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true"><circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><circle cx="19" cy="14" r="6.5" fill="currentColor"></circle></svg>
          <span>Vell Instruments</span>
        </a>
        <p>Vell and Halo are fictional, made for a design specimen. Figures on this page are illustrative. Photography via Unsplash.</p>
        <a href="#top" class="totop">Back to top ↑</a>
      </div>
    </footer>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="f405"><feColorMatrix type="matrix" values="0 0 .3 0 0  0 0 .46 0 0  0 0 1.6 0 0  0 0 0 1 0"></feColorMatrix></filter>
      <filter id="f561"><feColorMatrix type="matrix" values="1.6 0 0 0 0  .3 0 0 0 0  .95 0 0 0 0  0 0 0 1 0"></feColorMatrix></filter>
      <filter id="f488"><feColorMatrix type="matrix" values="0 .9 0 0 0  0 2.6 0 0 0  0 1.45 0 0 0  0 0 0 1 0"></feColorMatrix></filter>
    </svg>
  </body>
</html>

<style is:global>
  :root {
    --bone: #e9eae4;
    --paper: #f4f4f0;
    --ink: #111311;
    --mute: #60655f;
    --line: rgb(17 19 17 / 0.14);
    --night: #0d0f0e;
    --c-405: #3247ff;
    --c-561: #ff2d8a;
    --c-488: #2fcf74;
    --ease: cubic-bezier(0.2, 0.7, 0.1, 1);
    --gut: clamp(16px, 3.4vw, 48px);
    color-scheme: light;
  }
  html { background: var(--bone); }
  html.lenis, html.lenis body { height: auto; }
  .lenis-smooth { scroll-behavior: auto !important; }
  body {
    margin: 0;
    background: var(--bone);
    color: var(--ink);
    font-family: 'Instrument Sans', ui-sans-serif, system-ui, sans-serif;
    font-variation-settings: 'wdth' 100;
    font-size: 17px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  ::selection { background: var(--c-405); color: #fff; }
  :focus-visible { outline: 2px solid var(--c-405); outline-offset: 3px; border-radius: 4px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .skip { position: absolute; left: 12px; top: -60px; z-index: 50; padding: 10px 14px; background: var(--ink); color: #fff; border-radius: 8px; }
  .skip:focus { top: 12px; }
  h1, h2, h3 { margin: 0; font-weight: 600; }
  p { margin: 0; }
  .mono, .eyebrow, .kicker, .readout, .specs dt, .n, .v, .ax, .tag, .nm, .ex { font-family: 'Geist Mono', ui-monospace, monospace; }
  .kicker { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mute); margin-bottom: 22px; }
  h2 { font-variation-settings: 'wdth' 82; letter-spacing: -0.035em; line-height: 0.98; font-size: clamp(36px, 5.4vw, 80px); }

  /* split words */
  .wm { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .w { display: inline-block; will-change: transform; }

  /* buttons */
  .btn { display: inline-flex; align-items: center; gap: 10px; height: 52px; padding: 0 22px; border-radius: 999px; font-weight: 500; font-size: 16px; text-decoration: none; border: 1px solid transparent; cursor: pointer; transition: background 0.25s var(--ease), color 0.25s var(--ease), transform 0.25s var(--ease), border-color 0.25s; font-family: inherit; }
  .btn iconify-icon { font-size: 18px; transition: transform 0.3s var(--ease); }
  .btn:hover iconify-icon { transform: translate(2px, -2px); }
  .btn:active { transform: scale(0.98); }
  .btn-ink { background: var(--ink); color: var(--paper); }
  .btn-ink:hover { background: var(--c-405); }
  .btn-line { border-color: var(--line); color: var(--ink); background: transparent; }
  .btn-line:hover { border-color: var(--ink); }
  .btn-sm { height: 40px; padding: 0 16px; font-size: 14px; }
  .btn[disabled] { opacity: 0.55; cursor: progress; }

  /* nav */
  .nav { position: absolute; inset: 0 0 auto 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 20px var(--gut); }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-weight: 600; font-size: 20px; letter-spacing: -0.02em; }
  .nav ul { display: flex; gap: 30px; list-style: none; margin: 0; padding: 0; }
  .nav ul a { color: var(--ink); text-decoration: none; font-size: 14px; position: relative; }
  .nav ul a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -4px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform 0.35s var(--ease); }
  .nav ul a:hover::after { transform: scaleX(1); }

  /* hero */
  .hero { position: relative; min-height: max(100svh, 760px); display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: 1fr auto; column-gap: clamp(24px, 4vw, 72px); padding: 96px var(--gut) 0; box-sizing: border-box; background: var(--paper); border-bottom: 1px solid var(--line); }
