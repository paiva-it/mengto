  .ch-list li::before { content: ''; position: absolute; inset: 0; background: var(--cc); opacity: 0; z-index: -1; transform: scaleY(0.2); transform-origin: bottom; transition: opacity 0.4s var(--ease), transform 0.5s var(--ease); }
  .ch-list li::after { content: ''; position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%; background: var(--cc); transform: scaleX(0); transform-origin: left; transition: transform 0.6s var(--ease); }
  .ch-list li:hover::after { transform: scaleX(1); }
  .ch-list li:hover::before { opacity: 0.06; transform: none; }
  .nm { font-size: clamp(34px, 3.4vw, 52px); font-weight: 500; letter-spacing: -0.04em; color: var(--cc); line-height: 1; }
