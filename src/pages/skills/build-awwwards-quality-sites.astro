  .notes li b { font: 500 12px/1.9 'Geist Mono', monospace; }
  .notes li.on { color: #e8e9e4; }
  .notes li.now b { color: var(--c-488); }
  .chart { margin: 0; }
  .chart svg { width: 100%; height: auto; overflow: visible; }
  .chart .grid { stroke: rgb(255 255 255 / 0.09); }
  .chart .ax { fill: #6c716b; font-size: 11px; }
