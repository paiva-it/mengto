    .days-inner { padding-top: 56px; gap: 18px; }
    .day b { font-size: 96px; }
    .vals { margin-top: 18px; padding: 12px 0; }
    .notes { margin-top: 14px; }
    .notes li:not(.now) { display: none; }
    .chart .ax { font-size: 20px; }
    .chart svg { margin-left: 18px; width: calc(100% - 18px); }
    .vals dd { font-size: 24px; }
    .notes li { font-size: 13.5px; grid-template-columns: 52px 1fr; }
    .nav .btn-sm { height: 36px; padding: 0 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition-duration: 0.01ms !important; }
  }
</style>


<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';
  import 'iconify-icon';
  import { control, halo, x, y } from '../../components/skills/build-awwwards-quality-sites/growth';
  import { mount, type Specimen } from '../../components/skills/build-awwwards-quality-sites/specimen';

  gsap.registerPlugin(ScrollTrigger);
  const params = new URLSearchParams(location.search);
  const shot = params.has('shot');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches || params.has('reduced');
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector(s) as T;
  const $$ = <T extends Element = HTMLElement>(s: string) => [...document.querySelectorAll(s)] as T[];

  // ── Split headings into words. Plain-text elements only; the unsplit sentence stays as the accessible name.
  $$('[data-split]').forEach((el) => {
    const text = el.textContent!.trim().replace(/\s+/g, ' ');
    el.innerHTML = `<span class="sr-only">${text}</span><span aria-hidden="true">${text
      .split(' ')
      .map((w) => `<span class="wm"><span class="w">${w}</span></span>`)
      .join(' ')}</span>`;
  });

  // ── Hero specimen (WebGL). Reduced motion or failure keeps the static poster and lens.
  const field = $('#field');
  const xy = $('#xy');
  let spec: Specimen | null = null;
  let lastXY = '';
  const onLens = (lx: number, ly: number) => {
    const s = `${Math.round(lx * 860)} · ${Math.round((1 - ly) * 860)} µm`;
    if (s !== lastXY) xy.textContent = lastXY = s;
  };
  const W: Record<string, [number, number, number, number]> = {
    merge: [0, 0, 0, 1],
    '405': [1, 0, 0, 0],
    '561': [0, 1, 0, 0],
    '488': [0, 0, 1, 0],
  };
  const setChannel = (ch: string) => {
    $$<HTMLButtonElement>('.seg button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.ch === ch)));
    const lensImg = $<HTMLImageElement>('.poster-lens img');
    lensImg.style.filter = ch === 'merge' ? '' : `url(#f${ch})`;
    if (!spec) return;
    const [a, b, c, m] = W[ch];
    gsap.to(spec.w, { x: a, y: b, z: c, duration: 0.6, ease: 'power2.out', overwrite: true });
    gsap.to(spec.u.uMerge, { value: m, duration: 0.6, ease: 'power2.out', overwrite: true });
  };
  $$<HTMLButtonElement>('.seg button').forEach((b) => b.addEventListener('click', () => setChannel(b.dataset.ch!)));

  // Live stage clock (decorative readout).
  const clock = $('#clock');
  let secs = 2 * 86400 + 14 * 3600 + 6 * 60 + 31;
  const tickClock = () => {
    const d = Math.floor(secs / 86400);
    const h = Math.floor((secs % 86400) / 3600);
    const m = Math.floor((secs % 3600) / 60);
    const s = secs % 60;
    clock.textContent = `${String(d).padStart(2, '0')}d ${[h, m, s].map((v) => String(v).padStart(2, '0')).join(':')}`;
    secs++;
  };
  const clockId = reduced ? 0 : window.setInterval(tickClock, 1000);

  const heroIntro = (s: Specimen | null) => {
    if (reduced) return;
    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
    tl.from('h1 .w', { yPercent: 70, opacity: 0.15, duration: 0.9, stagger: 0.035 }, 0)
      .from('.reticle', { rotate: -40, opacity: 0, duration: 1.6, ease: 'power3.out' }, 0)
      .from('.readout', { opacity: 0, y: 6, duration: 0.6, stagger: 0.08 }, 0.5)
      .from('.channels', { opacity: 0, y: 10, duration: 0.6 }, 0.8)
      .from('.specs > div', { opacity: 0, y: 14, duration: 0.7, stagger: 0.06 }, 0.4);
    if (s) tl.fromTo(s.u.uReveal, { value: 0 }, { value: 1, duration: 1.8, ease: 'power3.inOut' }, 0.1);
  };

  const boot = async () => {
    if (!reduced) {
      try {
        spec = await mount(field, '/skills/build-awwwards-quality-sites/specimen.jpg', { shot, onLens });
      } catch {
        spec = null;
      }
    }
    heroIntro(spec);
  };
  boot();

  // ── Smooth scroll: Lenis is the only engine, driven by GSAP's ticker and feeding ScrollTrigger.
  let lenis: Lenis | null = null;
  const raf = (t: number) => lenis?.raf(t * 1000);
  if (!reduced) {
    lenis = new Lenis({ lerp: 0.1, anchors: true });
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add(raf);
    gsap.ticker.lagSmoothing(0);
  }

  // ── Section choreography.
  const days = $('#days');
  const dayN = $('#day-n');
  const vHalo = $('#v-halo');
  const vCtrl = $('#v-ctrl');
  const drawn = $<SVGRectElement>('#drawn-r');
  const cur = $<SVGLineElement>('#cursor');
  const dotH = $<SVGCircleElement>('#dot-h');
  const dotC = $<SVGCircleElement>('#dot-c');
  const noteEls = $$('.notes li');
  const setDay = (d: number) => {
    dayN.textContent = String(Math.round(d)).padStart(2, '0');
    vHalo.textContent = `${halo(d).toFixed(0)} %`;
    vCtrl.textContent = `${control(d).toFixed(0)} %`;
    const cx = String(x(d));
    drawn.setAttribute('width', cx);
    cur.setAttribute('x1', cx);
    cur.setAttribute('x2', cx);
    dotH.setAttribute('cx', cx);
    dotH.setAttribute('cy', String(y(halo(d))));
    dotC.setAttribute('cx', cx);
    dotC.setAttribute('cy', String(y(control(d))));
    let now = -1;
    noteEls.forEach((li, i) => {
      const on = d >= Number(li.dataset.day) - 0.01;
      li.classList.toggle('on', on);
      if (on) now = i;
    });
    noteEls.forEach((li, i) => li.classList.toggle('now', i === now));
  };

  if (reduced) {
    setDay(14);
  } else {
    setDay(0);
    const mm = gsap.matchMedia();
    mm.add({ wide: '(min-width: 901px)', narrow: '(max-width: 900px)' }, (ctx) => {
      ScrollTrigger.create({
        trigger: days,
        start: 'top top',
        end: ctx.conditions!.wide ? '+=170%' : '+=130%',
        pin: true,
        scrub: 0.6,
        onUpdate: (self) => setDay(self.progress * 14),
      });
    });

    // Headings rise word by word, then their section's supporting copy follows.
    $$('[data-reveal]').forEach((h) => {
      const sec = h.closest('section')!;
      const tl = gsap.timeline({ scrollTrigger: { trigger: h, start: 'top 82%', once: true } });
      tl.from(h.querySelectorAll('.w'), { yPercent: 100, duration: 1, ease: 'expo.out', stagger: 0.03 });
      const support = sec.querySelectorAll('.sub, .parts li, .facts li, .form > *, .ch-list li');
      if (support.length) tl.from(support, { opacity: 0, y: 24, duration: 0.8, ease: 'power3.out', stagger: 0.06 }, 0.25);
    });

    // Images open like a shutter; the instrument photo also settles from a slight push-in.
    $$('[data-clip]').forEach((m) => {
      gsap.fromTo(m, { clipPath: 'inset(18% 10% 18% 10% round 6px)' }, { clipPath: 'inset(0% 0% 0% 0% round 6px)', duration: 1.4, ease: 'expo.out', scrollTrigger: { trigger: m, start: 'top 85%', once: true } });
    });
    gsap.fromTo('.inst-media img', { scale: 1.18 }, { scale: 1, ease: 'none', scrollTrigger: { trigger: '.inst-media', start: 'top bottom', end: 'bottom top', scrub: true } });
    gsap.from('.steps li', { y: 40, opacity: 0, duration: 1, ease: 'power3.out', stagger: 0.12, scrollTrigger: { trigger: '.steps', start: 'top 80%', once: true } });
  }

  // Measurements depend on fonts and images.
  document.fonts?.ready.then(() => ScrollTrigger.refresh());
  window.addEventListener('load', () => ScrollTrigger.refresh());

  // ── Loan-unit form: client-side validation, loading and success states (demo only; nothing is sent).
  const form = $<HTMLFormElement>('#form');
  const status = $('#status');
  const msg: Record<string, string> = {
    name: 'Tell us who to address the loan to.',
    org: 'Which lab or institution is this for?',
    email: 'We need a work e-mail we can reply to.',
    assay: 'Pick the closest assay; we prepare the right plate adapter.',
  };
  const check = (el: HTMLInputElement | HTMLSelectElement) => {
    const ok = el.checkValidity();
    el.setAttribute('aria-invalid', String(!ok));
    const err = document.getElementById(`e-${el.name}`);
    if (err) err.textContent = ok ? '' : msg[el.name];
    return ok;
  };
  const fields = $$<HTMLInputElement>('#form [required]');
  fields.forEach((el) => el.addEventListener('blur', () => el.value && check(el)));
  fields.forEach((el) => el.addEventListener('input', () => el.getAttribute('aria-invalid') === 'true' && check(el)));
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const bad = fields.filter((el) => !check(el));
    status.className = 'status';
    if (bad.length) {
      status.textContent = '';
      bad[0].focus();
      return;
    }
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true;
    btn.classList.add('loading');
    btn.querySelector('.lbl')!.textContent = 'Checking the loan calendar';
    status.textContent = '';
    window.setTimeout(() => {
      btn.classList.remove('loading');
      btn.querySelector('.lbl')!.textContent = 'Request received';
      status.classList.add('ok');
      status.textContent = 'Thank you. This is a demo page, so nothing left your browser — but a real Halo loan would start with a call this week.';
    }, 1400);
  });

  // ── Cleanup.
  window.addEventListener('pagehide', () => {
    spec?.destroy();
    lenis?.destroy();
    gsap.ticker.remove(raf);
    ScrollTrigger.getAll().forEach((t) => t.kill());
    window.clearInterval(clockId);
  });
</script>
