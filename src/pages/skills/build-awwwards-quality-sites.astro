  .channels { position: absolute; left: 50%; bottom: -10px; transform: translateX(-50%); }
  .seg { display: flex; gap: 2px; padding: 4px; background: rgb(244 244 240 / 0.86); backdrop-filter: blur(10px); border: 1px solid var(--line); border-radius: 999px; }
  .seg button { display: inline-flex; align-items: center; gap: 7px; height: 32px; padding: 0 12px; border: 0; border-radius: 999px; background: transparent; color: var(--mute); font: 500 12px/1 'Geist Mono', monospace; cursor: pointer; transition: background 0.2s, color 0.2s; }
