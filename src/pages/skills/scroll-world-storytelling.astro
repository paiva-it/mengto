---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

// Vael Chocolate Works — Batch 14, told as a thermal ledger. Mode 3 (HTML / data / type):
// semantic DOM + one inline SVG chart, driven by one native-scroll conductor.
// Story config is kept apart from the renderer: `points` is the data, `beats` the ledger.
const points = [
  { id: 'open', label: 'Open', day: 'Day 0', temp: 27 },
  { id: 'ferment', label: 'Ferment', day: 'Days 1–6', temp: 48 },
  { id: 'dry', label: 'Dry', day: 'Days 7–14', temp: 34 },
  { id: 'roast', label: 'Roast', day: 'Day 40', temp: 121 },
  { id: 'conche', label: 'Conche', day: 'Days 41–43', temp: 68 },
  { id: 'melt', label: 'Melt', day: 'Day 44', temp: 45 },
  { id: 'cool', label: 'Cool', day: 'Day 44', temp: 27 },
  { id: 'temper', label: 'Temper', day: 'Day 44', temp: 31 },
  { id: 'rest', label: 'Rest', day: 'Days 45–61', temp: 18 },
];

// `to` = index of the last chart point this beat draws to; `w` = scroll weight in viewport heights.
const beats = [
  { id: 'pod', to: 0, w: 1.2, word: 'Seed', eyebrow: '01 / Day 0 · Open', title: 'A bar begins as a wet seed.', body: 'Forty beans in sweet white pulp, cut from the tree at dawn and opened by hand before noon.', evidence: 'Pod pulp · 27 °C' },
  { id: 'ferment', to: 2, w: 1.35, word: 'Ferment', eyebrow: '02 / Days 1–14 · Box & sun', title: 'Flavour is made in the box.', body: 'Nobody adds heat. Yeasts eat the pulp, the mass warms itself to 48 °C, then a week of sun dries it to keep.', evidence: 'Peak 48 °C on day 4 · dried at 34 °C' },
  { id: 'roast', to: 3, w: 1.3, word: 'Roast', eyebrow: '03 / Day 40 · Roast', title: 'Roast low enough to taste the place.', body: 'A dark roast makes every origin taste alike. We stop at 121 °C after twenty-two minutes and keep the valley in it.', evidence: '121 °C · 22 min · drum no. 2' },
  { id: 'conche', to: 4, w: 1.15, word: 'Conche', eyebrow: '04 / Days 41–43 · Conche', title: 'Seventy-two hours of slow friction.', body: 'Granite rollers work nibs and cane sugar below 70 °C until the grit is gone and the sharp acids have aired off.', evidence: '68 °C held for 72 h' },
  { id: 'temper', to: 7, w: 1.7, word: 'Temper', eyebrow: '05 / Day 44 · Temper', title: 'The last four degrees decide the snap.', body: 'Melt to 45 °C, cool to 27 °C, lift to 31 °C. Only one crystal form survives, and it is the one that shines.', evidence: '45 → 27 → 31 °C · form V crystals' },
  { id: 'rest', to: 8, w: 1.15, word: 'Rest', eyebrow: '06 / Days 45–61 · Rest', title: 'Then it waits in the dark.', body: 'Wrapped bars rest at 18 °C for two weeks while the flavour settles. The snap stays clean; the gloss holds.', evidence: '18 °C · 17 days' },
  { id: 'batch', to: 8, w: 1.1, word: 'Batch 14', eyebrow: '07 / Batch 14', title: '1,200 bars. Two ingredients.', body: 'Seventy per cent cacao and cane sugar, from one harvest and sixty-one days of watching. Released 3 November.', evidence: null, cta: { label: 'Reserve a Batch 14 bar', href: 'mailto:workshop@vael-chocolate.example?subject=Batch%2014' } },
];

// Chart geometry (viewBox 720 × 400): x across stages, y linear 0–130 °C.
const X0 = 44, DX = 79, Y0 = 336, YH = 290, TMAX = 130;
const xy = points.map((p, i) => ({ ...p, x: X0 + i * DX, y: +(Y0 - (p.temp / TMAX) * YH).toFixed(1) }));
const path = 'M' + xy.map((p) => `${p.x} ${p.y}`).join(' L');
const grid = [0, 40, 80, 120].map((t) => ({ t, y: +(Y0 - (t / TMAX) * YH).toFixed(1) }));
const yTemper = +(Y0 - (31 / TMAX) * YH).toFixed(1);
const config = JSON.stringify({ points: xy.map(({ x, y, temp, label, day }) => ({ x, y, temp, label, day })), beats: beats.map(({ to }) => ({ to })) });
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Vael Chocolate Works — Batch 14, a thermal ledger</title>
    <meta name="description" content="Sixty-one days in the life of a chocolate bar, told through the temperatures it lives through: open, ferment, roast, conche, temper, rest." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <BackPill />

    <header class="top">
      <a class="brand" href="#pod" aria-label="Vael Chocolate Works, back to start">
        <span class="brand-mark" aria-hidden="true"></span>
        <span><b>Vael</b> Chocolate Works</span>
      </a>
      <span class="top-mid">Batch 14 · Thermal ledger</span>
      <span class="top-count" aria-hidden="true"><b id="beat-no">01</b> / 07</span>
    </header>

    <main class="layout" data-config={config}>
      <div class="chapters">
        {beats.map((b, i) => (
          <section class:list={['chapter', { 'is-active': i === 0 }]} id={b.id} style={`--w:${b.w}`} aria-labelledby={`${b.id}-h`}>
            <div class="copy">
              <span class="eyebrow">{b.eyebrow}</span>
              {i === 0
                ? <h1 id={`${b.id}-h`}>{b.title}</h1>
                : <h2 id={`${b.id}-h`}>{b.title}</h2>}
              <p>{b.body}</p>
              {b.evidence && <span class="evidence">{b.evidence}</span>}
              {b.cta && (
                <>
                  <a class="cta" href={b.cta.href}>{b.cta.label}<span aria-hidden="true">↗</span></a>
                  <span class="fineprint">Bars from Vael's own ledger. Temperatures are the maker's process notes, not lab data.</span>
                </>
              )}
            </div>
          </section>
        ))}
      </div>

      <aside class="stage-col" aria-label="Batch 14 temperature chart">
        <div class="stage">
          <div class="stage-head">
            <span>Batch 14 — the temperatures a bean lives through</span>
            <span class="hide-sm">°C · peak per stage</span>
          </div>

          <div class="figure">
            <div class="metric">
              <div class="metric-value" aria-hidden="true"><span id="temp">27</span><sup>°C</sup></div>
              <div class="metric-label"><b id="stage-name">Open</b><span id="stage-day">Day 0</span></div>
            </div>

            <svg class="chart" viewBox="0 0 720 400" role="img" aria-labelledby="chart-t chart-d">
              <title id="chart-t">Batch 14 temperature by stage</title>
              <desc id="chart-d">Peak temperature in degrees Celsius at nine stages: open 27, ferment 48, dry 34, roast 121, conche 68, melt 45, cool 27, temper 31, rest 18.</desc>
              <defs>
                <clipPath id="drawn"><rect id="drawn-rect" x="0" y="0" width="720" height="400" /></clipPath>
              </defs>
              <g class="grid">
                {grid.map((g) => (
                  <>
                    <line x1={X0 - 14} x2="706" y1={g.y} y2={g.y} />
                    <text x={X0 - 18} y={g.y - 6}>{g.t}</text>
                  </>
                ))}
              </g>
              <line class="window" x1={X0 - 14} x2="706" y1={yTemper} y2={yTemper} />
              <path class="area" clip-path="url(#drawn)" d={`${path} L${xy.at(-1)!.x} ${Y0} L${X0} ${Y0} Z`} />
              <path class="ghost" d={path} />
              <path class="trend" id="trend" d={path} />
              <line class="probe-line" id="probe-line" x1={X0} x2={X0} y1={xy[0].y} y2={Y0} />
              <g class="points">
                {xy.map((p, i) => <circle class:list={['pt', { 'is-on': i === 0 }]} cx={p.x} cy={p.y} r="6.5" />)}
              </g>
              <circle class="probe" id="probe" cx={X0} cy={xy[0].y} r="11" />
              <g class="xlabels">
                {xy.map((p, i) => (
                  <g class:list={['xl', { 'is-on': i === 0 }]}>
                    <text x={p.x} y={Y0 + 30} text-anchor="middle">{p.label}</text>
                    <text class="xl-day" x={p.x} y={Y0 + 48} text-anchor="middle">{p.day}</text>
                  </g>
                ))}
              </g>
            </svg>
          </div>

          <nav class="foot" aria-label="Chapters">
            <ol class="rail">
              {beats.map((b, i) => (
                <li><a class:list={{ 'is-on': i === 0 }} href={`#${b.id}`} aria-label={`${String(i + 1).padStart(2, '0')}: ${b.title}`}><span>{String(i + 1).padStart(2, '0')}</span></a></li>
              ))}
            </ol>
            <span class="legend hide-sm"><i class="lg-line"></i>Batch 14 <i class="lg-win"></i>Working temper 31 °C <i class="lg-dot"></i>Now</span>
          </nav>

          <div class="words" aria-hidden="true">
            {beats.map((b, i) => <span class:list={['word', { 'is-on': i === 0 }]}>{b.word}</span>)}
          </div>
        </div>

        <table class="sr-only">
          <caption>Batch 14 peak temperature by stage</caption>
          <thead><tr><th scope="col">Stage</th><th scope="col">When</th><th scope="col">°C</th></tr></thead>
          <tbody>{points.map((p) => <tr><td>{p.label}</td><td>{p.day}</td><td>{p.temp}</td></tr>)}</tbody>
        </table>
      </aside>
    </main>

    <footer class="colophon">
      <span><b>Vael</b> Chocolate Works</span>
      <span>Batch 14 · 70 % cacao · cane sugar · 1,200 bars</span>
      <span>A fictional maker, an honest process.</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --paper: #efe7d9;      /* dominant field: cocoa-butter paper */
    --paper-2: #e6dccb;
    --ink: #2a1a12;        /* roasted-nib near-black */
    --muted: #7b6a5c;
    --line: rgb(42 26 18 / 0.18);
    --red: #d6461f;        /* vermilion proof mark */
    --blue: #2348a6;       /* cobalt data line */
    --display: 'Bricolage Grotesque', 'Arial Narrow', sans-serif;
    --read: 'Newsreader', Georgia, serif;
    --top: 64px;
  }
  html { background: var(--paper); scroll-behavior: smooth; }
  body { margin: 0; min-width: 320px; background: var(--paper); color: var(--ink); font-family: var(--read); -webkit-font-smoothing: antialiased; }
  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  .top {
    position: fixed; z-index: 10; inset: 0 0 auto; height: var(--top);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px;
    padding: 0 clamp(16px, 2.4vw, 32px); border-bottom: 1px solid var(--line); background: var(--paper);
    font: 500 11px/1 var(--display); letter-spacing: 0.16em; text-transform: uppercase;
  }
  .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; justify-self: start; }
  .brand b { font-weight: 800; letter-spacing: 0.04em; font-size: 15px; font-stretch: 75%; margin-right: 4px; }
  .brand-mark { width: 18px; height: 18px; background: var(--ink); clip-path: polygon(0 0, 100% 0, 100% 62%, 62% 100%, 0 100%); }
  .top-mid { color: var(--muted); }
  .top-count { justify-self: end; font-variant-numeric: tabular-nums; }
  .top-count b { color: var(--red); font-weight: 700; }

  .layout { display: grid; grid-template-columns: minmax(340px, 0.8fr) minmax(560px, 1.2fr); }
  .chapters { border-right: 1px solid var(--line); }
  .chapter {
    min-height: calc(var(--w) * 100vh); display: flex; align-items: center;
    padding: calc(var(--top) + 8vh) clamp(24px, 4.6vw, 72px) 8vh; border-bottom: 1px solid var(--line);
  }
  .copy { max-width: 540px; }
  .js .copy { opacity: 0.2; transform: translateY(24px); transition: opacity 0.35s, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
  .js .chapter.is-active .copy { opacity: 1; transform: none; }
  .eyebrow { display: flex; align-items: center; gap: 12px; color: var(--red); font: 600 11px/1 var(--display); letter-spacing: 0.18em; text-transform: uppercase; }
  .eyebrow::before { content: ''; width: 28px; height: 2px; background: currentColor; }
  h1, h2 {
    margin: 22px 0 24px; font: 700 clamp(52px, 6.2vw, 100px)/0.86 var(--display); font-stretch: 75%;
    font-variation-settings: 'opsz' 96; letter-spacing: -0.035em; text-wrap: balance;
  }
  .copy p { margin: 0; max-width: 30em; color: #5b4a3e; font-size: clamp(18px, 1.55vw, 22px); line-height: 1.5; text-wrap: pretty; }
  .evidence { display: inline-block; margin-top: 28px; padding-top: 9px; border-top: 1.5px solid var(--ink); font: 600 11px/1 var(--display); letter-spacing: 0.14em; text-transform: uppercase; font-variant-numeric: tabular-nums; }
  .cta {
    display: inline-flex; align-items: center; gap: 18px; margin-top: 34px; padding: 18px 22px;
    background: var(--ink); color: var(--paper); text-decoration: none;
    font: 600 12px/1 var(--display); letter-spacing: 0.16em; text-transform: uppercase; transition: background 0.2s;
  }
  .cta span { color: #ff8a62; font-size: 18px; }
  .cta:hover { background: var(--red); }
  .cta:hover span { color: var(--paper); }
  .fineprint { display: block; margin-top: 18px; color: var(--muted); font-size: 14px; font-style: italic; }

  .stage-col { position: relative; }
  .stage {
    position: sticky; top: 0; height: 100vh; overflow: hidden;
    display: grid; grid-template-rows: auto 1fr auto; gap: 12px;
    padding: calc(var(--top) + 28px) clamp(24px, 3.6vw, 56px) 34px;
  }
  .stage-head { position: relative; z-index: 1; display: flex; justify-content: space-between; gap: 20px; color: var(--muted); font: 500 10px/1.4 var(--display); letter-spacing: 0.16em; text-transform: uppercase; }
  .figure { position: relative; z-index: 1; display: grid; grid-template-rows: auto auto; align-content: center; gap: clamp(20px, 4vh, 48px); min-height: 0; }
  .metric { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; border-bottom: 1px solid var(--line); padding-bottom: 14px; }
  .metric-value { display: flex; align-items: flex-start; font: 800 clamp(96px, 11vw, 176px)/0.78 var(--display); font-stretch: 75%; letter-spacing: -0.05em; font-variant-numeric: tabular-nums; }
  .metric-value sup { margin: 0.06em 0 0 0.08em; font: 600 clamp(18px, 1.6vw, 24px)/1 var(--display); letter-spacing: 0; color: var(--red); }
  .metric-label { display: grid; gap: 8px; text-align: right; font: 500 11px/1 var(--display); letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .metric-label b { color: var(--ink); font-weight: 800; font-size: clamp(22px, 2.2vw, 34px); letter-spacing: -0.01em; font-stretch: 75%; }
  .chart { display: block; width: 100%; height: auto; max-height: 52vh; overflow: visible; }
  .grid line { stroke: var(--line); stroke-width: 1; }
  .grid text { fill: var(--muted); font: 500 11px var(--display); letter-spacing: 0.08em; text-anchor: end; }
  .window { stroke: var(--red); stroke-width: 1; stroke-dasharray: 3 5; opacity: 0.7; }
  .area { fill: rgb(42 26 18 / 0.07); }
  .ghost { fill: none; stroke: var(--blue); stroke-opacity: 0.32; stroke-width: 1.5; stroke-dasharray: 2 6; stroke-linecap: round; }
  .trend { fill: none; stroke: var(--blue); stroke-width: 4; stroke-linejoin: round; stroke-linecap: round; }
  .probe-line { stroke: var(--red); stroke-width: 1; }
  .probe { fill: none; stroke: var(--red); stroke-width: 2; }
  .pt { fill: var(--paper); stroke: var(--ink); stroke-opacity: 0.35; stroke-width: 2; transition: fill 0.25s, stroke 0.25s; }
  .pt.is-on { fill: var(--blue); stroke: var(--blue); stroke-opacity: 1; }
  .pt.is-now { fill: var(--red); stroke: var(--red); }
  .xl text { fill: var(--muted); font: 600 11px var(--display); letter-spacing: 0.1em; text-transform: uppercase; transition: fill 0.25s; }
  .xl .xl-day { font-weight: 500; font-size: 10px; letter-spacing: 0.04em; text-transform: none; opacity: 0.8; }
  .xl.is-on text { fill: var(--ink); }
  .xl.is-now text:first-child { fill: var(--red); }

  .foot { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 24px; border-top: 1px solid var(--line); padding-top: 14px; }
  .rail { display: flex; gap: 6px; margin: 0; padding: 0; list-style: none; flex: 1; max-width: 520px; }
  .rail li { flex: 1; }
  .rail a { display: grid; gap: 7px; text-decoration: none; color: var(--muted); font: 600 10px/1 var(--display); letter-spacing: 0.12em; padding: 4px 0; }
  .rail a::before { content: ''; height: 3px; background: var(--line); transition: background 0.25s; }
  .rail a.is-done::before { background: var(--ink); }
  .rail a.is-on::before { background: var(--red); }
  .rail a.is-on { color: var(--ink); }
  .legend { display: flex; align-items: center; gap: 10px; color: var(--muted); font: 500 10px/1 var(--display); letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap; }
  .lg-line { width: 18px; height: 3px; background: var(--blue); }
  .lg-win { width: 18px; border-top: 1px dashed var(--red); margin-left: 8px; }
  .lg-dot { width: 9px; height: 9px; border-radius: 50%; border: 2px solid var(--red); margin-left: 8px; }

  .words { position: absolute; inset: auto 0 15% 0; pointer-events: none; white-space: nowrap; overflow: hidden; }
  .word {
    display: none; font: 800 clamp(140px, 19vw, 300px)/0.8 var(--display); font-stretch: 75%; letter-spacing: -0.05em;
    color: var(--ink); opacity: 0.05; transform: translateX(calc(8% - var(--local, 0) * 14%));
  }
  .word.is-on { display: block; }

  .colophon {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 32px; padding: 28px clamp(16px, 2.4vw, 32px) 80px;
    background: var(--ink); color: var(--paper-2); font: 500 11px/1.4 var(--display); letter-spacing: 0.14em; text-transform: uppercase;
  }
  .colophon b { font-weight: 800; }

  @media (max-width: 1100px) {
    .layout { grid-template-columns: minmax(320px, 0.85fr) minmax(0, 1.15fr); }
    .hide-sm { display: none; }
  }

  @media (max-width: 900px) {
    :root { --top: 54px; --stage: 40svh; }
    .top { grid-template-columns: 1fr auto; }
    .top-mid { display: none; }
    .layout { display: block; }
    .stage-col { position: fixed; z-index: 5; inset: var(--top) 0 auto; height: var(--stage); background: var(--paper); border-bottom: 1px solid var(--ink); }
    .stage { height: var(--stage); padding: 14px 16px 10px; gap: 6px; }
    .stage-head { font-size: 9px; }
    .metric { padding-bottom: 8px; }
    .metric-value { font-size: clamp(64px, 19vw, 110px); }
    .metric-label b { font-size: 22px; }
    .figure { grid-template-rows: auto 1fr; align-content: stretch; gap: 4px; }
    .chart { height: 100%; max-height: none; }
    .xl:not(.is-now) text { display: none; }
    .xl .xl-day { display: none; }
    .xl text { font-size: 20px; }
    .grid text { font-size: 16px; }
    .rail a { font-size: 0; gap: 0; padding: 6px 0; }
    .words { display: none; }
    .chapters { margin-top: calc(var(--top) + var(--stage)); border-right: 0; }
    .chapter { min-height: calc(var(--w) * 56svh); padding: 32px 16px 40px; }
    h1, h2 { font-size: clamp(44px, 13vw, 72px); margin: 16px 0 16px; }
    .copy p { font-size: 17px; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .js .copy, .pt, .xl text, .rail a::before { transition: none; }
    .js .copy { transform: none; }
    .words { display: none; }
  }
</style>

<script>
  // One scroll conductor: native scroll → beat + local progress → continuous chart position.
  document.documentElement.classList.add('js');

  type Pt = { x: number; y: number; temp: number; label: string; day: string };
  const root = document.querySelector<HTMLElement>('.layout')!;
  const { points, beats } = JSON.parse(root.dataset.config!) as { points: Pt[]; beats: { to: number }[] };
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
  const $$ = (s: string) => [...document.querySelectorAll<HTMLElement | SVGElement>(s)];
  const chapters = $$('.chapter') as HTMLElement[];
  const dots = $$('.pt');
  const xls = $$('.xl');
  const rail = $$('.rail a');
  const words = $$('.word') as HTMLElement[];
  const trend = $<SVGPathElement>('#trend');
  const probe = $<SVGCircleElement>('#probe');
  const probeLine = $<SVGLineElement>('#probe-line');
  const drawnRect = $<SVGRectElement>('#drawn-rect');
  const tempEl = $('#temp');
  const nameEl = $('#stage-name');
  const dayEl = $('#stage-day');
  const beatNo = $('#beat-no');
  const stageCol = $<HTMLElement>('.stage-col');

  // Cumulative path length at each point, in viewBox units (matches stroke-dasharray units).
  const cum = points.reduce<number[]>((a, p, i) => (a.push(i ? a[i - 1] + Math.hypot(p.x - points[i - 1].x, p.y - points[i - 1].y) : 0), a), []);
  const total = cum.at(-1)!;
  trend.style.strokeDasharray = `${total} ${total}`;

  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  // Dwell at both ends of a beat; motion happens in the middle 70 %. Endpoints are unchanged.
  const ease = (t: number) => { const u = clamp((t - 0.15) / 0.7); return u * u * (3 - 2 * u); };

  let lastBeat = -1;
  let lastNow = -1;

  const update = () => {
    // Reference line: middle of what is visible below any fixed stage (mobile stacks the stage on top).
    const stageBottom = getComputedStyle(stageCol).position === 'fixed' ? stageCol.getBoundingClientRect().bottom : 0;
    const ref = stageBottom + (innerHeight - stageBottom) * 0.45;
    let beat = 0;
    chapters.forEach((c, i) => { if (c.getBoundingClientRect().top <= ref) beat = i; });
    const r = chapters[beat].getBoundingClientRect();
    const local = clamp((ref - r.top) / r.height);
    const from = beat ? beats[beat - 1].to : 0;
    const to = beats[beat].to;
    const pos = reduced.matches ? to : from + (to - from) * ease(local);

    // Interpolate along the polyline.
    const i = Math.min(points.length - 2, Math.floor(pos));
    const f = pos - i;
    const a = points[i], b = points[i + 1];
    const x = a.x + (b.x - a.x) * f, y = a.y + (b.y - a.y) * f;
    const len = cum[i] + (cum[i + 1] - cum[i]) * f;
    trend.style.strokeDashoffset = String(total - len);
    drawnRect.setAttribute('width', String(x));
    probe.setAttribute('cx', String(x)); probe.setAttribute('cy', String(y));
    probeLine.setAttribute('x1', String(x)); probeLine.setAttribute('x2', String(x)); probeLine.setAttribute('y1', String(y));
    tempEl.textContent = String(Math.round(a.temp + (b.temp - a.temp) * f));
    words[beat].style.setProperty('--local', reduced.matches ? '0' : local.toFixed(3));

    const now = Math.round(pos);
    if (now !== lastNow) {
      dots.forEach((d, k) => { d.classList.toggle('is-on', k <= now); d.classList.toggle('is-now', k === now); });
      xls.forEach((d, k) => { d.classList.toggle('is-on', k <= now); d.classList.toggle('is-now', k === now); });
      nameEl.textContent = points[now].label;
      dayEl.textContent = points[now].day;
      lastNow = now;
    }
    if (beat !== lastBeat) {
      chapters.forEach((c, k) => c.classList.toggle('is-active', k === beat));
      rail.forEach((l, k) => { l.classList.toggle('is-on', k === beat); l.classList.toggle('is-done', k < beat); if (k === beat) l.setAttribute('aria-current', 'step'); else l.removeAttribute('aria-current'); });
      words.forEach((w, k) => w.classList.toggle('is-on', k === beat));
      beatNo.textContent = String(beat + 1).padStart(2, '0');
      lastBeat = beat;
    }
  };

  // Coalesce scroll/resize into one frame; no loop runs while the page is still.
  let queued = false;
  const schedule = () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; update(); }); } };
  addEventListener('scroll', schedule, { passive: true });
  addEventListener('resize', schedule, { passive: true });
  reduced.addEventListener('change', schedule);
  update();
</script>
