---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

const img = (f: string) => `/skills/gsap/${f}`;

// Hero fan: each card's resting pose. x/y in px at 1100px stage width, scaled down in JS.
const days = [
  { n: '01', name: 'Arrive', title: 'Salt on the skin', tone: 'blue', items: ['17:00 · Welcome circle on the terrace', '19:30 · Island supper, no menus'] },
  { n: '02', name: 'Ground', title: 'Feet before thoughts', tone: 'lav', items: ['06:40 · Sunrise vinyasa', '18:00 · Sound bath in the lava cave'] },
  { n: '03', name: 'Open', title: 'Hips, then horizon', tone: 'cyan', items: ['07:30 · Long-hold yin', '15:00 · Cliff path to Fajã do Ouvidor'] },
  { n: '04', name: 'Quiet', title: 'A day without words', tone: 'glass', items: ['All day · Noble silence', '16:00 · Walking meditation, slow tea'] },
  { n: '05', name: 'Water', title: 'Breath under the swell', tone: 'red', items: ['07:00 · Sea swim + 4·4·6 holds', '18:30 · Restorative flow'] },
  { n: '06', name: 'Fire', title: 'The strong one', tone: 'violet', items: ['06:40 · Ninety-minute flow', '21:00 · Bonfire on the black beach'] },
  { n: '07', name: 'Return', title: 'Carry it home', tone: 'white', items: ['08:00 · Closing circle', '10:00 · A letter we post you in May'] },
];

const counters = [
  { v: 12, l: 'mats a week, never thirteen' },
  { v: 7, l: 'nights above the Atlantic' },
  { v: 3, l: 'teachers, all living on the island' },
  { v: 0, l: 'phones at the supper table' },
];

const dates = [
  { d: '11 – 17 May', s: 'Spring tides, whales offshore', left: 3 },
  { d: '08 – 14 June', s: 'Longest evenings of the year', left: 7 },
  { d: '14 – 20 September', s: 'Warm sea, first rains', left: 12 },
];
---
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lull — a slow yoga week on São Jorge</title>
    <meta name="description" content="Lull is a seven-day dusk yoga retreat for twelve guests on the cliffs of Ponta Erva, São Jorge, Azores." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body>
    <div class="flare" aria-hidden="true"></div>
    <canvas id="dots" aria-hidden="true"></canvas>

    <!-- ───────────── HERO: draggable practice cards ───────────── -->
    <section class="hero" id="top">
      <div class="frame" aria-hidden="true">
        <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
        <div class="diag"></div><div class="guide-v"></div><div class="guide-h"></div>
      </div>

      <header class="nav" data-intro>
        <a href="#top" class="logo" aria-label="Lull, home">
          <span class="logo-mark"><span></span></span>Lull.
        </a>
        <nav aria-label="Sections">
          <a href="#breath">Breath</a><a href="#days">The week</a><a href="#teachers">Teachers</a><a href="#book">Dates</a>
        </nav>
        <a href="#book" class="pill-btn">Hold a mat</a>
      </header>

      <div class="hero-copy">
        <p class="eyebrow" data-intro>Ponta Erva · São Jorge, Azores · 12 mats a week</p>
        <h1 class="title" id="hero-title">Arrange your slow week</h1>
        <p class="sub" data-intro>Grab the practices and set them in whatever order your body asks for. Nothing here is fixed&nbsp;— not even the sunset.</p>
      </div>

      <div class="stage-wrap">
        <div class="stage" id="stage">
          <article class="card c-blue" data-pose="-375,60,-18,0.86" aria-label="Sunrise vinyasa">
            <div class="grid-tex"></div>
            <div class="card-in">
              <span class="tag">SUNRISE · 06:40</span>
              <div><div class="rule"></div><h3>Salt<br />water<br />vinyasa</h3></div>
            </div>
          </article>

          <article class="card c-lav" data-pose="-200,20,-9,0.95" aria-label="Yin practice">
            <div class="card-in dark">
              <span class="tag">STILLNESS</span>
              <h3>Yin until<br />the tide<br />turns</h3>
            </div>
            <div class="block"></div>
          </article>

          <article class="card c-cyan" data-pose="200,20,11,0.95" aria-label="Sound bath">
            <div class="cyan-top">
              <div class="meter">
                <div class="meter-row"><span>Inhale</span><b style="width:44%"></b></div>
                <div class="meter-row"><span>Hold</span><b style="width:44%" class="o"></b></div>
                <div class="meter-row"><span>Exhale</span><b style="width:66%"></b></div>
                <div class="wave" aria-hidden="true">{Array.from({ length: 18 }, () => <i></i>)}</div>
              </div>
            </div>
            <div class="cyan-bot">
              <div class="tail"></div>
              <h3>SOUND<br />BATH IN<br />THE LAVA<br />CAVE</h3>
            </div>
          </article>

          <article class="card c-red" data-pose="375,60,20,0.86" aria-label="Breath lead Mara Quental">
            <img src={img('mara.jpg')} alt="" class="red-img" />
            <div class="red-shade"></div>
            <div class="red-txt"><span>BREATH LEAD</span><h3>Mara</h3></div>
          </article>

          <article class="card c-glass" data-pose="0,0,0,1.04" aria-label="Lull retreat">
            <div class="glass-in">
              <img src={img('ines.webp')} alt="" class="glass-img" />
              <div class="dotmx"></div><div class="noise"></div><div class="vignette"></div>
              <div class="glass-txt">
                <span>LULL RETREAT · No. 14</span>
                <h2><span>Seven days</span><span>of unhurried</span><span class="row">breath <i class="ring"></i></span></h2>
              </div>
            </div>
          </article>
        </div>
      </div>

      <div class="hero-foot" data-intro>
        <span class="hint"><span class="hand" aria-hidden="true"></span>Drag any card · it floats where you leave it</span>
        <button type="button" class="ghost-btn" id="shuffle">Shuffle the week</button>
      </div>
    </section>

    <!-- ───────────── BREATH: a looping timeline ───────────── -->
    <section class="breath" id="breath">
      <div class="breath-copy">
        <p class="eyebrow" data-reveal>Every class opens the same way</p>
        <h2 class="h2" data-split>Four in, four held, six out.</h2>
        <p class="body" data-reveal>Before a single pose, Mara counts the room into one rhythm. Twelve people, one breath, sixteen seconds long. Follow the circle — it is the same clock we use on the mat.</p>
        <ol class="phases" data-reveal>
          <li data-phase="inhale"><b>Inhale</b><span>4 s</span></li>
          <li data-phase="hold"><b>Hold</b><span>4 s</span></li>
          <li data-phase="exhale"><b>Exhale</b><span>6 s</span></li>
          <li data-phase="rest"><b>Rest</b><span>2 s</span></li>
        </ol>
        <button type="button" class="ghost-btn" id="breath-toggle" aria-pressed="false">Pause the breath</button>
      </div>
      <div class="clock" data-reveal aria-live="off">
        <div class="clock-ring r1"></div><div class="clock-ring r2"></div><div class="clock-ring r3"></div>
        <svg class="arc" viewBox="0 0 200 200" aria-hidden="true">
          <circle cx="100" cy="100" r="92" class="arc-bg" />
          <circle cx="100" cy="100" r="92" class="arc-fg" id="arc" />
        </svg>
        <div class="orb" id="orb"></div>
        <div class="clock-label"><b id="phase-name">Inhale</b><span id="phase-count">4</span></div>
      </div>
    </section>

    <!-- ───────────── DAYS: pinned horizontal scrub ───────────── -->
    <section class="days" id="days">
      <div class="days-head">
        <div>
          <p class="eyebrow">The week, day by day</p>
          <h2 class="h2">Seven days, one direction:<br />slower.</h2>
        </div>
        <div class="progress" aria-hidden="true"><i id="days-bar"></i></div>
      </div>
      <div class="track" id="track">
        {days.map((d) => (
          <article class={`day t-${d.tone}`}>
            <div class="day-top"><span class="day-n">{d.n}</span><span class="tag">{d.name.toUpperCase()}</span></div>
            <h3>{d.title}</h3>
            <ul>{d.items.map((i) => <li>{i}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <!-- ───────────── TEACHERS + counters ───────────── -->
    <section class="teachers" id="teachers">
      <div class="counters">
        {counters.map((c) => (
          <div class="counter" data-reveal>
            <b data-count={c.v}>{c.v}</b>
            <span>{c.l}</span>
          </div>
        ))}
      </div>

      <h2 class="h2 center" data-split>Three teachers. All of them live here.</h2>

      <div class="t-grid">
        <article class="t-card" data-reveal>
          <div class="t-media red-tint"><img src={img('mara.jpg')} alt="Mara Quental, portrait" loading="lazy" /></div>
          <div class="t-meta"><span class="tag">BREATH & PRANAYAMA</span><h3>Mara Quental</h3><p>Free-diver turned teacher. Twelve years of counting breaths under the swell off Velas.</p></div>
        </article>
        <article class="t-card" data-reveal>
          <div class="t-media lav-tint"><img src={img('ines.webp')} alt="Inês Valadão, portrait" loading="lazy" /></div>
          <div class="t-meta"><span class="tag">YIN & STILLNESS</span><h3>Inês Valadão</h3><p>Leads the silent day. Holds a pose longer than you think you can, and then a little longer.</p></div>
        </article>
        <article class="t-card" data-reveal>
          <div class="t-media sound">
            <div class="bars" aria-hidden="true">{Array.from({ length: 24 }, () => <i></i>)}</div>
            <span class="sound-cap">Gruta do Fogo · 18:00</span>
          </div>
          <div class="t-meta"><span class="tag">SOUND & REST</span><h3>Tomé Ávila</h3><p>Plays bowls and a hand-built drum inside a lava tube where the echo lasts nine seconds.</p></div>
        </article>
      </div>
    </section>

    <!-- ───────────── BOOK ───────────── -->
    <section class="book" id="book">
      <div class="book-card" data-reveal>
        <div class="book-l">
          <p class="eyebrow">2027 weeks</p>
          <h2 class="h2">Hold one of<br />twelve mats.</h2>
          <p class="body">€1&nbsp;840 in a shared stone room, €2&nbsp;260 on your own. Meals, ferries from Pico and every class included. We reply by hand within two days.</p>
          <a href="mailto:mats@lull.example" class="magnet" id="magnet"><span>Request a mat</span></a>
        </div>
        <ul class="dates">
          {dates.map((d) => (
            <li data-reveal>
              <div><b>{d.d}</b><span>{d.s}</span></div>
              <em>{d.left === 12 ? 'Open' : `${d.left} left`}</em>
            </li>
          ))}
        </ul>
      </div>
      <footer class="foot">
        <span class="logo small"><span class="logo-mark"><span></span></span>Lull.</span>
        <span>Ponta Erva, São Jorge · Azores</span>
        <span>A fictional retreat, built to show GSAP motion.</span>
      </footer>
    </section>

    <BackPill />

    <script>
      import * as THREE from 'three';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { Draggable } from 'gsap/Draggable';
      import { InertiaPlugin } from 'gsap/InertiaPlugin';
      import { SplitText } from 'gsap/SplitText';

      gsap.registerPlugin(ScrollTrigger, Draggable, InertiaPlugin, SplitText);
      // ponytail: wall-clock time — on a starved GPU (software WebGL) default lag smoothing stalls the intro for seconds
      gsap.ticker.lagSmoothing(0);

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector(s) as unknown as T;
      const $$ = <T extends Element = HTMLElement>(s: string) => Array.from(document.querySelectorAll(s)) as unknown as T[];

      /* ── WebGL dot field (Three.js), rendered on the GSAP ticker ── */
      const initDots = () => {
        const canvas = $<HTMLCanvasElement>('#dots');
        let renderer: THREE.WebGLRenderer;
        try {
          renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false });
        } catch {
          canvas.remove(); // ponytail: no WebGL → the CSS flare alone carries the background
          return;
        }
        renderer.setPixelRatio(Math.min(devicePixelRatio, 1.5));
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(45, 1, 1, 1000);
        camera.position.z = 100;
        const N = 44;
        const pos = new Float32Array(N * N * 3);
        const off = new Float32Array(N * N);
        for (let i = 0; i < N * N; i++) {
          pos[i * 3] = ((i % N) - N / 2) * 10;
          pos[i * 3 + 1] = Math.random() * 10 - 15;
          pos[i * 3 + 2] = (Math.floor(i / N) - N / 2) * 10;
          off[i] = Math.random() * Math.PI * 2;
        }
        const geo = new THREE.BufferGeometry();
        geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
        geo.setAttribute('aOffset', new THREE.BufferAttribute(off, 1));
        const mat = new THREE.ShaderMaterial({
          transparent: true,
          depthWrite: false,
          uniforms: { uTime: { value: 0 } },
          vertexShader: `
            uniform float uTime; attribute float aOffset; varying float vA;
            void main(){
              float p = sin(uTime*0.5 + aOffset)*0.5 + 0.5;
              vec4 mv = modelViewMatrix * vec4(position,1.0);
              gl_Position = projectionMatrix * mv;
              vA = smoothstep(-160.0, 40.0, mv.z) * (0.12 + 0.34*p);
              gl_PointSize = (2.0 + p*1.6) * (100.0 / -mv.z);
            }`,
          fragmentShader: `
            varying float vA;
            void main(){ if(length(gl_PointCoord-0.5)>0.5) discard; gl_FragColor = vec4(0.92,0.86,1.0,vA); }`,
        });
        const pts = new THREE.Points(geo, mat);
        pts.rotation.x = Math.PI * 0.4;
        pts.position.y = -20;
        scene.add(pts);

        const resize = () => {
          camera.aspect = innerWidth / innerHeight;
          camera.updateProjectionMatrix();
          renderer.setSize(innerWidth, innerHeight, false);
        };
        addEventListener('resize', resize);
        resize();

        const mouse = { x: 0, y: 0 };
        addEventListener('pointermove', (e) => {
          mouse.x = (e.clientX - innerWidth / 2) * 0.025;
          mouse.y = (e.clientY - innerHeight / 2) * 0.025;
        });
        const render = (time = 0) => {
          mat.uniforms.uTime.value = time;
          camera.position.x += (mouse.x - camera.position.x) * 0.03;
          camera.position.y += (-mouse.y + 10 - camera.position.y) * 0.03;
          camera.lookAt(scene.position);
          renderer.render(scene, camera);
        };
        if (reduce) {
          camera.position.y = 10;
          render(2);
          addEventListener('resize', () => render(2));
        } else {
          gsap.ticker.add((t) => render(t));
        }
      };
      initDots();

      /* ── Hero: entrance timeline + Draggable cards ── */
      const hero = $('.hero');
      const stage = $('#stage');
      const cards = $$<HTMLElement>('.card');
      const poses = cards.map((c) => {
        const [x, y, rotation, scale] = c.dataset.pose!.split(',').map(Number);
        return { x, y, rotation, scale };
      });
      const floats = new Map<HTMLElement, gsap.core.Tween>();
      let topZ = 50;

      const fit = () => {
        const f = gsap.utils.clamp(0.5, 1, Math.min(innerWidth / 1180, innerHeight / 1090));
        gsap.set(stage, { scale: f });
      };
      fit();
      addEventListener('resize', fit);

      const float = (card: HTMLElement) => {
        if (reduce) return;
        floats.get(card)?.kill();
        floats.set(
          card,
          gsap.to(card, {
            y: `+=${gsap.utils.random(-9, 9)}`,
            rotation: `+=${gsap.utils.random(-1.5, 1.5)}`,
            duration: gsap.utils.random(3, 5),
            repeat: -1,
            yoyo: true,
            ease: 'sine.inOut',
          }),
        );
      };

      const intro = () => {
        const split = SplitText.create('#hero-title', { type: 'chars,words', charsClass: 'ch' });
        const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
        gsap.set('#hero-title', { visibility: 'visible' });
        tl.fromTo('.frame', { autoAlpha: 0 }, { autoAlpha: 1, duration: 1.2 }, 0)
          .from('.nav', { y: -16, autoAlpha: 0, duration: 0.8 }, 0.1)
          .from('.hero .eyebrow', { y: 12, autoAlpha: 0, duration: 0.7 }, 0.2)
          .from(split.chars, { yPercent: 80, autoAlpha: 0, duration: 0.9, stagger: { each: 0.02, from: 'center' }, clearProps: 'transform' }, 0.2)
          .from('.hero .sub', { y: 16, autoAlpha: 0, duration: 0.8 }, '-=0.6')
          .addLabel('cards', 0.35)
          .from('.hero-foot', { y: 12, autoAlpha: 0, duration: 0.8 }, 'cards+=0.8');
        cards.forEach((card, i) => {
          const p = poses[i];
          tl.fromTo(
            card,
            { x: p.x * 1.5, y: p.y + 180, rotation: p.rotation * 1.6, scale: p.scale * 0.8, autoAlpha: 0 },
            { x: p.x, y: p.y, rotation: p.rotation, scale: p.scale, autoAlpha: 1, duration: 1.25, ease: 'back.out(1.25)', onComplete: () => float(card) },
            `cards+=${i * 0.08}`,
          );
        });
      };

      const rest = () => {
        cards.forEach((card, i) => gsap.set(card, { ...poses[i], autoAlpha: 1 }));
        gsap.set('.frame, .hero [data-intro], #hero-title', { autoAlpha: 1 });
      };

      cards.forEach((card) => {
        const tilt = gsap.quickTo(card, 'rotation', { duration: 0.5, ease: 'power3.out' });
        let base = 0;
        Draggable.create(card, {
          type: 'x,y',
          bounds: hero,
          inertia: !reduce,
          edgeResistance: 0.7,
          zIndexBoost: false,
          onPress() {
            gsap.killTweensOf(card);
            floats.get(card)?.kill();
            card.style.zIndex = String(++topZ);
            base = gsap.getProperty(card, 'rotation') as number;
            gsap.to(card, { scale: '+=0.04', duration: 0.3, ease: 'power2.out' });
            card.classList.add('lifted');
          },
          onDrag() {
            tilt(base + gsap.utils.clamp(-14, 14, this.deltaX * 1.2));
          },
          onRelease() {
            tilt(base);
            gsap.to(card, { scale: '-=0.04', duration: 0.5, ease: 'power2.out' });
            card.classList.remove('lifted');
          },
          onThrowComplete() {
            float(card);
          },
          onClick() {
            float(card);
          },
        });
      });

      // Keyboard-reachable: re-fan the cards in a new order with one timeline.
      $('#shuffle').addEventListener('click', () => {
        const order = gsap.utils.shuffle([...poses.keys()]);
        const tl = gsap.timeline({ defaults: { duration: reduce ? 0 : 1.1, ease: 'expo.inOut' } });
        cards.forEach((card, i) => {
          floats.get(card)?.kill();
          const p = poses[order[i]];
          card.style.zIndex = String(p.scale > 1 ? 40 : p.scale > 0.9 ? 30 : 20);
          tl.to(card, { ...p, onComplete: () => float(card) }, i * 0.05);
        });
      });

      /* ── Breath clock: one looping timeline with labels ── */
      const phases = [
        { id: 'inhale', name: 'Inhale', d: 4, scale: 1.6 },
        { id: 'hold', name: 'Hold', d: 4, scale: 1.6 },
        { id: 'exhale', name: 'Exhale', d: 6, scale: 1 },
        { id: 'rest', name: 'Rest', d: 2, scale: 1 },
      ];
      const arc = $<SVGCircleElement>('#arc');
      const LEN = 2 * Math.PI * 92;
      gsap.set(arc, { strokeDasharray: LEN, strokeDashoffset: LEN });
      const nameEl = $('#phase-name');
      const countEl = $('#phase-count');
      const chips = $$('.phases li');
      let shown = '';
      const breath = gsap.timeline({
        repeat: -1,
        paused: true,
        onUpdate() {
          let t = this.time();
          for (const ph of phases) {
            if (t < ph.d || ph.id === 'rest') {
              const left = String(Math.max(1, Math.ceil(ph.d - t)));
              const key = ph.id + left;
              if (key !== shown) {
                shown = key;
                nameEl.textContent = ph.name;
                countEl.textContent = left;
                chips.forEach((c) => c.classList.toggle('on', c.dataset.phase === ph.id));
              }
              break;
            }
            t -= ph.d;
          }
        },
      });
      phases.forEach((ph) => {
        breath.addLabel(ph.id).to('#orb', { scale: ph.scale, duration: ph.d, ease: ph.id === 'hold' || ph.id === 'rest' ? 'none' : 'sine.inOut' });
      });
      breath
        .to('.clock-ring', { scale: 1.14, autoAlpha: 0.55, stagger: 0.25, duration: 4, ease: 'sine.inOut' }, 'inhale')
        .to('.clock-ring', { scale: 1, autoAlpha: 1, stagger: 0.25, duration: 6, ease: 'sine.inOut' }, 'exhale')
        .fromTo(arc, { strokeDashoffset: LEN }, { strokeDashoffset: 0, duration: 16, ease: 'none' }, 0);
      breath.progress(0.001);

      const toggle = $<HTMLButtonElement>('#breath-toggle');
      let userPaused = reduce;
      const sync = () => {
        toggle.textContent = userPaused ? 'Play the breath' : 'Pause the breath';
        toggle.setAttribute('aria-pressed', String(userPaused));
      };
      sync();
      toggle.addEventListener('click', () => {
        userPaused = !userPaused;
        userPaused ? breath.pause() : breath.play();
        sync();
      });
      ScrollTrigger.create({
        trigger: '.breath',
        start: 'top 75%',
        end: 'bottom 25%',
        onToggle: (self) => (self.isActive && !userPaused ? breath.play() : breath.pause()),
      });

      /* ── Sound bars (teacher card + hero cyan card) ── */
      if (!reduce) {
        gsap.to('.bars i, .wave i', {
          scaleY: () => gsap.utils.random(0.2, 1),
          duration: 0.6,
          ease: 'sine.inOut',
          repeat: -1,
          repeatRefresh: true,
          stagger: { each: 0.04, from: 'center' },
        });
      }

      /* ── Scroll choreography (motion only) ── */
      const mm = gsap.matchMedia();
      mm.add('(prefers-reduced-motion: no-preference)', () => {
        // Line-masked heading reveals
        $$('[data-split]').forEach((h) => {
          SplitText.create(h, {
            type: 'lines',
            mask: 'lines',
            autoSplit: true,
            onSplit: (s) =>
              gsap.from(s.lines, { yPercent: 105, duration: 1, ease: 'expo.out', stagger: 0.1, scrollTrigger: { trigger: h, start: 'top 85%' } }),
          });
        });

        ScrollTrigger.batch('[data-reveal]', {
          start: 'top 88%',
          onEnter: (els) => gsap.fromTo(els, { y: 40, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.9, ease: 'power3.out', stagger: 0.09, overwrite: true }),
        });

        // Pinned horizontal scrub through the seven days
        const track = $('#track');
        const dist = () => Math.max(0, track.scrollWidth - innerWidth + 32);
        gsap
          .timeline({
            scrollTrigger: { trigger: '.days', start: 'top top', end: () => `+=${dist()}`, pin: true, scrub: 1, invalidateOnRefresh: true },
          })
          .to(track, { x: () => -dist(), ease: 'none' }, 0)
          .fromTo('#days-bar', { scaleX: 0 }, { scaleX: 1, ease: 'none' }, 0);

        // Counters tick up once
        $$('[data-count]').forEach((el) => {
          const v = Number(el.dataset.count);
          const o = { n: v === 0 ? 9 : 0 };
          gsap.to(o, {
            n: v,
            duration: 1.6,
            ease: 'power2.out',
            snap: { n: 1 },
            onUpdate: () => (el.textContent = String(o.n)),
            scrollTrigger: { trigger: el, start: 'top 90%' },
          });
        });

        // Magnetic CTA via quickTo
        const mag = $('#magnet');
        const mx = gsap.quickTo(mag, 'x', { duration: 0.5, ease: 'power3.out' });
        const my = gsap.quickTo(mag, 'y', { duration: 0.5, ease: 'power3.out' });
        const onMove = (e: PointerEvent) => {
          const r = mag.getBoundingClientRect();
          mx((e.clientX - r.left - r.width / 2) * 0.3);
          my((e.clientY - r.top - r.height / 2) * 0.3);
        };
        const onLeave = () => (mx(0), my(0));
        mag.addEventListener('pointermove', onMove);
        mag.addEventListener('pointerleave', onLeave);
        return () => {
          mag.removeEventListener('pointermove', onMove);
          mag.removeEventListener('pointerleave', onLeave);
        };
      });

      // Chars split is font-agnostic, so the intro starts now; line splits use autoSplit for late fonts.
      reduce ? rest() : intro();
      document.fonts.ready.then(() => ScrollTrigger.refresh());
      addEventListener('load', () => ScrollTrigger.refresh());
    </script>

