      .clock-label b { color: var(--lav-ink); font-size: 13px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; }
      .clock-label span { min-width: 1ch; font-size: 40px; font-weight: 600; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }

      /* ── days ── */
      .days { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; gap: 40px; padding: 72px 0; box-sizing: border-box; overflow: hidden; }
