      .red-tint { background: var(--red); }
      .lav-tint { background: var(--lav-ink); }
      .sound { background: linear-gradient(to bottom, var(--cyan-a), var(--cyan-b)); display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 22px; }
