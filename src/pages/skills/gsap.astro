      .counter b { font-size: clamp(48px, 6vw, 80px); font-weight: 600; line-height: 1; letter-spacing: -0.06em; font-variant-numeric: tabular-nums; background: linear-gradient(to bottom, var(--ink), var(--ink-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .counter span { font-size: 14px; color: var(--muted); }
