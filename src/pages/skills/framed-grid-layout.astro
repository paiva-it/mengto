---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

// Seeded RNG so the generated tile art is identical on every build.
const rng = (seed: number) => () => {
  seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

const INK = '#18181b';
const ACCENT = '#e5533d';
const greys = ['#ecece8', '#dcdcd7', '#c9c9c3', '#b0b0aa', '#8f8f89', '#6b6b66'];

// One small SVG per game, all drawn on a square cell grid like the games themselves.
const tileArt = (mode: 'tide' | 'market' | 'siege', seed: number) => {
  const r = rng(seed);
  // 4:3 boards: n columns × m rows
  const n = mode === 'siege' ? 8 : mode === 'market' ? 12 : 16;
  const m = (n * 3) / 4;
  const s = 240 / n;
  const out: string[] = [];
  for (let y = 0; y < m; y++) {
    for (let x = 0; x < n; x++) {
      let fill = greys[0];
      if (mode === 'tide') {
        const h = 0.5 + 0.3 * Math.sin(x * 0.55 + 1.3) * Math.cos(y * 0.5 + 0.4) + 0.18 * Math.sin((x - y) * 0.42) + (r() - 0.5) * 0.12;
        fill = h < 0.42 ? 'url(#hatch)' : greys[Math.min(5, Math.floor((h - 0.42) * 9) + 1)];
      } else if (mode === 'market') {
        const lane = x % 3 === 1 || y % 3 === 1;
        fill = lane ? greys[0] : greys[1 + Math.floor(r() * 4)];
      } else {
        fill = (x + y) % 2 ? greys[1] : greys[0];
      }
      out.push(`<rect x="${x * s}" y="${y * s}" width="${s}" height="${s}" fill="${fill}"/>`);
    }
  }
  if (mode === 'tide') {
    // A dyke being plotted, with the cursor on its newest tile.
    const ring = [[5, 9], [6, 9], [7, 9], [8, 9], [9, 9], [10, 9], [10, 8], [10, 7], [10, 6]];
    ring.forEach(([x, y]) => out.push(`<rect x="${x * s}" y="${y * s}" width="${s}" height="${s}" fill="${INK}"/>`));
    out.push(`<rect x="${10 * s + 1}" y="${5 * s + 1}" width="${s - 2}" height="${s - 2}" fill="none" stroke="${ACCENT}" stroke-width="2"/>`);
  }
  if (mode === 'market') {
    out.push(`<rect x="${6 * s}" y="${3 * s}" width="${2 * s}" height="${s}" fill="${ACCENT}"/>`);
  }
  if (mode === 'siege') {
    const pieces = [[0, 0, 1], [2, 0, 1], [4, 1, 1], [1, 1, 1], [5, 2, 1], [6, 0, 1], [1, 5, 0], [3, 4, 0], [4, 5, 0], [2, 3, 0], [7, 4, 0], [6, 5, 0]];
    pieces.forEach(([x, y, side], i) => {
      const c = i === 4 ? ACCENT : side ? INK : '#ffffff';
      out.push(`<circle cx="${x * s + s / 2}" cy="${y * s + s / 2}" r="${s * 0.3}" fill="${c}" stroke="${INK}" stroke-width="1.25"/>`);
    });
  }
  // Cell guides
  for (let i = 1; i < n; i++) out.push(`<line x1="${i * s}" y1="0" x2="${i * s}" y2="180" stroke="${INK}" stroke-opacity=".08"/>`);
  for (let i = 1; i < m; i++) out.push(`<line x1="0" y1="${i * s}" x2="240" y2="${i * s}" stroke="${INK}" stroke-opacity=".08"/>`);
  return `<svg viewBox="0 0 240 180" aria-hidden="true"><defs><pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="6" height="6" fill="#f2f2ef"/><line x1="0" y1="0" x2="0" y2="6" stroke="${INK}" stroke-opacity=".14"/></pattern></defs>${out.join('')}</svg>`;
};

const games = [
  {
    code: 'KS-04', title: 'Tidewright', status: 'In development', when: 'Early access Q1 2027', platforms: 'PC · Switch',
    blurb: 'Survey a drowning archipelago one tide at a time. Every dyke you plot pushes the water somewhere else — usually onto a neighbour.',
    proof: 'Wishlists 41,280', art: tileArt('tide', 4),
  },
  {
    code: 'KS-03', title: 'Ledger of Small Hours', status: 'Released', when: 'March 2023', platforms: 'PC · Mac · iPad',
    blurb: 'Run a night market on a twelve-by-nine lot. Stalls open at dusk, rents fall due at three, and the books balance by dawn or not at all.',
    proof: 'Very Positive · 4,812 reviews', art: tileArt('market', 11),
  },
  {
    code: 'KS-02', title: 'Pocket Siege', status: 'Released', when: 'June 2021', platforms: 'PC · Switch · iOS · Android',
    blurb: 'An eight-by-six tactics duel sized for one train ride. Eleven pieces a side, perfect information, no dice and no luck to blame.',
    proof: '512,000 players', art: tileArt('siege', 2),
  },
];

const stats = [
  ['09', 'people in a converted print shop on the Lieve canal'],
  ['03', 'games shipped, every one still patched'],
  ['612k', 'players across Steam, Switch and mobile'],
  ['00', 'crunch weeks since the studio opened in 2019'],
];

const devlog = [
  ['24.09.26', 'Design', 'Why the tide moves before you do', 'We swapped the turn order. Players now see where the water goes before committing a single dyke, and the hardest islands got easier to read without getting easier to win.', '8 min'],
  ['11.09.26', 'Engine', 'Flooding 4,096 tiles in under a millisecond', 'A flood fill per turn sounded cheap until the late-game maps arrived. Notes on bitsets, dirty regions and the bug that drowned a lighthouse.', '12 min'],
  ['28.08.26', 'Art', 'Eleven greys and one warning colour', 'Tidewright has no blue water. How we built a palette where the only saturated thing on screen is the tile you are about to regret.', '6 min'],
  ['09.08.26', 'Studio', 'Next Fest: 38,000 plays and what broke', 'The demo held up. The tutorial did not. Heatmaps of where people quit, and the three screens we have already rewritten.', '10 min'],
];

const build = [
  ['Islands designed', 34, 40],
  ['Tide events', 112, 120],
  ['Languages', 6, 11],
  ['Steam Deck verified', 1, 1],
];

const milestones = [
  ['14 Oct', 'Closed beta, wave two'],
  ['03 Dec', 'Content lock'],
  ['Feb 27', 'Early access on Steam'],
];

const principles = [
  ['One board, read at a glance', 'If a screenshot cannot tell you who is winning, the rules are too clever. We cut until it can.'],
  ['No hidden dice', 'Every outcome is visible a turn ahead. Losing should feel like your idea, not the game’s.'],
  ['Ship small, patch for years', 'Pocket Siege got its 41st update this spring. Small games are how we can afford to keep caring.'],
  ['Forty-hour weeks', 'No crunch, no exceptions, including launch. The schedule bends; people do not.'],
];

const team = [
  ['LV', 'Lotte Vermeulen', 'Director, design'],
  ['IS', 'Ibrahim Saidi', 'Systems design'],
  ['MP', 'Mirela Petrescu', 'Art direction'],
  ['JD', 'Jonas De Wilde', 'Engine & tools'],
  ['AB', 'Aiko Brandt', 'Audio'],
  ['PC', 'Pieter Claes', 'Level design'],
  ['NH', 'Noor Haddad', 'Production'],
  ['TF', 'Tomás Ferreira', 'QA & automation'],
  ['ES', 'Elin Strand', 'Community'],
];

const roles = [
  ['Gameplay programmer', 'Godot · C#', 'Ghent or remote EU', 'Full-time'],
  ['Technical artist', 'Shaders · pipeline', 'Ghent, hybrid', 'Full-time'],
  ['Localisation lead', 'JA · KO · ZH', 'Remote', '9-month contract'],
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kerf Studio — small strategy games on a square grid</title>
    <meta name="description" content="Kerf Studio is a nine-person independent game studio in Ghent making turn-based strategy games. Now building Tidewright." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <BackPill />
    <main class="framed-grid">
      <!-- Header -->
      <header class="frame frame-brackets span-12 bar">
        <a class="logo" href="#top" aria-label="Kerf Studio home">
          <svg viewBox="0 0 20 20" aria-hidden="true"><rect x=".5" y=".5" width="19" height="19" fill="none" stroke="currentColor"/><rect x="2" y="2" width="7.5" height="7.5" fill="currentColor"/><rect x="10.5" y="10.5" width="7.5" height="7.5" fill="var(--accent)"/></svg>
          <span>Kerf Studio</span>
        </a>
        <nav aria-label="Primary">
          <a href="#games">Games</a>
          <a href="#devlog">Devlog</a>
          <a href="#studio">Studio</a>
          <a href="#jobs">Jobs</a>
        </nav>
        <span class="mono muted bar-status"><i class="dot" aria-hidden="true"></i>Demo build 0.9.4 live</span>
        <a class="btn btn-ink btn-sm" href="#games">Wishlist Tidewright</a>
      </header>

      <!-- Hero -->
      <section id="top" class="frame frame-brackets span-8 hero">
        <div class="meta-row mono">
          <span>Independent studio / Ghent, BE</span>
          <span>Est. 2019</span>
        </div>
        <h1>Small strategy games, built on a square grid.</h1>
        <div class="hero-foot">
          <p class="lede">We are nine people in an old print shop by the canal. We make turn-based games you can read at a glance and still be turning over a week later.</p>
          <div class="ctas">
            <a class="btn btn-ink" href="#games">Play the Tidewright demo</a>
            <a class="btn btn-line" href="#devlog">Read the devlog</a>
          </div>
        </div>
        <ol class="ruler mono" aria-hidden="true">
          {Array.from({ length: 8 }, (_, i) => <li>{String(i + 1).padStart(2, '0')}</li>)}
        </ol>
      </section>

      <!-- Live playfield -->
      <aside class="frame frame-brackets span-4 field" aria-labelledby="field-title">
        <div class="meta-row mono">
          <span id="field-title">KS-04 · Tidewright</span>
          <span class="live"><i class="dot" aria-hidden="true"></i>Live sim</span>
        </div>
        <div class="board">
          <canvas id="tide" role="img" aria-label="A Tidewright board: a grey archipelago on a 16 by 16 grid. A red cursor plots a ring of black dykes while the tide rises, and the low ground inside the ring stays dry."></canvas>
        </div>
        <dl class="readout mono">
          <div><dt>Turn</dt><dd id="r-turn">041</dd></div>
          <div><dt>Tide</dt><dd id="r-tide">+1.2 m</dd></div>
          <div><dt>Dykes</dt><dd id="r-dykes">18</dd></div>
          <div><dt>Dry land</dt><dd id="r-dry">62%</dd></div>
        </dl>
      </aside>

      <!-- Stats -->
      {stats.map(([n, l]) => (
        <div class="frame frame-brackets span-3 stat">
          <span class="stat-n">{n}</span>
          <span class="stat-l">{l}</span>
        </div>
      ))}

      <!-- Games -->
      <div id="games" class="frame frame-brackets span-12 section-head">
        <span class="mono muted">01 / Games</span>
        <h2>Three released, one on the board.</h2>
        <p class="muted">Each game is one rule set on one grid, tuned for years rather than months.</p>
      </div>
      {games.map((g) => (
        <article class="frame frame-brackets span-4 game">
          <div class="meta-row mono">
            <span>{g.code}</span>
            <span class:list={['tag', { 'tag-accent': g.status === 'In development' }]}>{g.status}</span>
          </div>
          <div class="art" set:html={g.art} />
          <h3>{g.title}</h3>
          <p class="muted">{g.blurb}</p>
          <dl class="spec mono">
            <div><dt>Out</dt><dd>{g.when}</dd></div>
            <div><dt>On</dt><dd>{g.platforms}</dd></div>
            <div><dt>So far</dt><dd>{g.proof}</dd></div>
          </dl>
        </article>
      ))}

      <!-- Devlog -->
      <section id="devlog" class="frame frame-brackets span-8 devlog" aria-labelledby="devlog-title">
        <div class="meta-row mono"><span>02 / Devlog</span><span>Every other Thursday</span></div>
        <h2 id="devlog-title">Notes from the build.</h2>
        <ul>
          {devlog.map(([date, tag, title, body, len]) => (
            <li>
              <a href="#devlog" class="post">
                <span class="mono muted">{date}</span>
                <span class="mono tag">{tag}</span>
                <span class="post-body">
                  <strong>{title}</strong>
                  <span class="muted">{body}</span>
                </span>
                <span class="mono muted post-len">{len}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <aside class="frame frame-brackets span-4 build" aria-labelledby="build-title">
        <div class="meta-row mono"><span>Build status</span><span>0.9.4</span></div>
        <h2 id="build-title">Tidewright, 27 weeks out.</h2>
        <ul class="meters">
          {build.map(([label, v, max]) => (
            <li>
              <div class="mono meter-row"><span>{label}</span><span>{v} / {max}</span></div>
              <div class="meter" role="meter" aria-label={label as string} aria-valuemin="0" aria-valuemax={max} aria-valuenow={v}>
                <span style={`--p:${((v as number) / (max as number)) * 100}%`}></span>
              </div>
            </li>
          ))}
        </ul>
        <ol class="milestones">
          {milestones.map(([d, t], i) => (
            <li class:list={{ next: i === 0 }}><span class="mono">{d}</span><span>{t}</span></li>
          ))}
        </ol>
        <p class="mono muted small">Open bugs: 147 · Crash-free sessions: 99.6% · Last playtest: 26 Sep, 31 players</p>
      </aside>

      <!-- Studio -->
      <section id="studio" class="frame frame-brackets span-6 principles" aria-labelledby="principles-title">
        <div class="meta-row mono"><span>03 / Studio</span><span>How we work</span></div>
        <h2 id="principles-title">Four rules we have not broken yet.</h2>
        <ol>
          {principles.map(([t, b], i) => (
            <li>
              <span class="mono idx">{String(i + 1).padStart(2, '0')}</span>
              <div><strong>{t}</strong><p class="muted">{b}</p></div>
            </li>
          ))}
        </ol>
      </section>

      <section class="frame frame-brackets span-6 team" aria-labelledby="team-title">
        <div class="meta-row mono"><span>The nine</span><span>Ghent · Lisbon · Malmö</span></div>
        <h2 id="team-title">One room, one table, one build.</h2>
        <ul class="team-grid">
          {team.map(([ini, name, role], i) => (
            <li>
              <span class:list={['ini mono', { 'ini-accent': i === 0 }]} aria-hidden="true">{ini}</span>
              <span><strong>{name}</strong><span class="muted">{role}</span></span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Jobs + newsletter -->
      <section id="jobs" class="frame frame-brackets span-8 jobs" aria-labelledby="jobs-title">
        <div class="meta-row mono"><span>04 / Jobs</span><span>3 open</span></div>
        <h2 id="jobs-title">Pull up a chair.</h2>
        <ul>
          {roles.map(([role, stack, where, type]) => (
            <li>
              <a href="#jobs" class="role">
                <strong>{role}</strong>
                <span class="mono muted">{stack}</span>
                <span class="mono muted">{where}</span>
                <span class="mono">{type} →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <aside class="frame frame-brackets span-4 signup" aria-labelledby="signup-title">
        <div class="meta-row mono"><span>Mailing list</span><span>~1 / month</span></div>
        <h2 id="signup-title">Hear when the tide comes in.</h2>
        <p class="muted">Release dates, demo builds and the long devlog posts. Nothing else, and never sold on.</p>
        <form id="signup" novalidate>
          <label for="email" class="mono muted">E-mail</label>
          <div class="field-row">
            <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
            <button class="btn btn-ink" type="submit">Subscribe</button>
          </div>
          <p id="signup-msg" class="mono small" role="status" aria-live="polite"></p>
        </form>
      </aside>

      <footer class="frame frame-brackets span-12 foot mono">
        <span>© 2026 Kerf Studio BV · Lievekaai 14, 9000 Gent</span>
        <span class="muted">Press kit · Steam · Bluesky · hello@kerf.games</span>
      </footer>
    </main>

    <style is:global>
      :root {
        --fg-bg: #f3f3f0;
        --fg-surface: rgba(255, 255, 255, 0.62);
        --fg-line: rgba(24, 24, 27, 0.14);
        --fg-line-strong: rgba(24, 24, 27, 0.34);
        --fg-texture: rgba(24, 24, 27, 0.035);
        --fg-gap: 16px;
        --fg-pad: clamp(16px, 2vw, 28px);
        --fg-corner: 18px;
        --ink: #18181b;
        --muted: #6f6f76;
        --accent: #e5533d;
        --sans: 'Geist', ui-sans-serif, system-ui, sans-serif;
        --mono: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      html { background: var(--fg-bg); scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body { margin: 0; color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; }

      /* Parent grid — every frame snaps to these 12 columns */
      .framed-grid {
        min-height: 100vh;
        padding: var(--fg-gap);
        background:
          repeating-linear-gradient(135deg, transparent 0 11px, var(--fg-texture) 11px 12px),
          var(--fg-bg);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--fg-gap);
        max-width: 1600px;
        margin: 0 auto;
        box-sizing: border-box;
      }
      .framed-grid > * { min-width: 0; }

      .frame { position: relative; border: 1px solid var(--fg-line); padding: var(--fg-pad); overflow: hidden; box-sizing: border-box; }
      .frame-brackets {
        --b: var(--fg-line-strong);
        background:
          linear-gradient(var(--b), var(--b)) left top / var(--fg-corner) 1px no-repeat,
          linear-gradient(var(--b), var(--b)) left top / 1px var(--fg-corner) no-repeat,
          linear-gradient(var(--b), var(--b)) right top / var(--fg-corner) 1px no-repeat,
          linear-gradient(var(--b), var(--b)) right top / 1px var(--fg-corner) no-repeat,
          linear-gradient(var(--b), var(--b)) left bottom / var(--fg-corner) 1px no-repeat,
          linear-gradient(var(--b), var(--b)) left bottom / 1px var(--fg-corner) no-repeat,
          linear-gradient(var(--b), var(--b)) right bottom / var(--fg-corner) 1px no-repeat,
          linear-gradient(var(--b), var(--b)) right bottom / 1px var(--fg-corner) no-repeat,
          var(--fg-surface);
      }

      .span-12 { grid-column: span 12; }
      .span-8 { grid-column: span 8; }
      .span-6 { grid-column: span 6; }
      .span-4 { grid-column: span 4; }
      .span-3 { grid-column: span 3; }

      /* Type */
      .mono { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.04em; text-transform: uppercase; }
      .muted { color: var(--muted); }
      .small { font-size: 11px; line-height: 1.6; }
      h1, h2, h3 { margin: 0; font-weight: 500; letter-spacing: -0.035em; }
      h1 { font-size: clamp(44px, 6.2vw, 92px); line-height: 0.95; max-width: 11ch; }
      h2 { font-size: clamp(26px, 2.6vw, 38px); line-height: 1.05; }
      h3 { font-size: 24px; line-height: 1.1; }
      p { margin: 0; line-height: 1.55; }
      a { color: inherit; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

      .meta-row { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 14px; border-bottom: 1px solid var(--fg-line); }
      .dot { display: inline-block; width: 6px; height: 6px; background: var(--accent); margin-right: 8px; vertical-align: 1px; }
      .live .dot, .bar-status .dot { animation: blink 1.6s steps(2, jump-none) infinite; }
      @keyframes blink { 50% { opacity: 0.2; } }

      .btn { display: inline-flex; align-items: center; justify-content: center; height: 44px; padding: 0 20px; border: 1px solid var(--ink); font: 500 14px/1 var(--sans); text-decoration: none; cursor: pointer; white-space: nowrap; transition: background-color .2s, color .2s; }
      .btn-sm { height: 36px; padding: 0 14px; font-size: 13px; }
      .btn-ink { background: var(--ink); color: #fafaf9; }
      .btn-ink:hover { background: #3a3a40; }
      .btn-line { background: transparent; color: var(--ink); }
      .btn-line:hover { background: var(--ink); color: #fafaf9; }

      /* Header */
      .bar { display: flex; align-items: center; gap: 28px; padding-block: 14px; }
      .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 600; letter-spacing: -0.02em; font-size: 16px; }
      .logo svg { width: 20px; height: 20px; }
      .bar nav { display: flex; gap: 24px; margin-left: 32px; }
      .bar nav a { text-decoration: none; font-size: 14px; color: var(--muted); }
      .bar nav a:hover { color: var(--ink); }
      .bar-status { margin-left: auto; }

      /* Hero */
      .hero { display: flex; flex-direction: column; gap: 40px; padding-bottom: 0; }
      .hero h1 { margin-top: auto; }
      .hero-foot { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 32px; align-items: end; }
      .lede { font-size: 17px; max-width: 46ch; color: #3f3f46; }
      .ctas { display: flex; gap: 10px; flex-wrap: wrap; }
      .ruler { list-style: none; margin: 0 calc(var(--fg-pad) * -1); padding: 0; display: grid; grid-template-columns: repeat(8, 1fr); border-top: 1px solid var(--fg-line); }
      .ruler li { padding: 8px 10px; border-left: 1px solid var(--fg-line); color: var(--muted); font-size: 10px; }
      .ruler li:first-child { border-left: 0; }

      /* Playfield */
      .field { display: flex; flex-direction: column; gap: 16px; }
      .board { position: relative; aspect-ratio: 1; border: 1px solid var(--fg-line); }
      .board canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
      .readout { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; border: 1px solid var(--fg-line); }
      .readout div { padding: 10px 12px; border-left: 1px solid var(--fg-line); }
      .readout div:first-child { border-left: 0; }
      .readout dt { color: var(--muted); font-size: 10px; }
      .readout dd { margin: 4px 0 0; font-size: 14px; color: var(--ink); letter-spacing: 0; }

      /* Stats */
      .stat { display: flex; align-items: flex-end; gap: 16px; min-height: 120px; }
      .stat-n { font-size: clamp(40px, 4vw, 56px); font-weight: 500; letter-spacing: -0.05em; line-height: 0.85; font-variant-numeric: tabular-nums; }
      .stat-l { font-size: 13.5px; line-height: 1.4; color: var(--muted); max-width: 22ch; }

      /* Section head */
      .section-head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--fg-gap); align-items: end; padding-block: 36px; }
      .section-head > span { grid-column: span 3; align-self: start; }
      .section-head h2 { grid-column: span 5; }
      .section-head p { grid-column: span 4; }

      /* Games */
      .game { display: flex; flex-direction: column; gap: 18px; transition: background-color .25s; }
      .game:hover { --b: var(--ink); }
      .art { aspect-ratio: 4 / 3; border: 1px solid var(--fg-line); overflow: hidden; }
      .art svg { width: 100%; height: 100%; display: block; }
      .tag { border: 1px solid var(--fg-line-strong); padding: 3px 7px; font-size: 10px; }
      .tag-accent { border-color: var(--accent); color: var(--accent); }
      .game p { font-size: 15px; }
      .spec { margin: auto 0 0; border-top: 1px solid var(--fg-line); }
      .spec div { display: flex; justify-content: space-between; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--fg-line); }
      .spec div:last-child { border-bottom: 0; padding-bottom: 0; }
      .spec dt { color: var(--muted); }
      .spec dd { margin: 0; text-align: right; }

      /* Devlog */
      .devlog, .build, .principles, .team, .jobs, .signup { display: flex; flex-direction: column; gap: 22px; }
      .devlog ul, .jobs ul, .principles ol, .meters, .team-grid { list-style: none; margin: 0; padding: 0; }
      .post { display: grid; grid-template-columns: 84px 84px minmax(0, 1fr) 52px; gap: 16px; padding: 18px 0; border-top: 1px solid var(--fg-line); text-decoration: none; align-items: baseline; }
      .post .tag { justify-self: start; }
      .post-body { display: grid; gap: 6px; }
      .post-body strong { font-weight: 500; font-size: 18px; letter-spacing: -0.015em; }
      .post-body .muted { font-size: 14.5px; line-height: 1.5; }
      .post-len { text-align: right; }
      .post:hover strong, .role:hover strong { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }

      /* Build */
      .meters { display: grid; gap: 18px; }
      .meter-row { display: flex; justify-content: space-between; margin-bottom: 8px; }
      .meter { height: 10px; border: 1px solid var(--fg-line-strong); background: repeating-linear-gradient(135deg, transparent 0 3px, rgba(24,24,27,.08) 3px 4px); }
      .meter span { display: block; height: 100%; width: var(--p); background: var(--ink); }
      .milestones { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--fg-line); }
      .milestones li { display: grid; grid-template-columns: 84px minmax(0, 1fr); gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--fg-line); font-size: 14.5px; align-items: baseline; }
      .milestones li.next .mono { color: var(--accent); }
      .build .small { margin-top: auto; padding-top: 16px; border-top: 1px solid var(--fg-line); }

      /* Principles */
      .principles ol li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 12px; padding: 16px 0; border-top: 1px solid var(--fg-line); }
      .principles .idx { color: var(--accent); padding-top: 3px; }
      .principles strong { font-weight: 500; font-size: 17px; }
      .principles p { margin-top: 4px; font-size: 14.5px; }

      /* Team */
      .team-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--fg-line); border-left: 1px solid var(--fg-line); }
      .team-grid li { display: flex; gap: 12px; align-items: center; padding: 14px; border-right: 1px solid var(--fg-line); border-bottom: 1px solid var(--fg-line); min-width: 0; }
      .team-grid li > span:last-child { display: grid; min-width: 0; }
      .team-grid strong { font-weight: 500; font-size: 14.5px; }
      .team-grid .muted { font-size: 13px; }
      .ini { flex: none; width: 36px; height: 36px; display: grid; place-items: center; border: 1px solid var(--fg-line-strong); font-size: 11px; }
      .ini-accent { background: var(--accent); border-color: var(--accent); color: #fff; }

      /* Jobs */
      .role { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr) auto; gap: 16px; align-items: baseline; padding: 18px 0; border-top: 1px solid var(--fg-line); text-decoration: none; }
      .role strong { font-weight: 500; font-size: 18px; letter-spacing: -0.015em; }

      /* Signup */
      .signup form { display: grid; gap: 8px; margin-top: auto; }
      .field-row { display: flex; }
      .field-row input { flex: 1; min-width: 0; height: 44px; padding: 0 14px; border: 1px solid var(--ink); border-right: 0; background: #fff; font: 15px var(--sans); color: var(--ink); border-radius: 0; }
      .field-row input:focus-visible { outline-offset: -2px; }
      #signup-msg { min-height: 18px; }

      .foot { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-block: 18px; }

      /* Tablet: halve the 4/3-column frames, keep the 12-col grid */
      @media (max-width: 1100px) {
        .span-8, .span-4 { grid-column: span 12; }
        .span-3 { grid-column: span 6; }
        .game { grid-column: span 6; }
        .game:first-of-type { grid-column: span 12; }
        .field { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
        .field .meta-row { grid-column: 1 / -1; }
        .field .readout { grid-template-columns: 1fr 1fr; }
        .field .readout div:nth-child(3) { border-left: 0; }
        .field .readout div:nth-child(n+3) { border-top: 1px solid var(--fg-line); }
        .bar-status { display: none; }
        .bar nav { margin-left: auto; }
      }
      @media (max-width: 760px) {
        .framed-grid { grid-template-columns: 1fr; }
        .span-12, .span-8, .span-6, .span-4, .span-3, .game, .game:first-of-type { grid-column: 1 / -1; }
        .bar { flex-wrap: wrap; gap: 14px; }
        .bar nav { order: 3; width: 100%; margin: 0; gap: 18px; padding-top: 12px; border-top: 1px solid var(--fg-line); }
        .bar .btn { margin-left: auto; }
        .hero { gap: 28px; }
        .hero h1 { margin-top: 12px; }
        .hero-foot { grid-template-columns: 1fr; gap: 24px; }
        .ruler { grid-template-columns: repeat(4, 1fr); }
        .ruler li:nth-child(n+5) { display: none; }
        .field { display: flex; align-items: stretch; }
        .readout { grid-template-columns: repeat(2, 1fr) !important; }
        .stat { min-height: 0; }
        .section-head { grid-template-columns: 1fr; padding-block: 24px; }
        .section-head > * { grid-column: 1 / -1 !important; }
        .post { grid-template-columns: auto auto 1fr; row-gap: 10px; }
        .post-body { grid-column: 1 / -1; }
        .post-len { grid-row: 1; grid-column: 3; }
        .team-grid { grid-template-columns: 1fr 1fr; }
        .role { grid-template-columns: 1fr auto; row-gap: 6px; }
        .role strong { grid-column: 1 / -1; }
        .role > span:nth-of-type(2) { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        .live .dot, .bar-status .dot { animation: none; }
      }
    </style>

    <script>
      // ---- Tidewright live sim: tide rises and falls, the cursor plots a dyke ring, enclosed low ground stays dry.
      const canvas = document.getElementById('tide') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d')!;
      const N = 16;
      const INK = '#18181b', ACCENT = '#e5533d';
      const $ = (id: string) => document.getElementById(id)!;

      // Heightmap: smooth sine field, a basin in the middle that the ring encloses.
      const H: number[] = [];
      for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) {
        let h = 0.55 + 0.22 * Math.sin(x * 0.62 + 0.9) * Math.cos(y * 0.55 + 0.3) + 0.14 * Math.sin((x - y) * 0.45 + 1.7) + 0.06 * Math.sin(x * 1.9 + y * 1.3);
        const dx = x - 7.5, dy = y - 8, d = Math.hypot(dx, dy);
        h -= Math.max(0, 0.32 - d * 0.07); // central basin
        h -= Math.max(0, (Math.min(x, y, N - 1 - x, N - 1 - y) < 1 ? 0.18 : 0)); // shoreline
        H.push(h);
      }

      // Dyke ring around the basin, walked clockwise.
      const ring: number[] = [];
      const [x0, y0, x1, y1] = [4, 4, 11, 12];
      for (let x = x0; x <= x1; x++) ring.push(y0 * N + x);
      for (let y = y0 + 1; y <= y1; y++) ring.push(y * N + x1);
      for (let x = x1 - 1; x >= x0; x--) ring.push(y1 * N + x);
      for (let y = y1 - 1; y > y0; y--) ring.push(y * N + x0);

      let turn = 0;
      const HOLD = 10; // turns the finished polder holds before the map resets
      const cycle = ring.length + HOLD;
      const level = (t: number) => 0.53 + 0.1 * Math.sin(t * 0.32 - 1.2);

      const state = (t: number) => {
        const placed = Math.min(t % cycle, ring.length);
        const dyke = new Uint8Array(N * N);
        for (let i = 0; i < placed; i++) dyke[ring[i]] = 1;
        const lv = level(t);
        const wet = new Uint8Array(N * N);
        const q: number[] = [];
        for (let i = 0; i < N * N; i++) {
          const x = i % N, y = (i / N) | 0;
          if ((x === 0 || y === 0 || x === N - 1 || y === N - 1) && !dyke[i] && H[i] < lv) { wet[i] = 1; q.push(i); }
        }
        while (q.length) {
          const i = q.pop()!, x = i % N, y = (i / N) | 0;
          for (const [nx, ny] of [[x + 1, y], [x - 1, y], [x, y + 1], [x, y - 1]]) {
            if (nx < 0 || ny < 0 || nx >= N || ny >= N) continue;
            const j = ny * N + nx;
            if (!wet[j] && !dyke[j] && H[j] < lv) { wet[j] = 1; q.push(j); }
          }
        }
        return { placed, dyke, wet, lv };
      };

      let size = 0;
      const resize = () => {
        const r = canvas.getBoundingClientRect();
        const dpr = Math.min(2, window.devicePixelRatio || 1);
        size = r.width;
        canvas.width = Math.round(r.width * dpr);
        canvas.height = Math.round(r.height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      const shade = (h: number, lv: number) => {
        const k = Math.max(0, Math.min(1, (h - lv) / 0.45));
        const v = Math.round(222 - k * 110);
        return `rgb(${v},${v},${v - 4})`;
      };

      const draw = (t: number) => {
        const { placed, dyke, wet, lv } = state(t);
        const s = size / N;
        ctx.clearRect(0, 0, size, size);
        let dry = 0;
        for (let i = 0; i < N * N; i++) {
          const x = (i % N) * s, y = ((i / N) | 0) * s;
          if (dyke[i]) { ctx.fillStyle = INK; ctx.fillRect(x, y, s, s); dry++; continue; }
          if (wet[i]) {
            ctx.fillStyle = '#f4f4f1';
            ctx.fillRect(x, y, s, s);
            // hatch: denser where the water is deeper
            ctx.strokeStyle = `rgba(24,24,27,${0.06 + Math.min(0.14, (lv - H[i]) * 0.6)})`;
            ctx.lineWidth = 1;
            ctx.save(); ctx.beginPath(); ctx.rect(x, y, s, s); ctx.clip();
            ctx.beginPath();
            for (let o = -s; o < s; o += s / 3) { ctx.moveTo(x + o, y + s); ctx.lineTo(x + o + s, y); }
            ctx.stroke(); ctx.restore();
            continue;
          }
          dry++;
          if (H[i] < lv) {
            // polder: below the tide but held dry by the dykes
            ctx.fillStyle = '#ffffff'; ctx.fillRect(x, y, s, s);
            ctx.fillStyle = 'rgba(229,83,61,.55)';
            ctx.fillRect(x + s / 2 - 1, y + s / 2 - 1, 2, 2);
          } else {
            ctx.fillStyle = shade(H[i], lv); ctx.fillRect(x, y, s, s);
          }
        }
        // cell guides
        ctx.strokeStyle = 'rgba(24,24,27,.09)'; ctx.lineWidth = 1;
        ctx.beginPath();
        for (let i = 1; i < N; i++) { const p = Math.round(i * s) + 0.5; ctx.moveTo(p, 0); ctx.lineTo(p, size); ctx.moveTo(0, p); ctx.lineTo(size, p); }
        ctx.stroke();
        // cursor with L-brackets on the next tile to plot
        const next = placed < ring.length ? ring[placed] : ring[ring.length - 1];
        const cx = (next % N) * s, cy = ((next / N) | 0) * s, c = s * 0.35, pad = 3;
        ctx.fillStyle = 'rgba(229,83,61,.18)'; ctx.fillRect(cx, cy, s, s);
        ctx.strokeStyle = ACCENT; ctx.lineWidth = 2;
        ctx.beginPath();
        const L = (x: number, y: number, dx: number, dy: number) => { ctx.moveTo(x + dx * c, y); ctx.lineTo(x, y); ctx.lineTo(x, y + dy * c); };
        L(cx - pad, cy - pad, 1, 1); L(cx + s + pad, cy - pad, -1, 1); L(cx - pad, cy + s + pad, 1, -1); L(cx + s + pad, cy + s + pad, -1, -1);
        ctx.stroke();

        $('r-turn').textContent = String(t + 41).padStart(3, '0');
        const m = (lv - 0.53) * 14;
        $('r-tide').textContent = `${m >= 0 ? '+' : '−'}${Math.abs(m).toFixed(1)} m`;
        $('r-dykes').textContent = String(placed).padStart(2, '0');
        $('r-dry').textContent = `${Math.round((dry / (N * N)) * 100)}%`;
      };

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      resize();
      // ponytail: reduced motion shows one finished, high-tide frame instead of the loop
      turn = reduced ? ring.length + 4 : 15;
      draw(turn);
      new ResizeObserver(() => { resize(); draw(turn); }).observe(canvas);

      if (!reduced) {
        let visible = true;
        new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(canvas);
        setInterval(() => {
          if (!visible || document.hidden) return;
          turn = (turn + 1) % (cycle * 40);
          draw(turn);
        }, 520);
      }

      // ---- Newsletter: no backend, just validate and confirm.
      const form = document.getElementById('signup') as HTMLFormElement;
      const email = document.getElementById('email') as HTMLInputElement;
      const msg = document.getElementById('signup-msg')!;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!email.checkValidity()) {
          msg.style.color = 'var(--accent)';
          msg.textContent = 'That address does not look complete.';
          email.focus();
          return;
        }
        msg.style.color = 'var(--ink)';
        msg.textContent = `Noted. First letter goes to ${email.value}.`;
        form.reset();
      });
    </script>
  </body>
</html>
