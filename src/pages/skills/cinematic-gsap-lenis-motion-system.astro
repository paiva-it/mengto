---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

const img = (n: string) => `/skills/cinematic-gsap-lenis-motion-system/${n}.jpg`;

const notes = [
  {
    n: '01',
    tier: 'Top',
    when: 'The first fifteen minutes',
    title: 'Bitter orange, pressed cold',
    body: 'Seville peel, zested by hand the week it arrives. It is loud on purpose, and gone before you have finished your coffee.',
    src: img('oranges'),
  },
  {
    n: '02',
    tier: 'Heart',
    when: 'Hour one to hour four',
    title: 'Fig leaf after rain',
    body: 'Green, milky, a little bitter. The note the house is named for: the colour copper turns once weather has had its way with it.',
    src: img('leaves'),
  },
  {
    n: '03',
    tier: 'Base',
    when: 'Still there the next morning',
    title: 'Labdanum and old vetiver',
    body: 'A resin we age for four months in glass. It sits close to the skin and is the part people ask about, usually the day after.',
    src: img('amber'),
  },
];

const collection = [
  { no: 'No. 1', name: 'Patina', notes: 'Fig leaf · bitter orange · vetiver', price: '€165 · 50 ml', src: img('leaves') },
  { no: 'No. 2', name: 'Rain Ledger', notes: 'Petrichor · orris · cold stone', price: '€165 · 50 ml', src: img('fern') },
  { no: 'No. 3', name: 'Bitter Orchard', notes: 'Seville orange · neroli · cedar', price: '€150 · 50 ml', src: img('oranges') },
  { no: 'No. 4', name: 'Resin Hours', notes: 'Labdanum · benzoin · smoke', price: '€180 · 50 ml', src: img('amber') },
  { no: 'No. 5', name: 'Late Lamp', notes: 'Beeswax · cardamom · birch tar', price: '€170 · 50 ml', src: img('candle') },
];

const ritual = [
  { n: '01', title: 'Request the tin', body: 'Five 2 ml vials in a folded copper tin. €18, credited in full against your first bottle.' },
  { n: '02', title: 'Wear one a day', body: 'On skin, never on paper. At six in the evening, write down what you can still smell.' },
  { n: '03', title: 'Choose slowly', body: 'Send the card back with one name on it. We pour your bottle from the batch that is resting now.' },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Verdigris — perfume that arrives slowly</title>
    <meta name="description" content="Verdigris is a small perfume house in Ghent composing five fragrances the way copper turns green: patiently, in weather, over years." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href={img('leaves')} />
    <script is:inline>
      // Hide animated elements only when JS runs and motion is allowed; otherwise content stays visible.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('has-motion');
    </script>
  </head>
  <body class="vg">
    <BackPill />

    <div class="vg-cursor" data-cursor aria-hidden="true"><span class="vg-cursor-dot"></span><span class="vg-cursor-label" data-cursor-label></span></div>

    <header class="vg-nav" data-hero="nav">
      <a href="#top" class="vg-mark" aria-label="Verdigris, home"><span class="vg-dot"></span>Verdigris</a>
      <nav aria-label="Primary">
        <a href="#notes">Anatomy</a>
        <a href="#atelier">Atelier</a>
        <a href="#collection">Collection</a>
      </nav>
      <a href="#ritual" class="vg-btn vg-btn--ghost vg-nav-cta" data-magnetic="0.3" data-cursor-label="Sample">Sample tin</a>
    </header>

    <main id="top">
      <!-- HERO — four-part timeline: media → headline → copy → action -->
      <section class="vg-hero" data-mouse-parallax aria-labelledby="hero-title">
        <div class="vg-glow" data-mouse-depth="0.015" aria-hidden="true"></div>

        <div class="vg-hero-copy">
          <p class="vg-label" data-hero="copy">Parfums lents — Ghent, since 2011</p>
          <h1 id="hero-title" class="vg-display" data-hero="title">
            <span class="motion-line-mask"><span class="motion-line">Perfume that</span></span>
            <span class="motion-line-mask"><span class="motion-line">arrives</span></span>
            <span class="motion-line-mask"><span class="motion-line"><em>slowly.</em></span></span>
          </h1>
          <p class="vg-lede" data-hero="copy">
            Five fragrances composed the way a copper roof turns green — patiently, in weather, over years.
            Each batch rests four months before we pour it.
          </p>
          <div class="vg-cta-row">
            <a href="#notes" class="vg-btn vg-btn--solid" data-hero="cta" data-magnetic="0.25" data-cursor-label="Explore">
              Discover No. 1 Patina <span class="vg-arrow" aria-hidden="true"><i>→</i><i>→</i></span>
            </a>
            <button type="button" class="vg-btn vg-btn--ghost" data-hero="cta" data-replay data-magnetic="0.25" data-cursor-label="Replay">
              <span aria-hidden="true">↺</span> Replay sequence
            </button>
          </div>
        </div>

        <div class="vg-hero-art" aria-hidden="true">
          <div class="vg-ring" data-hero="media" data-mouse-depth="0.05"></div>
          <figure class="vg-arch" data-hero="frame" data-mouse-depth="0.025">
            <img src={img('leaves')} alt="" data-hero-img />
          </figure>
          <figure class="vg-float" data-hero="media" data-mouse-depth="0.07">
            <img src={img('amber')} alt="" />
          </figure>
          <div class="vg-chip" data-hero="media" data-mouse-depth="0.09">
            <span class="vg-dot"></span>
            <span><strong>No. 1 Patina</strong><br />Eau de parfum · 50 ml</span>
          </div>
        </div>

        <ol class="vg-seq" aria-label="Hero motion sequence">
          <li><span class="vg-seq-n">01</span> Media<span class="vg-seq-bar"><i data-seq="0"></i></span></li>
          <li><span class="vg-seq-n">02</span> Headline<span class="vg-seq-bar"><i data-seq="1"></i></span></li>
          <li><span class="vg-seq-n">03</span> Copy<span class="vg-seq-bar"><i data-seq="2"></i></span></li>
          <li><span class="vg-seq-n">04</span> Action<span class="vg-seq-bar"><i data-seq="3"></i></span></li>
        </ol>
      </section>

      <!-- MANIFESTO -->
      <section class="vg-light vg-manifesto" aria-labelledby="manifesto-title">
        <p class="vg-label" data-reveal="fade-up">The house</p>
        <h2 id="manifesto-title" class="vg-statement" data-motion-text="words">We do not chase the first spray. We write for the hour after, when a perfume stops performing and starts to belong to the person wearing it.</h2>
        <dl class="vg-stats" data-reveal-group>
          <div data-reveal-item><dt>Fragrances in fifteen years</dt><dd>5</dd></div>
          <div data-reveal-item><dt>Months each batch rests</dt><dd>4</dd></div>
          <div data-reveal-item><dt>Bottles poured per batch</dt><dd>312</dd></div>
        </dl>
      </section>

      <!-- PINNED STORY SCENE -->
      <section id="notes" class="vg-story" data-story-scene aria-labelledby="story-title">
        <p class="vg-story-depth" data-story-depth aria-hidden="true">Patina</p>
        <div class="vg-story-copy">
          <p class="vg-label" data-reveal="fade-up">Anatomy of No. 1</p>
          <h2 id="story-title" class="vg-h2" data-motion-text="lines">
            <span class="motion-line-mask"><span class="motion-line">Three movements,</span></span>
            <span class="motion-line-mask"><span class="motion-line">one afternoon.</span></span>
          </h2>
          <ol class="vg-tiers" data-reveal-group>
            {notes.map((n, i) => (
              <li data-reveal-item data-tier={i} class={i === 0 ? 'is-active' : ''}>
                <span class="vg-tier-n">{n.n}</span>
                <span class="vg-tier-name">{n.tier}</span>
                <span class="vg-tier-when">{n.when}</span>
              </li>
            ))}
          </ol>
          <div class="vg-story-progress" aria-hidden="true"><i data-story-progress></i></div>
        </div>
        <div class="vg-story-window">
          {notes.map((n) => (
            <article class="vg-panel" data-story-panel>
              <img src={n.src} alt="" loading="lazy" />
              <div class="vg-panel-cap">
                <p class="vg-label">{n.n} — {n.tier} note</p>
                <h3>{n.title}</h3>
                <p>{n.body}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- ATELIER: clip reveals + parallax -->
      <section id="atelier" class="vg-light vg-atelier" aria-labelledby="atelier-title">
        <figure class="vg-atelier-main" data-image-reveal data-parallax-section data-cursor-label="Atelier">
          <img src={img('eucalyptus')} alt="A glass dropper of base oil resting on a wooden board beside a eucalyptus sprig" data-parallax-image data-parallax-speed="0.12" loading="lazy" />
        </figure>
        <div class="vg-atelier-copy">
          <p class="vg-label" data-reveal="fade-up">The atelier</p>
          <h2 id="atelier-title" class="vg-h2" data-motion-text="lines">
            <span class="motion-line-mask"><span class="motion-line">A chapel roof</span></span>
            <span class="motion-line-mask"><span class="motion-line">that took ninety</span></span>
            <span class="motion-line-mask"><span class="motion-line">winters to turn.</span></span>
          </h2>
          <p class="vg-body" data-reveal="blur-in">
            We work under the copper roof of a deconsecrated chapel on the Koperstraat. Two perfumers, one organ loft of
            raw materials, and a cellar cool enough to let a resin settle without hurrying it.
          </p>
          <figure class="vg-atelier-small" data-parallax-layer data-parallax-speed="0.14" data-parallax-section>
            <div data-image-reveal><img src={img('fern')} alt="Dense fern fronds in deep green" loading="lazy" /></div>
            <figcaption class="vg-label">Fern absolute, Ardennes, 2024 harvest</figcaption>
          </figure>
        </div>
      </section>

      <!-- HORIZONTAL COLLECTION -->
      <section id="collection" class="vg-collection" data-horizontal-gallery aria-labelledby="collection-title">
        <div class="vg-collection-head">
          <p class="vg-label" data-reveal="fade-up">The collection</p>
          <h2 id="collection-title" class="vg-h2" data-motion-text="words">Five perfumes, no flankers.</h2>
          <p class="vg-hint vg-label" aria-hidden="true">Scroll <span>→</span></p>
        </div>
        <div class="vg-track" data-horizontal-track>
          {collection.map((c) => (
            <a href="#ritual" class="vg-card" data-tilt data-cursor-label="Sample">
              <div class="vg-card-media"><img src={c.src} alt="" loading="lazy" /></div>
              <div class="vg-card-meta">
                <span class="vg-label">{c.no}</span>
                <h3>{c.name}</h3>
                <p>{c.notes}</p>
                <span class="vg-card-price">{c.price}</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- RITUAL -->
      <section id="ritual" class="vg-light vg-ritual" aria-labelledby="ritual-title">
        <p class="vg-label" data-reveal="fade-up">The sample ritual</p>
        <h2 id="ritual-title" class="vg-h2" data-motion-text="words">Wear it for a week before you decide.</h2>
        <ol class="vg-steps" data-reveal-group>
          {ritual.map((r) => (
            <li data-reveal-item>
              <span class="vg-step-n">{r.n}</span>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </li>
          ))}
        </ol>
      </section>
    </main>

    <footer class="vg-foot" data-parallax-section>
      <div class="vg-glow vg-glow--foot" aria-hidden="true"></div>
      <h2 class="vg-display vg-foot-title" data-motion-text="lines">
        <span class="motion-line-mask"><span class="motion-line">Visit the chapel.</span></span>
        <span class="motion-line-mask"><span class="motion-line">Bring your wrist.</span></span>
      </h2>
      <div class="vg-foot-row" data-reveal-group>
        <p data-reveal-item>Koperstraat 9, 9000 Ghent<br />Thursday to Saturday, 11:00 – 18:00</p>
        <p data-reveal-item>atelier@verdigris.example<br />Sample tins ship within the EU</p>
        <a href="#ritual" class="vg-btn vg-btn--solid" data-reveal-item data-magnetic="0.3" data-cursor-label="Order">
          Request the sample tin <span class="vg-arrow" aria-hidden="true"><i>→</i><i>→</i></span>
        </a>
      </div>
      <p class="vg-wordmark" data-parallax-layer data-parallax-speed="0.08" aria-hidden="true">Verdigris</p>
    </footer>

    <style is:global>
      .vg {
        --ink: #0a0d0c;
        --ink-2: #111614;
        --line-d: rgb(255 255 255 / 0.1);
        --text-d: #eef1ec;
        --muted-d: #8f9a94;
        --bone: #ebeae3;
        --bone-2: #dfded5;
        --text-l: #111513;
        --muted-l: #5b625e;
        --line-l: rgb(17 21 19 / 0.14);
        --mint: #86e0a0;
        --verd: #2d7a61;
        --gutter: clamp(16px, 2.2vw, 32px);
        margin: 0;
        background: var(--ink);
        color: var(--text-d);
        font-family: 'Geist', ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow-x: clip;
      }
      .vg img { display: block; max-width: 100%; }
      .vg a { color: inherit; text-decoration: none; }
      .vg :focus-visible { outline: 2px solid var(--mint); outline-offset: 4px; border-radius: 6px; }

      /* Motion foundation (from the skill) */
      html.has-motion [data-motion-text],
      html.has-motion [data-reveal],
      html.has-motion [data-reveal-item],
      html.has-motion [data-image-reveal],
      html.has-motion [data-hero] { visibility: hidden; }
      .motion-line-mask, .motion-word-mask { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.1em; margin-bottom: -0.1em; }
      .motion-line, .motion-word { display: inline-block; will-change: transform, opacity, filter; }
      [data-image-reveal] { overflow: hidden; }

      .vg-label {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
        color: var(--muted-d); margin: 0;
      }
      .vg-light .vg-label { color: var(--muted-l); }
      .vg-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 14px var(--mint); flex: none; }

      .vg-display {
        font-weight: 500; letter-spacing: -0.058em; line-height: 0.9;
        font-size: clamp(52px, 8.6vw, 136px); margin: 0;
      }
      .vg-display .motion-line-mask { display: block; }
      .vg-display em { font-style: normal; color: var(--mint); }
      .vg-h2 { font-weight: 500; letter-spacing: -0.045em; line-height: 0.98; font-size: clamp(36px, 4.6vw, 68px); margin: 0; }
      .vg-h2 .motion-line-mask { display: block; }

      /* Buttons */
      .vg-btn {
        display: inline-flex; align-items: center; gap: 10px;
        height: 48px; padding: 0 22px; border-radius: 999px;
        font: 500 14px/1 'Geist', sans-serif; letter-spacing: -0.005em;
        cursor: pointer; border: 1px solid transparent; white-space: nowrap;
        transition: background-color 0.45s cubic-bezier(0.22, 1, 0.36, 1), color 0.45s, border-color 0.45s;
      }
      .vg-btn--solid { background: var(--text-d); color: var(--ink) !important; }
      .vg-btn--solid:hover { background: var(--mint); }
      .vg-btn--ghost { background: transparent; color: var(--text-d); border-color: rgb(255 255 255 / 0.22); }
      .vg-btn--ghost:hover { border-color: var(--mint); color: var(--mint); }
      .vg-arrow { position: relative; display: inline-block; width: 1em; height: 1em; overflow: hidden; }
      .vg-arrow i { position: absolute; inset: 0; font-style: normal; line-height: 1; transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s; }
      .vg-arrow i + i { transform: translateX(-120%); opacity: 0; }
      .vg-btn:hover .vg-arrow i:first-child { transform: translateX(120%); opacity: 0; }
      .vg-btn:hover .vg-arrow i + i { transform: translateX(0); opacity: 1; }

      /* Nav */
      .vg-nav {
        position: fixed; inset: 0 0 auto 0; z-index: 50;
        display: flex; align-items: center; justify-content: space-between; gap: 24px;
        padding: 16px var(--gutter);
        mix-blend-mode: difference; color: #fff;
      }
      .vg-mark { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; letter-spacing: -0.03em; font-size: 18px; }
      .vg-nav nav { display: flex; gap: 28px; font-size: 14px; }
      .vg-nav nav a { opacity: 0.8; transition: opacity 0.4s; }
      .vg-nav nav a:hover { opacity: 1; }
      .vg-nav .vg-btn { height: 38px; padding: 0 16px; font-size: 13px; color: #fff; border-color: rgb(255 255 255 / 0.4); }

      /* Hero */
      .vg-hero {
        position: relative; min-height: 100svh; overflow: hidden;
        display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 32px;
        align-items: center;
        padding: 110px var(--gutter) 108px;
        border-bottom: 1px solid var(--line-d);
      }
      .vg-glow {
        position: absolute; inset: -10%; pointer-events: none;
        background: radial-gradient(ellipse 42% 48% at 72% 40%, rgb(70 150 100 / 0.3), rgb(40 90 64 / 0.1) 55%, transparent 100%);
      }
      .vg-hero-copy { position: relative; display: grid; gap: 28px; align-content: center; }
      .vg-lede { max-width: 30rem; font-size: 17px; line-height: 1.55; color: #b9c2bd; margin: 0; }
      .vg-cta-row { display: flex; flex-wrap: wrap; gap: 12px; }
      .vg-hero-art { position: relative; height: min(68vh, 640px); }
      .vg-arch {
        position: absolute; inset: 0 6% 0 14%; margin: 0;
        border-radius: 999px 999px 28px 28px; overflow: hidden;
        background: #13201a;
      }
      .vg-arch img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.85) brightness(0.9); }
      .vg-ring {
        position: absolute; width: 58%; aspect-ratio: 1; left: 0; top: 4%;
        border: 1px solid rgb(134 224 160 / 0.35); border-radius: 50%;
      }
      .vg-float {
        position: absolute; left: 0; bottom: 6%; width: clamp(140px, 15vw, 210px); aspect-ratio: 3 / 4; margin: 0;
        border-radius: 16px; overflow: hidden; box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.7);
        border: 1px solid rgb(255 255 255 / 0.12);
      }
      .vg-float img { width: 100%; height: 100%; object-fit: cover; }
      .vg-chip {
        position: absolute; right: 0; top: 18%;
        display: flex; align-items: center; gap: 12px;
        padding: 12px 16px; border-radius: 14px;
        background: rgb(12 18 15 / 0.62); backdrop-filter: blur(14px);
        border: 1px solid var(--line-d); font-size: 13px; line-height: 1.35; color: var(--muted-d);
      }
      .vg-chip strong { color: var(--text-d); font-weight: 500; }

      .vg-seq {
        position: absolute; left: var(--gutter); right: var(--gutter); bottom: 28px;
        display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px;
        list-style: none; margin: 0; padding: 0;
        font-family: 'Geist Mono', monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-d);
      }
      .vg-seq li { display: grid; grid-template-columns: auto 1fr; gap: 6px 10px; }
      .vg-seq-n { color: var(--mint); }
      .vg-seq-bar { grid-column: 1 / -1; height: 1px; background: var(--line-d); overflow: hidden; }
      .vg-seq-bar i { display: block; height: 100%; background: var(--mint); transform-origin: left; }

      /* Light sections */
      .vg-light { background: var(--bone); color: var(--text-l); }
      .vg-manifesto { padding: clamp(96px, 14vw, 200px) var(--gutter) clamp(80px, 10vw, 140px); display: grid; gap: 40px; }
      .vg-statement { font-weight: 500; letter-spacing: -0.04em; line-height: 1.04; font-size: clamp(32px, 4.4vw, 66px); margin: 0; max-width: 22ch; }
      .vg-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 40px 0 0; border-top: 1px solid var(--line-l); padding-top: 24px; }
      .vg-stats div { display: flex; flex-direction: column-reverse; gap: 10px; }
      .vg-stats dt { font-family: 'Geist Mono', monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-l); }
      .vg-stats dd { margin: 0; font-size: clamp(48px, 6vw, 96px); font-weight: 400; letter-spacing: -0.06em; line-height: 0.9; color: var(--verd); }

      /* Story scene */
      .vg-story {
        position: relative; overflow: hidden; background: var(--ink);
        display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(24px, 4vw, 64px);
        align-items: center; min-height: 100svh;
        padding: 96px var(--gutter) 64px;
      }
      .vg-story-depth {
        position: absolute; left: -1vw; bottom: -3vw; margin: 0; pointer-events: none;
        font-size: 26vw; font-weight: 600; letter-spacing: -0.07em; line-height: 0.8;
        color: transparent; -webkit-text-stroke: 1px rgb(134 224 160 / 0.12);
      }
      .vg-story-copy { position: relative; display: grid; gap: 32px; }
      .vg-tiers { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-d); }
      .vg-tiers li {
        display: grid; grid-template-columns: 40px 1fr auto; align-items: baseline; gap: 12px;
        padding: 16px 0; border-bottom: 1px solid var(--line-d); color: var(--muted-d);
        transition: color 0.5s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .vg-tiers li.is-active { color: var(--text-d); }
      .vg-tier-n { font-family: 'Geist Mono', monospace; font-size: 11px; color: var(--mint); }
      .vg-tier-name { font-size: 22px; letter-spacing: -0.03em; }
      .vg-tier-when { font-size: 13px; }
      .vg-story-progress { height: 2px; background: var(--line-d); }
      .vg-story-progress i { display: block; height: 100%; background: var(--mint); transform: scaleX(0); transform-origin: left; }
      .vg-story-window { position: relative; height: min(76vh, 720px); border-radius: 24px; overflow: hidden; }
      .vg-panel { position: relative; height: 100%; }
      .vg-panel img { width: 100%; height: 100%; object-fit: cover; }
      .vg-panel::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgb(6 9 8 / 0.82)); }
      .vg-panel-cap { position: absolute; left: 28px; right: 28px; bottom: 28px; z-index: 1; max-width: 34rem; }
      .vg-panel-cap .vg-label { color: var(--mint); }
      .vg-panel-cap h3 { font-size: clamp(28px, 3vw, 44px); font-weight: 500; letter-spacing: -0.04em; margin: 12px 0 10px; line-height: 1; }
      .vg-panel-cap p:last-child { margin: 0; color: #c3ccc7; font-size: 15px; line-height: 1.55; }

      /* Atelier */
      .vg-atelier {
        display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(32px, 6vw, 96px);
        padding: clamp(96px, 12vw, 180px) var(--gutter); align-items: start;
      }
      .vg-atelier-main { margin: 0; aspect-ratio: 4 / 5; border-radius: 20px; }
      .vg-atelier-main img { width: 100%; height: 115%; object-fit: cover; will-change: transform; }
      .vg-atelier-copy { display: grid; gap: 28px; padding-top: 8vw; }
      .vg-body { font-size: 17px; line-height: 1.6; color: var(--muted-l); margin: 0; max-width: 32rem; }
      .vg-atelier-small { margin: 112px 0 0 auto; width: min(320px, 70%); display: grid; gap: 12px; will-change: transform; }
      .vg-atelier-small > div { border-radius: 14px; aspect-ratio: 1; }
      .vg-atelier-small img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.6) brightness(0.92); }

      /* Collection */
      .vg-collection { position: relative; overflow: hidden; padding: 96px 0 72px; border-top: 1px solid var(--line-d); }
      .vg-collection-head { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 16px 24px; padding: 0 var(--gutter) 48px; }
      .vg-collection-head .vg-label:first-child { grid-column: 1 / -1; }
      .vg-hint span { display: inline-block; color: var(--mint); }
      .vg-track { display: flex; gap: 20px; padding: 0 var(--gutter); width: max-content; }
      .vg-card {
        width: clamp(260px, 27vw, 400px); flex: none; display: grid; gap: 18px;
        transform-style: preserve-3d; will-change: transform;
      }
      .vg-card-media { aspect-ratio: 4 / 5; border-radius: 18px; overflow: hidden; background: var(--ink-2); }
      .vg-card-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), filter 0.6s; filter: saturate(0.75); }
      .vg-card:hover .vg-card-media img, .vg-card:focus-visible .vg-card-media img { transform: scale(1.06); filter: saturate(1); }
      .vg-card-meta { display: grid; gap: 6px; }
      .vg-card-meta h3 { margin: 0; font-size: 28px; font-weight: 500; letter-spacing: -0.04em; }
      .vg-card-meta p { margin: 0; color: var(--muted-d); font-size: 14px; }
      .vg-card-price { font-family: 'Geist Mono', monospace; font-size: 12px; color: var(--mint); margin-top: 6px; }

      /* Ritual */
      .vg-ritual { padding: clamp(96px, 12vw, 180px) var(--gutter); display: grid; gap: 32px; }
      .vg-ritual .vg-h2 { max-width: 16ch; }
      .vg-steps { list-style: none; padding: 0; margin: 32px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
      .vg-steps li { background: var(--bone-2); border-radius: 20px; padding: 28px; display: grid; gap: 14px; align-content: start; min-height: 240px; }
      .vg-step-n { font-family: 'Geist Mono', monospace; font-size: 12px; color: var(--verd); }
      .vg-steps h3 { margin: 40px 0 0; font-size: 26px; font-weight: 500; letter-spacing: -0.035em; }
      .vg-steps p { margin: 0; color: var(--muted-l); line-height: 1.55; font-size: 15px; }

      /* Footer */
      .vg-foot { position: relative; overflow: hidden; padding: clamp(96px, 12vw, 180px) var(--gutter) 0; }
      .vg-glow--foot { inset: 0 -20% -40% -20%; background: radial-gradient(closest-side at 30% 60%, rgb(70 150 100 / 0.28), transparent); }
      .vg-foot-title { position: relative; font-size: clamp(44px, 7.4vw, 116px); }
      .vg-foot-row { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 24px 64px; margin-top: 56px; color: var(--muted-d); font-size: 15px; line-height: 1.6; }
      .vg-foot-row p { margin: 0; }
      .vg-foot-row .vg-btn { margin-left: auto; }
      .vg-wordmark {
        position: relative; margin: 72px 0 0; white-space: nowrap;
        font-size: 22.5vw; font-weight: 600; letter-spacing: -0.075em; line-height: 0.74;
        color: transparent; -webkit-text-stroke: 1px rgb(255 255 255 / 0.16);
        transform: translateY(8%); will-change: transform;
      }

      /* Cursor */
      .vg-cursor {
        position: fixed; left: 0; top: 0; z-index: 9999; pointer-events: none;
        mix-blend-mode: difference; opacity: 0; will-change: transform;
      }
      .vg-cursor-dot { position: absolute; left: -7px; top: -7px; width: 14px; height: 14px; border-radius: 50%; background: #fff; }
      .vg-cursor-label {
        position: absolute; left: 22px; top: -6px; white-space: nowrap; color: #fff;
        font-family: 'Geist Mono', monospace; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
      }
      @media (prefers-reduced-motion: reduce), (pointer: coarse) { .vg-cursor { display: none; } }

      /* Responsive */
      @media (max-width: 899px) {
        .vg-nav nav { display: none; }
        .vg-hero { grid-template-columns: minmax(0, 1fr); padding-top: 104px; padding-bottom: 120px; gap: 40px; align-items: start; }
        .vg-hero-art { height: 440px; }
        .vg-glow { background: radial-gradient(ellipse 70% 40% at 60% 68%, rgb(70 150 100 / 0.3), transparent 100%); }
        .vg-arch { inset: 0 0 0 18%; }
        .vg-chip { top: auto; bottom: 18%; right: 8px; }
        .vg-seq { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 16px; }
        .vg-stats { grid-template-columns: minmax(0, 1fr); }
        .vg-story { grid-template-columns: minmax(0, 1fr); padding-top: 88px; }
        .vg-story-window { height: auto; overflow: visible; display: grid; gap: 16px; border-radius: 0; }
        .vg-panel { height: auto; aspect-ratio: 4 / 5; border-radius: 20px; overflow: hidden; }
        .vg-story-progress { display: none; }
        .vg-tier-when { display: none; }
        .vg-atelier { grid-template-columns: minmax(0, 1fr); }
        .vg-atelier-copy { padding-top: 0; }
        .vg-collection-head { grid-template-columns: minmax(0, 1fr); }
        .vg-track { width: auto; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); padding-bottom: 12px; scrollbar-width: none; }
        .vg-card { scroll-snap-align: start; width: 78vw; }
        .vg-steps { grid-template-columns: minmax(0, 1fr); }
        .vg-steps li { min-height: 0; }
        .vg-steps h3 { margin-top: 16px; }
        .vg-foot-row .vg-btn { margin-left: 0; }
      }
      @media (max-width: 480px) {
        .vg-nav-cta { display: none; }
        .vg-hero-art { height: 380px; }
      }
    </style>

    <script>
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);
      gsap.defaults({ ease: 'power3.out', duration: 0.85 });

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finePointer = !window.matchMedia('(pointer: coarse)').matches;
      const $$ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) =>
        Array.from(root.querySelectorAll<T>(sel)) as unknown as T[];

      // ---- Lenis on the GSAP ticker ----
      if (!reduceMotion) {
        const lenis = new Lenis({ lerp: 0.08, smoothWheel: true, wheelMultiplier: 0.9, anchors: true });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);
      }

      // ---- Hero: four-part timeline with replay ----
      function initHero() {
        const media = $$('[data-hero="media"]');
        const frame = document.querySelector<HTMLElement>('[data-hero="frame"]')!;
        const frameImg = document.querySelector<HTMLElement>('[data-hero-img]')!;
        const title = document.querySelector<HTMLElement>('[data-hero="title"]')!;
        const lines = $$('.motion-line', title);
        const copy = $$('[data-hero="copy"]');
        const cta = $$('[data-hero="cta"]');
        const nav = document.querySelector<HTMLElement>('[data-hero="nav"]')!;
        const bars = $$('[data-seq]');
        const glow = document.querySelector<HTMLElement>('.vg-hero .vg-glow')!;

        if (reduceMotion) {
          gsap.set([nav, frame, title, ...media, ...copy, ...cta], { autoAlpha: 1 });
          gsap.set(bars, { scaleX: 1 });
          return null;
        }

        const tl = gsap.timeline({ defaults: { ease: 'power4.out' } });
        // 01 Media — background first
        tl.addLabel('media', 0)
          .fromTo(glow, { autoAlpha: 0 }, { autoAlpha: 1, duration: 1.4, ease: 'power3.out' }, 'media')
          .fromTo(frame, { autoAlpha: 1, clipPath: 'inset(100% 0% 0% 0% round 999px 999px 28px 28px)' }, { clipPath: 'inset(0% 0% 0% 0% round 999px 999px 28px 28px)', duration: 1.1 }, 'media')
          .fromTo(frameImg, { scale: 1.14 }, { scale: 1, duration: 1.4 }, 'media')
          .fromTo(media, { y: 36, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 1, stagger: 0.09 }, 'media+=0.35')
          .fromTo(nav, { autoAlpha: 0, y: -12 }, { autoAlpha: 1, y: 0, duration: 0.9 }, 'media+=0.2')
          // 02 Headline — lines
          .addLabel('headline', 0.45)
          .set(title, { autoAlpha: 1 }, 'headline')
          .fromTo(lines, { yPercent: 105, autoAlpha: 0, filter: 'blur(8px)' }, { yPercent: 0, autoAlpha: 1, filter: 'blur(0px)', duration: 1, stagger: 0.11 }, 'headline')
          // 03 Copy
          .addLabel('copy', 1.05)
          .fromTo(copy, { y: 24, autoAlpha: 0, filter: 'blur(8px)' }, { y: 0, autoAlpha: 1, filter: 'blur(0px)', duration: 0.9, stagger: 0.08 }, 'copy')
          // 04 Action
          .addLabel('action', 1.4)
          .fromTo(cta, { y: 18, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.8, stagger: 0.08, ease: 'power3.out' }, 'action');

        // Sequence strip mirrors each part's span.
        const spans: [string, number][] = [['media', 1.1], ['headline', 1.2], ['copy', 0.98], ['action', 0.88]];
        spans.forEach(([label, d], i) => {
          tl.fromTo(bars[i], { scaleX: 0 }, { scaleX: 1, duration: d, ease: 'power3.out' }, label);
        });

        const replay = document.querySelector<HTMLButtonElement>('[data-replay]')!;
        replay.addEventListener('click', () => tl.restart());
        return tl;
      }

      // ---- Text reveals ----
      function splitWords(element: HTMLElement) {
        if (element.dataset.motionSplit === 'true') return;
        const text = element.textContent || '';
        element.textContent = '';
        element.setAttribute('aria-label', text.trim());
        text.split(/(\s+)/).forEach((part) => {
          if (!part.trim()) {
            element.appendChild(document.createTextNode(part));
            return;
          }
          const mask = document.createElement('span');
          const word = document.createElement('span');
          mask.className = 'motion-word-mask';
          mask.setAttribute('aria-hidden', 'true');
          word.className = 'motion-word';
          word.textContent = part;
          mask.appendChild(word);
          element.appendChild(mask);
        });
        element.dataset.motionSplit = 'true';
      }

      function initTextReveals() {
        if (reduceMotion) {
          gsap.set('[data-motion-text]', { autoAlpha: 1 });
          return;
        }
        $$("[data-motion-text='words']").forEach((el) => {
          splitWords(el);
          gsap.set(el, { autoAlpha: 1 });
          gsap.fromTo(el.querySelectorAll('.motion-word'), { yPercent: 110, autoAlpha: 0, filter: 'blur(8px)' }, {
            yPercent: 0, autoAlpha: 1, filter: 'blur(0px)', duration: 0.9, ease: 'power4.out', stagger: 0.045,
            scrollTrigger: { trigger: el, start: 'top 82%', once: true },
          });
        });
        $$("[data-motion-text='lines']").forEach((el) => {
          gsap.set(el, { autoAlpha: 1 });
          gsap.fromTo(el.querySelectorAll('.motion-line'), { yPercent: 105, autoAlpha: 0, filter: 'blur(8px)' }, {
            yPercent: 0, autoAlpha: 1, filter: 'blur(0px)', duration: 1, ease: 'power4.out', stagger: 0.11,
            scrollTrigger: { trigger: el, start: 'top 84%', once: true },
          });
        });
      }

      // ---- Scroll reveals ----
      const revealPresets: Record<string, { from: gsap.TweenVars; to: gsap.TweenVars }> = {
        'fade-up': { from: { y: 32, autoAlpha: 0 }, to: { y: 0, autoAlpha: 1 } },
        'blur-in': { from: { y: 18, autoAlpha: 0, filter: 'blur(10px)' }, to: { y: 0, autoAlpha: 1, filter: 'blur(0px)' } },
      };

      function initScrollReveals() {
        if (reduceMotion) {
          gsap.set('[data-reveal], [data-reveal-item], [data-reveal-group]', { autoAlpha: 1 });
          return;
        }
        $$('[data-reveal-group]').forEach((group) => {
          gsap.set(group, { autoAlpha: 1 });
          gsap.fromTo(group.querySelectorAll('[data-reveal-item]'), { y: 36, autoAlpha: 0, filter: 'blur(8px)' }, {
            y: 0, autoAlpha: 1, filter: 'blur(0px)', duration: 0.95, ease: 'power4.out', stagger: 0.075,
            scrollTrigger: { trigger: group, start: 'top 82%', once: true },
          });
        });
        $$('[data-reveal]:not([data-reveal-item])').forEach((el) => {
          const preset = revealPresets[el.dataset.reveal || ''] || revealPresets['fade-up'];
          gsap.set(el, { autoAlpha: 1 });
          gsap.fromTo(el, preset.from, {
            ...preset.to, duration: 0.9, ease: 'power4.out',
            scrollTrigger: { trigger: el, start: 'top 84%', once: true },
          });
        });
      }

      // ---- Clip image reveals ----
      function initImageReveals() {
        if (reduceMotion) {
          gsap.set('[data-image-reveal]', { autoAlpha: 1, clipPath: 'none' });
          return;
        }
        $$('[data-image-reveal]').forEach((figure) => {
          const image = figure.querySelector('img');
          gsap.set(figure, { autoAlpha: 1 });
          gsap.timeline({ scrollTrigger: { trigger: figure, start: 'top 82%', once: true } })
            .fromTo(figure, { clipPath: 'inset(0 0 100% 0)' }, { clipPath: 'inset(0 0 0% 0)', duration: 1.1, ease: 'power4.out' })
            .fromTo(image, { scale: 1.08, autoAlpha: 0.75 }, { scale: 1, autoAlpha: 1, duration: 1.2, ease: 'power4.out' }, 0);
        });
      }

      // ---- Parallax (background slower, foreground faster) ----
      function initParallax() {
        if (reduceMotion) return;
        $$('[data-parallax-image], [data-parallax-layer]').forEach((layer) => {
          const speed = Number(layer.dataset.parallaxSpeed || 0.18);
          const section = (layer.parentElement?.closest('[data-parallax-section]') as HTMLElement) || layer;
          gsap.to(layer, {
            y: () => window.innerHeight * speed * -1,
            ease: 'none',
            scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 1.2, invalidateOnRefresh: true },
          });
        });
      }

      // ---- Pinned scenes (desktop only; stacked on phones) ----
      function initPinned() {
        if (reduceMotion) return;
        const mm = gsap.matchMedia();
        mm.add('(min-width: 900px)', () => {
          // DOM order matters: the story pin must exist before the gallery measures its start.
          $$('[data-story-scene]').forEach((scene) => {
            const panels = $$('[data-story-panel]', scene);
            const tiers = $$('[data-tier]', scene);
            const bar = scene.querySelector('[data-story-progress]');
            gsap.timeline({
              scrollTrigger: {
                trigger: scene, start: 'top top', end: () => `+=${panels.length * window.innerHeight}`,
                scrub: 1.1, pin: true, anticipatePin: 1,
                onUpdate: (self) => {
                  const idx = Math.round(self.progress * (panels.length - 1));
                  tiers.forEach((t, i) => t.classList.toggle('is-active', i === idx));
                },
              },
            })
              .to(panels, { yPercent: -100 * (panels.length - 1), ease: 'none' })
              .to(scene.querySelectorAll('[data-story-depth]'), { yPercent: -16, ease: 'none' }, 0)
              .fromTo(bar, { scaleX: 0 }, { scaleX: 1, ease: 'none' }, 0);
          });

          $$('[data-horizontal-gallery]').forEach((section) => {
            const track = section.querySelector<HTMLElement>('[data-horizontal-track]');
            if (!track) return;
            gsap.to(track, {
              x: () => -(track.scrollWidth - window.innerWidth),
              ease: 'none',
              scrollTrigger: {
                trigger: section, start: 'top top', end: () => `+=${track.scrollWidth - window.innerWidth}`,
                scrub: 1, pin: true, anticipatePin: 1, invalidateOnRefresh: true,
              },
            });
          });
        });
      }

      // ---- Magnetic buttons + tilt cards ----
      function initMagnetic() {
        if (reduceMotion || !finePointer) return;
        $$('[data-magnetic]').forEach((el) => {
          const strength = Number(el.dataset.magnetic || 0.18);
          const xTo = gsap.quickTo(el, 'x', { duration: 0.45, ease: 'power3.out' });
          const yTo = gsap.quickTo(el, 'y', { duration: 0.45, ease: 'power3.out' });
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            xTo((e.clientX - r.left - r.width / 2) * strength);
            yTo((e.clientY - r.top - r.height / 2) * strength);
          });
          el.addEventListener('pointerleave', () => { xTo(0); yTo(0); });
        });
        $$('[data-tilt]').forEach((card) => {
          gsap.set(card, { transformPerspective: 900 });
          const rx = gsap.quickTo(card, 'rotationX', { duration: 0.55, ease: 'power3.out' });
          const ry = gsap.quickTo(card, 'rotationY', { duration: 0.55, ease: 'power3.out' });
          card.addEventListener('pointermove', (e) => {
            const r = card.getBoundingClientRect();
            ry(((e.clientX - r.left) / r.width - 0.5) * 6); // ±3deg, under the 4deg ceiling
            rx(((e.clientY - r.top) / r.height - 0.5) * -6);
          });
          card.addEventListener('pointerleave', () => { rx(0); ry(0); });
        });
      }

      // ---- Cursor follower ----
      function initCursor() {
        if (reduceMotion || !finePointer) return;
        const cursor = document.querySelector<HTMLElement>('[data-cursor]');
        if (!cursor) return;
        const dot = cursor.querySelector('.vg-cursor-dot');
        const label = cursor.querySelector<HTMLElement>('[data-cursor-label]');
        const xTo = gsap.quickTo(cursor, 'x', { duration: 0.35, ease: 'power3.out' });
        const yTo = gsap.quickTo(cursor, 'y', { duration: 0.35, ease: 'power3.out' });
        let shown = false;
        document.addEventListener('pointermove', (e) => {
          if (!shown) {
            gsap.set(cursor, { x: e.clientX, y: e.clientY });
            gsap.to(cursor, { opacity: 1, duration: 0.4 });
            shown = true;
          }
          xTo(e.clientX);
          yTo(e.clientY);
        });
        $$('[data-cursor-label]').filter((t) => !cursor.contains(t)).forEach((t) => {
          t.addEventListener('pointerenter', () => {
            if (label) label.textContent = t.dataset.cursorLabel || '';
            gsap.to(dot, { scale: 1.75, duration: 0.35, ease: 'power3.out' });
            gsap.fromTo(label, { autoAlpha: 0, x: -6 }, { autoAlpha: 1, x: 0, duration: 0.35 });
          });
          t.addEventListener('pointerleave', () => {
            gsap.to(dot, { scale: 1, duration: 0.35, ease: 'power3.out' });
            gsap.to(label, { autoAlpha: 0, duration: 0.25 });
          });
        });
      }

      // ---- Mouse-reactive layers ----
      function initMouseParallax() {
        if (reduceMotion || !finePointer) return;
        $$('[data-mouse-parallax]').forEach((section) => {
          const setters = $$('[data-mouse-depth]', section).map((layer) => ({
            depth: Number(layer.dataset.mouseDepth || 0.04),
            xTo: gsap.quickTo(layer, 'x', { duration: 0.8, ease: 'power3.out' }),
            yTo: gsap.quickTo(layer, 'y', { duration: 0.8, ease: 'power3.out' }),
          }));
          section.addEventListener('pointermove', (e) => {
            const r = section.getBoundingClientRect();
            const x = e.clientX - r.left - r.width / 2;
            const y = e.clientY - r.top - r.height / 2;
            setters.forEach(({ depth, xTo, yTo }) => { xTo(x * depth); yTo(y * depth); });
          });
          section.addEventListener('pointerleave', () => setters.forEach(({ xTo, yTo }) => { xTo(0); yTo(0); }));
        });
      }

      // Pins first so later triggers measure the pin spacing.
      initPinned();
      initHero();
      initTextReveals();
      initScrollReveals();
      initImageReveals();
      initParallax();
      initMagnetic();
      initCursor();
      initMouseParallax();
      ScrollTrigger.refresh();
      window.addEventListener('load', () => ScrollTrigger.refresh());
      document.fonts?.ready.then(() => ScrollTrigger.refresh());
    </script>
  </body>
</html>
