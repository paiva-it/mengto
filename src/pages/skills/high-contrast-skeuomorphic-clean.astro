      .range-ticks { display: flex; justify-content: space-between; margin-top: 4px; font-size: 9px; }
      .track { position: relative; height: 6px; margin-top: 18px; border-radius: 99px; }
      .track-f { position: absolute; inset: 0 auto 0 0; border-radius: 99px; background: linear-gradient(90deg, rgba(116, 240, 167, 0.15), var(--sig)); }
      .knob { position: absolute; top: 50%; width: 16px; height: 16px; margin: -8px 0 0 -8px; border-radius: 50%; background: linear-gradient(180deg, #fff, #c9cacd); box-shadow: 0 1px 0 #000, 0 3px 6px rgba(0, 0, 0, 0.7); }

      /* Blocks */
      .block { padding-top: 96px; }
      .block-h { max-width: 46rem; }
      .h2 { font-weight: 400; font-size: clamp(32px, 3.6vw, 52px); line-height: 1.04; letter-spacing: -0.03em; color: #f3f4f5; text-wrap: balance; }
      .h2-sm { font-size: clamp(28px, 2.6vw, 38px); }
      .steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 40px; }
      .step { display: flex; flex-direction: column; gap: 12px; padding: 20px; transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1); }
      .step:hover { transform: translateY(-3px); }
      .step-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
      .step-n { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; font-size: 13px; color: #d7d9dc; }
      .step-t { font-weight: 500; font-size: 22px; letter-spacing: -0.02em; }
      .step .small { flex: 1; }
      .sliver { height: 4px; margin-top: 10px; border-radius: 9px; overflow: hidden; }
      .sliver span { display: block; height: 100%; border-radius: 9px; background: linear-gradient(90deg, #6d7077, #d6d8dc); }
      .step:nth-child(3) .sliver span { background: linear-gradient(90deg, var(--sig-d), var(--sig)); box-shadow: 0 0 8px rgba(116, 240, 167, 0.6); }

      .duo { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 20px; align-items: stretch; }
      .orbit-card { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 24px; align-items: center; padding: 28px; border-radius: 28px; }
      .orbit-copy .small { margin-top: 14px; }
      .orbit-well { border-radius: 50%; padding: 0; aspect-ratio: 1; }
      .orbit { display: block; width: 100%; height: 100%; }
      .o-ring { fill: none; stroke: rgba(255, 255, 255, 0.12); }
      .o-dash { stroke-dasharray: 2 6; stroke: #4a4c53; stroke-width: 6; }
      .o-core { fill: #17181b; stroke: rgba(255, 255, 255, 0.2); }
      .o-lbl { font: 500 9px var(--mono); letter-spacing: 0.2em; fill: #b7b9be; text-anchor: middle; }
      .o-spin { transform-origin: 130px 130px; animation: spin 80s linear infinite; }
      .o-node line { stroke: rgba(255, 255, 255, 0.22); stroke-dasharray: 3 3; }
      .o-node circle { fill: #222327; stroke: rgba(255, 255, 255, 0.35); }
      .o-node.is-sig circle { fill: var(--sig); stroke: none; filter: drop-shadow(0 0 5px rgba(116, 240, 167, 0.9)); }
      .o-node.is-sig line { stroke: var(--sig); }
      @keyframes spin { to { transform: rotate(360deg); } }

      .modes { padding: 24px; border-radius: 28px; display: flex; flex-direction: column; gap: 18px; }
      .modes .col-h { padding: 0; }
      .mode-list { display: flex; flex-direction: column; gap: 14px; }
      .mode-list li { display: grid; grid-template-columns: 96px minmax(0, 1fr) 42px; gap: 14px; align-items: center; font-size: 14px; color: #d5d7da; }
      .bar-w { height: 10px; border-radius: 99px; overflow: hidden; padding: 2px; }
      .bar-f { display: block; height: 100%; border-radius: 99px; background: linear-gradient(180deg, #e6e7e9, #8e9097); }
      .bar-sig { background: linear-gradient(180deg, #b6fbd3, var(--sig)); box-shadow: 0 0 8px rgba(116, 240, 167, 0.5); }
      .mode-v { text-align: right; font-size: 13px; color: var(--mute); }
      .mode-foot { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: auto; padding-top: 18px; border-top: 1px solid rgba(255, 255, 255, 0.06); }
      .mode-foot .tiny { font-size: 9.5px; margin-top: 4px; }

      .duo-join { align-items: center; gap: 48px; }
      .switches { display: flex; flex-direction: column; gap: 12px; margin-top: 30px; }
      .sw { display: inline-flex; align-items: center; gap: 14px; padding: 0; border: 0; background: none; color: #d6d8dc; font: 400 15px var(--sans); cursor: pointer; text-align: left; width: fit-content; }
      .sw-t { position: relative; flex: none; width: 46px; height: 26px; border-radius: 99px; transition: background 0.25s; }
      .sw-k { position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: linear-gradient(180deg, #4a4c52, #2a2b30); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 2px 4px rgba(0, 0, 0, 0.8); transition: transform 0.25s cubic-bezier(0.3, 0.7, 0.3, 1), background 0.25s; }
      .sw[aria-checked='true'] .sw-t { background: #0b2a1a; box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.8), inset 0 0 0 1px rgba(116, 240, 167, 0.3); }
      .sw[aria-checked='true'] .sw-k { transform: translateX(20px); background: linear-gradient(180deg, #fff, #cfd0d3); }

      .search-card { padding: 16px; border-radius: 28px; display: flex; flex-direction: column; gap: 12px; }
      .search { display: flex; align-items: center; gap: 12px; height: 56px; padding: 0 16px; border-radius: 16px; color: var(--mute); cursor: text; }
      .search input { flex: 1; min-width: 0; height: 100%; border: 0; outline: 0; background: transparent; color: var(--ink); font: 400 16px var(--sans); }
      .search input::placeholder { color: var(--faint); }
      .search:focus-within { box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.8), inset 0 0 0 1px rgba(116, 240, 167, 0.45), 0 1px 0 rgba(255, 255, 255, 0.06); }
      kbd { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 6px; color: var(--mute); background: linear-gradient(180deg, #24252a, #17181b); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 1px 0 #000; }
      .results { display: flex; flex-direction: column; min-height: 252px; }
      .res { display: grid; grid-template-columns: 10px minmax(0, 1fr) auto; gap: 14px; align-items: center; padding: 14px 8px; border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
      .res:last-child { border-bottom: 0; }
      .res-dot { width: 7px; height: 7px; border-radius: 50%; background: #4a4c53; }
      .res-dot.is-sig { background: var(--sig); box-shadow: 0 0 8px var(--sig); }
      .res-n { display: block; font-size: 15px; color: #eceef0; }
      .res-s { display: block; margin-top: 2px; font-size: 13px; color: var(--faint); }
      .res-empty { display: block; color: var(--mute); font-size: 14px; }

      .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; margin-top: 96px; padding-top: 22px; border-top: 1px solid rgba(255, 255, 255, 0.07); font-size: 10.5px; }
      .foot .sig-dot { width: 5px; height: 5px; }

      /* Responsive */
      @media (max-width: 1180px) {
        .hide-md { display: none; }
        .vitals { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .today { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .today .col:last-child { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 20px; }
        .today .col:last-child .col-h { grid-column: 1 / -1; }
        .today .col:last-child .inst + .inst { margin-top: 0; }
        .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .duo { grid-template-columns: minmax(0, 1fr); }
      }
      @media (max-width: 900px) {
        .shell { margin: 12px 10px 32px; padding: 18px 18px 22px; border-radius: 28px; }
        .rail { display: none; }
        .bar { flex-wrap: wrap; }
        .seg { order: 3; flex: 1 0 100%; }
        .hide-sm { display: none; }
        .hero { grid-template-columns: minmax(0, 1fr); gap: 32px; padding: 40px 0 44px; }
        .today { grid-template-columns: minmax(0, 1fr); }
        .today .col:last-child { display: flex; }
        .today .col:last-child .inst + .inst { margin-top: 0; }
        .block { padding-top: 72px; }
        .duo-join { gap: 28px; }
      }
      @media (max-width: 560px) {
        .h1 { font-size: 42px; }
        .lede { font-size: 16px; }
        .vitals { gap: 10px; }
        .num { font-size: 26px; }
        .steps { grid-template-columns: minmax(0, 1fr); }
        .orbit-card { grid-template-columns: minmax(0, 1fr); padding: 22px; }
        .orbit-well { width: min(240px, 100%); margin: 0 auto; }
        .mode-list li { grid-template-columns: 78px minmax(0, 1fr) 38px; gap: 10px; }
        .mode-foot { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
        .tl { padding: 18px 14px 6px; }
        .tl-i { grid-template-columns: 42px 12px minmax(0, 1fr); gap: 10px; }
        .tl-i::after { left: 57px; }
        .map-legend { gap: 8px 12px; }
      }
      @media (prefers-reduced-motion: reduce) {
        .pulse, .o-spin { animation: none; }
        .step, .key, .sw-k, .meter-f { transition: none; }
      }
    </style>
  </body>
</html>
