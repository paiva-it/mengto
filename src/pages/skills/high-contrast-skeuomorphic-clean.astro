---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

const districts = [
  { id: 'all', label: 'Whole core' },
  { id: 'old', label: 'Old Town' },
  { id: 'market', label: 'Market' },
  { id: 'river', label: 'Riverside' },
  { id: 'linden', label: 'Linden' },
];

const timeline = [
  { t: '05:30', title: 'Delivery window opens', meta: 'Marktgasse · cargo bikes & vans', done: true },
  { t: '10:00', title: 'Bollards down — Weavers’ Row', meta: 'Market day · stalls until 15:00', live: true },
  { t: '14:10', title: 'School street — Lindenschule', meta: 'Pick-up · gate 4 closed 40 min' },
  { t: '19:00', title: 'Evening terraces — River Quay', meta: 'Tables out until 23:00' },
];

const requests = [
  { who: 'MK', street: 'Weavers’ Row 14', items: [{ text: 'Add a bench outside the bakery', done: true }, { text: 'Move bike rack out of fire lane', done: false }] },
  { who: 'JS', street: 'Kornstraße', items: [{ text: 'Extend delivery window to 11:30', done: true }, { text: 'Plant two limes at the corner', done: false }] },
];

const steps = [
  { n: '01', title: 'Filter', body: 'Six modal filters at the ring-road gates. Buses, bikes and blue lights pass; through-traffic turns back.', state: 'Done', p: 100 },
  { n: '02', title: 'Trial', body: 'Paint, planters and loose seating for ninety days. Anything that fails is moved by Monday.', state: 'Done', p: 100 },
  { n: '03', title: 'Count', body: '38 street sensors log footfall, NO₂ and noise every hour — published raw, here, before anyone spins it.', state: 'Running', p: 64 },
  { n: '04', title: 'Rebuild', body: 'Kerbs come out, stone goes down, drains learn to take rain. Weavers’ Row first, spring 2027.', state: 'Next', p: 12 },
];

const modes = [
  { m: 'Walking', v: 46 },
  { m: 'Cycling', v: 29 },
  { m: 'Tram & bus', v: 18 },
  { m: 'Car', v: 7 },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Open Core — Vessmark car-free centre</title>
    <meta name="description" content="Open Core is Vessmark's public console for its car-free old town: closures, air, noise and resident requests, live." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="hc-page">
    <BackPill />
    <main class="shell" id="top">
      <canvas class="shell-dust" aria-hidden="true"></canvas>
      <span class="rail rail-l" aria-hidden="true"></span>
      <span class="rail rail-r" aria-hidden="true"></span>

      <!-- Top bar -->
      <header class="bar">
        <a href="#top" class="brand" aria-label="Open Core home">
          <span class="key key-sq" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3"/><path d="M12 3.5v5M12 15.5v5M3.5 12h5M15.5 12h5"/></svg>
          </span>
          <span class="brand-t">OPEN CORE<span class="brand-s">Vessmark</span></span>
        </a>
        <nav class="seg" aria-label="District">
          <div class="seg-in" role="tablist">
            {districts.map((d, i) => (
              <button type="button" role="tab" class="seg-b" data-district={d.id} aria-selected={i === 0 ? 'true' : 'false'}>
                {i === 0 && <span class="sig-dot" aria-hidden="true"></span>}{d.label}
              </button>
            ))}
          </div>
        </nav>
        <div class="bar-r">
          <span class="mono tiny dim hide-sm">Day 214</span>
          <button type="button" class="key key-ic" aria-label="Notifications">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 16V11a6 6 0 1 1 12 0v5l1.5 2h-15z"/><path d="M10 20a2 2 0 0 0 4 0"/></svg>
            <span class="badge-dot" aria-hidden="true"></span>
          </button>
        </div>
      </header>

      <!-- Hero -->
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow mono"><span class="sig-dot pulse" aria-hidden="true"></span>LIVE · 1.8 KM² CAR-FREE · 38 SENSORS</p>
          <h1 class="h1">A city centre <span class="h1-dim">that breathes again.</span></h1>
          <p class="lede">Open Core is Vessmark’s public console for its car-free old town — every closed street, every bollard and every hour of air, reported as it happens and open to the people who live here.</p>
          <div class="cta-row">
            <a href="#streets" class="key key-light">Find your street
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a href="#charter" class="key key-dark">Read the charter</a>
          </div>
          <dl class="vitals">
            <div class="mold vital">
              <dt class="mono tiny dim">NO₂ · annual mean</dt>
              <dd><span class="num" data-v="no2">18</span><span class="unit">µg/m³</span></dd>
              <dd class="delta mono"><span data-v="no2d">−41%</span> since closure</dd>
            </div>
            <div class="mold vital">
              <dt class="mono tiny dim">Street noise · daytime</dt>
              <dd><span class="num" data-v="db">52</span><span class="unit">dB(A)</span></dd>
              <dd class="delta mono"><span data-v="dbd">−9 dB</span> at façade</dd>
            </div>
            <div class="mold vital hide-md">
              <dt class="mono tiny dim">Streets returned</dt>
              <dd><span class="num" data-v="streets">64</span><span class="unit">of 71</span></dd>
              <dd class="delta mono">7 in trial</dd>
            </div>
          </dl>
        </div>

        <!-- Map instrument -->
        <div class="mold map-card">
          <div class="win-chrome">
            <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="mono tiny dim">inner-ring.live</span>
            <span class="chip mono"><span class="sig-dot" aria-hidden="true"></span><span data-v="label">Whole core</span></span>
          </div>
          <div class="well map-well">
            <svg class="map" viewBox="0 0 440 300" role="img" aria-label="Map of Vessmark's car-free core: six loops reachable only from the ring road, with six filtered gates and live cyclist movement.">
              <defs>
                <pattern id="hc-grid" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" fill="none" stroke="rgba(255,255,255,.035)" stroke-width="1"/></pattern>
                <radialGradient id="hc-glow" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#74f0a7" stop-opacity=".18"/><stop offset="1" stop-color="#74f0a7" stop-opacity="0"/></radialGradient>
              </defs>
              <rect width="440" height="300" fill="url(#hc-grid)"/>
              <!-- river -->
              <path d="M-10 262 C 90 236, 160 288, 250 260 S 400 236, 450 252" fill="none" stroke="#1f2a33" stroke-width="18" stroke-linecap="round"/>
              <path d="M-10 262 C 90 236, 160 288, 250 260 S 400 236, 450 252" fill="none" stroke="#2c3b47" stroke-width="1" stroke-dasharray="2 6"/>
              <!-- loops (cells) -->
              <g class="cells">
                <path data-cell="old" d="M96 70 L206 52 L214 136 L110 150 Z"/>
                <path data-cell="market" d="M206 52 L330 66 L322 140 L214 136 Z"/>
                <path data-cell="linden" d="M330 66 L372 120 L362 196 L322 140 Z"/>
                <path data-cell="river" d="M110 150 L214 136 L222 220 L120 228 Z"/>
                <path data-cell="river" d="M214 136 L322 140 L362 196 L300 226 L222 220 Z"/>
                <path data-cell="old" d="M70 120 L96 70 L110 150 L120 228 L76 200 Z"/>
              </g>
              <!-- ring road (cars allowed) -->
              <path class="ring" d="M60 112 C 60 60, 120 34, 220 34 S 392 56, 392 120 S 380 224, 300 240 S 110 252, 70 214 S 60 150, 60 112 Z"/>
              <!-- car-free streets -->
              <g class="streets">
                <path d="M96 70 L206 52 L330 66 L372 120"/>
                <path d="M110 150 L214 136 L322 140 L362 196"/>
                <path d="M206 52 L214 136 L222 220"/>
                <path d="M96 70 L110 150 L120 228"/>
                <path d="M330 66 L322 140 L300 226"/>
                <path d="M70 120 L110 150"/>
              </g>
              <!-- filters / gates -->
              <g class="gates">
                <rect x="66" y="108" width="8" height="8"/><rect x="200" y="30" width="8" height="8"/>
                <rect x="368" y="84" width="8" height="8"/><rect x="372" y="186" width="8" height="8"/>
                <rect x="216" y="232" width="8" height="8"/><rect x="104" y="216" width="8" height="8"/>
              </g>
              <circle cx="214" cy="136" r="70" fill="url(#hc-glow)"/>
              <!-- movers -->
              <g class="movers">
                <circle r="3"><animateMotion dur="14s" repeatCount="indefinite" path="M96 70 L206 52 L330 66 L372 120"/></circle>
                <circle r="3"><animateMotion dur="11s" repeatCount="indefinite" begin="-4s" path="M110 150 L214 136 L322 140 L362 196"/></circle>
                <circle r="2.5"><animateMotion dur="9s" repeatCount="indefinite" begin="-2s" path="M222 220 L214 136 L206 52"/></circle>
                <circle r="2.5"><animateMotion dur="12s" repeatCount="indefinite" begin="-7s" path="M120 228 L110 150 L96 70"/></circle>
                <circle r="2.5"><animateMotion dur="10s" repeatCount="indefinite" begin="-3s" path="M300 226 L322 140 L330 66"/></circle>
                <circle r="2"><animateMotion dur="16s" repeatCount="indefinite" begin="-9s" path="M372 120 L330 66 L206 52 L96 70"/></circle>
              </g>
              <g class="labels">
                <text x="128" y="104">OLD TOWN</text><text x="240" y="100">MARKET</text>
                <text x="334" y="134">LINDEN</text><text x="232" y="200">RIVERSIDE</text>
                <text x="14" y="292">ring road · cars ok</text>
              </g>
            </svg>
            <span class="corner c-tl" aria-hidden="true"></span><span class="corner c-tr" aria-hidden="true"></span>
            <span class="corner c-bl" aria-hidden="true"></span><span class="corner c-br" aria-hidden="true"></span>
          </div>
          <div class="map-legend mono tiny">
            <span><i class="lg lg-street"></i>Car-free street</span>
            <span><i class="lg lg-ring"></i>Ring road</span>
            <span><i class="lg lg-gate"></i>Filter gate</span>
            <span><i class="lg lg-move"></i>Bikes · live</span>
          </div>
        </div>
      </section>

      <!-- Today -->
      <section class="today" aria-labelledby="today-h">
        <h2 id="today-h" class="sr">Today on the streets</h2>
        <div class="col">
          <div class="col-h">
            <span class="col-t"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>Street timeline</span>
            <span class="mono tiny dim">Thu 2 Oct</span>
          </div>
          <ol class="mold tl">
            {timeline.map((e) => (
              <li class:list={['tl-i', { 'is-done': e.done, 'is-live': e.live }]}>
                <span class="tl-t mono">{e.t}</span>
                <span class="tl-dot" aria-hidden="true"></span>
                <div class:list={['tl-b', { 'mold raised': e.live }]}>
                  <p class="tl-title">{e.title}</p>
                  <p class="tl-meta">{e.meta}</p>
                  {e.live && <span class="chip chip-sig mono">LIVE</span>}
                </div>
              </li>
            ))}
          </ol>
        </div>

        <div class="col">
          <div class="col-h">
            <span class="col-t"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3h6v1M9 11l2 2 4-4"/></svg>Resident requests</span>
            <span class="mono tiny dim"><span id="open-count">2</span> open</span>
          </div>
          <div class="mold req">
            {requests.map((r) => (
              <div class="req-g">
                <p class="req-who"><span class="well av mono">{r.who}</span><span class="mono">{r.street}</span></p>
                {r.items.map((it) => (
                  <label class="check">
                    <input type="checkbox" checked={it.done} />
                    <span class="box" aria-hidden="true"><svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3.5 8.5l3 3 6-7"/></svg></span>
                    <span class="check-t">{it.text}</span>
                  </label>
                ))}
              </div>
            ))}
          </div>
        </div>

        <div class="col">
          <div class="col-h">
            <span class="col-t"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12a8 8 0 0 1 16 0M7.5 12a4.5 4.5 0 0 1 9 0"/><circle cx="12" cy="12" r="1.4" fill="currentColor"/></svg>Instruments</span>
            <span class="mono tiny dim">hourly</span>
          </div>
          <div class="mold inst">
            <div class="inst-top">
              <span class="well inst-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 9h11a3 3 0 1 0-3-3M3 14h15a3 3 0 1 1-3 3M3 19h7"/></svg></span>
              <div>
                <p class="mono tiny"><span class="sig-dot" aria-hidden="true"></span> Air · Weavers’ Row</p>
                <p class="inst-title">NO₂ at <span id="air-hour">08:00</span></p>
                <p class="dim small"><span id="air-val">22</span> µg/m³ · WHO line 10</p>
              </div>
            </div>
            <div class="meter well" aria-hidden="true"><span class="meter-f" id="air-fill"></span><span class="meter-who"></span></div>
            <label class="range-l">
              <span class="sr">Hour of day</span>
              <input id="air-range" class="range" type="range" min="0" max="23" value="8" />
            </label>
            <div class="range-ticks mono tiny dim"><span>00</span><span>06</span><span>12</span><span>18</span><span>23</span></div>
          </div>
          <div class="mold inst">
            <div class="inst-top">
              <span class="well inst-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="6" y="3" width="12" height="14" rx="3"/><path d="M6 11h12M9 21l1.5-4M15 21l-1.5-4"/></svg></span>
              <div>
                <p class="mono tiny"><span class="sig-dot" aria-hidden="true"></span> Tram · Line 3</p>
                <p class="inst-title">Every 6 minutes</p>
                <p class="dim small">Quay → Linden · next in <span id="tram-n">4</span> min</p>
              </div>
            </div>
            <div class="track well" aria-hidden="true"><span class="track-f" id="tram-fill"></span><span class="knob" id="tram-knob"></span></div>
          </div>
        </div>
      </section>

      <!-- Charter / steps -->
      <section class="block" id="charter" aria-labelledby="charter-h">
        <div class="block-h">
          <p class="eyebrow mono">THE CHARTER · FOUR MOVES</p>
          <h2 id="charter-h" class="h2">From kerb to commons. <span class="h1-dim">Slowly, in public.</span></h2>
        </div>
        <div class="steps">
          {steps.map((s) => (
            <article class="mold step">
              <div class="step-top">
                <span class="well step-n mono">{s.n}</span>
                <span class:list={['chip mono', { 'chip-sig': s.state === 'Running' }]}>{s.state}</span>
              </div>
              <h3 class="step-t">{s.title}</h3>
              <p class="dim small">{s.body}</p>
              <div class="sliver well" aria-label={`${s.p}% complete`} role="img"><span style={`width:${s.p}%`}></span></div>
            </article>
          ))}
        </div>
      </section>

      <!-- Instruments row -->
      <section class="block" aria-labelledby="loops-h">
        <div class="duo">
          <div class="mold orbit-card">
            <div class="orbit-copy">
              <p class="eyebrow mono">CIRCULATION</p>
              <h2 id="loops-h" class="h2 h2-sm">Six loops. No shortcuts.</h2>
              <p class="dim small">Every address is still reachable by car from the ring road — you just can’t drive through the core to get somewhere else. Six loops, each with one way in and the same way out.</p>
            </div>
            <div class="well orbit-well">
              <svg class="orbit" viewBox="0 0 260 260" aria-hidden="true">
                <circle cx="130" cy="130" r="118" class="o-ring o-dash"/>
                <circle cx="130" cy="130" r="80" class="o-ring"/>
                <circle cx="130" cy="130" r="38" class="o-core"/>
                <text x="130" y="134" class="o-lbl">CORE</text>
                <g class="o-spin">
                  <g class="o-node"><line x1="130" y1="50" x2="130" y2="12"/><circle cx="130" cy="50" r="7"/></g>
                  <g class="o-node" transform="rotate(60 130 130)"><line x1="130" y1="50" x2="130" y2="12"/><circle cx="130" cy="50" r="7"/></g>
                  <g class="o-node" transform="rotate(120 130 130)"><line x1="130" y1="50" x2="130" y2="12"/><circle cx="130" cy="50" r="7"/></g>
                  <g class="o-node is-sig" transform="rotate(180 130 130)"><line x1="130" y1="50" x2="130" y2="12"/><circle cx="130" cy="50" r="7"/></g>
                  <g class="o-node" transform="rotate(240 130 130)"><line x1="130" y1="50" x2="130" y2="12"/><circle cx="130" cy="50" r="7"/></g>
                  <g class="o-node" transform="rotate(300 130 130)"><line x1="130" y1="50" x2="130" y2="12"/><circle cx="130" cy="50" r="7"/></g>
                </g>
              </svg>
            </div>
          </div>
          <div class="mold modes">
            <div class="col-h">
              <span class="col-t">Trips into the core, by mode</span>
              <span class="mono tiny dim">Sep 2026</span>
            </div>
            <ul class="mode-list">
              {modes.map((m, i) => (
                <li>
                  <span class="mode-m">{m.m}</span>
                  <span class="well bar-w"><span class:list={['bar-f', { 'bar-sig': i === 0 }]} style={`width:${m.v}%`}></span></span>
                  <span class="mono mode-v">{m.v}%</span>
                </li>
              ))}
            </ul>
            <div class="mode-foot">
              <div><p class="num num-sm">1,240</p><p class="mono tiny dim">cargo-bike drops / day</p></div>
              <div><p class="num num-sm">+31%</p><p class="mono tiny dim">ground-floor footfall</p></div>
              <div><p class="num num-sm">0</p><p class="mono tiny dim">shops closed for access</p></div>
            </div>
          </div>
        </div>
      </section>

      <!-- Streets search -->
      <section class="block" id="streets" aria-labelledby="streets-h">
        <div class="duo duo-join">
          <div class="block-h">
            <p class="eyebrow mono">YOUR STREET</p>
            <h2 id="streets-h" class="h2">What’s happening <span class="h1-dim">outside your door?</span></h2>
            <p class="lede">Search any of the 71 streets inside the ring. Choose what we tell you about — nothing else, and never ads.</p>
            <div class="switches">
              <button type="button" class="sw" role="switch" aria-checked="true"><span class="sw-t well"><span class="sw-k"></span></span>Bollard &amp; closure changes</button>
              <button type="button" class="sw" role="switch" aria-checked="false"><span class="sw-t well"><span class="sw-k"></span></span>Air above the WHO line</button>
              <button type="button" class="sw" role="switch" aria-checked="true"><span class="sw-t well"><span class="sw-k"></span></span>Council votes on my loop</button>
            </div>
          </div>
          <div class="mold search-card">
            <label class="well search">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4 4"/></svg>
              <span class="sr">Street name</span>
              <input id="street-q" type="search" placeholder="Try “Weavers” or “Quay”" autocomplete="off" />
              <kbd class="mono tiny">/</kbd>
            </label>
            <ul class="results" id="street-list" aria-live="polite"></ul>
            <a href="#top" class="key key-light key-wide">Subscribe to this street</a>
          </div>
        </div>
      </section>

      <footer class="foot mono tiny dim">
        <span><span class="sig-dot" aria-hidden="true"></span> Open Core · a public service of the City of Vessmark (fictional)</span>
        <span>Data refreshed hourly · CC BY 4.0</span>
      </footer>
    </main>

    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector(s) as T;
      const $$ = (s: string, r: ParentNode = document) => [...r.querySelectorAll<HTMLElement>(s)];

      // District tabs → vitals + map cell highlight
      const data: Record<string, { label: string; no2: number; no2d: string; db: number; dbd: string; streets: string }> = {
        all: { label: 'Whole core', no2: 18, no2d: '−41%', db: 52, dbd: '−9 dB', streets: '64' },
        old: { label: 'Old Town', no2: 16, no2d: '−46%', db: 49, dbd: '−11 dB', streets: '22' },
        market: { label: 'Market', no2: 21, no2d: '−35%', db: 55, dbd: '−7 dB', streets: '14' },
        river: { label: 'Riverside', no2: 17, no2d: '−44%', db: 51, dbd: '−10 dB', streets: '17' },
        linden: { label: 'Linden', no2: 19, no2d: '−38%', db: 53, dbd: '−8 dB', streets: '11' },
      };
      const tabs = $$('.seg-b');
      const select = (btn: HTMLElement) => {
        const id = btn.dataset.district!;
        tabs.forEach((t) => {
          t.setAttribute('aria-selected', String(t === btn));
          t.tabIndex = t === btn ? 0 : -1;
        });
        const d = data[id];
        for (const k of ['no2', 'no2d', 'db', 'dbd', 'streets', 'label'] as const) {
          $$(`[data-v="${k}"]`).forEach((el) => (el.textContent = String(d[k])));
        }
        $$('.cells path').forEach((p) => p.classList.toggle('on', id === 'all' || p.dataset.cell === id));
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(t));
        t.addEventListener('keydown', (e) => {
          const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!step) return;
          const n = tabs[(i + step + tabs.length) % tabs.length];
          n.focus();
          select(n);
        });
      });
      select(tabs[0]);

      // Resident requests counter
      const boxes = $$('.req input') as unknown as HTMLInputElement[];
      const count = () => ($('#open-count').textContent = String(boxes.filter((b) => !b.checked).length));
      boxes.forEach((b) => b.addEventListener('change', count));
      count();

