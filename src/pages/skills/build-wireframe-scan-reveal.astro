---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Relay Nine — House Frame Nº 09</title>
    <meta name="description" content="A worker-owned bike courier collective surveys its house cargo frame: wire first, paint follows." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <section id="hero" class="hero" aria-labelledby="hero-title" data-state="scanning">
        <div class="pool" aria-hidden="true"></div>
        <p class="ghost" aria-hidden="true">R9</p>
        <canvas id="scan-canvas" aria-hidden="true"></canvas>

        <header class="bar">
          <a class="brand" href="#hero">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="16" r="4.2" /><circle cx="18" cy="16" r="4.2" /><path d="M6 16l4-8h6l2 8M10 8l2 8h6M14.5 5h3" /></svg>
            <span>Relay Nine</span>
          </a>
          <nav aria-label="Primary">
            <a href="#jig">The jig</a>
            <a href="#dispatch">Dispatch</a>
            <a class="join" href="#dispatch">Ride with us</a>
          </nav>
        </header>

        <div class="copy">
          <p class="eyebrow">Courier collective · est. 2014 · 14 riders</p>
          <h1 id="hero-title">Drawn before<br />it's welded.</h1>
          <p class="lede">
            We own our bikes the way we own the co-op: every tube measured, every joint argued over.
            House frame Nº 09 carries 30&nbsp;kg up Calçada hill and back before the espresso cools.
          </p>
        </div>

        <aside class="card" aria-label="House frame Nº 09">
          <img
            src="https://images.unsplash.com/photo-1507035895480-2b3156c31fc8?w=720&q=70&auto=format&fit=crop&crop=entropy&h=420"
            alt="A fixed-gear bike with orange rims leaning on a white wall"
            width="360"
            height="210"
          />
          <p class="card-k">House frame Nº 09 · “Kerbside”</p>
          <p class="card-t">Steel, fixed,<br />and stubborn.</p>
        </aside>

        <div class="panel">
          <div class="panel-top">
            <div>
              <p class="panel-k">Jig check 09</p>
              <p class="panel-t">Wire first. Paint follows.</p>
            </div>
            <button id="replay" type="button">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8a5 5 0 1 1-1.6-3.7M13 2.5v2.8h-2.8" /></svg>
              Replay scan
            </button>
          </div>
          <dl class="panel-row">
            <div><dt>Sweep</dt><dd>3.4 s</dd></div>
            <div><dt>Lag</dt><dd>520 mm</dd></div>
            <div><dt>Front</dt><dd id="scan-pct">0%</dd></div>
            <div><dt>State</dt><dd id="scan-state">Scanning</dd></div>
          </dl>
          <p id="scan-status" class="sr-only" aria-live="polite"></p>
        </div>
      </section>

      <section id="jig" class="jig" aria-labelledby="jig-title">
        <div class="jig-head">
          <p class="eyebrow dark">The jig sheet</p>
          <h2 id="jig-title">Fourteen riders signed this geometry.</h2>
          <p>
            Nº 09 started as a chalk outline on the depot floor. The numbers below are the ones that survived three
            winters of cobbles, tram rails and a crate that is never as light as the client says.
          </p>
        </div>
        <dl class="specs">
          <div><dt>Wheelbase</dt><dd>994<span>mm</span></dd><p>Long enough to keep a loaded crate calm on descents.</p></div>
          <div><dt>Head angle</dt><dd>73<span>°</span></dd><p>Quick in traffic, settled under the porteur rack.</p></div>
          <div><dt>Gear</dt><dd>48·17</dd><p>One ratio. Hills are a negotiation, not a shift.</p></div>
          <div><dt>Rack load</dt><dd>30<span>kg</span></dd><p>Rated for flowers, film reels and one cello, once.</p></div>
        </dl>
      </section>

      <section id="dispatch" class="dispatch" aria-labelledby="dispatch-title">
        <h2 id="dispatch-title">Dispatch runs 06:40 to 21:00, rain included.</h2>
        <div class="dispatch-grid">
          <p><b>Same-hour</b> anywhere inside the old walls, three boroughs out by noon.</p>
          <p><b>Owned by riders</b> — one vote each, profits split by kilometres ridden.</p>
          <p><b>Joining?</b> Bring a bike, ride a week with us, then we talk.</p>
        </div>
        <p class="foot">Relay Nine Couriers · Unit 4, Rua do Arco · dispatch@relaynine.example</p>
      </section>
      <BackPill />
    </main>

    <script>
      import { mount } from '../../components/skills/build-wireframe-scan-reveal/scan';
      const root = document.getElementById('hero');
      const canvas = document.getElementById('scan-canvas');
      const button = document.getElementById('replay');
      const status = document.getElementById('scan-status');
      const state = document.getElementById('scan-state');
      const pct = document.getElementById('scan-pct');
      if (root && canvas instanceof HTMLCanvasElement && button instanceof HTMLButtonElement && status && state && pct) {
        try {
          mount(root, canvas, { button, status, state, pct });
        } catch (error) {
          // No WebGL: the copy, card and panel still stand on their own.
          root.dataset.state = 'nogl';
          console.warn('Scan disabled:', error);
        }
      }
    </script>

    <style>
      :global(html) { background: #2b2a27; }
      :global(body) {
        margin: 0;
        background: #2b2a27;
        color: #f4efe7;
        font-family: 'Archivo', ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      main {
        --ink: #f4efe7;
        --muted: rgb(244 239 231 / 0.66);
        --hair: rgb(244 239 231 / 0.14);
        --signal: #ff5a1f;
        --pale: #ffe0cc;
        --mono: 'JetBrains Mono', ui-monospace, monospace;
      }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

      .hero {
        position: relative;
        height: 100svh;
        min-height: 640px;
        overflow: hidden;
        isolation: isolate;
        background:
          linear-gradient(90deg, var(--hair) 1px, transparent 1px) 0 0 / calc(100% / 6) 100%,
          linear-gradient(180deg, #3d3b37 0%, #34322e 55%, #2b2a27 100%);
      }
      .pool {
        position: absolute; inset: auto -10% -30% -10%; height: 75%; z-index: -1;
        background:
          radial-gradient(40% 60% at 22% 85%, rgb(255 120 50 / 0.28), transparent 70%),
          radial-gradient(55% 55% at 60% 100%, rgb(255 224 204 / 0.10), transparent 70%);
      }
      .ghost {
        position: absolute; right: -2vw; bottom: -9vw; margin: 0; z-index: 0;
        font: 800 46vw/0.8 'Archivo', sans-serif; font-stretch: 125%; letter-spacing: -0.06em;
        color: rgb(244 239 231 / 0.035); pointer-events: none; user-select: none;
      }
      #scan-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }

      .bar {
        position: absolute; top: 24px; left: 40px; right: 40px; z-index: 3;
        display: flex; align-items: center; justify-content: space-between; gap: 16px;
      }
      .brand {
        display: inline-flex; align-items: center; gap: 10px; padding: 9px 16px 9px 12px; border-radius: 999px;
        background: rgb(20 19 17 / 0.72); border: 1px solid var(--hair); color: var(--ink); text-decoration: none;
        font: 700 13px/1 'Archivo', sans-serif; font-stretch: 125%; letter-spacing: 0.14em; text-transform: uppercase;
        backdrop-filter: blur(8px);
      }
      .brand svg { width: 22px; height: 22px; fill: none; stroke: var(--signal); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
      nav { display: flex; gap: 6px; align-items: center; }
      nav a {
        color: var(--muted); text-decoration: none; font: 500 13px/1 var(--mono); letter-spacing: 0.04em;
        padding: 10px 12px; border-radius: 999px;
      }
      nav a:hover { color: var(--ink); }
      nav a.join { color: #1b1a18; background: var(--ink); font-weight: 500; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }

      .copy { position: absolute; z-index: 2; left: 40px; top: 15vh; max-width: 640px; }
      .eyebrow {
        margin: 0 0 20px; font: 500 12px/1.4 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--pale);
      }
      .eyebrow::before { content: ''; display: inline-block; width: 8px; height: 8px; margin-right: 10px; background: var(--signal); border-radius: 2px; }
      h1 {
        margin: 0; font-weight: 700; font-stretch: 125%; font-size: clamp(44px, 6.4vw, 100px);
        line-height: 0.92; letter-spacing: -0.035em; text-wrap: balance;
      }
      .lede { margin: 26px 0 0; max-width: 440px; font-size: 17px; line-height: 1.5; color: var(--muted); font-stretch: 92%; }

      .card {
        position: absolute; z-index: 2; right: 40px; top: 92px; width: 264px; padding: 12px 12px 18px;
        border-radius: 22px; background: #efe9df; color: #1e1d1a;
        box-shadow: 0 1px 0 rgb(255 255 255 / 0.6) inset, 0 30px 60px -25px rgb(0 0 0 / 0.55);
      }
      .card img { display: block; width: 100%; height: 118px; object-fit: cover; border-radius: 11px; background: #d6cfc3; }
      .card-k { margin: 16px 4px 6px; font: 500 11px/1.3 var(--mono); letter-spacing: 0.06em; color: #6d675d; text-transform: uppercase; }
        .card-t { margin: 0 4px; font: 700 22px/1 'Archivo', sans-serif; font-stretch: 112%; letter-spacing: -0.02em; }

      .panel {
        position: absolute; z-index: 2; left: 40px; bottom: 64px; width: min(420px, calc(100% - 32px));
        padding: 16px 16px 14px; border-radius: 18px; background: rgb(24 23 21 / 0.8); border: 1px solid var(--hair);
        backdrop-filter: blur(10px); box-sizing: border-box;
      }
      .panel-top { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
      .panel-k { margin: 0 0 5px; font: 500 11px/1 var(--mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--signal); }
      .panel-t { margin: 0; font-weight: 600; font-size: 16px; font-stretch: 105%; }
      #replay {
        display: inline-flex; align-items: center; gap: 8px; flex: none; cursor: pointer;
        padding: 12px 16px; border: 0; border-radius: 12px; background: var(--ink); color: #1b1a18;
        font: 600 14px/1 'Archivo', sans-serif;
      }
      #replay:hover { background: #fff; }
      #replay svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
      .panel-row {
        display: grid; grid-template-columns: repeat(4, auto); justify-content: space-between; gap: 8px;
        margin: 14px 0 0; padding-top: 12px; border-top: 1px solid var(--hair);
      }
      .panel-row dt { font: 400 10px/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: rgb(244 239 231 / 0.45); }
      .panel-row dd { margin: 5px 0 0; font: 500 13px/1 var(--mono); color: var(--ink); font-variant-numeric: tabular-nums; }
      #scan-state { color: var(--pale); }
      .hero[data-state='welded'] #scan-state { color: var(--signal); }

      .jig { background: #efe9df; color: #1e1d1a; padding: 120px 40px 110px; }
      .jig-head { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 64px; max-width: 1360px; margin: 0 auto; align-items: end; }
      .jig-head .eyebrow { grid-column: 1 / -1; margin: 0; }
      .eyebrow.dark { color: #6d675d; }
      h2 { margin: 0; font-weight: 700; font-stretch: 118%; font-size: clamp(32px, 4vw, 56px); line-height: 0.98; letter-spacing: -0.03em; text-wrap: balance; }
      .jig-head > p:last-child { margin: 0; font-size: 17px; line-height: 1.55; color: #4f4a42; max-width: 520px; }
      .specs { display: grid; grid-template-columns: repeat(4, 1fr); max-width: 1360px; margin: 72px auto 0; border-top: 1px solid #1e1d1a; }
      .specs > div { padding: 22px 24px 0 0; border-right: 1px solid rgb(30 29 26 / 0.15); }
      .specs > div + div { padding-left: 24px; }
      .specs > div:last-child { border-right: 0; }
      .specs dt { font: 500 11px/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: #6d675d; }
      .specs dd { margin: 14px 0 10px; font: 700 64px/1 'Archivo', sans-serif; font-stretch: 125%; letter-spacing: -0.04em; color: #1e1d1a; }
      .specs dd span { font-size: 0.32em; letter-spacing: 0; margin-left: 4px; color: var(--signal); }
      .specs p { margin: 0; font-size: 14px; line-height: 1.5; color: #4f4a42; max-width: 260px; }

      .dispatch { padding: 110px 40px 120px; max-width: 1440px; margin: 0 auto; }
      .dispatch h2 { max-width: 900px; }
      .dispatch-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-top: 56px; }
      .dispatch-grid p { margin: 0; padding-top: 18px; border-top: 1px solid var(--hair); color: var(--muted); font-size: 16px; line-height: 1.55; }
      .dispatch-grid b { color: var(--ink); font-weight: 600; }
      .foot { margin: 80px 0 0; font: 400 12px/1.5 var(--mono); color: rgb(244 239 231 / 0.42); }

      @media (max-width: 1100px) {
        .card { display: none; }
      }
      @media (max-width: 760px) {
        .hero { min-height: 700px; }
        .bar { left: 16px; right: 16px; top: 16px; }
        nav a:not(.join) { display: none; }
        .copy { left: 16px; right: 16px; top: 88px; }
        .eyebrow { font-size: 10.5px; margin-bottom: 16px; }
        .lede { font-size: 15px; margin-top: 18px; }
        .panel { left: 16px; bottom: 60px; padding: 14px; }
        .panel-t { font-size: 14px; }
        #replay { padding: 11px 13px; font-size: 13px; }
        .ghost { display: none; }
        .jig { padding: 80px 16px; }
        .jig-head { grid-template-columns: 1fr; }
        .specs { grid-template-columns: 1fr 1fr; margin-top: 48px; }
        .specs > div, .specs > div + div { padding: 20px 12px 24px 0; border-right: 0; border-bottom: 1px solid rgb(30 29 26 / 0.15); }
        .specs > div:nth-child(even) { padding-left: 12px; border-left: 1px solid rgb(30 29 26 / 0.15); }
        .specs dd { font-size: 44px; }
        .dispatch { padding: 80px 16px 96px; }
        .dispatch-grid { grid-template-columns: 1fr; gap: 20px; margin-top: 36px; }
      }
    </style>
  </body>
</html>
