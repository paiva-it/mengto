    return board(
      [
        { p: 'bK', s: 'g8' }, { p: 'bP', s: 'f7' }, { p: 'bP', s: 'g7' }, { p: 'bP', s: 'h7' }, { p: 'bR', s: 'd5' }, { p: 'bP', s: 'b6' },
        { p: 'wR', s: 'a1', to: 'a8', k: 0.12 }, { p: 'wK', s: 'g1' }, { p: 'wP', s: 'f2' }, { p: 'wP', s: 'g2' }, { p: 'wP', s: 'h2' }, { p: 'wP', s: 'c4' },
