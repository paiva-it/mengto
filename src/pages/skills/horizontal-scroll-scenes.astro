      default: return `<rect x="-16" y="-16" width="32" height="32" ${st}/><polygon points="-2.5,-10 2.5,-10 2.5,-2.5 10,-2.5 10,2.5 2.5,2.5 2.5,10 -2.5,10 -2.5,2.5 -10,2.5 -10,-2.5 -2.5,-2.5" fill="${o}"/>`;
