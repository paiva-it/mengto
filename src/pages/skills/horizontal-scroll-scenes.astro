  function board(pieces: Pc[], under = '', over = '', label = '') {
    let s = `<svg viewBox="0 0 512 512" role="img" aria-label="${label}"><rect x="0" y="0" width="512" height="512" rx="4" fill="${INK}"/><rect x="16" y="16" width="480" height="480" fill="${LIGHT}"/>`;
    for (let r = 0; r < 8; r++) for (let c = 0; c < 8; c++) if ((r + c) % 2) s += `<rect x="${16 + c * 60}" y="${16 + r * 60}" width="60" height="60" fill="${FELT}"/>`;
    for (let c = 0; c < 8; c++) s += `<text x="${46 + c * 60}" y="509" font-size="9" fill="${PAPER}" text-anchor="middle" opacity=".7">${String.fromCharCode(97 + c)}</text>`;
