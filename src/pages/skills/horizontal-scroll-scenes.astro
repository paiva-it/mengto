  }
  const hi = (sq: string, k: number, color = FLAG, op = 0.32) => { const [x, y] = sqXY(sq); return `<rect class="on" style="--k:${k}" x="${x - 30}" y="${y - 30}" width="60" height="60" fill="${color}" fill-opacity="${op}"/>`; };
  const arrow = (a: string, b: string, k: number) => {
