    volsub.textContent = f > 0 ? `move ${f.toFixed(2)}` : `dwell ${dw.toFixed(2)}`;

    /* the title lockup: the first line wipes it off as room 1 is written in */
    let lk = 1 - sstep(LK0, LK1 - 0.05, u);
    if (S.reduced) lk = 1 - sstep(0.02, 0.22, u);
    if (i > 0) lk = 0;
    let lmask = '';
    if (pro) { lmask = `linear-gradient(90deg,transparent ${((Lb - 0.01) * 100).toFixed(2)}%,#000 ${((Lb + 0.016) * 100).toFixed(2)}%)`; lk = 1; }
