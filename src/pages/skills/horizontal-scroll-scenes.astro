    const gAng = dir > 0 ? 90 : 270;
    const mobile = S.w <= 820;
    const show: number[] = [];
    chapters.forEach((el, ci) => {
      const home = ci * CYC;
      let arrive = clamp01((u - (home - ARR_IN)) / (ARR_IN + ARR_OUT));
      if (ci === 0) arrive = S.reduced ? sstep(0.1, 0.8, u / DWELL) : u <= LK0 ? 0 : Math.max(0.01, sstep(0.02, 0.6, u / DWELL));
      if (S.reduced && ci === i + 1 && f < 0.64) arrive = 0;
      let leave = clamp01((u - (home + DWELL + MOVE * 0.28)) / (MOVE * 0.34));
      let mask = '';
      if (burning && ci === i) {
