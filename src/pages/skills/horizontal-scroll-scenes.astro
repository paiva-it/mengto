  }
  const ease = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
  function leg(y: number, dur: number, veilAt: ((k: number) => number) | null, done: (() => void) | null, easeFn = ease) {
    const y0 = scrollY, dy = y - y0, t0 = performance.now();
    const g = (glide = { raf: 0, y });
    const step = (now: number) => {
      const k = Math.min(1, (now - t0) / dur);
      scrollTo(0, y0 + dy * easeFn(k));
      if (veilAt) setVeil(veilAt(k));
      if (k < 1) g.raf = requestAnimationFrame(step);
      else { glide = null; done?.(); }
    };
    g.raf = requestAnimationFrame(step);
  }
  function glideToScene(tgt: number) {
    const cur = travel(scrollProgress()).i;
    const yT = yFor(tgt * CYC + DWELL * 0.8);
    const fin = () => { S.glideTo = -1; S.glideHide = -1; S.announced = -1; dirty(); announce(tgt); };
    stopGlide();
    if (S.reduced || Math.abs(tgt - cur) < 2) {
      S.glideTo = tgt;
      const dy = yT - scrollY;
      if (S.reduced || Math.abs(dy) < 2) { scrollTo(0, yT); fin(); return; }
      glideDone = fin;
      leg(yT, Math.min(2400, Math.max(900, 700 + (Math.abs(dy) / innerHeight) * 150)), null, fin);
      return;
    }
    const fwd = tgt > cur;
    const yPre = yFor(fwd ? (tgt - 1) * CYC + DWELL * 0.96 : (tgt + 1) * CYC + 0.02);
    S.glideHide = fwd ? tgt - 1 : tgt + 1; S.glideTo = tgt;
    glideDone = fin;
    const t0 = performance.now();
    const g = (glide = { raf: 0, y: yT });
    const cover = (now: number) => {
      const k = Math.min(1, (now - t0) / 380);
      setVeil(sstep(0, 1, k));
      if (k < 1) { g.raf = requestAnimationFrame(cover); return; }
      scrollTo(0, yPre);
      g.raf = requestAnimationFrame(() => { g.raf = requestAnimationFrame(() => {
        leg(yT, 2600, (k2) => 1 - sstep(0, 0.24, k2), fin, (x) => 1 - Math.pow(1 - x, 2.4));
      }); });
    };
    g.raf = requestAnimationFrame(cover);
  }
  const cancel = () => { if (glide || S.glideTo >= 0) stopGlide(); };
  addEventListener('wheel', cancel, { passive: true });
  addEventListener('touchstart', cancel, { passive: true });
  addEventListener('keydown', (e) => { if (/Arrow|Page|Home|End|Space/.test(e.code)) cancel(); });
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest?.('[data-go]') as HTMLElement | null;
    if (!a) return;
    e.preventDefault();
    glideToScene(+a.dataset.go!);
  });

  (window as any).__hs = { travel, SPAN, yFor, render, state: () => travel(scrollProgress()) };
  S.w = STAGE.clientWidth; S.h = STAGE.clientHeight;
  // card capture (?shot at the top): hold mid-wipe between room 1 and 2 so the preview shows the line
  const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
  if (new URLSearchParams(location.search).has('shot') && nav?.type !== 'reload' && !location.hash && scrollY < 2) scrollTo(0, yFor(DWELL + MOVE * 0.28));
  render();
</script>
