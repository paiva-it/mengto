      } else if ((burning && ci === i + 1 && !mobile) || (pro && ci === 0)) {
        if (Lb < 1.16) mask = `linear-gradient(${gAng}deg,#000 ${((Lb - 0.062) * 100).toFixed(2)}%,transparent ${((Lb - 0.048) * 100).toFixed(2)}%)`;
