      const hidden = arrive < 0.002 || shown < 0.004;
      setCss(el, 'visibility', hidden ? 'hidden' : 'visible');
      el.inert = hidden;
      if (hidden) return;
      show.push(ci);
      setCss(el, 'webkitMaskImage', mask); setCss(el, 'maskImage', mask);
      setCss(el, 'opacity', shown.toFixed(3));
      const parts = [el.querySelector('.num'), el.querySelector('.big'), el.querySelector('.lede'), el.querySelector('.meta')] as HTMLElement[];
      const A0 = [0, 0.12, 0.4, 0.6];
      parts.forEach((p, k) => {
        const o = burning && ci === i + 1 ? 1 : sstep(A0[k], A0[k] + 0.3, arrive);
        setCss(p, 'opacity', o.toFixed(3));
        setCss(p, 'transform', `translate3d(0,${((1 - o) * 14).toFixed(1)}px,0)`);
      });
    });
    scrims.forEach((sc, k) => setCss(sc, 'visibility', show.some((ci) => ci % 2 === k && !mobile) ? 'visible' : 'hidden'));
  }

  let raf = 0;
  const dirty = () => { if (!raf) raf = requestAnimationFrame(render); };
  addEventListener('scroll', dirty, { passive: true });
  addEventListener('pageshow', dirty);
  addEventListener('load', dirty);
  document.addEventListener('visibilitychange', () => { if (document.hidden) settleGlide(); dirty(); });
  document.fonts?.ready.then(dirty);
  new ResizeObserver(() => { S.w = STAGE.clientWidth; S.h = STAGE.clientHeight; dirty(); }).observe(STAGE);
  document.querySelectorAll<HTMLInputElement>('input[name="mode"]').forEach((r) => r.addEventListener('change', () => { S.mode = r.value; dirty(); }));

  /* ---------------- fast-skip: only the last move plays, under a veil ---------------- */
  let glide: { raf: number; y: number } | null = null;
  let glideDone: (() => void) | null = null;
  const yFor = (u: number) => ((document.documentElement.scrollHeight - innerHeight) * u) / SPAN;
  const setVeil = (o: number) => { S.veil = o; smoke.style.opacity = o.toFixed(3); smoke.style.visibility = o > 0.002 ? 'visible' : 'hidden'; };
  function stopGlide() { S.glideTo = -1; S.glideHide = -1; glideDone = null; if (glide) { cancelAnimationFrame(glide.raf); glide = null; } setVeil(0); dirty(); }
