---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

const chapters = [
  {
    side: 'left',
    num: '01 — 19:00 · Doors open',
    title: 'Opening',
    tag: '1.e4',
    lede: 'Forty boards set by seven. Newcomers play the house Italian against whoever is nearest the kettle.',
    meta: [['Boards', '40'], ['Members', '212'], ['House line', 'Italian']],
  },
  {
    side: 'right',
    num: '02 — 20:00 · Lightning table',
    title: 'Blitz',
    tag: '3+2',
    lede: 'Three minutes a side, two seconds a move, and the loudest clock in the building.',
    meta: [['Control', '3 + 2'], ['Games tonight', '118'], ['Flags fallen', '23']],
  },
  {
    side: 'left',
    num: '03 — 20:45 · Thursday class',
    title: 'Lesson',
    tag: 'K+P',
    lede: 'One pawn, two kings, and the opposition explained with a teacup standing in for the black king.',
    meta: [['Topic', 'King & pawn'], ['Pupils', '14'], ['Teacher', 'M. Okafor']],
  },
  {
    side: 'right',
    num: '04 — 21:30 · Championship, round 6',
    title: 'Gambit',
    tag: 'Qxf7+',
    lede: 'She gave a pawn on move four. On move twenty-three the queen lands on f7 and the back room stops talking.',
    meta: [['Board', '1'], ['Move', '23. Qxf7+'], ['Clock', '0:41']],
  },
  {
    side: 'left',
    num: '05 — 22:40 · Last board standing',
    title: 'Mate',
    tag: '1–0',
    lede: 'Rook to the eighth rank. Hands shaken, scoresheets signed, chairs up and lights off by eleven.',
    meta: [['Result', '1 – 0'], ['Moves', '41'], ['Next', 'Thu 19:00']],
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>Horizontal Scroll Scenes — En Passant Chess Club</title>
    <meta name="description" content="One Thursday at the En Passant chess club, five rooms laid left to right and driven by nothing but vertical scroll." />
    <meta name="theme-color" content="#ebe5d8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div id="track"></div>

    <div id="stage" aria-label="One Thursday evening at the En Passant chess club, in five rooms">
      <div class="layer a" id="layerA"></div>
      <div class="layer b" id="layerB" aria-hidden="true"></div>
      <div class="fx" id="fx" aria-hidden="true">
        <div class="veil" id="veil"></div>
        <div class="glow" id="glow"></div>
        <div class="edge" id="edge"></div>
      </div>
      <div id="smoke" aria-hidden="true"></div>

      <div class="chrome">
        <div class="bar">
          <a class="brand" href="#s1" data-go="0" aria-label="En Passant, back to the first room">
            <span class="mark" aria-hidden="true"></span>En Passant<i>Depot 4 · Thursdays</i>
          </a>
          <span class="push"></span>
          <fieldset class="modes">
            <legend>Transition between rooms</legend>
            <label><input type="radio" name="mode" value="burn" checked /><span>Clock wipe</span></label>
            <label><input type="radio" name="mode" value="pan" /><span>Pan</span></label>
          </fieldset>
        </div>

        <div class="scrim" id="scrim0" aria-hidden="true"></div>
        <div class="scrim right" id="scrim1" aria-hidden="true"></div>

        <header class="lockup" id="lockup">
          <div class="k"><s></s>En Passant Chess Club · Tram Depot 4 · since 1987</div>
          <h1>Five rooms,<br />one <em>long</em><br />Thursday.</h1>
          <p>Scroll down to walk the depot left to right — from the first handshake at seven to the last mate before the lights go off.</p>
          <p class="fine">Every screen of scroll is a place you can land on, reverse through, skip across or reload into. No wheel hijack, no snap.</p>
        </header>

        {
          chapters.map((c, i) => (
            <section class={`chapter ${c.side}`} id={`ch${i}`} aria-labelledby={`t${i}`}>
              <div class="num">
                <s />
                {c.num}
              </div>
              <h2 class="big" id={`t${i}`}>
                {c.title}
                <em aria-hidden="true">{c.tag}</em>
              </h2>
              <div class="lede">{c.lede}</div>
              <div class="meta">
                {c.meta.map(([k, v]) => (
                  <div>
                    {k}
                    <b>{v}</b>
                  </div>
                ))}
              </div>
            </section>
          ))
        }

        <div class="vol" id="vol" aria-hidden="true">u 0.00 / 9.15<span id="volsub">dwell 0.00</span></div>
        <nav class="index" id="index" aria-label="Rooms">
          {
            chapters.map((c, i) => (
              <>
                <u aria-hidden="true">{String(i + 1).padStart(2, '0')}</u>
                <a href={`#s${i + 1}`} data-go={i}>
                  <span class="sr">Room {i + 1}, </span>
                  {c.title}
                  <i aria-hidden="true">{c.tag}</i>
                </a>
              </>
            ))
          }
        </nav>
        <div class="cue" id="cue" aria-hidden="true">Scroll</div>
        <div class="sr" id="live" role="status" aria-live="polite"></div>
      </div>
    </div>
    <BackPill />
  </body>
</html>

<style is:global>
  :root {
    --paper: #ebe5d8;
    --paper-hi: #f6f2e8;
    --ink: #1b1a17;
    --dim: rgba(27, 26, 23, 0.6);
    --hair: rgba(27, 26, 23, 0.2);
    --felt: #5f7d62;
    --flag: #d6452b;
    --sans: 'Archivo', ui-sans-serif, system-ui, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, Menlo, monospace;
    --n: 5;
    --span: 9.15;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  /* never smooth: the glide is ours, and smooth html makes every per-frame scrollTo chase itself */
  html { scrollbar-width: none; scroll-behavior: auto; background: var(--paper); }
  html::-webkit-scrollbar { display: none; }
  body { background: var(--paper); color: var(--ink); font-family: var(--sans); overflow-x: hidden; -webkit-font-smoothing: antialiased; }

  #track { height: calc((var(--span) + 1) * 100vh); }
  #stage { position: fixed; inset: 0; overflow: hidden; background: var(--paper); }

  /* ---- the world: one strip, rooms side by side ---- */
  .world { position: absolute; left: 0; top: 0; height: 100%; width: calc(var(--n) * 100%); will-change: transform; }
  .layer { position: absolute; inset: 0; overflow: hidden; }
  .layer.b { visibility: hidden; }
  .scene { position: absolute; top: 0; height: 100%; width: calc(100% / var(--n)); left: calc(var(--i) * 100% / var(--n)); overflow: hidden; }
  .bg { position: absolute; inset: 0;
    background:
      radial-gradient(50% 46% at var(--wx, 68%) 34%, rgba(255, 252, 240, 0.85), rgba(255, 252, 240, 0) 70%),
      linear-gradient(180deg, #e4ddcd 0%, #ebe5d8 40%, #e2dac9 64%, #d9d0bd 64.2%, #e0d8c6 100%);
  }
  /* clerestory panes of the old tram depot */
  .bg::before { content: ''; position: absolute; left: 0; right: 0; top: 5%; height: 20%;
    background:
      repeating-linear-gradient(90deg, transparent 0 3.2%, rgba(27, 26, 23, 0.07) 3.2% 3.5%),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.55) 0 14%, transparent 14% 16.6%);
    opacity: 0.8; }
  /* the hall floor: big checker tiles */
  .bg::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 35.8%;
    background: repeating-conic-gradient(rgba(27, 26, 23, 0.05) 0 25%, transparent 0 50%) 0 0 / 120px 120px;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 40%); mask-image: linear-gradient(180deg, transparent, #000 40%); }
  .art { position: absolute; width: min(38vw, 68vh, 620px); top: 53%; transform: translateY(-50%); }
  .art svg { display: block; width: 100%; height: auto; overflow: visible; }
  .art.r { right: clamp(30px, 7vw, 130px); }
  .art.l { left: clamp(30px, 7vw, 130px); }
  .art::after { content: ''; position: absolute; left: 6%; right: 6%; bottom: -5%; height: 5%; background: radial-gradient(closest-side, rgba(27, 26, 23, 0.28), transparent); }
  .art text { font-family: var(--mono); }

  /* ---- craft: every room reads its own clock --pc (eased) / --pl (linear) ---- */
  .mv { --t: clamp(0, (var(--pc) - var(--k)) * 6, 1);
    transform: translate(calc(var(--dx) * var(--t) * 1px), calc(var(--dy) * var(--t) * 1px)); }
  .cap { opacity: calc(1 - clamp(0, (var(--pc) - var(--k)) * 8, 1)); }
  .on { opacity: clamp(0, (var(--pc) - var(--k)) * 6, 1); }
  .off { opacity: calc(1 - clamp(0, (var(--pc) - var(--k)) * 6, 1)); }
  .draw { stroke-dasharray: 1; stroke-dashoffset: calc(1 - clamp(0, (var(--pc) - var(--k)) * 4, 1)); }
  .hand { transform: rotate(calc(var(--pl) * var(--sp) * 1deg)); }
  .flagd { transform: rotate(calc(clamp(0, (var(--pl) - 0.86) * 9, 1) * 62deg)); }
  .press { transform: translateY(calc(clamp(0, (var(--pl) - var(--k)) * 30, 1) * 9px)); }
  .stamp { opacity: clamp(0, (var(--pc) - 0.8) * 7, 1); transform: rotate(-8deg) scale(calc(1.25 - 0.25 * clamp(0, (var(--pc) - 0.8) * 7, 1))); }

  /* ---- the clock wipe ---- */
  .fx { position: absolute; inset: 0; pointer-events: none; visibility: hidden; overflow: hidden; }
  .veil { position: absolute; top: 0; bottom: 0; left: 0; width: 34%;
    background: linear-gradient(90deg, rgba(27, 26, 23, 0.36), rgba(27, 26, 23, 0.14) 40%, rgba(27, 26, 23, 0)); }
  .veil.rev { background: linear-gradient(270deg, rgba(27, 26, 23, 0.36), rgba(27, 26, 23, 0.14) 40%, rgba(27, 26, 23, 0)); }
  .glow { position: absolute; top: 0; bottom: 0; left: 0; width: 260px; margin-left: -130px; mix-blend-mode: multiply;
    background: linear-gradient(90deg, transparent, rgba(214, 69, 43, 0.1) 30%, rgba(214, 69, 43, 0.28) 50%, rgba(214, 69, 43, 0.1) 70%, transparent); }
  /* the line itself: two files of board squares with the flag-red seam */
  .edge { position: absolute; top: 0; bottom: 0; left: 0; width: 40px; margin-left: -20px;
    background: repeating-conic-gradient(var(--ink) 0 25%, var(--paper-hi) 0 50%) 0 0 / 40px 40px;
    box-shadow: 0 0 0 1px var(--ink), 0 0 40px rgba(27, 26, 23, 0.35); }
  .edge::after { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 4px; margin-left: -2px; background: var(--flag); box-shadow: 0 0 14px rgba(214, 69, 43, 0.8); }
  #smoke { position: absolute; inset: 0; z-index: 6; opacity: 0; visibility: hidden; pointer-events: none;
    background: repeating-conic-gradient(rgba(27, 26, 23, 0.06) 0 25%, transparent 0 50%) 0 0 / 96px 96px, radial-gradient(90% 70% at 50% 50%, var(--paper-hi), var(--paper) 70%); }

  /* ---- chrome ---- */
  .chrome { position: fixed; inset: 0; z-index: 5; pointer-events: none; }
  .chrome > * { pointer-events: auto; }
  .bar { position: absolute; z-index: 3; left: 0; right: 0; top: 0; height: 64px; padding: 0 30px; display: flex; align-items: center; gap: 26px; pointer-events: none; }
  .bar > * { pointer-events: auto; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-weight: 800; font-stretch: 112%; font-size: 17px; letter-spacing: -0.01em; text-transform: uppercase; }
  .brand i { font-style: normal; font-family: var(--mono); font-weight: 400; font-size: 11.5px; letter-spacing: 0.04em; text-transform: none; color: var(--dim); margin-left: 6px; }
  .mark { width: 18px; height: 18px; background: repeating-conic-gradient(var(--ink) 0 25%, transparent 0 50%) 0 0 / 9px 9px; outline: 1.5px solid var(--ink); }
  .push { flex: 1; pointer-events: none; }
  .modes { min-width: 0; display: flex; border: 1px solid var(--hair); border-radius: 999px; padding: 3px; background: rgba(246, 242, 232, 0.7); backdrop-filter: blur(6px); }
  .modes legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .modes label { position: relative; cursor: pointer; }
  .modes input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .modes span { display: block; padding: 8px 16px; border-radius: 999px; font-family: var(--mono); font-size: 12px; color: var(--dim); transition: background 0.2s, color 0.2s; }
  .modes input:checked + span { background: var(--ink); color: var(--paper-hi); }
  .modes input:focus-visible + span { outline: 1px solid var(--ink); outline-offset: 3px; }
  a:focus-visible { outline: 1px solid var(--ink); outline-offset: 5px; }

  .lockup { position: absolute; left: clamp(30px, 5.5vw, 110px); right: clamp(30px, 5.5vw, 110px); top: 50%; transform: translateY(-50%); pointer-events: none; }
  .lockup .k { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: clamp(14px, 1.6vw, 26px); font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--dim); }
  .lockup .k s, .num s { display: block; width: clamp(34px, 4vw, 70px); height: 1px; background: var(--ink); text-decoration: none; opacity: 0.5; }
  .lockup h1 { font-weight: 800; font-stretch: 108%; font-size: clamp(50px, 6.2vw, 120px); line-height: 0.9; letter-spacing: -0.035em; }
  .lockup h1 em { font-style: normal; color: var(--flag); }
  .lockup p { font-size: clamp(18px, 1.45vw, 25px); line-height: 1.38; max-width: min(24em, 44vw); margin-top: clamp(18px, 2vw, 34px); text-wrap: pretty; }
  .lockup .fine { font-family: var(--mono); font-size: 12.5px; line-height: 1.6; color: var(--dim); max-width: min(42em, 40vw); margin-top: 14px; }

  .chapter { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; padding: 0 clamp(30px, 5.5vw, 110px); opacity: 0; visibility: hidden; pointer-events: none; }
  .chapter.right { align-items: flex-end; text-align: right; }
  .chapter > * { position: relative; }
  .num { display: flex; align-items: center; gap: 14px; font-family: var(--mono); font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--dim); margin-bottom: clamp(12px, 1.4vw, 24px); }
  .chapter.right .num { flex-direction: row-reverse; }
  .big { font-weight: 850; font-stretch: 112%; font-size: clamp(60px, 8.4vw, 168px); line-height: 0.82; letter-spacing: -0.045em; display: flex; align-items: flex-start; gap: clamp(10px, 1.2vw, 22px); }
  .chapter.right .big { flex-direction: row-reverse; }
  .big em { font-family: var(--mono); font-style: normal; font-weight: 500; font-size: clamp(14px, 1.3vw, 22px); letter-spacing: 0; line-height: 1; color: var(--paper-hi); background: var(--flag); padding: 0.4em 0.55em; border-radius: 3px; margin-top: 0.4em; }
  .lede { font-size: clamp(18px, 1.6vw, 28px); line-height: 1.32; max-width: min(19em, 40vw); margin-top: clamp(18px, 2vw, 36px); text-wrap: pretty; }
  .meta { display: flex; gap: clamp(20px, 3vw, 52px); margin-top: clamp(18px, 2.2vw, 38px); font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--dim); }
  .chapter.right .meta { justify-content: flex-end; }
  .meta b { display: block; font-family: var(--sans); font-weight: 600; font-size: 17px; letter-spacing: -0.005em; text-transform: none; color: var(--ink); margin-top: 6px; }
  .scrim { position: absolute; inset: 0; pointer-events: none; visibility: hidden;
    background: linear-gradient(90deg, rgba(235, 229, 216, 0.85), rgba(235, 229, 216, 0.55) 26%, rgba(235, 229, 216, 0) 46%); }
  .scrim.right { background: linear-gradient(270deg, rgba(235, 229, 216, 0.85), rgba(235, 229, 216, 0.55) 26%, rgba(235, 229, 216, 0) 46%); }

  .index { position: absolute; right: 30px; bottom: 28px; display: grid; grid-template-columns: auto auto; column-gap: 16px; text-align: right; font-family: var(--mono); }
  .index::before { content: ''; position: absolute; z-index: -1; pointer-events: none; inset: -30px -30px -26px -50px; background: radial-gradient(closest-side, rgba(235, 229, 216, 0.9), rgba(235, 229, 216, 0.5) 60%, rgba(235, 229, 216, 0)); }
  .index u { text-decoration: none; font-size: 11px; opacity: 0.55; line-height: 22px; }
  .index a { font-size: 12.5px; line-height: 22px; color: inherit; text-decoration: none; opacity: 0.55; transition: opacity 0.25s; }
  .index a i { font-style: normal; display: inline-block; min-width: 3.6em; margin-left: 10px; color: var(--dim); text-align: left; }
  .index a:hover { opacity: 1; }
  .index a[aria-current='step'], .index u.on { opacity: 1; }
  .index a[aria-current='step'] i { color: var(--flag); }
  .vol { position: absolute; left: 30px; bottom: 28px; font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.06em; color: var(--dim); line-height: 1.7; }
  .vol span { display: block; color: var(--flag); }
  .cue { position: absolute; left: 50%; bottom: 26px; transform: translateX(-50%); font-family: var(--mono); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; pointer-events: none; }
  .cue::after { content: ''; display: block; width: 1px; height: 22px; margin: 10px auto 0; background: linear-gradient(var(--ink), transparent); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  #back-pill { bottom: 84px; }

  @media (min-width: 821px) and (max-height: 760px) {
    .index a:not([aria-current='step']), .index u:not(.on) { display: none; }
    .index u.on::after { content: ' / 05'; }
  }
  @media (max-width: 820px) {
    .bar { height: auto; padding: 14px 20px; gap: 12px; }
    .push { display: none; }
    .brand { font-size: 15px; }
    .brand i { display: none; }
    .modes { margin-left: auto; }
    .modes span { padding: 7px 11px; font-size: 11px; }
    .chapter { padding: 0 20px 14vh; justify-content: flex-end; }
    .chapter.right { align-items: flex-start; text-align: left; }
    .chapter.right .num, .chapter.right .big { flex-direction: row; }
    .chapter.right .meta { justify-content: flex-start; }
    .big { font-size: clamp(52px, 16vw, 100px); flex-wrap: wrap; }
    .lede { max-width: none; font-size: clamp(16px, 4.4vw, 21px); margin-top: 14px; }
    .meta { gap: 18px; margin-top: 16px; font-size: 10.5px; }
    .meta b { font-size: 14.5px; }
    .art { width: min(78vw, 46vh); top: 12%; transform: none; left: 50% !important; right: auto !important; margin-left: calc(min(78vw, 46vh) / -2); }
    .lockup { top: auto; bottom: 14vh; transform: none; left: 20px; right: 20px; }
    .lockup h1 { font-size: clamp(42px, 12.4vw, 80px); }
    .lockup p { max-width: none; margin-top: 14px; font-size: clamp(16px, 4.4vw, 20px); }
    .lockup .fine { display: none; }
    .lockup .k { font-size: 10.5px; gap: 10px; }
    .lockup .k s { display: none; }
    .index a:not([aria-current='step']), .index u:not(.on) { display: none; }
    .index u.on::after { content: ' / 05'; }
    .index { right: 20px; bottom: 20px; }
    .vol { left: 20px; bottom: 20px; font-size: 10.5px; }
    .cue { display: none; }
    #back-pill { bottom: 64px; }
  }
</style>

<script>
  // ponytail: one vanilla module, ported from the skill's travel()/render()/glide. No libraries.
  const N = 5;
  const DWELL = 1.15, MOVE = 0.85;
  const CYC = DWELL + MOVE;
  const SPAN = N * DWELL + (N - 1) * MOVE; // 9.15
  const LK0 = 0.02, LK1 = 0.4; // the title's own wipe, inside dwell 0

  const clamp01 = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x);
  const sstep = (a: number, b: number, x: number) => { const t = clamp01((x - a) / (b - a)); return t * t * (3 - 2 * t); };

  /* THE state machine: scroll progress in, scene state out. Pure. */
  function travel(sp: number) {
    const u = Math.min(SPAN - 1e-5, sp * SPAN);
    const i = Math.min(N - 1, Math.floor(u / CYC));
    const local = u - i * CYC;
    const dw = Math.min(1, local / DWELL);
    const f = i >= N - 1 ? 0 : clamp01((local - DWELL) / MOVE);
    const rc = clamp01((f - 0.01) / 0.97);
    return { i, u, dw, f, fe: sstep(0, 1, f), L: -0.08 + 1.24 * rc, live: Math.min(N - 1, f < 0.39 ? i : i + 1) };
  }

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const STAGE = $('stage');
  const layerA = $('layerA'), layerB = $('layerB');
  const fx = $('fx'), veilEl = $('veil'), glowEl = $('glow'), edgeEl = $('edge'), smoke = $('smoke');
  const lockup = $('lockup'), cue = $('cue'), vol = $('vol'), volsub = $('volsub'), live = $('live');
  const chapters = Array.from(document.querySelectorAll<HTMLElement>('.chapter'));
  const scrims = [$('scrim0'), $('scrim1')];
  const RIGHT = chapters.map((c) => c.classList.contains('right'));
  const NAMES = chapters.map((c) => (c.querySelector('h2')!.firstChild!.textContent || '').trim());

  /* ---------------- the rooms: inline SVG, no ids (two copies of the world) ---------------- */
  const PAPER = '#f6f2e8', INK = '#1b1a17', FELT = '#5f7d62', LIGHT = '#ece4cf', FLAG = '#d6452b';
  const sqXY = (s: string) => [16 + (s.charCodeAt(0) - 97) * 60 + 30, 16 + (8 - +s[1]) * 60 + 30];
  // Bauhaus-style top-down pieces: the shape says how it moves
  function shape(t: string, white: boolean) {
    const f = white ? PAPER : INK, o = white ? INK : PAPER;
    const st = `fill="${f}" stroke="${INK}" stroke-width="2.5" stroke-linejoin="round"`;
    switch (t) {
      case 'P': return `<circle r="10.5" ${st}/>`;
      case 'R': return `<rect x="-15" y="-15" width="30" height="30" ${st}/>`;
      case 'N': return `<polygon points="-15,-17 -2,-17 -2,3 15,3 15,17 -15,17" ${st}/>`;
      case 'B': return `<polygon transform="rotate(45)" points="-4.5,-18 4.5,-18 4.5,-4.5 18,-4.5 18,4.5 4.5,4.5 4.5,18 -4.5,18 -4.5,4.5 -18,4.5 -18,-4.5 -4.5,-4.5" ${st}/>`;
