---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

// Dial geometry — one 640 × 640 instrument, centre C.
const C = 320;
const polar = (r: number, deg: number) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [+(C + r * Math.cos(a)).toFixed(2), +(C + r * Math.sin(a)).toFixed(2)];
};

const ticks = Array.from({ length: 120 }, (_, i) => {
  const len = i % 10 === 0 ? 18 : i % 5 === 0 ? 11 : 6;
  const [x1, y1] = polar(262 - len, i * 3);
  const [x2, y2] = polar(262, i * 3);
  return { x1, y1, x2, y2, major: i % 10 === 0 };
});

const months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'].map((m, i) => {
  const [x, y] = polar(214, i * 30 + 15);
  return { m, x, y };
});

const hex = Array.from({ length: 6 }, (_, i) => polar(158, i * 60));
const hexPath = hex.map(([x, y], i) => `${i ? 'L' : 'M'}${x} ${y}`).join(' ') + 'Z';

// Stack 07 (walnut, 50 mm, two years in the shed) is 83 % of the way to the bench.
const stackProgress = 0.83;
const arcEnd = polar(234, stackProgress * 360);
const arcPath = `M ${C} ${C - 234} A 234 234 0 1 1 ${arcEnd[0]} ${arcEnd[1]}`;

const ledger = [
  { id: '07', wood: 'English walnut', cut: '50 mm · through-and-through', stacked: 'Feb 2025', target: '24 months', mc: '17.4', p: 0.83, state: 'Seasoning' },
  { id: '03', wood: 'Ripple sycamore', cut: '25 mm · quarter-sawn', stacked: 'Sep 2025', target: '12 months', mc: '15.2', p: 1, state: 'To the bench' },
  { id: '11', wood: 'Brown oak', cut: '75 mm · waney edge', stacked: 'Jan 2024', target: '36 months', mc: '18.9', p: 0.92, state: 'Seasoning' },
  { id: '14', wood: 'Wild cherry', cut: '32 mm · slab', stacked: 'Apr 2026', target: '15 months', mc: '24.6', p: 0.4, state: 'Stickered' },
];
const RING = 2 * Math.PI * 44;

const stages = [
  { code: 'T−0', name: 'Fell & sticker', note: 'Milled the week it comes down, stacked on 25 mm stickers under the north shed roof.' },
  { code: 'T+1y/in', name: 'Season', note: 'One year for every inch of thickness, weighed monthly against a sample board.' },
  { code: '+3 wk', name: 'Condition', note: 'Brought into the heated workshop to settle at 9 % before a single cut is made.' },
  { code: '+10 wk', name: 'Make', note: 'Sawn, planed and joined by one maker, start to finish, on the same bench.' },
  { code: '+3 wk', name: 'Oil & cure', note: 'Five coats of hardwax oil, a week between the last two, then wrapped in blankets.' },
];

const pieces = [
  { no: 'No. 14', name: 'Windsor side chair', wood: 'Ash spindles, walnut seat', weeks: '9', price: '£2,400', kind: 'chair' },
  { no: 'No. 22', name: 'Trestle dining table', wood: 'Brown oak, drawbored', weeks: '12', price: '£7,800', kind: 'table' },
  { no: 'No. 31', name: 'Hanging wall cabinet', wood: 'Ripple sycamore, cherry pulls', weeks: '8', price: '£3,900', kind: 'cabinet' },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Rook &amp; Ledger — furniture made on the timber's clock</title>
    <meta name="description" content="Rook & Ledger is a furniture workshop that seasons every board one year per inch before it reaches the bench." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@200;300;400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="field" aria-hidden="true"></div>

    <header class="nav">
      <div class="nav-in">
        <a href="#top" class="brand" aria-label="Rook & Ledger, home">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1" /><path d="M12 3.5V7M12 17v3.5M3.5 12H7M17 12h3.5" stroke="currentColor" stroke-width="1" /><path d="M12 12 15.5 8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
          <span>Rook <i>&amp;</i> Ledger</span>
        </a>
        <nav aria-label="Primary">
          <a href="#ledger">Ledger</a>
          <a href="#process">Process</a>
          <a href="#pieces">Pieces</a>
          <a href="#commission">Commission</a>
        </nav>
        <span class="nav-time mono" aria-hidden="true"><span class="live-dot"></span><span data-clock-short>--:--</span> UK</span>
      </div>
    </header>

    <main id="top">
      <!-- HERO -->
      <div class="hero-wrap">
      <section class="hero">
        <div class="hero-copy reveal">
          <span class="pill mono"><span class="live-dot"></span>Shed 2 · 41 boards seasoning</span>
          <h1>Furniture made on the <em>timber's</em> clock.</h1>
          <p class="lede">We don't cut a board until it has stood one year for every inch of its thickness. The dial tracks each stack in the shed, so a chair commissioned today is already counting down.</p>
          <div class="ctas">
            <a class="btn btn-light" href="#commission">Reserve a bench slot</a>
            <a class="btn btn-glass" href="#ledger">Read the seasoning ledger <span aria-hidden="true">→</span></a>
          </div>
          <dl class="hero-stats">
            <div><dt class="mono">Boards stacked</dt><dd>1,284</dd></div>
            <div><dt class="mono">Pieces since 2011</dt><dd>612</dd></div>
            <div><dt class="mono">Bench queue</dt><dd>14 wk</dd></div>
          </dl>
        </div>

        <div class="dial-zone">
          <div class="beam beam-h" aria-hidden="true"></div>
          <div class="beam beam-v" aria-hidden="true"></div>
          <span class="deg mono d0" aria-hidden="true">000°</span>
          <span class="deg mono d90" aria-hidden="true">090°</span>
          <span class="deg mono d180" aria-hidden="true">180°</span>
          <span class="deg mono d270" aria-hidden="true">270°</span>

          <figure class="dial" role="img" aria-label="Seasoning dial: stack 07, English walnut, 83 percent seasoned, moisture 17.4 percent. Hands show workshop time.">
            <div class="wisps" aria-hidden="true"><span></span><span></span><span></span></div>
            <div class="disk" aria-hidden="true"></div>
            <svg viewBox="0 0 640 640" aria-hidden="true">
              <defs>
                <radialGradient id="core" cx="50%" cy="38%" r="65%">
                  <stop offset="0" stop-color="#fff" stop-opacity=".16" />
                  <stop offset=".55" stop-color="#fff" stop-opacity=".03" />
                  <stop offset="1" stop-color="#fff" stop-opacity="0" />
                </radialGradient>
                <linearGradient id="rim" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#fff" stop-opacity=".5" />
                  <stop offset=".5" stop-color="#fff" stop-opacity=".06" />
                  <stop offset="1" stop-color="#fff" stop-opacity=".22" />
                </linearGradient>
                <path id="textRing" d={`M ${C} ${C} m -286 0 a 286 286 0 1 1 572 0 a 286 286 0 1 1 -572 0`} />
                <filter id="glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="4" /></filter>
              </defs>

              <circle cx={C} cy={C} r="306" fill="none" stroke="url(#rim)" stroke-width="1" />
              <g class="spin-slow">
                <text class="ring-text"><textPath href="#textRing">AIR-DRIED ONE YEAR PER INCH OF THICKNESS · STACK 07 · ENGLISH WALNUT · 50 MM · NORTH SHED · HEBDEN BRIDGE · </textPath></text>
              </g>
              <circle cx={C} cy={C} r="266" fill="none" stroke="#fff" stroke-opacity=".12" />

              <g>
                {ticks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke="#fff" stroke-opacity={t.major ? 0.7 : 0.22} stroke-width={t.major ? 1.4 : 1} />)}
              </g>

              <circle cx={C} cy={C} r="234" fill="none" stroke="#fff" stroke-opacity=".06" stroke-width="1.5" />
              <path d={arcPath} fill="none" stroke="#fff" stroke-opacity=".9" stroke-width="1.5" stroke-linecap="round" class="arc" />
              <circle cx={arcEnd[0]} cy={arcEnd[1]} r="9" fill="#fff" opacity=".55" filter="url(#glow)" />
              <circle cx={arcEnd[0]} cy={arcEnd[1]} r="3" fill="#fff" />

              {months.map((m) => <text x={m.x} y={m.y} class="month" text-anchor="middle" dominant-baseline="middle">{m.m}</text>)}

              <g class="spin-mid">
                <circle cx={C} cy={C} r="190" fill="none" stroke="#fff" stroke-opacity=".18" stroke-dasharray="1 7" />
              </g>
              <g class="spin-rev">
                <path d={hexPath} fill="none" stroke="#fff" stroke-opacity=".16" />
                {hex.map(([x, y]) => <circle cx={x} cy={y} r="2.2" fill="#fff" fill-opacity=".55" />)}
              </g>

              <circle cx={C} cy={C} r="118" fill="url(#core)" stroke="url(#rim)" stroke-width="1" />
              <path d={`M ${C - 132} ${C} H ${C - 122} M ${C + 122} ${C} H ${C + 132} M ${C} ${C - 132} V ${C - 122} M ${C} ${C + 122} V ${C + 132}`} stroke="#fff" stroke-opacity=".5" />

              <text x={C} y={C - 52} class="core-label" text-anchor="middle">STACK 07 · WALNUT</text>
              <text x={C} y={C + 62} class="core-big" text-anchor="middle">17.4<tspan class="core-unit" dx="3">% MC</tspan></text>
              <text x={C} y={C + 82} class="core-label" text-anchor="middle">83 % SEASONED</text>

              <g class="hands">
                <g data-hand="h"><line x1={C} y1={C + 18} x2={C} y2={C - 112} stroke="#fff" stroke-width="2.4" stroke-linecap="round" /></g>
                <g data-hand="m"><line x1={C} y1={C + 22} x2={C} y2={C - 176} stroke="#fff" stroke-opacity=".9" stroke-width="1.4" stroke-linecap="round" /></g>
                <g data-hand="s">
                  <line x1={C} y1={C + 36} x2={C} y2={C - 206} stroke="#fff" stroke-opacity=".55" stroke-width=".8" />
                  <circle cx={C} cy={C - 206} r="2.4" fill="#fff" />
                </g>
                <circle cx={C} cy={C} r="5" fill="#09090b" stroke="#fff" stroke-width="1.2" />
              </g>
            </svg>
          </figure>

          <div class="readout glass mono">
            <span>Bench time</span><strong data-clock-long>--:--:--</strong><span class="sep"></span><span>Next stack ready</span><strong>Mar 2027</strong>
          </div>
        </div>
      </section>
      </div>

      <!-- LEDGER -->
      <section id="ledger" class="section">
        <div class="sec-head reveal">
          <span class="pill mono">01 · Seasoning ledger</span>
          <h2>Every stack has a dial.</h2>
          <p>We weigh a sample board from each stack on the first of the month. When it stops losing water, the stack comes indoors. These are the four nearest the door.</p>
        </div>
        <div class="ledger">
          {ledger.map((b) => (
            <article class="glass card reveal">
              <div class="card-top mono"><span>Stack {b.id}</span><span class={b.p >= 1 ? 'state ready' : 'state'}>{b.state}</span></div>
              <svg class="mini" viewBox="0 0 100 100" aria-hidden="true">
                <circle cx="50" cy="50" r="48" fill="none" stroke="#fff" stroke-opacity=".08" />
                {Array.from({ length: 36 }, (_, i) => {
                  const a = (i * 10 * Math.PI) / 180;
                  return <line x1={50 + 40 * Math.sin(a)} y1={50 - 40 * Math.cos(a)} x2={50 + (i % 3 === 0 ? 36 : 38) * Math.sin(a)} y2={50 - (i % 3 === 0 ? 36 : 38) * Math.cos(a)} stroke="#fff" stroke-opacity=".25" stroke-width=".6" />;
                })}
                <circle cx="50" cy="50" r="44" fill="none" stroke="#fff" stroke-opacity=".1" stroke-width="1.5" />
                <circle cx="50" cy="50" r="44" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-dasharray={`${(RING * b.p).toFixed(1)} ${RING.toFixed(1)}`} transform="rotate(-90 50 50)" />
                <text x="50" y="49" text-anchor="middle" class="mini-big">{Math.round(b.p * 100)}<tspan class="mini-unit">%</tspan></text>
                <text x="50" y="63" text-anchor="middle" class="mini-label">SEASONED</text>
              </svg>
              <h3>{b.wood}</h3>
              <p class="mono sub">{b.cut}</p>
              <dl class="rows mono">
                <div><dt>Stacked</dt><dd>{b.stacked}</dd></div>
                <div><dt>Target</dt><dd>{b.target}</dd></div>
                <div><dt>Moisture</dt><dd>{b.mc} %</dd></div>
              </dl>
            </article>
          ))}
        </div>
      </section>

      <!-- PROCESS -->
      <section id="process" class="section">
        <div class="sec-head reveal">
          <span class="pill mono">02 · Process</span>
          <h2>Sixteen weeks at the bench, after the years in the stack.</h2>
          <p>The calendar is fixed by the wood, not by us. What we control is the last four months, and we keep them for one piece at a time.</p>
        </div>
        <div class="ruler glass reveal">
          <div class="ruler-track" aria-hidden="true">
            {Array.from({ length: 101 }, (_, i) => <span class={i % 10 === 0 ? 'tk major' : i % 5 === 0 ? 'tk mid' : 'tk'} style={`left:${i}%`}></span>)}
            <span class="ruler-fill"></span>
          </div>
          <ol class="stages">
            {stages.map((s) => (
              <li>
                <span class="mono code">{s.code}</span>
                <h3>{s.name}</h3>
                <p>{s.note}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- PIECES -->
      <section id="pieces" class="section">
        <div class="sec-head reveal">
          <span class="pill mono">03 · Pieces</span>
          <h2>Three drawings we make again and again.</h2>
          <p>Each is drawn to your room and cut from a stack you can visit. Prices include delivery within two hundred miles of the workshop.</p>
        </div>
        <div class="pieces">
          {pieces.map((p) => (
            <article class="glass piece reveal">
              <div class="drawing" aria-hidden="true">
                <svg viewBox="0 0 240 180">
                  <g class="guides"><path d="M0 160H240M120 0V180" /><circle cx="120" cy="90" r="78" /></g>
                  {p.kind === 'chair' && (
                    <g class="ink">
                      <path d="M86 40 Q120 28 154 40" /><path d="M88 42 L84 100 M152 42 L156 100" />
                      <path d="M100 38 L98 100 M110 35 L109 100 M120 34 V100 M130 35 L131 100 M140 38 L142 100" />
                      <path d="M74 100 H166 M76 106 H164" /><path d="M82 106 L72 160 M158 106 L168 160 M100 106 L96 160 M140 106 L144 160" />
                      <path d="M77 136 H163" />
                    </g>
                  )}
                  {p.kind === 'table' && (
                    <g class="ink">
                      <path d="M28 72 H212 M28 80 H212" />
                      <path d="M56 80 L48 160 M66 80 L74 160 M174 80 L166 160 M184 80 L192 160" />
                      <path d="M42 160 H80 M160 160 H198" /><path d="M70 122 H170" /><circle cx="66" cy="122" r="2" /><circle cx="174" cy="122" r="2" />
                    </g>
                  )}
                  {p.kind === 'cabinet' && (
                    <g class="ink">
                      <path d="M74 20 H166 V150 H74 Z M68 16 H172 M80 26 H160 V144 H80 Z" />
                      <path d="M120 26 V144" /><path d="M86 60 H114 M86 98 H114 M126 60 H154 M126 98 H154" />
                      <path d="M114 84 v8 M126 84 v8" /><path d="M74 150 L84 160 M166 150 L156 160" />
                    </g>
                  )}
                </svg>
                <span class="mono fig">FIG. {p.no.replace('No. ', '')}</span>
              </div>
              <div class="piece-body">
                <span class="mono no">{p.no}</span>
                <h3>{p.name}</h3>
                <p>{p.wood}</p>
                <dl class="rows mono">
                  <div><dt>At the bench</dt><dd>{p.weeks} weeks</dd></div>
                  <div><dt>From</dt><dd>{p.price}</dd></div>
                </dl>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- COMMISSION -->
      <section id="commission" class="section">
        <div class="commission glass reveal">
          <div class="c-copy">
            <span class="pill mono">04 · Commission</span>
            <h2>Set the thickness. The wood sets the date.</h2>
            <p>Thicker boards make heavier, calmer furniture, and they take longer to settle. Slide to see when a piece felled for you this month would arrive.</p>
            <label for="thick" class="mono slider-label">Board thickness <output id="thick-out" for="thick">50 mm · 2 in</output></label>
            <input id="thick" type="range" min="1" max="4" step="0.25" value="2" aria-describedby="eta" />
            <div class="slider-scale mono" aria-hidden="true"><span>25 mm</span><span>50</span><span>75</span><span>100 mm</span></div>
            <a class="btn btn-light" href="mailto:bench@rookandledger.example">Reserve a bench slot</a>
          </div>
          <div class="c-dial">
            <svg viewBox="0 0 300 300" aria-hidden="true">
              <circle cx="150" cy="150" r="140" fill="none" stroke="url(#rim)" />
              {Array.from({ length: 60 }, (_, i) => {
                const a = (i * 6 * Math.PI) / 180;
                const l = i % 12 === 0 ? 14 : 7;
                return <line x1={150 + 128 * Math.sin(a)} y1={150 - 128 * Math.cos(a)} x2={150 + (128 - l) * Math.sin(a)} y2={150 - (128 - l) * Math.cos(a)} stroke="#fff" stroke-opacity={i % 12 === 0 ? 0.7 : 0.22} />;
              })}
              {[0, 1, 2, 3, 4].map((y) => <text x={150 + 96 * Math.sin((y * 72 * Math.PI) / 180)} y={150 - 96 * Math.cos((y * 72 * Math.PI) / 180)} class="month" text-anchor="middle" dominant-baseline="middle">{`Y${y}`}</text>)}
              <circle cx="150" cy="150" r="136" fill="none" stroke="#fff" stroke-opacity=".08" stroke-width="2" />
              <circle id="eta-arc" cx="150" cy="150" r="136" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" transform="rotate(-90 150 150)" pathLength="100" stroke-dasharray="0 100" />
              <circle cx="150" cy="150" r="70" fill="url(#core)" stroke="#fff" stroke-opacity=".14" />
            </svg>
            <div class="c-center" id="eta" aria-live="polite">
              <span class="mono">Arrives</span>
              <strong data-eta-date>—</strong>
              <span class="mono" data-eta-months>—</span>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="foot-in">
        <span class="brand"><span>Rook <i>&amp;</i> Ledger</span></span>
        <span class="mono">Mill Lane Workshop · Hebden Bridge · Open to visitors the first Saturday of each month</span>
        <span class="mono">53.742° N · 2.014° W</span>
      </div>
    </footer>

    <BackPill />

    <script>
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const tz = 'Europe/London';
      const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: tz, hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' });
      const hands = {
        h: document.querySelector<SVGGElement>('[data-hand="h"]'),
        m: document.querySelector<SVGGElement>('[data-hand="m"]'),
        s: document.querySelector<SVGGElement>('[data-hand="s"]'),
      };
      const shortEls = document.querySelectorAll('[data-clock-short]');
      const longEls = document.querySelectorAll('[data-clock-long]');
      let lastText = '';

      const tick = () => {
        const now = new Date();
        const parts = Object.fromEntries(fmt.formatToParts(now).map((p) => [p.type, p.value]));
        const h = +parts.hour, m = +parts.minute;
        // ponytail: sweep uses local ms; London offsets are whole minutes so seconds align.
        const s = +parts.second + (reduced ? 0 : now.getMilliseconds() / 1000);
        hands.s?.setAttribute('transform', `rotate(${s * 6} 320 320)`);
        hands.m?.setAttribute('transform', `rotate(${(m + s / 60) * 6} 320 320)`);
        hands.h?.setAttribute('transform', `rotate(${((h % 12) + m / 60) * 30} 320 320)`);
        const text = `${parts.hour}:${parts.minute}:${parts.second}`;
        if (text !== lastText) {
          lastText = text;
          shortEls.forEach((el) => (el.textContent = `${parts.hour}:${parts.minute}`));
          longEls.forEach((el) => (el.textContent = text));
        }
      };
      tick();
      if (reduced) setInterval(tick, 1000);
      else {
        const loop = () => { if (!document.hidden) tick(); requestAnimationFrame(loop); };
        requestAnimationFrame(loop);
      }

      // Commission dial: one year per inch + 3 weeks conditioning + 10 at the bench + 3 curing.
      const input = document.getElementById('thick') as HTMLInputElement;
      const out = document.getElementById('thick-out');
      const arc = document.getElementById('eta-arc');
      const dateEl = document.querySelector('[data-eta-date]');
      const monthsEl = document.querySelector('[data-eta-months]');
      const monthFmt = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' });
      const update = () => {
        const inches = +input.value;
        const months = Math.round(inches * 12 + 16 / 4.345);
        const d = new Date();
        d.setDate(1);
        d.setMonth(d.getMonth() + months);
        if (out) out.textContent = `${Math.round(inches * 25)} mm · ${inches} in`;
        arc?.setAttribute('stroke-dasharray', `${Math.min(100, (months / 60) * 100).toFixed(1)} 100`);
        if (dateEl) dateEl.textContent = monthFmt.format(d);
        if (monthsEl) monthsEl.textContent = `${months} months from felling`;
      };
      input.addEventListener('input', update);
      update();

      // Gentle reveals.
      const items = document.querySelectorAll('.reveal');
      if (reduced || !('IntersectionObserver' in window)) items.forEach((el) => el.classList.add('in'));
      else {
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }), { rootMargin: '0px 0px -8% 0px' });
        items.forEach((el) => io.observe(el));
      }
    </script>

    <style is:global>
      :root {
        --bg: #050506;
        --ink: #f4f4f5;
        --mute: #a1a1aa;
        --dim: #71717a;
        --line: rgb(255 255 255 / 0.06);
        --sans: 'Inter Tight', ui-sans-serif, system-ui, sans-serif;
        --mono: 'JetBrains Mono', ui-monospace, monospace;
      }
      html { background: var(--bg); scroll-behavior: smooth; }
      body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--sans); font-weight: 300; overflow-x: clip; -webkit-font-smoothing: antialiased; }
      .mono { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 400; }
      a { color: inherit; text-decoration: none; }
      :focus-visible { outline: 1px solid #fff; outline-offset: 3px; }

      /* Grid field: faint 80 px grid that fades out away from the dial. */
      .field { position: fixed; inset: 0; z-index: 0; pointer-events: none;
        background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
        background-size: 80px 80px; background-position: center top;
        mask-image: radial-gradient(ellipse 80% 70% at 68% 40%, #000 20%, transparent 85%);
        -webkit-mask-image: radial-gradient(ellipse 80% 70% at 68% 40%, #000 20%, transparent 85%); }

      /* Dark glass shell with a 1 px gradient edge. */
      .glass { position: relative; border-radius: 22px;
        background: linear-gradient(180deg, rgb(28 28 31 / 0.55), rgb(10 10 12 / 0.6));
        backdrop-filter: blur(18px) saturate(120%); -webkit-backdrop-filter: blur(18px) saturate(120%);
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 30px 80px -30px rgb(0 0 0 / 0.9); }
      .glass::before, .pill::before, .btn-glass::before, .nav-in::before { content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px; pointer-events: none;
        background: linear-gradient(180deg, rgb(255 255 255 / 0.26), rgb(255 255 255 / 0.04) 45%, rgb(255 255 255 / 0.1));
        -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; }

      /* Nav */
      .nav { position: fixed; inset: 14px 0 auto; z-index: 50; padding: 0 16px; }
      .nav-in { position: relative; max-width: 1240px; margin: 0 auto; height: 52px; padding: 0 10px 0 18px; border-radius: 999px;
        display: flex; align-items: center; justify-content: space-between; gap: 16px;
        background: rgb(10 10 12 / 0.55); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
      .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 400; font-size: 16px; letter-spacing: -0.01em; }
      .brand i { font-style: normal; color: var(--dim); }
      .nav nav { display: flex; gap: 4px; }
      .nav nav a { padding: 8px 14px; border-radius: 999px; font-size: 14px; color: var(--mute); transition: color .3s, background .3s; }
      .nav nav a:hover { color: var(--ink); background: rgb(255 255 255 / 0.05); }
      .nav-time { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; background: rgb(255 255 255 / 0.04); color: var(--mute); }
      .live-dot { width: 6px; height: 6px; border-radius: 50%; background: #fff; box-shadow: 0 0 10px #fff; animation: pulse 2.4s ease-in-out infinite; }
      @keyframes pulse { 50% { opacity: .35; box-shadow: 0 0 2px #fff; } }

      /* Pills & buttons */
      .pill { position: relative; display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; border-radius: 999px; color: var(--mute);
        background: rgb(18 18 20 / 0.6); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
      .btn { position: relative; display: inline-flex; align-items: center; gap: 10px; height: 46px; padding: 0 22px; border-radius: 999px; font-size: 15px; font-weight: 400; transition: transform .3s, box-shadow .3s, background .3s; }
      .btn-light { color: #09090b; background: linear-gradient(180deg, #fff, #d4d4d8); box-shadow: 0 0 0 1px rgb(255 255 255 / 0.4), 0 8px 30px -8px rgb(255 255 255 / 0.35); }
      .btn-light:hover { transform: translateY(-1px); box-shadow: 0 0 0 1px #fff, 0 10px 40px -6px rgb(255 255 255 / 0.5); }
      .btn-glass { color: var(--ink); background: rgb(20 20 23 / 0.6); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
      .btn-glass:hover { background: rgb(36 36 40 / 0.7); }

      /* Hero */
      main { position: relative; z-index: 1; }
      .hero-wrap { overflow-x: clip; }
      .hero { position: relative; max-width: 1240px; margin: 0 auto; min-height: 100svh; padding: 104px 16px 48px; box-sizing: border-box;
        display: grid; grid-template-columns: 1fr; gap: 40px; align-items: center; }
      .hero-copy { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: flex-start; gap: 26px; }
      h1 { margin: 0; font-weight: 200; font-size: clamp(44px, 6.2vw, 84px); line-height: 0.98; letter-spacing: -0.045em; max-width: 11ch; }
      h1 em { font-style: normal; color: var(--dim); }
      .lede { margin: 0; max-width: 46ch; font-size: 17px; line-height: 1.6; color: var(--mute); }
      .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
      .hero-stats { display: flex; gap: 0; margin: 10px 0 0; border-top: 1px solid var(--line); padding-top: 22px; }
      .hero-stats div { padding-right: 28px; margin-right: 28px; border-right: 1px solid var(--line); }
      .hero-stats div:last-child { border: 0; margin: 0; padding: 0; }
      .hero-stats dt { color: var(--dim); font-size: 10px; }
      .hero-stats dd { margin: 6px 0 0; font-size: 26px; font-weight: 200; letter-spacing: -0.03em; }

      .dial-zone { position: relative; display: flex; flex-direction: column; align-items: center; gap: 22px; }
      .beam { position: absolute; pointer-events: none; z-index: 0; }
      .beam-h { left: -100vw; right: -100vw; top: calc(min(560px, 88vw) / 2); height: 1px;
        background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.08) 30%, rgb(255 255 255 / 0.08) 70%, transparent); }
      .beam-h::after, .beam-v::after { content: ''; position: absolute; inset: 0; background-repeat: no-repeat; }
      .beam-h::after { background-image: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.55), transparent); background-size: 260px 1px; animation: sweep-x 9s linear infinite; }
      .beam-v { top: -120px; bottom: -200px; left: 50%; width: 1px;
        background: linear-gradient(180deg, transparent, rgb(255 255 255 / 0.08) 20%, rgb(255 255 255 / 0.08) 80%, transparent); }
      .beam-v::after { background-image: linear-gradient(180deg, transparent, rgb(255 255 255 / 0.5), transparent); background-size: 1px 200px; animation: sweep-y 11s linear infinite; }
      @keyframes sweep-x { from { background-position: -260px 0; } to { background-position: calc(100% + 260px) 0; } }
      @keyframes sweep-y { from { background-position: 0 -200px; } to { background-position: 0 calc(100% + 200px); } }
      .deg { position: absolute; z-index: 1; color: var(--dim); font-size: 10px; }
      .d0 { top: -28px; left: calc(50% + 8px); }
      .d180 { top: calc(min(560px, 88vw) + 8px); left: calc(50% + 8px); }
      .d90 { top: calc(min(560px, 88vw) / 2 - 20px); left: calc(50% + min(560px, 88vw) / 2 + 12px); }
      .d270 { top: calc(min(560px, 88vw) / 2 - 20px); right: calc(50% + min(560px, 88vw) / 2 + 12px); }

      .dial { position: relative; z-index: 1; margin: 0; width: min(560px, 88vw); aspect-ratio: 1; }
      .dial svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
      .disk { position: absolute; inset: 2.5%; border-radius: 50%;
        background: radial-gradient(circle at 50% 30%, rgb(40 40 44 / 0.35), rgb(8 8 10 / 0.55) 70%);
        backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12), inset 0 -30px 60px rgb(0 0 0 / 0.5), 0 50px 120px -40px rgb(0 0 0 / 0.9); }
      .wisps { position: absolute; inset: 8%; border-radius: 50%; }
      .wisps span { position: absolute; border-radius: 50%; filter: blur(40px); opacity: .5; }
      .wisps span:nth-child(1) { inset: 10% 30% 45% 8%; background: rgb(255 255 255 / 0.35); animation: drift1 18s ease-in-out infinite alternate; }
      .wisps span:nth-child(2) { inset: 50% 6% 8% 45%; background: rgb(212 212 216 / 0.25); animation: drift2 22s ease-in-out infinite alternate; }
      .wisps span:nth-child(3) { inset: 32% 32%; background: rgb(255 255 255 / 0.4); animation: drift1 14s ease-in-out infinite alternate-reverse; }
      @keyframes drift1 { to { transform: translate(18%, 14%) scale(1.15); } }
      @keyframes drift2 { to { transform: translate(-20%, -12%) scale(.9); } }

      .ring-text { font-family: var(--mono); font-size: 10.5px; letter-spacing: 4.2px; fill: rgb(255 255 255 / 0.5); }
      .month { font-family: var(--mono); font-size: 10px; letter-spacing: 1.5px; fill: rgb(255 255 255 / 0.42); }
      .core-label { font-family: var(--mono); font-size: 9.5px; letter-spacing: 2px; fill: rgb(255 255 255 / 0.5); }
      .core-big { font-family: var(--sans); font-weight: 200; font-size: 30px; letter-spacing: -1px; fill: #fff; }
      .core-unit { font-family: var(--mono); font-size: 10px; letter-spacing: 1.5px; fill: rgb(255 255 255 / 0.55); }
      .spin-slow, .spin-mid, .spin-rev { transform-origin: 320px 320px; transform-box: view-box; }
      .spin-slow { animation: spin 160s linear infinite; }
      .spin-mid { animation: spin 70s linear infinite; }
      .spin-rev { animation: spin 120s linear infinite reverse; }
      @keyframes spin { to { transform: rotate(360deg); } }
      .arc { filter: drop-shadow(0 0 4px rgb(255 255 255 / 0.6)); }

      .readout { display: flex; align-items: center; flex-wrap: wrap; justify-content: center; gap: 10px 14px; padding: 12px 20px; border-radius: 999px; color: var(--dim); font-size: 10.5px; }
      .readout strong { color: var(--ink); font-weight: 500; font-variant-numeric: tabular-nums; }
      .readout .sep { width: 1px; height: 14px; background: rgb(255 255 255 / 0.14); }

      /* Sections */
      .section { position: relative; max-width: 1240px; margin: 0 auto; padding: 96px 16px; box-sizing: border-box; }
      .section::before { content: ''; position: absolute; left: 16px; right: 16px; top: 0; height: 1px; background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.12), transparent); }
      .sec-head { display: grid; gap: 18px; justify-items: start; max-width: 640px; margin-bottom: 48px; }
      h2 { margin: 0; font-weight: 200; font-size: clamp(32px, 4.2vw, 52px); line-height: 1.04; letter-spacing: -0.04em; }
      .sec-head p, .c-copy > p { margin: 0; font-size: 16px; line-height: 1.65; color: var(--mute); max-width: 52ch; }
      h3 { margin: 0; font-weight: 300; font-size: 22px; letter-spacing: -0.02em; }

      .ledger { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
      .card { padding: 22px; display: flex; flex-direction: column; gap: 14px; }
      .card-top { display: flex; justify-content: space-between; color: var(--dim); font-size: 10px; }
      .state { color: var(--mute); }
      .state.ready { color: #fff; text-shadow: 0 0 10px rgb(255 255 255 / 0.6); }
      .mini { width: 132px; height: 132px; align-self: center; margin: 6px 0 4px; }
      .mini-big { font-family: var(--sans); font-weight: 200; font-size: 22px; fill: #fff; }
      .mini-unit { font-size: 11px; fill: rgb(255 255 255 / 0.55); }
      .mini-label { font-family: var(--mono); font-size: 5.5px; letter-spacing: 1.2px; fill: rgb(255 255 255 / 0.45); }
      .sub { color: var(--dim); font-size: 10px; margin: -8px 0 0; }
      .rows { margin: 4px 0 0; display: grid; gap: 0; }
      .rows div { display: flex; justify-content: space-between; padding: 9px 0; border-top: 1px solid var(--line); }
      .rows dt { color: var(--dim); }
      .rows dd { margin: 0; color: var(--ink); }

      .ruler { padding: 40px 32px 32px; }
      .ruler-track { position: relative; height: 40px; margin: 0 0 34px; }
      .tk { position: absolute; bottom: 0; width: 1px; height: 8px; background: rgb(255 255 255 / 0.18); }
      .tk.mid { height: 14px; background: rgb(255 255 255 / 0.3); }
      .tk.major { height: 22px; background: rgb(255 255 255 / 0.55); }
      .ruler-fill { position: absolute; left: 0; bottom: -1px; height: 1px; width: 100%; background: linear-gradient(90deg, rgb(255 255 255 / 0.15), #fff); box-shadow: 0 0 10px rgb(255 255 255 / 0.4); }
      .stages li { position: relative; }
      .stages li::before { content: ""; position: absolute; top: -39px; left: 0; width: 9px; height: 9px; margin-left: -4px; border-radius: 50%; background: #09090b; border: 1px solid #fff; box-shadow: 0 0 10px rgb(255 255 255 / 0.5); }
      .stages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px; }
      .stages li { display: grid; gap: 8px; align-content: start; }
      .stages .code { color: #fff; font-size: 10px; }
      .stages h3 { font-size: 19px; }
      .stages p { margin: 0; font-size: 14px; line-height: 1.55; color: var(--mute); }

      .pieces { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
      .piece { overflow: hidden; display: flex; flex-direction: column; }
      .drawing { position: relative; aspect-ratio: 4 / 3; border-bottom: 1px solid var(--line);
        background: radial-gradient(circle at 50% 45%, rgb(255 255 255 / 0.06), transparent 65%); }
      .drawing svg { position: absolute; inset: 0; width: 100%; height: 100%; }
      .guides { fill: none; stroke: rgb(255 255 255 / 0.08); stroke-dasharray: 2 4; }
      .ink { fill: none; stroke: rgb(255 255 255 / 0.78); stroke-width: 1; stroke-linecap: round; stroke-linejoin: round; }
      .fig { position: absolute; left: 16px; top: 14px; color: var(--dim); font-size: 9.5px; }
      .piece-body { padding: 22px; display: grid; gap: 8px; }
      .piece-body .no { color: var(--dim); font-size: 10px; }
      .piece-body > p { margin: 0 0 6px; color: var(--mute); font-size: 15px; }

      .commission { display: grid; grid-template-columns: 1fr; gap: 40px; padding: 32px 22px; border-radius: 28px; align-items: center; }
      .c-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
      .slider-label { display: flex; justify-content: space-between; width: 100%; color: var(--dim); margin-top: 8px; }
      .slider-label output { color: var(--ink); }
      input[type='range'] { width: 100%; appearance: none; -webkit-appearance: none; height: 28px; background: transparent; margin: 0; }
      input[type='range']::-webkit-slider-runnable-track { height: 1px; background: rgb(255 255 255 / 0.25); }
      input[type='range']::-moz-range-track { height: 1px; background: rgb(255 255 255 / 0.25); }
      input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; width: 18px; height: 18px; margin-top: -9px; border-radius: 50%; background: #09090b; border: 1px solid #fff; box-shadow: 0 0 14px rgb(255 255 255 / 0.5); }
      input[type='range']::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: #09090b; border: 1px solid #fff; box-shadow: 0 0 14px rgb(255 255 255 / 0.5); }
      .slider-scale { display: flex; justify-content: space-between; width: 100%; color: var(--dim); font-size: 9.5px; margin: -8px 0 10px; }
      .c-dial { position: relative; width: min(340px, 100%); aspect-ratio: 1; justify-self: center; }
      .c-dial svg { width: 100%; height: 100%; overflow: visible; }
      #eta-arc { transition: stroke-dasharray .6s cubic-bezier(.2,.7,.2,1); filter: drop-shadow(0 0 4px rgb(255 255 255 / 0.6)); }
      .c-center { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; gap: 6px; color: var(--dim); }
      .c-center strong { font-weight: 200; font-size: 30px; letter-spacing: -0.03em; color: var(--ink); }
      .c-center .mono { font-size: 9.5px; }

      .foot { position: relative; z-index: 1; border-top: 1px solid var(--line); padding: 32px 16px 80px; }
      .foot-in { max-width: 1240px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 14px 32px; justify-content: space-between; align-items: center; color: var(--dim); }
      .foot-in .mono { font-size: 10px; }

      .reveal { opacity: 0; transform: translateY(18px); transition: opacity 1.1s cubic-bezier(.2,.7,.2,1), transform 1.1s cubic-bezier(.2,.7,.2,1); }
      .reveal.in { opacity: 1; transform: none; }
      .hero-copy.reveal { opacity: 1; transform: none; animation: rise 1.2s cubic-bezier(.2,.7,.2,1) both; }
      @keyframes rise { from { opacity: 0; transform: translateY(18px); } }

      @media (min-width: 980px) {
        .hero { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); padding-top: 96px; }
        .commission { grid-template-columns: 1.1fr 0.9fr; padding: 56px; }
      }
      @media (max-width: 979px) {
        .stages { grid-template-columns: 1fr; gap: 22px; }
        .ruler-track { display: none; }
        .stages li { padding-left: 20px; border-left: 1px solid rgb(255 255 255 / 0.18); }
        .ruler { padding: 28px 22px; }
        .stages li::before { top: 2px; margin-left: -5px; }
      }
      @media (max-width: 760px) {
        .nav nav { display: none; }
        .hero-stats div { padding-right: 16px; margin-right: 16px; }
        .hero-stats dd { font-size: 22px; }
        .deg { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition: none !important; }
        html { scroll-behavior: auto; }
        .reveal { opacity: 1; transform: none; }
      }
    </style>
  </body>
</html>
