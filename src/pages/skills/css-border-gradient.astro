---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

const img = (id: string, w = 640) => `https://images.unsplash.com/photo-${id}?w=${w}&q=72&auto=format&fit=crop`;
const IMG = {
  projector: '1478720568477-152d9b164e26',
  sea: '1534447677768-be436bb09401',
  seats: '1489599849927-2ee91cede3ba',
  darkSeats: '1524712245354-2c4e5e7121c0',
  neon: '1536440136628-849c177e76a1',
  reels: '1542204165-65bf26472b9b',
  screen: '1595769816263-9b910be24d5f',
  clapper: '1485846234645-a62644f84728',
  slate: '1594909122845-11baa439b7bf',
  booth: '1440404653325-ab127d49abc1',
  audience: '1517604931442-7e0c8ed2963c',
};

const passes = [
  { id: 'day', name: 'Day Ticket', price: 9, unit: 'per screening', lines: ['Any one programme, any day', 'Seat held until 10 min before', 'Swap once, free'] },
  { id: 'festival', name: 'Festival Pass', price: 64, unit: 'all eight days', lines: ['20 screenings across four rooms', 'Priority queue at Sala 1', 'Closing night & awards', 'One vote for the Audience Prize'], badge: 'Most chosen' },
  { id: 'nocturne', name: 'Nocturne Pass', price: 28, unit: 'six midnights', lines: ['All six 23:59 programmes', 'Late tram home included', 'Coffee in the booth bar'] },
];

const programme = [
  {
    id: 'competition', label: 'Competition', count: 42,
    films: [
      { day: 'Fri 12', time: '21:30', title: 'The Salt Keepers', who: 'Mariana Leal', from: 'PT', min: 14, room: 'Sala 1', img: IMG.sea, note: 'Opening night' },
      { day: 'Sat 13', time: '18:00', title: 'Every Lamp in Tbilisi', who: 'Nino Abashidze', from: 'GE', min: 19, room: 'Sala 2', img: IMG.neon },
      { day: 'Sat 13', time: '20:15', title: 'Weather for Two', who: 'Jonas Vik', from: 'NO', min: 11, room: 'Sala 1', img: IMG.screen },
      { day: 'Sun 14', time: '16:40', title: 'A Ferry Called Tuesday', who: 'Ama Owusu', from: 'GH / UK', min: 23, room: 'Rooftop', img: IMG.audience },
    ],
  },
  {
    id: 'nocturne', label: 'Nocturne', count: 18,
    films: [
      { day: 'Sat 13', time: '23:59', title: 'Static Choir', who: 'Kaito Mori', from: 'JP', min: 17, room: 'Sala 3', img: IMG.darkSeats },
      { day: 'Sun 14', time: '23:59', title: 'Night Shift at the Planetarium', who: 'Lea Brandt', from: 'DE', min: 21, room: 'Sala 3', img: IMG.sea },
      { day: 'Tue 16', time: '23:59', title: 'Teeth of the Tide', who: 'Inés Calderón', from: 'MX', min: 13, room: 'Sala 3', img: IMG.projector },
      { day: 'Thu 18', time: '23:59', title: 'Afterimage', who: 'Coletivo Ruído', from: 'BR', min: 25, room: 'Sala 1', img: IMG.booth },
    ],
  },
  {
    id: 'family', label: 'Family', count: 26,
    films: [
      { day: 'Sun 14', time: '11:00', title: 'The Kite That Wanted Rain', who: 'Sophie Arnaud', from: 'FR', min: 9, room: 'Sala 2', img: IMG.slate },
      { day: 'Mon 15', time: '11:00', title: "Grandma's Cinema", who: 'Tomás Rey', from: 'PT', min: 12, room: 'Sala 1', img: IMG.seats },
      { day: 'Mon 15', time: '14:30', title: 'Moth & the Moon', who: 'Priya Nair', from: 'IN', min: 8, room: 'Rooftop', img: IMG.reels },
      { day: 'Wed 17', time: '11:00', title: 'Paper Boats, Big River', who: 'Elif Kaya', from: 'TR', min: 15, room: 'Sala 2', img: IMG.clapper },
    ],
  },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Halation — Lisbon Short Film Week</title>
    <meta name="description" content="Halation, the eleventh Lisbon Short Film Week: 86 short films, four screens, eight nights in March." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href={img(IMG.projector, 2400)} />
  </head>
  <body>
    <BackPill />

    <!-- ===== HERO ===== -->
    <header class="hero">
      <img class="hero-bg" src={img(IMG.projector, 2400)} alt="" />
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="guides" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

      <nav class="nav wrap" aria-label="Main">
        <a class="logo" href="#top" aria-label="Halation home">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2" fill="currentColor" />
            <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-opacity=".45" />
            <circle cx="12" cy="12" r="11" fill="none" stroke="currentColor" stroke-opacity=".18" />
          </svg>
          Halation
        </a>
        <ul class="nav-links">
          <li><a href="#programme">Programme</a></li>
          <li><a href="#passes">Passes</a></li>
          <li><a href="#letters">Venues</a></li>
        </ul>
        <div class="nav-end">
          <a class="nav-quiet" href="#letters">Press</a>
          <a class="btn-light" href="#passes">Get a pass <span aria-hidden="true">→</span></a>
        </div>
      </nav>

      <div class="hero-body wrap" id="top">
        <div class="hero-copy">
          <p class="mono eyebrow"><span class="dot" aria-hidden="true"></span>11th edition · Lisbon · 12—19 March 2027</p>
          <h1>Short films,<br /><span class="dim">in long light.</span></h1>
          <p class="lede">Eight nights of cinema under twenty-five minutes, projected in four rooms of a 1931 picture palace on the river. Come for one film. Stay for the one after.</p>
          <dl class="stats">
            <div><dt class="mono">Films</dt><dd>86</dd></div>
            <div><dt class="mono">Countries</dt><dd>31</dd></div>
            <div><dt class="mono">Screens</dt><dd>4</dd></div>
            <div><dt class="mono">World premieres</dt><dd>19</dd></div>
          </dl>
        </div>

        <!-- The one gradient-bordered surface in this view: masked pattern, 2px (hero card). -->
        <article class="hero-card gb-mask gb-2" aria-labelledby="opening-title">
          <div class="hc-top">
            <span class="mono tag">Opening night</span>
            <span class="mono muted">Fri 12 Mar · 21:30</span>
          </div>
          <div class="hc-still">
            <img src={img(IMG.sea, 900)} alt="A small sailboat on still water under a starry sky" loading="eager" />
            <span class="mono runtime">14′00″</span>
          </div>
          <h2 id="opening-title">The Salt Keepers</h2>
          <p class="hc-meta">Mariana Leal · Portugal · World premiere</p>
          <p class="hc-text">Two sisters keep the last salt pans of the Sado estuary through one sleepless summer. Followed by a live score from Orquestra Maré.</p>
          <a class="hc-link" href="#programme">
            <span>Reserve a seat in Sala 1</span>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
          </a>
        </article>
      </div>
    </header>

    <main>
      <!-- ===== PASSES (light theme: separate tokens) ===== -->
      <section class="passes" id="passes" aria-labelledby="passes-title">
        <div class="wrap">
          <div class="sec-head">
            <p class="mono idx">01 — Passes</p>
            <h2 id="passes-title">Choose how much light you want.</h2>
            <p class="sec-sub">One pass for the whole week, or a single seat for a single film. Your choice gets the frame; everything else stays quiet.</p>
          </div>

          <fieldset class="pass-grid">
            <legend class="sr-only">Pass type</legend>
            {passes.map((p) => (
              <label class="pass gb-light">
                <input type="radio" name="pass" value={p.id} checked={p.id === 'festival'} data-name={p.name} data-price={p.price} />
                <span class="pass-top">
                  <span class="pass-name">{p.name}</span>
                  {p.badge && <span class="mono pass-badge">{p.badge}</span>}
                </span>
                <span class="pass-price">€{p.price}<small class="mono">{p.unit}</small></span>
                <span class="pass-lines">
                  {p.lines.map((l) => <span>{l}</span>)}
                </span>
                <span class="mono pass-check" aria-hidden="true"><span class="tick"></span><span class="pick-label"></span></span>
              </label>
            ))}
          </fieldset>

          <div class="pass-bar">
            <p class="mono" aria-live="polite" id="pass-summary">Festival Pass · €64 · on sale until 11 March</p>
            <a class="btn-dark" href="#letters">Continue <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <!-- ===== PROGRAMME ===== -->
      <section class="programme" id="programme" aria-labelledby="prog-title">
        <div class="wrap">
          <div class="prog-head">
            <div>
              <p class="mono idx">02 — Programme</p>
              <h2 id="prog-title">This week on the four screens.</h2>
            </div>
            <div class="tabs" role="tablist" aria-label="Programme strand">
              {programme.map((s, i) => (
                <button class="tab" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                  {s.label}<span class="mono">{s.count}</span>
                </button>
              ))}
            </div>
          </div>

          {programme.map((s, i) => (
            <ol class="films" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
              {s.films.map((f) => (
                <li class="film gb-mask gb-hover">
                  <img src={img(f.img, 360)} alt="" />
                  <span class="mono when"><b>{f.day}</b> Mar · {f.time}</span>
                  <span class="film-main">
                    <a class="film-title" href="#passes">{f.title}</a>
                    <span class="film-who">{f.who} · {f.from}</span>
                  </span>
                  <span class="mono film-room">{f.room}</span>
                  <span class="mono film-min">{f.min}′</span>
                  {f.note && <span class="mono film-note">{f.note}</span>}
                </li>
              ))}
            </ol>
          ))}
        </div>
      </section>

      <!-- ===== LETTERS / FOOTER ===== -->
      <section class="letters" id="letters" aria-labelledby="letters-title">
        <div class="wrap letters-grid">
          <div>
            <p class="mono idx">03 — Letters from the booth</p>
            <h2 id="letters-title">One e-mail a week, written by the projectionists.</h2>
          </div>
          <form class="signup" onsubmit="event.preventDefault(); this.querySelector('output').value = 'Thank you — the first letter leaves on Friday.';">
            <label for="email" class="mono">E-mail address</label>
            <div class="field">
              <input id="email" type="email" required placeholder="you@riverside.pt" autocomplete="email" />
              <button type="submit" class="btn-light">Subscribe</button>
            </div>
            <output class="mono muted" aria-live="polite"></output>
          </form>
        </div>
        <div class="wrap foot">
          <p><strong>Cinema Alvorada</strong><br />Rua da Ribeira Nova 14, 1200-371 Lisboa</p>
          <p><strong>Rooftop screen</strong><br />Terraço do Mercado, open from 20:00</p>
          <p class="mono muted">Halation is a fictional festival.<br />Stills via Unsplash.</p>
        </div>
      </section>
    </main>

    <script>
      // Pass picker: update the live summary.
      const summary = document.getElementById('pass-summary')!;
      document.querySelectorAll<HTMLInputElement>('input[name="pass"]').forEach((r) =>
        r.addEventListener('change', () => {
          summary.textContent = `${r.dataset.name} · €${r.dataset.price} · on sale until 11 March`;
        }),
      );

      // Tabs: click + roving arrow-key focus (WAI-ARIA tabs pattern).
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const select = (t: HTMLButtonElement) => {
        tabs.forEach((x) => {
          const on = x === t;
          x.setAttribute('aria-selected', String(on));
          x.tabIndex = on ? 0 : -1;
          document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
        });
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(t));
        t.addEventListener('keydown', (e) => {
          const step = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
          if (!step) return;
          const next = tabs[(i + step + tabs.length) % tabs.length];
          next.focus();
          select(next);
        });
      });
    </script>

    <style>
      :global(:root) {
        --ink: #f4f1f6;
        --ink-2: rgba(244, 241, 246, 0.68);
        --ink-3: rgba(244, 241, 246, 0.46);
        --night: #0d0b0f;
        --night-2: #141117;
        --paper: #efede8;
        --paper-ink: #17141c;
        --violet: #8b6cff;

        /* Dark-surface border tokens — the skill's defaults. */
        --surface: rgba(16, 12, 18, 0.56);
        --border-a: rgba(255, 255, 255, 0.34);
        --border-b: rgba(125, 92, 255, 0.36);
        --border-c: rgba(255, 255, 255, 0.08);

        /* Light-surface tokens: the same alpha disappears on paper, so ink-based stops instead. */
        --l-surface: #fbfaf7;
        --l-border-a: rgba(23, 20, 28, 0.26);
        --l-border-b: rgba(110, 78, 245, 0.55);
        --l-border-c: rgba(23, 20, 28, 0.06);

        --sans: 'Geist', ui-sans-serif, system-ui, sans-serif;
        --mono: 'Geist Mono', ui-monospace, monospace;
      }
      :global(html) { scroll-behavior: smooth; }
      :global(body) {
        margin: 0;
        background: var(--night);
        color: var(--ink);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
      }
      .wrap { width: min(1360px, 100% - 2 * clamp(20px, 4vw, 48px)); margin-inline: auto; }
      .mono { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; }
      .muted { color: var(--ink-3); }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      a { color: inherit; text-decoration: none; }
      :focus-visible { outline: 2px solid var(--violet); outline-offset: 3px; border-radius: 6px; }

      /* ---------- Gradient border: masked pattern (keeps complex backgrounds) ---------- */
      .gb-mask { position: relative; }
      .gb-mask::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        padding: var(--gb-w, 1px);
        background: linear-gradient(145deg, var(--border-a), var(--border-b) 45%, var(--border-c));
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
      }
      .gb-2 { --gb-w: 2px; }

      /* ---------- Buttons ---------- */
      .btn-light, .btn-dark {
        display: inline-flex; align-items: center; gap: 10px;
        height: 42px; padding: 0 18px; border-radius: 999px;
        font: 500 14px/1 var(--sans); border: 0; cursor: pointer;
        transition: transform 0.2s ease, background-color 0.2s ease;
      }
      .btn-light { background: var(--ink); color: var(--paper-ink); box-shadow: 0 6px 24px -10px rgba(0, 0, 0, 0.6); }
      .btn-light:hover { background: #fff; }
      .btn-dark { background: var(--paper-ink); color: var(--paper); }
      .btn-dark:hover { background: #000; }

      /* ---------- Hero ---------- */
      .hero {
        position: relative; isolation: isolate; overflow: hidden;
        min-height: max(100svh, 760px);
        display: flex; flex-direction: column;
      }
      .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 30% 40%; z-index: -3; filter: saturate(0.85) contrast(1.05); }
      .hero-shade {
        position: absolute; inset: 0; z-index: -2;
        background:
          radial-gradient(60% 50% at 78% 38%, rgba(125, 92, 255, 0.16), transparent 70%),
          linear-gradient(180deg, rgba(13, 11, 15, 0.55) 0%, rgba(13, 11, 15, 0.05) 28%, rgba(13, 11, 15, 0.35) 55%, rgba(13, 11, 15, 0.94) 100%),
          linear-gradient(90deg, rgba(13, 11, 15, 0.55), transparent 55%);
      }
      .guides {
        position: absolute; inset: 0; z-index: -1; pointer-events: none;
        width: min(1360px, 100% - 2 * clamp(20px, 4vw, 48px)); margin-inline: auto;
        display: grid; grid-template-columns: repeat(3, 1fr);
      }
      .guides i { border-left: 1px solid rgba(255, 255, 255, 0.07); }
      .guides i:last-child { position: absolute; right: 0; top: 0; bottom: 0; }

      .nav { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-top: 26px; }
      .logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 18px; letter-spacing: -0.01em; }
      .nav-links { display: flex; gap: 32px; list-style: none; margin: 0; padding: 0; font-size: 14px; color: var(--ink-2); }
      .nav-links a:hover, .nav-quiet:hover { color: var(--ink); }
      .nav-end { display: flex; align-items: center; gap: 22px; font-size: 14px; }
      .nav-quiet { color: var(--ink-2); }

      .hero-body {
        flex: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 400px);
        align-items: end; gap: 48px; padding-block: 80px 56px;
      }
      .eyebrow { display: inline-flex; align-items: center; gap: 10px; color: var(--ink-2); margin: 0 0 26px; }
      .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--violet); box-shadow: 0 0 0 4px rgba(139, 108, 255, 0.18); }
      h1 {
        margin: 0; font-weight: 500; letter-spacing: -0.045em; line-height: 0.92;
        font-size: clamp(52px, 8vw, 128px);
      }
      .dim { color: rgba(244, 241, 246, 0.55); }
      .lede { max-width: 470px; margin: 28px 0 0; font-size: 16px; line-height: 1.6; color: var(--ink-2); font-weight: 300; }
      .stats { display: flex; flex-wrap: wrap; gap: 0; margin: 40px 0 0; }
      .stats div { padding: 0 28px; border-left: 1px solid rgba(255, 255, 255, 0.14); }
      .stats div:first-child { padding-left: 0; border-left: 0; }
      .stats dt { color: var(--ink-3); font-size: 10.5px; }
      .stats dd { margin: 6px 0 0; font-size: 28px; font-weight: 500; letter-spacing: -0.03em; }

      .hero-card {
        border-radius: 22px; padding: 18px 18px 22px;
        background: var(--surface);
        backdrop-filter: blur(22px) saturate(1.2);
        -webkit-backdrop-filter: blur(22px) saturate(1.2);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 30px 80px -30px rgba(0, 0, 0, 0.8);
      }
      .hc-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 14px; }
      .tag { color: var(--ink); padding: 5px 9px; border-radius: 999px; background: rgba(139, 108, 255, 0.2); font-size: 10.5px; }
      .hc-still { position: relative; border-radius: 12px; overflow: hidden; aspect-ratio: 16 / 9; }
      .hc-still img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .runtime { position: absolute; right: 10px; bottom: 10px; padding: 4px 7px; border-radius: 6px; background: rgba(0, 0, 0, 0.55); font-size: 10.5px; }
      .hero-card h2 { margin: 18px 0 4px; font-size: 26px; font-weight: 500; letter-spacing: -0.03em; }
      .hc-meta { margin: 0; font-size: 13px; color: var(--ink-3); }
      .hc-text { margin: 14px 0 20px; font-size: 14px; line-height: 1.6; color: var(--ink-2); font-weight: 300; }
      .hc-link {
        display: flex; justify-content: space-between; align-items: center;
        padding-bottom: 10px; border-bottom: 1px solid rgba(255, 255, 255, 0.22); font-size: 14px;
      }
      .hc-link:hover { border-color: var(--ink); }

      /* ---------- Passes (light) ---------- */
      .passes { background: var(--paper); color: var(--paper-ink); padding-block: clamp(80px, 11vw, 140px); }
      .sec-head { max-width: 640px; margin-bottom: 56px; }
      .idx { color: rgba(23, 20, 28, 0.5); margin: 0 0 18px; }
      .passes h2, .programme h2, .letters h2 { margin: 0; font-weight: 500; letter-spacing: -0.035em; line-height: 1; font-size: clamp(34px, 4.6vw, 60px); }
      .sec-sub { margin: 20px 0 0; font-size: 16px; line-height: 1.6; color: rgba(23, 20, 28, 0.62); max-width: 520px; }

      .pass-grid { border: 0; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; align-items: stretch; }
      .pass {
        position: relative; cursor: pointer; display: flex; flex-direction: column; gap: 18px;
        padding: 28px; border-radius: 20px;
        /* Resting: plain hairline, no gradient. */
        border: 1px solid rgba(23, 20, 28, 0.1);
        background: rgba(255, 255, 255, 0.42);
        transition: background-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
      }
      .pass:hover { background: rgba(255, 255, 255, 0.75); }
      .pass input { position: absolute; opacity: 0; pointer-events: none; }
      /* Selected: simple padding-box / border-box pattern, 2px for the active state. */
      .pass:has(input:checked) {
        border: 2px solid transparent;
        padding: 27px;
        background:
          linear-gradient(var(--l-surface), var(--l-surface)) padding-box,
          linear-gradient(135deg, var(--l-border-a), var(--l-border-b), var(--l-border-c)) border-box;
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.9) inset, 0 24px 50px -28px rgba(60, 40, 140, 0.35);
      }
      /* Focus never relies on the gradient alone. */
      .pass:has(input:focus-visible) { outline: 2px solid var(--paper-ink); outline-offset: 4px; }
      .pass-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
      .pass-name { font-size: 17px; font-weight: 500; }
      .pass-badge { font-size: 10px; padding: 4px 8px; border-radius: 999px; background: rgba(110, 78, 245, 0.1); color: #5a3ee0; }
      .pass-price { font-size: 52px; font-weight: 500; letter-spacing: -0.05em; line-height: 1; display: flex; align-items: baseline; gap: 10px; }
      .pass-price small { font-size: 10.5px; letter-spacing: 0.08em; color: rgba(23, 20, 28, 0.5); }
      .pass-lines { display: grid; gap: 10px; padding-top: 18px; border-top: 1px solid rgba(23, 20, 28, 0.08); font-size: 14.5px; color: rgba(23, 20, 28, 0.72); flex: 1; align-content: start; }
      .pass-lines span::before { content: '—'; margin-right: 10px; color: rgba(23, 20, 28, 0.3); }
      .pass-check { display: flex; align-items: center; gap: 10px; color: rgba(23, 20, 28, 0.5); font-size: 10.5px; }
      .tick { width: 16px; height: 16px; border-radius: 50%; border: 1px solid rgba(23, 20, 28, 0.25); display: grid; place-items: center; }
      .pick-label::after { content: 'Select'; }
      .pass:has(input:checked) .tick { border-color: #6e4ef5; background: #6e4ef5; box-shadow: inset 0 0 0 3px var(--l-surface); }
      .pass:has(input:checked) .pass-check { color: #5a3ee0; }
      .pass:has(input:checked) .pick-label::after { content: 'Selected'; }

      .pass-bar { margin-top: 28px; display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
      .pass-bar p { margin: 0; color: rgba(23, 20, 28, 0.62); }

      /* ---------- Programme (dark) ---------- */
      .programme { background: var(--night); padding-block: clamp(80px, 11vw, 140px); }
      .programme .idx, .letters .idx { color: var(--ink-3); }
      .prog-head { display: flex; justify-content: space-between; align-items: end; gap: 32px; flex-wrap: wrap; margin-bottom: 44px; }
      .tabs { display: flex; gap: 6px; padding: 5px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.08); background: rgba(255, 255, 255, 0.02); }
      .tab {
        display: inline-flex; align-items: center; gap: 8px; height: 38px; padding: 0 16px;
        border-radius: 999px; border: 1px solid transparent; background: transparent;
        color: var(--ink-3); font: 500 14px/1 var(--sans); cursor: pointer;
      }
      .tab .mono { font-size: 10px; opacity: 0.7; }
      .tab:hover { color: var(--ink); }
      /* Active tab: simple pattern, 1px. */
      .tab[aria-selected='true'] {
        color: var(--ink);
        background:
          linear-gradient(#1b1720, #1b1720) padding-box,
          linear-gradient(135deg, var(--border-a), var(--border-b), var(--border-c)) border-box;
      }

      .films { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
      .film {
        display: grid; align-items: center; gap: 24px;
        grid-template-columns: 112px 150px minmax(0, 1fr) 90px 48px;
        padding: 12px 20px 12px 12px; border-radius: 16px;
        background: rgba(255, 255, 255, 0.025);
        transition: background-color 0.3s ease;
      }
      /* Hover / focus: the edge fades in — opacity only, the gradient itself never moves. */
      .gb-hover::before { opacity: 0; transition: opacity 0.3s ease; }
      .gb-hover:hover::before, .gb-hover:focus-within::before { opacity: 1; }
      .film:hover, .film:focus-within { background: rgba(255, 255, 255, 0.05); }
      .film img { width: 112px; height: 64px; object-fit: cover; border-radius: 10px; display: block; filter: saturate(0.85); }
      .when { color: var(--ink-3); }
      .when b { color: var(--ink); font-weight: 500; }
      .film-main { display: grid; gap: 4px; min-width: 0; }
      .film-title { font-size: 19px; font-weight: 500; letter-spacing: -0.02em; }
      .film-title::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
      .film-title:focus-visible { outline: none; }
      .film:has(.film-title:focus-visible) { outline: 2px solid var(--violet); outline-offset: 3px; }
      .film-who { font-size: 13.5px; color: var(--ink-3); }
      .film-room { color: var(--ink-2); }
      .film-min { color: var(--ink-2); text-align: right; }
      .film-note { position: absolute; top: -8px; left: 136px; font-size: 9.5px; padding: 3px 7px; border-radius: 999px; background: var(--violet); color: #fff; }

      /* ---------- Letters ---------- */
      .letters { background: var(--night-2); padding-block: clamp(72px, 9vw, 120px) 32px; border-top: 1px solid rgba(255, 255, 255, 0.06); }
      .letters-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 48px; align-items: end; }
      .letters h2 { font-size: clamp(30px, 3.6vw, 46px); max-width: 620px; }
      .signup { display: grid; gap: 12px; }
      .signup label { color: var(--ink-3); }
      .field {
        display: flex; gap: 8px; padding: 6px 6px 6px 18px; border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(255, 255, 255, 0.03);
      }
      .field:focus-within {
        border-color: transparent;
        background:
          linear-gradient(#18141c, #18141c) padding-box,
          linear-gradient(135deg, var(--border-a), var(--border-b), var(--border-c)) border-box;
        outline: 2px solid var(--violet); outline-offset: 3px;
      }
      .field input { flex: 1; min-width: 0; background: transparent; border: 0; color: var(--ink); font: 400 15px var(--sans); outline: none; }
      .field input::placeholder { color: var(--ink-3); }
      .signup output { min-height: 1em; }
      .foot { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 80px; padding-top: 28px; border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: 14px; line-height: 1.6; color: var(--ink-2); }
      .foot p { margin: 0; }
      .foot strong { color: var(--ink); font-weight: 500; }
      .foot p:last-child { text-align: right; font-size: 10.5px; line-height: 1.8; }

      /* ---------- Responsive ---------- */
      @media (max-width: 1080px) {
        .hero-body { grid-template-columns: 1fr; gap: 40px; padding-top: 120px; }
        .hero-card { max-width: 440px; }
        .film { grid-template-columns: 96px 130px minmax(0, 1fr) 48px; }
        .film img { width: 96px; height: 56px; }
        .film-room { display: none; }
        .film-note { left: 118px; }
      }
      @media (max-width: 820px) {
        .nav-links, .nav-quiet { display: none; }
        .guides { grid-template-columns: 1fr 1fr; }
        .guides i:nth-child(3) { display: none; }
        .pass-grid { grid-template-columns: 1fr; }
        .letters-grid { grid-template-columns: 1fr; }
        .foot { grid-template-columns: 1fr; }
        .foot p:last-child { text-align: left; }
      }
      @media (max-width: 600px) {
        .hero { min-height: auto; }
        .hero-body { padding-block: 72px 40px; }
        .hero-bg { object-position: 40% 70%; }
        .hero-shade {
          background:
            radial-gradient(80% 40% at 80% 70%, rgba(125, 92, 255, 0.18), transparent 70%),
            linear-gradient(180deg, rgba(13, 11, 15, 0.78) 0%, rgba(13, 11, 15, 0.7) 45%, rgba(13, 11, 15, 0.45) 70%, rgba(13, 11, 15, 0.92) 100%);
        }
        .stats div { padding: 0 16px; }
        .stats dd { font-size: 22px; }
        .stats div:nth-child(4) { display: none; }
        .hero-card { max-width: none; }
        .tabs { width: 100%; }
        .tab { flex: 1; justify-content: center; padding: 0 8px; }
        .film { grid-template-columns: 76px minmax(0, 1fr) auto; gap: 14px; padding: 10px 14px 10px 10px; }
        .film img { width: 76px; height: 76px; grid-row: span 2; }
        .when { grid-column: 2 / 4; font-size: 10.5px; }
        .film-main { grid-column: 2; }
        .film-title { font-size: 16.5px; }
        .film-min { grid-column: 3; align-self: end; }
        .film-note { left: 8px; top: -8px; font-size: 8.5px; }
        .pass { padding: 22px; }
        .pass:has(input:checked) { padding: 21px; }
        .pass-price { font-size: 44px; }
        .field { flex-wrap: nowrap; }
      }
      @media (prefers-reduced-motion: reduce) {
        :global(html) { scroll-behavior: auto; }
        *, *::before { transition: none !important; }
      }
    </style>
  </body>
</html>
