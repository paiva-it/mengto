---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';
import { formula } from '../../components/skills/matterjs/formula';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sorrel No. 3 — Fourteen ingredients, weighed and dropped</title>
    <meta name="description" content="Silt & Sorrel's cleansing balm, shown as its own formula: fourteen ingredients sized by weight, falling into the tray." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="bar">
      <a class="brand" href="#top"><span class="dot" aria-hidden="true"></span>Silt &amp; Sorrel</a>
      <nav aria-label="Primary">
        <a href="#formula">Formula</a>
        <a href="#refill">Refills</a>
        <a href="#refill" class="pill-link">Order No. 3 — €34</a>
      </nav>
    </header>

    <main id="top">
      <section class="stage-wrap" aria-labelledby="h-hero">
        <div class="stage" id="stage">
          <canvas id="tray" role="img" aria-label="The fourteen ingredients of the Sorrel No. 3 cleansing balm, each shape sized by its share of the formula, falling and settling at the bottom of the tray. Drag them with a mouse or finger."></canvas>

          <div class="stage-copy">
            <p class="eyebrow">Sorrel No. 3 · Cleansing balm · Batch 07</p>
            <h1 id="h-hero">Fourteen ingredients.<br /><span class="soft">Weighed, then dropped.</span></h1>
            <p class="lede">Every shape in this tray is one thing in the jar, sized by how much of it we use. Sunflower oil does most of the work; green tea barely registers. Nothing else is in there — pick any of them up and check.</p>
          </div>

          <div class="controls" role="group" aria-label="Tray controls">
            <button type="button" id="btn-reset">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8a5 5 0 1 0 1.6-3.7M3 2.5v2.8h2.8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Drop again
            </button>
            <button type="button" id="btn-shake">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 9l3-4 3 6 3-6 3 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Shake<span class="wide">the tray</span>
            </button>
            <button type="button" id="btn-pause" aria-pressed="false">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.5v9M10.5 3.5v9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              <span>Pause</span>
            </button>
          </div>

          <p class="readout" id="readout" aria-live="polite">
            <span class="swatch" id="readout-swatch"></span>
            <span id="readout-text">Drag an ingredient to read it.</span>
          </p>

          <div class="corner" aria-hidden="true">
            <span>14 bodies</span><span>g = 1.0</span><span>e = 0.18</span>
          </div>
        </div>
      </section>

      <section class="formula" id="formula" aria-labelledby="h-formula">
        <div class="section-head">
          <p class="eyebrow">The full ledger</p>
          <h2 id="h-formula">What the shapes are, and what they do.</h2>
          <p>Percentages by weight, rounded to the tenth. Oils are circles, butters and clay are blocks, waxes are hexagons, extracts are capsules. The order in the tray is the order on the label.</p>
        </div>
        <ol class="ledger">
          {formula.map((f) => (
            <li>
              <span class="sw" style={`--c:${f.color}`} data-shape={f.shape}></span>
              <span class="name">{f.name}<small>{f.role}</small></span>
              <span class="pct">{f.pct.toFixed(1)}%</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="refill" id="refill" aria-labelledby="h-refill">
        <h2 id="h-refill" class="sr-only">How a jar is made</h2>
        <div class="fact">
          <p class="num">400</p>
          <p class="fact-title">jars per batch</p>
          <p>Poured by hand in Lisbon on Thursdays. Your lid carries the batch number and the date it set.</p>
        </div>
        <div class="fact">
          <p class="num">0</p>
          <p class="fact-title">water, so no preservative</p>
          <p>A balm with no water has nothing for bacteria to live in. That is the whole reason the list stops at fourteen.</p>
        </div>
        <div class="fact">
          <p class="num">3×</p>
          <p class="fact-title">refills per glass jar</p>
          <p>The refill arrives as a wax-paper puck. Drop it in the jar you already own; send the paper back in the same envelope.</p>
        </div>
      </section>
    </main>

    <footer class="foot">
      <span>Silt &amp; Sorrel — skincare with a short ingredient list.</span>
      <span class="mono">Physics: Matter.js 0.20 · custom canvas renderer</span>
    </footer>

    <BackPill />

    <script>
      import { mountTray } from '../../components/skills/matterjs/tray';
      mountTray(document.getElementById('stage') as HTMLElement);
    </script>

    <style is:global>
      :root {
        --bg: #ebe5d9;
        --panel: #f5f1e8;
        --ink: #22241e;
        --muted: #6c695e;
        --line: rgb(34 36 30 / 0.13);
        --sage: #7e9a62;
        --clay: #c8553d;
        --radius: 22px;
      }
      html { background: var(--bg); color: var(--ink); scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: 'Inter Tight', ui-sans-serif, system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        overflow-x: clip;
      }
      .mono, .eyebrow, .corner, .readout, .pct, .num + .fact-title { font-family: 'IBM Plex Mono', ui-monospace, monospace; }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      a, button { color: inherit; }
      :focus-visible { outline: 2px solid var(--clay); outline-offset: 3px; border-radius: 8px; }

      .bar {
        display: flex; align-items: center; justify-content: space-between; gap: 16px;
        height: 64px; padding: 0 28px;
      }
      .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 17px; letter-spacing: -0.01em; text-decoration: none; }
      .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--sage); box-shadow: 7px 0 0 -2px var(--clay); margin-right: 6px; }
      .bar nav { display: flex; align-items: center; gap: 26px; font-size: 14px; }
      .bar nav a { text-decoration: none; color: var(--muted); }
      .bar nav a:hover { color: var(--ink); }
      .bar nav .pill-link { color: var(--panel); background: var(--ink); padding: 9px 16px; border-radius: 999px; font-weight: 500; }
      .bar nav .pill-link:hover { color: #fff; background: #000; }

      .stage-wrap { padding: 0 16px; }
      .stage {
        position: relative;
        height: max(560px, calc(100svh - 64px - 16px));
        border-radius: var(--radius);
        background:
          radial-gradient(120% 70% at 85% 0%, rgb(126 154 98 / 0.16), transparent 60%),
          radial-gradient(90% 60% at 0% 100%, rgb(200 85 61 / 0.08), transparent 60%),
          var(--panel);
        border: 1px solid var(--line);
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.7), 0 1px 2px rgb(34 36 30 / 0.05), 0 24px 48px -28px rgb(34 36 30 / 0.25);
        overflow: hidden;
        isolation: isolate;
      }
      #tray { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; cursor: grab; }
      #tray.dragging { cursor: grabbing; }
      .stage-copy {
        position: relative; z-index: 1; pointer-events: none;
        display: grid; grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr); align-items: start; gap: 14px 48px;
        padding: 40px 40px 0;
      }
      .eyebrow { grid-column: 1 / -1; margin: 0; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
      h1 {
        margin: 0; font-weight: 600; letter-spacing: -0.045em; line-height: 0.95;
        font-size: clamp(42px, 5.6vw, 84px);
      }
      h1 .soft { color: var(--muted); font-weight: 500; }
      .lede { margin: 30px 0 0; justify-self: end; max-width: 34ch; color: var(--muted); font-size: 17px; }

      .controls { position: absolute; z-index: 2; right: 20px; bottom: 20px; display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
      .controls button {
        display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 16px;
        font: 500 14px/1 'Inter Tight', sans-serif; letter-spacing: -0.005em;
        border: 1px solid var(--line); border-radius: 999px; cursor: pointer;
        background: rgb(245 241 232 / 0.82); backdrop-filter: blur(10px);
        box-shadow: 0 1px 2px rgb(34 36 30 / 0.08);
      }
      .controls button:hover { background: #fff; }
      .controls svg { width: 16px; height: 16px; flex: none; }
      .controls button { white-space: nowrap; }
      .wide { margin-left: -4px; }
      #btn-reset { background: var(--ink); color: var(--panel); border-color: var(--ink); }
      #btn-reset:hover { background: #000; }

      .readout {
        position: absolute; z-index: 2; left: 20px; bottom: 20px; margin: 0;
        display: flex; align-items: center; gap: 10px; max-width: min(460px, calc(100% - 40px));
        padding: 10px 14px; font-size: 12px; line-height: 1.4; letter-spacing: 0.01em;
        background: rgb(245 241 232 / 0.82); backdrop-filter: blur(10px);
        border: 1px solid var(--line); border-radius: 14px; pointer-events: none;
      }
      .swatch { flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--muted); }
      .corner {
        position: absolute; z-index: 1; top: 44px; right: 40px; display: flex; gap: 16px;
        font-size: 11px; color: var(--muted); letter-spacing: 0.04em; pointer-events: none;
      }

      .formula { padding: 120px 28px 40px; max-width: 1280px; margin: 0 auto; }
      .section-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px 48px; align-items: end; margin-bottom: 48px; }
      .section-head h2 { margin: 0; font-size: clamp(32px, 4vw, 52px); font-weight: 600; letter-spacing: -0.035em; line-height: 1; }
      .section-head p:last-child { margin: 0; color: var(--muted); max-width: 52ch; }
      .ledger { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; column-gap: 48px; counter-reset: l; }
      .ledger li {
        display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; align-items: center; gap: 16px;
        padding: 16px 0; border-top: 1px solid var(--line);
      }
      .sw { width: 18px; height: 18px; background: var(--c); border-radius: 50%; box-shadow: inset 0 0 0 1px rgb(34 36 30 / 0.15); }
      .sw[data-shape='block'] { border-radius: 5px; }
      .sw[data-shape='capsule'] { height: 10px; border-radius: 6px; }
      .sw[data-shape='hex'] { border-radius: 0; clip-path: polygon(25% 5%, 75% 5%, 100% 50%, 75% 95%, 25% 95%, 0 50%); }
      .name { font-weight: 500; font-size: 17px; letter-spacing: -0.01em; }
      .name small { display: block; font-weight: 400; font-size: 14px; color: var(--muted); letter-spacing: 0; }
      .pct { font-size: 14px; color: var(--ink); font-variant-numeric: tabular-nums; }

      .refill {
        max-width: 1280px; margin: 0 auto; padding: 72px 28px 120px;
        display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px;
      }
      .fact { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; }
      .fact p { margin: 0; color: var(--muted); }
      .fact .num { font-size: 64px; font-weight: 600; letter-spacing: -0.05em; line-height: 1; color: var(--ink); }
      .fact .fact-title { margin: 10px 0 18px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink); }
      .foot { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 28px; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }

      @media (max-width: 860px) {
        .bar { padding: 0 16px; }
        .bar nav a:not(.pill-link) { display: none; }
        .stage { height: max(620px, calc(100svh - 64px - 12px)); }
        .stage-copy { grid-template-columns: minmax(0, 1fr); padding: 24px 22px 0; }
        h1 { font-size: clamp(38px, 11vw, 64px); }
        .lede { font-size: 15px; margin: 0; justify-self: start; max-width: 40ch; }
        .stage-copy .eyebrow { font-size: 11px; letter-spacing: 0.05em; }
        .wide { display: none; }
        .corner { display: none; }
        .controls { left: 12px; right: 12px; bottom: 12px; justify-content: stretch; }
        .controls button { flex: 1; justify-content: center; padding: 0 10px; font-size: 13px; }
        .readout { left: 12px; right: 12px; bottom: 62px; max-width: none; }
        .formula { padding: 80px 16px 24px; }
        .section-head { grid-template-columns: minmax(0, 1fr); }
        .ledger { grid-template-columns: minmax(0, 1fr); }
        .refill { grid-template-columns: minmax(0, 1fr); padding: 48px 16px 96px; }
      }
      @media (max-width: 420px) {
        #btn-shake svg, #btn-pause svg { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }
    </style>
  </body>
</html>
