---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

const nav = ['Studio', 'Process', 'Furnace log', 'Sessions'];

const stats = [
  ['1,148 °C', 'Furnace, holding'],
  ['04', 'Benches on the floor'],
  ['14 h', 'Annealing cycle'],
  ['3.1 %', 'Cobalt oxide by weight'],
];

const steps = [
  {
    no: '01',
    tag: 'Gather',
    temp: '1,148 °C',
    title: 'A honey-thick turn of glass.',
    body: 'The pipe dips into the crucible and rotates once, twice, until the gather reads the size of a plum. Too slow and it sags; too fast and it tears.',
  },
  {
    no: '02',
    tag: 'Marver',
    temp: '980 °C',
    title: 'Rolled flat on cold steel.',
    body: 'The steel table pulls heat from the skin of the gather and centres it. This is where the smalt frit goes on — crushed cobalt glass that becomes the blue.',
  },
  {
    no: '03',
    tag: 'Blow',
    temp: '1,260 °C',
    title: 'One breath, then the bench.',
    body: 'A short puff opens the bubble. The rest of the shape comes from jacks, wet newspaper and the glory hole, reheating every forty seconds.',
  },
  {
    no: '04',
    tag: 'Anneal',
    temp: '482 °C → 20 °C',
    title: 'Fourteen hours of waiting.',
    body: 'Every piece goes straight into the annealer and cools on a written curve. Skip it and the glass keeps its stress — and cracks on the shelf a week later.',
  },
];

const pieces = [
  { no: 'SM-217', name: 'Tidewater bottle', meta: 'Cobalt over clear · 31 cm', price: '€ 340' },
  { no: 'SM-221', name: 'Low weather bowl', meta: 'Smalt frit, cased · Ø 24 cm', price: '€ 260' },
  { no: 'SM-226', name: 'Night drop vase', meta: 'Steel-blue, optic mould · 22 cm', price: '€ 290' },
];

const sessions = [
  ['Paperweight hour', 'One gather, one colour pull, one solid sphere you collect after the anneal.', '90 min', '€ 95'],
  ['Two-day cup course', 'Pipe work, shaping and opening a lip. You leave with three cups and a ruined pair of jeans.', '2 days', '€ 420'],
  ['Bench rental', 'For blowers with a portfolio. Furnace, glory hole, annealer slot and an assistant on request.', 'per hour', '€ 60'],
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Smalt Hot Shop — cobalt glass, blown in Ghent</title>
    <meta name="description" content="Smalt Hot Shop, a cobalt-glass blowing studio, presented in a dark-blue mesh-gradient design system." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@200;300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="mesh-page">
    <!-- page rails -->
    <div class="page-rails" aria-hidden="true"><span></span><span></span></div>

    <header class="wrap hero-wrap">
      <section class="mesh-shell hero" aria-labelledby="hero-title">
        <canvas class="mesh-shell__field" data-dark-blue-mesh data-focus="hero" aria-hidden="true"></canvas>
        <span class="mesh-corner c-tl" aria-hidden="true"></span>
        <span class="mesh-corner c-tr" aria-hidden="true"></span>
        <span class="mesh-corner c-bl" aria-hidden="true"></span>
        <span class="mesh-corner c-br" aria-hidden="true"></span>

        <div class="mesh-shell__content hero__content">
          <div class="topbar">
            <a class="brand" href="#top" id="top">
              <span class="brand__mark" aria-hidden="true"></span>
              Smalt <span class="brand__sub">Hot Shop</span>
            </a>
            <nav class="mesh-nav" aria-label="Primary">
              {nav.map((item, i) => <a href={`#${item.toLowerCase().replace(' ', '-')}`} aria-current={i === 0 ? 'page' : undefined}>{item}</a>)}
            </nav>
            <a class="cta cta--small mesh-cta-secondary" href="#sessions">Book a bench</a>
          </div>

          <div class="hero__body">
            <p class="eyebrow reveal" style="--d: 0.05s"><span class="dot"></span>Ghent · Furnace lit since 2014</p>
            <h1 id="hero-title" class="hero__title">
              <span class="mask"><span class="reveal-line" style="--d: 0.12s">Cobalt glass,</span></span>
              <span class="mask"><span class="reveal-line" style="--d: 0.24s">blown at <em>1,148&nbsp;°C</em>,</span></span>
              <span class="mask"><span class="reveal-line" style="--d: 0.36s">then cooled for a day.</span></span>
            </h1>
            <p class="hero__copy reveal" style="--d: 0.5s">
              Smalt is a four-bench hot shop running one cobalt furnace around the clock. We make small runs of deep-blue vessels, teach the pipe to beginners, and publish every annealing curve we fire.
            </p>
            <div class="cta-row reveal" style="--d: 0.6s">
              <a class="cta mesh-cta-primary" href="#sessions">Book a hot-shop session</a>
              <a class="cta mesh-cta-secondary" href="#furnace-log">Read tonight's furnace log <span aria-hidden="true">→</span></a>
            </div>
          </div>

          <!-- floating network: furnace instruments -->
          <svg class="links" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <path d="M71 23 C 78 30, 80 38, 83 45" />
            <path d="M83 45 C 79 54, 72 60, 66 66" />
            <path d="M83 45 L 90 70" />
          </svg>
          <ul class="nodes" aria-label="Live instruments">
            <li class="mesh-node n1">Furnace <b>1,148 °C</b></li>
            <li class="mesh-node n2">Glory hole <b>1,260 °C</b></li>
            <li class="mesh-node n3 is-cool">Annealer <b>468 °C ↓</b></li>
            <li class="mesh-node n4">Bench 02 <b>in use</b></li>
          </ul>

          <dl class="hero__stats">
            {stats.map(([v, l], i) => (
              <div>
                <dt>{l}</dt>
                <dd>{v}</dd>
                <span class="num">0{i + 1}</span>
              </div>
            ))}
          </dl>
        </div>
      </section>
    </header>

    <main>
      <!-- Process -->
      <section class="wrap section" id="process" aria-labelledby="process-title">
        <div class="section__head">
          <p class="label"><span class="num">01</span> Process</p>
          <h2 id="process-title">Four temperatures between<br class="br-lg" /> sand and a shelf.</h2>
          <p class="section__lede">Every piece in the shop passes through the same four stations. The numbers are the ones the pyrometer reads, not the ones in the textbook.</p>
        </div>
        <ol class="steps frame">
          {steps.map((s) => (
            <li class="step">
              <div class="step__top">
                <span class="num">{s.no}</span>
                <span class="step__tag">{s.tag}</span>
              </div>
              <p class="step__temp">{s.temp}</p>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- Furnace log -->
      <section class="wrap section" id="furnace-log" aria-labelledby="log-title">
        <div class="log mesh-shell">
          <canvas class="mesh-shell__field log__field" data-dark-blue-mesh data-focus="log" aria-hidden="true"></canvas>
          <span class="mesh-corner c-tl" aria-hidden="true"></span>
          <span class="mesh-corner c-br" aria-hidden="true"></span>
          <div class="log__inner">
            <div class="log__copy">
              <p class="label"><span class="num">02</span> Furnace log</p>
              <h2 id="log-title">Tonight's anneal, in the open.</h2>
              <p class="section__lede">
                Load 0412 went in at 18:40: nine bottles, a bowl and two beginners' paperweights. The annealer soaks at 482 °C, then walks down on the curve below. Collect from 09:00.
              </p>
              <dl class="log__facts">
                <div><dt>Load</dt><dd>0412</dd></div>
                <div><dt>Pieces</dt><dd>12</dd></div>
                <div><dt>Now</dt><dd><span class="dot"></span>468 °C</dd></div>
                <div><dt>Ready</dt><dd>09:00</dd></div>
              </dl>
            </div>
            <figure class="chart" aria-labelledby="chart-cap">
              <svg viewBox="0 0 560 300" role="img" aria-label="Annealing curve: 482 °C soak for two hours, slow cool to 370 °C over six hours, then down to room temperature over six hours. Current point: hour 2.4 at 468 °C.">
                <defs>
                  <linearGradient id="curveFill" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#93c5fd" stop-opacity="0.28" />
                    <stop offset="1" stop-color="#93c5fd" stop-opacity="0" />
                  </linearGradient>
                </defs>
                <g class="grid">
                  {[0, 1, 2, 3, 4].map((i) => <line x1="40" x2="548" y1={20 + i * 60} y2={20 + i * 60} />)}
                  {[0, 2, 4, 6, 8, 10, 12, 14].map((h) => <line x1={40 + h * 36.3} x2={40 + h * 36.3} y1="20" y2="260" />)}
                </g>
                <g class="axis">
                  {['500', '375', '250', '125', '0'].map((t, i) => <text x="32" y={24 + i * 60} text-anchor="end">{t}</text>)}
                  {[0, 2, 4, 6, 8, 10, 12, 14].map((h) => <text x={40 + h * 36.3} y="282" text-anchor="middle">{h}h</text>)}
                </g>
                <path class="curve-fill" d="M40 260 L40 28.6 L112.6 28.6 L330.4 82.4 L548 258 L548 260 Z" fill="url(#curveFill)" />
                <path class="curve" d="M40 28.6 L112.6 28.6 L330.4 82.4 L548 258" />
                <path class="curve-done" d="M40 28.6 L112.6 28.6 L127.1 32.2" />
                <circle class="now-ring" cx="127.1" cy="32.2" r="9" />
                <circle class="now" cx="127.1" cy="32.2" r="4" />
                <text class="tag" x="48" y="54">482 °C soak · 2 h</text>
                <text class="tag" x="318" y="112" text-anchor="end">strain point 370 °C</text>
              </svg>
              <figcaption id="chart-cap"><span>°C over hours</span><span>Load 0412 · annealer B</span></figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- Pieces -->
      <section class="wrap section" id="studio" aria-labelledby="pieces-title">
        <div class="section__head section__head--row">
          <div>
            <p class="label"><span class="num">03</span> From the last firing</p>
            <h2 id="pieces-title">Three shapes, one blue.</h2>
          </div>
          <p class="section__lede">Small runs of eight to twelve. When a load is gone it is gone; the cobalt batch never mixes the same way twice.</p>
        </div>
        <div class="pieces">
          {pieces.map((p, i) => (
            <article class="piece frame">
              <div class="piece__stage">
                <span class="piece__no">{p.no}</span>
                <svg viewBox="0 0 200 240" aria-hidden="true">
                  <defs>
                    <linearGradient id={`g${i}`} x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0" stop-color="#dbeafe" stop-opacity="0.55" />
                      <stop offset="0.35" stop-color="#1d4ed8" stop-opacity="0.75" />
                      <stop offset="0.75" stop-color="#312e81" stop-opacity="0.85" />
                      <stop offset="1" stop-color="#030712" stop-opacity="0.9" />
                    </linearGradient>
                  </defs>
                  <ellipse class="shadow" cx="100" cy="226" rx={[44, 70, 40][i]} ry="5" />
                  {i === 0 && <path fill={`url(#g${i})`} class="vessel" d="M88 20 h24 v8 c0 6 -4 8 -4 16 c0 22 40 40 40 92 c0 52 -18 84 -48 84 c-30 0 -48 -32 -48 -84 c0 -52 40 -70 40 -92 c0 -8 -4 -10 -4 -16 z" />}
                  {i === 1 && <path fill={`url(#g${i})`} class="vessel" d="M22 120 h156 c0 54 -34 100 -78 100 c-44 0 -78 -46 -78 -100 z" />}
                  {i === 2 && <path fill={`url(#g${i})`} class="vessel" d="M92 34 h16 c2 22 50 70 50 124 c0 40 -26 62 -58 62 c-32 0 -58 -22 -58 -62 c0 -54 48 -102 50 -124 z" />}
                  {i === 0 && <path class="glint" d="M76 110 c-12 16 -16 40 -14 70" />}
                  {i === 1 && <path class="glint" d="M38 132 c4 30 18 52 40 66" />}
                  {i === 2 && <path class="glint" d="M70 120 c-14 22 -18 48 -12 72" />}
                </svg>
              </div>
              <div class="piece__meta">
                <div>
                  <h3>{p.name}</h3>
                  <p>{p.meta}</p>
                </div>
                <span class="piece__price">{p.price}</span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Sessions -->
      <section class="wrap section" id="sessions" aria-labelledby="sessions-title">
        <div class="section__head">
          <p class="label"><span class="num">04</span> Sessions</p>
          <h2 id="sessions-title">Pick up the pipe.</h2>
          <p class="section__lede">Thursdays to Sundays, two students per bench, closed-toe shoes and cotton only. Everything you make goes through the same anneal as ours.</p>
        </div>
        <ul class="sessions frame">
          {sessions.map(([name, body, unit, price], i) => (
            <li class="session">
              <span class="num">0{i + 1}</span>
              <div class="session__main">
                <h3>{name}</h3>
                <p>{body}</p>
              </div>
              <div class="session__price"><b>{price}</b><span>{unit}</span></div>
              <a class="cta cta--small mesh-cta-secondary" href="#book" aria-label={`Book ${name}`}>Book</a>
            </li>
          ))}
        </ul>
      </section>

      <!-- Closing shell -->
      <section class="wrap section section--last" id="book" aria-labelledby="book-title">
        <div class="mesh-shell closer">
          <canvas class="mesh-shell__field" data-dark-blue-mesh data-focus="closer" aria-hidden="true"></canvas>
          <span class="mesh-corner c-tl" aria-hidden="true"></span>
          <span class="mesh-corner c-tr" aria-hidden="true"></span>
          <span class="mesh-corner c-bl" aria-hidden="true"></span>
          <span class="mesh-corner c-br" aria-hidden="true"></span>
          <div class="closer__inner">
            <p class="eyebrow"><span class="dot"></span>Next open bench · Thursday 17:00</p>
            <h2 id="book-title">The furnace is already hot.</h2>
            <p class="section__lede">Write to us with a date and how many of you are coming. We reply within a day, usually from the bench.</p>
            <div class="cta-row">
              <a class="cta mesh-cta-primary" href="mailto:bench@smalt.example">bench@smalt.example</a>
              <a class="cta mesh-cta-secondary" href="#furnace-log">Visit the studio · Dok Noord 7</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="wrap footer">
      <span>© Smalt Hot Shop, Ghent</span>
      <span class="footer__mono">Furnace 1 · cobalt batch 0412 · 1,148 °C</span>
    </footer>

    <BackPill />

    <script>
      const VERT = `attribute vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }`;
      const FRAG = `
        precision highp float;
        uniform vec2 r; uniform float t; uniform vec2 focus;
        float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
        float noise(vec2 p){
          vec2 i = floor(p), f = fract(p); vec2 u = f * f * (3.0 - 2.0 * f);
          return mix(mix(hash(i), hash(i + vec2(1, 0)), u.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), u.x), u.y);
        }
        float fbm(vec2 p){
          float v = 0.0, a = 0.5;
          for (int i = 0; i < 5; i++){ v += a * noise(p); p = p * 2.03 + vec2(1.7, 9.2); a *= 0.5; }
          return v;
        }
        void main(){
          vec2 uv = gl_FragCoord.xy / r;
          vec2 p = (gl_FragCoord.xy - 0.5 * r) / r.y;
          float T = t * 0.035;
          vec2 q = vec2(fbm(p * 1.2 + T), fbm(p * 1.2 + vec2(5.2, 1.3) - T));
          vec2 w = vec2(fbm(p * 1.5 + 2.2 * q + vec2(1.7, 9.2) + T * 0.7), fbm(p * 1.5 + 2.2 * q + vec2(8.3, 2.8) - T * 0.6));
          float f = fbm(p * 1.3 + 2.6 * w);

          vec3 bg = vec3(0.012, 0.027, 0.071);
          vec3 navy = vec3(0.027, 0.067, 0.122);
          vec3 cobalt = vec3(0.114, 0.306, 0.847);
          vec3 indigo = vec3(0.192, 0.180, 0.506);
          vec3 steel = vec3(0.220, 0.353, 0.486);
          vec3 ice = vec3(0.859, 0.918, 0.996);

          vec3 c = mix(bg, navy, smoothstep(0.3, 0.62, f));
          c = mix(c, indigo, smoothstep(0.5, 1.0, length(q)) * 0.5);
          c = mix(c, cobalt, smoothstep(0.52, 0.85, f) * 0.95);
          c = mix(c, steel, smoothstep(0.45, 1.0, w.y) * 0.35);
          c += ice * pow(smoothstep(0.6, 0.95, f), 3.0) * 0.45;

          // contour mesh: thin iso-lines through the field
          float band = abs(fract(f * 10.0) - 0.5);
          c += ice * smoothstep(0.05, 0.0, band) * 0.07 * smoothstep(0.35, 0.75, f);

          // light pools around the focus, copy side stays dark
          float d = length(p - focus);
          c *= 0.25 + 0.95 * smoothstep(1.35, 0.1, d);

          // sparse horizontal scan streak
          float scan = smoothstep(0.004, 0.0, abs(uv.y - fract(t * 0.03))) * 0.07;
          c += vec3(0.75, 0.85, 1.0) * scan;
          c += (hash(gl_FragCoord.xy + fract(t)) - 0.5) * 0.018;
          gl_FragColor = vec4(c, 1.0);
        }`;

      const FOCUS: Record<string, [number, number]> = { hero: [0.45, 0.12], log: [0.55, -0.05], closer: [0.0, 0.2] };
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Skill fallback: 2D radial-gradient mesh when WebGL is unavailable.
      const init2D = (canvas: HTMLCanvasElement) => {
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        const points = [
          { x: 0.18, y: 0.3, r: 0.45, color: 'rgba(29, 78, 216, 0.55)' },
          { x: 0.68, y: 0.22, r: 0.38, color: 'rgba(49, 46, 129, 0.58)' },
          { x: 0.78, y: 0.72, r: 0.52, color: 'rgba(56, 90, 124, 0.48)' },
          { x: 0.42, y: 0.58, r: 0.34, color: 'rgba(219, 234, 254, 0.18)' },
        ];
        const draw = (time = 0) => {
          const w = (canvas.width = canvas.clientWidth);
          const h = (canvas.height = canvas.clientHeight);
          ctx.fillStyle = '#030712';
          ctx.fillRect(0, 0, w, h);
          ctx.globalCompositeOperation = 'screen';
          points.forEach((pt, i) => {
            const x = pt.x * w + (reduceMotion ? 0 : Math.sin(time * 0.00018 + i) * 24);
            const y = pt.y * h + (reduceMotion ? 0 : Math.cos(time * 0.00016 + i) * 18);
            const g = ctx.createRadialGradient(x, y, 0, x, y, Math.max(w, h) * pt.r);
            g.addColorStop(0, pt.color);
            g.addColorStop(1, 'rgba(3, 7, 18, 0)');
            ctx.fillStyle = g;
            ctx.fillRect(0, 0, w, h);
          });
          ctx.globalCompositeOperation = 'source-over';
          if (!reduceMotion) requestAnimationFrame(draw);
        };
        draw();
      };

      const initGL = (canvas: HTMLCanvasElement) => {
        const gl = canvas.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'low-power' });
        if (!gl) return false;
        const sh = (type: number, src: string) => {
          const s = gl.createShader(type)!;
          gl.shaderSource(s, src);
          gl.compileShader(s);
          return s;
        };
        const prog = gl.createProgram()!;
        gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT));
        gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG));
        gl.linkProgram(prog);
        if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return false;
        gl.useProgram(prog);
        gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
        gl.enableVertexAttribArray(0);
        gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
        const uR = gl.getUniformLocation(prog, 'r');
        const uT = gl.getUniformLocation(prog, 't');
        gl.uniform2fv(gl.getUniformLocation(prog, 'focus'), FOCUS[canvas.dataset.focus ?? 'hero']);

        // ponytail: the field is soft, so render at half resolution and let CSS upscale.
        const SCALE = 0.5;
        const resize = () => {
          canvas.width = Math.max(1, Math.round(canvas.clientWidth * SCALE));
          canvas.height = Math.max(1, Math.round(canvas.clientHeight * SCALE));
          gl.viewport(0, 0, canvas.width, canvas.height);
          gl.uniform2f(uR, canvas.width, canvas.height);
        };
        const t0 = performance.now() - 40000; // start mid-drift so the first frame is already composed
        let visible = true;
        let raf = 0;
        const frame = (now: number) => {
          gl.uniform1f(uT, (now - t0) / 1000);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
          if (!reduceMotion && visible) raf = requestAnimationFrame(frame);
        };
        resize();
        frame(performance.now());
        new ResizeObserver(() => {
          resize();
          if (reduceMotion) frame(performance.now());
        }).observe(canvas);
        new IntersectionObserver(([e]) => {
          visible = e.isIntersecting;
          cancelAnimationFrame(raf);
          if (visible && !reduceMotion) raf = requestAnimationFrame(frame);
        }).observe(canvas);
        return true;
      };

      document.querySelectorAll<HTMLCanvasElement>('[data-dark-blue-mesh]').forEach((c) => {
        if (!initGL(c)) init2D(c);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --mesh-bg: #030712;
    --mesh-bg-blue: #07111f;
    --mesh-shell: rgba(7, 13, 25, 0.82);
    --mesh-shell-inner: rgba(4, 9, 18, 0.72);
    --mesh-line: rgba(191, 219, 254, 0.14);
    --mesh-line-strong: rgba(226, 232, 240, 0.28);
    --mesh-text: #f8fafc;
    --mesh-copy: #9fb2ca;
    --mesh-muted: #64748b;
    --mesh-accent: #dbeafe;
    --mesh-cobalt: #1d4ed8;
    --mesh-indigo: #312e81;
    --mesh-steel: #385a7c;
    --sans: 'Inter Tight', ui-sans-serif, system-ui, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
  }
  html { scroll-behavior: smooth; background: var(--mesh-bg); }
  body.mesh-page {
    margin: 0;
    min-height: 100vh;
    font-family: var(--sans);
    color: var(--mesh-text);
    background:
      radial-gradient(circle at 50% 0%, rgba(29, 78, 216, 0.18), transparent 34rem),
      linear-gradient(180deg, var(--mesh-bg-blue), var(--mesh-bg) 48%, #01030a);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  .mesh-page ::selection { color: #020617; background: var(--mesh-accent); }
</style>

<style>
  .wrap { width: min(1360px, calc(100% - 32px)); margin-inline: auto; position: relative; }
  .page-rails { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
  .page-rails span {
    position: absolute; top: 0; bottom: 0; width: 1px;
    background: linear-gradient(180deg, transparent, var(--mesh-line), transparent);
  }
  .page-rails span:first-child { left: max(8px, calc(50% - 696px)); }
  .page-rails span:last-child { right: max(8px, calc(50% - 696px)); }
  main, header, footer { position: relative; z-index: 1; }

  /* ---------- shell ---------- */
  .mesh-shell {
    position: relative; overflow: hidden;
    border: 1px solid transparent; border-radius: 32px;
    background:
      linear-gradient(var(--mesh-shell), var(--mesh-shell)) padding-box,
      linear-gradient(145deg, rgba(255, 255, 255, 0.46), rgba(147, 197, 253, 0.18), rgba(255, 255, 255, 0.04)) border-box;
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }
  .mesh-shell__field { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.9; pointer-events: none; }
  .mesh-shell__content {
    position: relative; z-index: 2;
    min-height: clamp(560px, 72vh, 820px);
    padding: clamp(20px, 4vw, 56px);
  }
  .mesh-corner { position: absolute; z-index: 3; width: 6px; height: 6px; background: var(--mesh-line-strong); }
  .c-tl { top: 18px; left: 18px; } .c-tr { top: 18px; right: 18px; }
  .c-bl { bottom: 18px; left: 18px; } .c-br { bottom: 18px; right: 18px; }

  .hero-wrap { padding-top: 16px; }
  .hero__content {
    min-height: max(640px, calc(100vh - 32px));
    display: grid; grid-template-rows: auto 1fr auto; gap: 32px;
    background: linear-gradient(90deg, rgba(3, 7, 18, 0.72) 0%, rgba(3, 7, 18, 0.35) 45%, rgba(3, 7, 18, 0) 70%);
  }

  /* ---------- nav ---------- */
  .topbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--mesh-text); text-decoration: none; font-weight: 600; letter-spacing: -0.01em; font-size: 17px; }
  .brand__sub { font-weight: 300; color: var(--mesh-copy); }
  .brand__mark {
    width: 22px; height: 22px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #dbeafe, #1d4ed8 45%, #312e81 75%, #030712);
    box-shadow: 0 0 22px rgba(96, 165, 250, 0.45), inset 0 0 0 1px rgba(255, 255, 255, 0.25);
  }
  .mesh-nav {
    display: flex; align-items: center; gap: 6px; width: fit-content; padding: 6px;
    border: 1px solid transparent; border-radius: 999px;
    background:
      linear-gradient(rgba(5, 12, 24, 0.76), rgba(5, 12, 24, 0.76)) padding-box,
      linear-gradient(120deg, rgba(255, 255, 255, 0.28), rgba(96, 165, 250, 0.16), rgba(255, 255, 255, 0.04)) border-box;
    backdrop-filter: blur(18px);
  }
  .mesh-nav a { color: var(--mesh-copy); border-radius: 999px; padding: 9px 14px; text-decoration: none; font-size: 14px; transition: color 0.3s, background 0.3s; }
  .mesh-nav a:hover, .mesh-nav a[aria-current='page'] { color: var(--mesh-text); background: rgba(255, 255, 255, 0.08); }

  /* ---------- CTAs ---------- */
  .cta {
    display: inline-flex; align-items: center; gap: 8px; border-radius: 999px;
    padding: 14px 22px; font-size: 15px; font-weight: 500; text-decoration: none; white-space: nowrap;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .cta:hover { transform: translateY(-1px); }
  .cta:focus-visible, .mesh-nav a:focus-visible, .brand:focus-visible { outline: 2px solid #93c5fd; outline-offset: 3px; }
  .cta--small { padding: 9px 16px; font-size: 14px; }
  .mesh-cta-primary { color: #020617; background: #f8fafc; box-shadow: 0 16px 36px rgba(219, 234, 254, 0.18); }
  .mesh-cta-secondary {
    color: var(--mesh-text); border: 1px solid transparent;
    background:
      linear-gradient(rgba(5, 12, 24, 0.62), rgba(5, 12, 24, 0.62)) padding-box,
      linear-gradient(135deg, rgba(255, 255, 255, 0.28), rgba(96, 165, 250, 0.12), rgba(255, 255, 255, 0.04)) border-box;
    backdrop-filter: blur(12px);
  }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; }

  /* ---------- hero copy ---------- */
  .hero__body { align-self: center; max-width: 820px; display: grid; gap: 24px; padding-top: 24px; }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 10px; margin: 0;
    font: 500 12px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--mesh-copy);
  }
  .dot {
    display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #bfdbfe;
    box-shadow: 0 0 14px rgba(147, 197, 253, 0.8); animation: pulse 3.2s ease-in-out infinite;
  }
  .hero__title {
    margin: 0; font-weight: 300; letter-spacing: -0.035em;
    font-size: clamp(42px, 6vw, 88px); line-height: 0.98;
  }
  .hero__title em { font-style: normal; font-weight: 500; color: var(--mesh-accent); }
  .mask { display: block; overflow: hidden; padding-bottom: 0.06em; }
  @media (min-width: 821px) { .mask { white-space: nowrap; } }
  .reveal-line { display: block; animation: rise 1.1s cubic-bezier(0.2, 0.7, 0.1, 1) var(--d, 0s) both; }
  .reveal { animation: fade 1s ease var(--d, 0s) both; }
  .hero__copy { margin: 0; max-width: 520px; font-size: clamp(16px, 1.25vw, 18px); line-height: 1.6; color: var(--mesh-copy); font-weight: 400; }

  /* ---------- nodes ---------- */
  .links { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; }
  .links path { fill: none; stroke: rgba(191, 219, 254, 0.28); stroke-width: 1; vector-effect: non-scaling-stroke; stroke-dasharray: 3 5; animation: dash 18s linear infinite; }
  .nodes { list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  .mesh-node {
    position: absolute; display: inline-flex; align-items: center; gap: 8px;
    border: 1px solid rgba(191, 219, 254, 0.18); border-radius: 999px; padding: 7px 12px;
    color: var(--mesh-copy); background: rgba(5, 12, 24, 0.58); backdrop-filter: blur(14px);
    font: 400 12px/1 var(--mono); white-space: nowrap;
    transform: translate(-50%, -50%);
    animation: fade 1s ease 0.9s both;
  }
  .mesh-node b { color: var(--mesh-text); font-weight: 500; }
  .mesh-node::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%; background: #bfdbfe;
    box-shadow: 0 0 18px rgba(147, 197, 253, 0.72); animation: pulse 4s ease-in-out infinite;
  }
  .mesh-node.is-cool::before { background: #818cf8; box-shadow: 0 0 18px rgba(129, 140, 248, 0.7); }
  .n1 { left: 71%; top: 23%; } .n2 { left: 83%; top: 45%; }
  .n3 { left: 66%; top: 66%; animation-delay: 1.05s; } .n4 { left: 90%; top: 70%; animation-delay: 1.2s; }
  .n2::before { animation-delay: 1.3s; } .n3::before { animation-delay: 2.1s; }

  .hero__stats {
    margin: 0; display: grid; grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--mesh-line); position: relative; z-index: 2;
  }
  .hero__stats > div { position: relative; padding: 20px 20px 4px 0; display: grid; gap: 6px; }
  .hero__stats > div + div { padding-left: 20px; border-left: 1px solid var(--mesh-line); }
  .hero__stats dt { font-size: 13px; color: var(--mesh-copy); order: 2; }
  .hero__stats dd { margin: 0; font-size: clamp(22px, 2.2vw, 30px); font-weight: 300; letter-spacing: -0.02em; order: 1; }
  .hero__stats .num { position: absolute; top: 20px; right: 16px; }

  .num { font: 500 11px/1 var(--mono); color: var(--mesh-muted); letter-spacing: 0.06em; }

  /* ---------- sections ---------- */
  .section { padding-block: clamp(72px, 10vw, 128px) 0; }
  .section--last { padding-bottom: 48px; }
  .section__head { display: grid; gap: 18px; max-width: 720px; margin-bottom: 40px; }
  .section__head--row { max-width: none; grid-template-columns: 1fr minmax(0, 420px); align-items: end; gap: 32px; }
  .label {
    margin: 0; display: inline-flex; gap: 12px; align-items: center;
    font: 500 12px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--mesh-copy);
  }
  .label .num { padding: 5px 7px; border: 1px solid var(--mesh-line); border-radius: 6px; }
  h2 { margin: 0; font-weight: 300; letter-spacing: -0.03em; font-size: clamp(32px, 4vw, 56px); line-height: 1.04; }
  h3 { margin: 0; font-weight: 500; letter-spacing: -0.015em; font-size: 19px; }
  .section__lede { margin: 0; color: var(--mesh-copy); font-size: 16px; line-height: 1.65; max-width: 560px; }

  .frame {
    position: relative; border: 1px solid var(--mesh-line); border-radius: 24px;
    background: linear-gradient(180deg, rgba(10, 20, 38, 0.6), rgba(4, 9, 18, 0.5));
  }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); }
  .step { padding: 28px 26px 32px; display: grid; gap: 14px; align-content: start; }
  .step + .step { border-left: 1px solid var(--mesh-line); }
  .step__top { display: flex; justify-content: space-between; align-items: center; }
  .step__tag { font: 500 11px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--mesh-accent); }
  .step__temp { margin: 18px 0 4px; font-size: 30px; font-weight: 200; letter-spacing: -0.02em; color: var(--mesh-text); }
  .step p:last-child { margin: 0; color: var(--mesh-copy); font-size: 14.5px; line-height: 1.6; }

  /* ---------- furnace log ---------- */
  .log__field { opacity: 0.75; }
  .log__inner {
    position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(28px, 4vw, 64px); padding: clamp(36px, 4.5vw, 64px) clamp(22px, 4.5vw, 64px); align-items: center;
    background: linear-gradient(90deg, rgba(3, 7, 18, 0.7), rgba(3, 7, 18, 0.2));
  }
  .log__copy { display: grid; gap: 20px; }
  .log__facts { margin: 8px 0 0; display: grid; grid-template-columns: repeat(4, auto); justify-content: start; gap: 0; border: 1px solid var(--mesh-line); border-radius: 14px; overflow: hidden; width: fit-content; max-width: 100%; }
  .log__facts > div { padding: 12px 16px; display: grid; gap: 6px; background: rgba(5, 12, 24, 0.5); }
  .log__facts > div + div { border-left: 1px solid var(--mesh-line); }
  .log__facts dt { font: 500 10px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--mesh-muted); }
  .log__facts dd { margin: 0; font-size: 17px; display: inline-flex; gap: 8px; align-items: center; }
  .chart {
    margin: 0; padding: 18px 18px 14px; border-radius: 20px; border: 1px solid var(--mesh-line);
    background: rgba(4, 9, 18, 0.62); backdrop-filter: blur(16px);
  }
  .chart svg { display: block; width: 100%; height: auto; }
  .chart .grid line { stroke: rgba(191, 219, 254, 0.07); }
  .chart .axis text, .chart .tag { font: 400 11px var(--mono); fill: var(--mesh-muted); }
  .chart .tag { fill: var(--mesh-copy); }
  .curve { fill: none; stroke: rgba(219, 234, 254, 0.45); stroke-width: 1.5; stroke-dasharray: 4 4; }
  .curve-done { fill: none; stroke: #f8fafc; stroke-width: 2; }
  .now { fill: #f8fafc; }
  .now-ring { fill: none; stroke: rgba(147, 197, 253, 0.7); animation: ring 2.6s ease-out infinite; transform-origin: 127.1px 32.2px; }
  .chart figcaption { display: flex; justify-content: space-between; margin-top: 10px; font: 400 11px var(--mono); color: var(--mesh-muted); letter-spacing: 0.04em; }

  /* ---------- pieces ---------- */
  .pieces { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .piece { overflow: hidden; }
  .piece__stage {
    position: relative; aspect-ratio: 4 / 3.6; display: grid; place-items: center;
    background:
      radial-gradient(60% 55% at 50% 45%, rgba(29, 78, 216, 0.22), transparent 70%),
      linear-gradient(180deg, rgba(7, 17, 31, 0.9), rgba(3, 7, 18, 0.9));
    border-bottom: 1px solid var(--mesh-line);
  }
  .piece__stage svg { width: 52%; height: auto; transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.1, 1); }
  .piece:hover .piece__stage svg { transform: translateY(-6px); }
  .vessel { stroke: rgba(219, 234, 254, 0.35); stroke-width: 1; }
  .glint { fill: none; stroke: rgba(248, 250, 252, 0.55); stroke-width: 3; stroke-linecap: round; }
  .shadow { fill: rgba(29, 78, 216, 0.25); filter: blur(4px); }
  .piece__no { position: absolute; top: 16px; left: 18px; font: 500 11px/1 var(--mono); color: var(--mesh-muted); letter-spacing: 0.06em; }
  .piece__meta { display: flex; justify-content: space-between; gap: 16px; align-items: end; padding: 20px 22px 22px; }
  .piece__meta p { margin: 6px 0 0; color: var(--mesh-copy); font-size: 14px; }
  .piece__price { font: 500 13px/1 var(--mono); color: var(--mesh-text); white-space: nowrap; }

  /* ---------- sessions ---------- */
  .sessions { list-style: none; margin: 0; padding: 0; }
  .session { display: grid; grid-template-columns: 48px minmax(0, 1fr) 120px auto; gap: 24px; align-items: center; padding: 26px 28px; }
  .session + .session { border-top: 1px solid var(--mesh-line); }
  .session__main p { margin: 6px 0 0; color: var(--mesh-copy); font-size: 14.5px; line-height: 1.55; max-width: 560px; }
  .session__price { display: grid; gap: 4px; text-align: right; }
  .session__price b { font-weight: 300; font-size: 26px; letter-spacing: -0.02em; }
  .session__price span { font: 400 11px/1 var(--mono); color: var(--mesh-muted); text-transform: uppercase; letter-spacing: 0.06em; }

  /* ---------- closer ---------- */
  .closer__inner {
    position: relative; z-index: 2; display: grid; gap: 22px; justify-items: center; text-align: center;
    padding: clamp(56px, 9vw, 120px) clamp(20px, 5vw, 64px);
    background: radial-gradient(70% 80% at 50% 50%, rgba(3, 7, 18, 0.55), rgba(3, 7, 18, 0.1));
  }
  .closer__inner .cta-row { justify-content: center; }
  .closer__inner .section__lede { max-width: 460px; }

  .footer { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 24px 4px 72px; color: var(--mesh-muted); font-size: 13px; border-top: 1px solid var(--mesh-line); margin-top: 24px; }
  .footer__mono { font-family: var(--mono); font-size: 11px; letter-spacing: 0.05em; }

  /* ---------- motion ---------- */
  @keyframes rise { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .mesh-node { animation-name: nodeIn; }
  @keyframes nodeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.45; } }
  @keyframes dash { to { stroke-dashoffset: -160; } }
  @keyframes ring { 0% { opacity: 0.9; transform: scale(0.5); } 100% { opacity: 0; transform: scale(1.6); } }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
    html { scroll-behavior: auto; }
  }

  /* ---------- responsive ---------- */
  @media (max-width: 1100px) {
    .mesh-nav { display: none; }
    .steps { grid-template-columns: repeat(2, 1fr); }
    .step:nth-child(3) { border-left: 0; }
    .step:nth-child(n + 3) { border-top: 1px solid var(--mesh-line); }
    .log__inner { grid-template-columns: 1fr; }
    .n1 { left: 74%; top: 20%; }
  }
  @media (max-width: 820px) {
    .links, .n3, .n4 { display: none; }
    .nodes { position: static; display: flex; flex-wrap: wrap; gap: 8px; }
    .mesh-node { position: static; transform: none; }
    .hero__content {
      grid-template-rows: auto 1fr auto auto; min-height: max(600px, calc(100svh - 32px));
      background: linear-gradient(180deg, rgba(3, 7, 18, 0.15), rgba(3, 7, 18, 0.65));
    }
    .hero__stats { grid-template-columns: repeat(2, 1fr); }
    .hero__stats > div:nth-child(3) { border-left: 0; padding-left: 0; }
    .hero__stats > div:nth-child(n + 3) { border-top: 1px solid var(--mesh-line); }
    .hero__stats > div { padding-bottom: 16px; }
    .section__head--row { grid-template-columns: 1fr; }
    .pieces { grid-template-columns: 1fr; }
    .session { grid-template-columns: 1fr auto; gap: 14px 16px; padding: 22px 20px; }
    .session > .num { grid-column: 1 / -1; }
    .session__main { grid-column: 1 / -1; }
    .session__price { text-align: left; }
    .br-lg { display: none; }
  }
  @media (max-width: 560px) {
    .steps { grid-template-columns: 1fr; }
    .step + .step { border-left: 0; border-top: 1px solid var(--mesh-line); }
    .hero__content { padding: 20px; }
    .hero__body { padding-top: 8px; gap: 20px; }
    .cta-row .cta { flex: 1 1 100%; justify-content: center; }
    .log__facts { grid-template-columns: repeat(2, auto); }
    .log__facts > div:nth-child(3) { border-left: 0; }
    .log__facts > div:nth-child(n + 3) { border-top: 1px solid var(--mesh-line); }
    .mesh-shell { border-radius: 24px; }
    .chart { padding: 12px 10px 10px; }
    .chart .axis text, .chart .tag { font-size: 15px; }
    .chart svg { overflow: visible; }
    .chart { padding: 12px 18px 10px 14px; }
  }
</style>
