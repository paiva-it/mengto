  .fld input[aria-invalid='true'], .fld select[aria-invalid='true'] { border-color: var(--bad); }
  .err { font-style: normal; font-size: 12px; color: var(--bad); min-height: 0; }
  .check { display: flex; gap: 10px; align-items: flex-start; font-size: 13.5px; line-height: 1.45; color: #b9b6b0; cursor: pointer; }
  .check input { margin-top: 3px; accent-color: var(--sig); }
  .dim { color: var(--mute-d); }
  .ctx { padding: 12px; border: 1px solid var(--hair); background: var(--ink); }
  .f-foot { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; padding: 16px 20px 20px; border-top: 1px solid var(--hair); }
  .f-msg { font-size: 14px; line-height: 1.45; flex: 1 1 220px; }
  .f-msg[data-tone='ok'] { color: var(--ok); } .f-msg[data-tone='bad'] { color: var(--bad); } .f-msg[data-tone='warn'] { color: var(--warn); }

  .foot { border-top: 1px solid var(--hair); }
  .foot-in { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-top: 24px; padding-bottom: 72px; color: var(--mute-d); text-transform: none; letter-spacing: .02em; }

  /* reveals */
  .js .reveal { opacity: 0; transform: translateY(14px); transition: opacity .6s var(--e), transform .6s var(--e); }
  .js .reveal.in { opacity: 1; transform: none; }

  @media (max-width: 1080px) {
    .hero-in { grid-template-columns: 1fr; min-height: 0; max-height: none; gap: 48px; }
    .nav { display: none; }
    .m-grid { grid-template-columns: 1fr 1fr; }
    .m:nth-child(3) { padding-left: 0; border-left: 0; }
    .m:nth-child(n+3) { border-top: 1px solid var(--paper-line); }
    .row-btn { grid-template-columns: 40px minmax(0, 1fr) 80px; }
    .row-lede { grid-column: 2; grid-row: 2; }
    .row-tog { grid-column: 3; grid-row: 1; }
    .row-panel { padding-left: 0; }
    .spec { grid-template-columns: 1fr 1fr; }
    .spec .cell:nth-child(n) { border-right: 1px solid var(--paper-line); border-bottom: 1px solid var(--paper-line); }
    .spec .cell:nth-child(2n) { border-right: 0; }
    .spec .cell:nth-child(n+7) { border-bottom: 0; }
    .case-list, .faq-in, .cta-in { grid-template-columns: 1fr; }
    .sec-head.split { grid-template-columns: 1fr; gap: 20px; }
    .filters { justify-self: start; }
    .demo-grid { grid-template-columns: 1fr; }
    .demo-side { border-right: 0; border-bottom: 1px solid var(--hair-2); }
    .states { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .wrap { padding: 0 16px; }
    .hdr .btn-line { font-size: 10.5px; padding: 0 10px; }
    .hero-in { padding-top: 40px; padding-bottom: 48px; }
    .hero .lede { font-size: 16px; }
    .trace { padding: 16px; }
    .trace-top { flex-direction: column; gap: 4px; }
    .step { grid-template-columns: 64px minmax(0, 1fr); padding-right: 20px; }
    .step .k { grid-column: 2; }
    .step .h { grid-column: 1 / -1; grid-row: 2; margin-top: 6px; }
    .step .d { grid-column: 1 / -1; grid-row: 3; }
    .gate-top, .load-head { flex-direction: column; gap: 4px; }
    .trace-stats b { font-size: 19px; }
    .trace-stats div + div { padding-left: 10px; }
    .metrics, .cases, .faq { padding: 72px 0; }
    .solutions { padding-bottom: 72px; }
    .demo { padding: 72px 0; }
    .security { padding-bottom: 72px; }
    .m-grid { grid-template-columns: 1fr; }
    .m + .m { padding-left: 0; border-left: 0; border-top: 1px solid var(--paper-line); }
    .row-btn { grid-template-columns: 32px minmax(0, 1fr) 24px; gap: 12px; }
    .row-tog span { display: none !important; }
    .row-title { font-size: 19px; }
    .spec { grid-template-columns: 1fr; }
    .spec .cell:nth-child(n) { border-right: 0; border-bottom: 1px solid var(--paper-line); }
    .spec .cell:last-child { border-bottom: 0; }
    .state-btn { font-size: 13px; padding: 8px 8px; align-items: flex-start; }
    .state-btn .tone-dot { margin-top: 6px; }
    .console-top { flex-direction: column; gap: 4px; padding: 12px 16px; }
    .console-body { padding: 22px 16px; }
    .c-cols { grid-template-columns: 1fr; }
    .c-log { padding: 12px 16px; }
    .risk-row { grid-template-columns: 1fr; gap: 8px; }
    .risk-row.head { display: none; }
    .case-body { grid-template-columns: 1fr; }
    .case-head, .case-body { padding: 18px 16px; }
    .after div { grid-template-columns: 1fr; gap: 4px; }
    .f-grid { grid-template-columns: 1fr; padding: 16px; }
    .form-top { flex-direction: column; gap: 4px; }
    .faq details p { padding-right: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .oe *, .oe *::before, .oe *::after { transition: none !important; animation: none !important; }
  }
</style>

<script>
  type Tone = 'sig' | 'ok' | 'warn' | 'bad' | 'mute';
  type Act = { label: string; to: string; kind?: 'solid' | 'ghost'; needsBm?: boolean };
  type State = { pill: string; tone: Tone; title: string; body: string; did: string[]; didNot: string[]; actions: Act[]; loading?: boolean };

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.documentElement.classList.add('js');

  /* ---------- hero trace: settles step by step, then holds at the gate ---------- */
  const trace = document.getElementById('trace')!;
  const seq = [...trace.querySelectorAll<HTMLElement>('.step'), trace.querySelector<HTMLElement>('.gate')!];
  const settleTrace = () => { seq.forEach((el) => el.classList.add('on')); trace.classList.add('drawn'); };
  if (reduce) settleTrace();
  else {
    seq.forEach((el, i) => setTimeout(() => el.classList.add('on'), 250 + i * 420));
    setTimeout(() => trace.classList.add('drawn'), 250 + seq.length * 420);
  }

  /* ---------- section reveals ---------- */
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('.reveal').forEach((el, i) => {
    if (reduce) el.classList.add('in');
    else { (el as HTMLElement).style.transitionDelay = `${(i % 4) * 70}ms`; io.observe(el); }
  });
  addEventListener('pagehide', () => io.disconnect());

  /* ---------- solution rows (button + region: Enter and Space come free) ---------- */
  document.querySelectorAll<HTMLButtonElement>('.row-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      document.getElementById(btn.getAttribute('aria-controls')!)!.hidden = open;
    });
  });

  /* ---------- product demo: deterministic state machine ---------- */
  const S: Record<string, State> = {
    pending: { pill: 'Awaiting approval', tone: 'sig', title: 'Cast change ready for your review',
      body: 'L. Varga to dance Myrtha on Thursday and Saturday. Four checks passed; the call sheet and six notices are drafted and held.',
      did: ['Read the physio rest flag (ref PX-2291)', 'Checked hours: 25.5 of 30 h if approved', 'Drafted call sheet v14 and six notices'],
      didNot: ['Send anything to dancers', 'Read the physio note itself', 'Change the casting grid'],
      actions: [{ label: 'Approve and release', to: 'released', kind: 'solid', needsBm: true }, { label: 'Deny', to: 'denied', kind: 'ghost', needsBm: true }] },
    loading: { pill: 'Loading', tone: 'warn', title: 'Fetching the latest calendar', body: 'Reading rehearsal bookings and the casting grid before drafting. Approval is disabled until the data is current.',
      did: [], didNot: [], actions: [], loading: true },
    unavailable: { pill: 'Integration unavailable', tone: 'bad', title: 'Physio system not responding',
      body: 'Corps cannot confirm the rest flag, so it will not draft a substitution. The last known flag is shown but not used.',
      did: ['Retried 3 times over 90 seconds', 'Notified the company manager'], didNot: ['Assume the dancer is fit', 'Draft a cast change on cached data'],
      actions: [{ label: 'Retry connection', to: 'pending', kind: 'solid' }] },
    permission: { pill: 'Insufficient permission', tone: 'bad', title: 'You can view this change, not approve it',
      body: 'Rehearsal assistants can see drafts and add comments. Approval for cast changes belongs to the ballet master or the artistic director.',
      did: ['Recorded the attempted approval', 'Kept the draft unchanged'], didNot: ['Release the change', 'Escalate on your behalf'],
      actions: [{ label: 'Back to the draft', to: 'pending', kind: 'ghost' }] },
    stale: { pill: 'Stale data', tone: 'warn', title: 'Calendar changed since this draft',
      body: 'A pianist call was moved after Corps drafted the change. The hours check may no longer hold, so approval is paused until a re-check.',
      did: ['Detected the calendar edit at 09:31', 'Paused approval on draft v14'], didNot: ['Silently update the draft', 'Discard your earlier comments'],
      actions: [{ label: 'Re-run checks', to: 'pending', kind: 'solid' }] },
    denied: { pill: 'Approval denied', tone: 'mute', title: 'Change denied by the ballet master',
      body: 'Reason recorded: “Varga is not partnered with Albrecht’s cover yet. Use second cast.” The original cast stands; nothing was sent.',
      did: ['Recorded the reason against run 0187', 'Kept the draft for reference'], didNot: ['Retry with another dancer automatically', 'Notify anyone of the draft'],
      actions: [{ label: 'Draft with second cast', to: 'pending', kind: 'ghost' }] },
    partial: { pill: 'Partial completion', tone: 'warn', title: '5 of 6 notices delivered',
      body: 'The call sheet and casting grid are updated. Wardrobe’s inbox rejected the notice, so the costume fitting is not yet confirmed.',
      did: ['Published call sheet v14', 'Delivered 5 notices, read receipts pending'], didNot: ['Mark the run complete', 'Re-send to a different address'],
      actions: [{ label: 'Retry wardrobe notice', to: 'released', kind: 'solid' }, { label: 'Roll back', to: 'rolledback', kind: 'ghost', needsBm: true }] },
    released: { pill: 'Released', tone: 'ok', title: 'Change approved and released',
      body: 'Approved by the ballet master. Call sheet v14 is on the company board and all six notices were delivered.',
      did: ['Published call sheet v14', 'Delivered six notices', 'Sealed the audit packet'], didNot: ['Touch Friday or Sunday', 'Change any other production'],
      actions: [{ label: 'Roll back to original cast', to: 'rolledback', kind: 'ghost', needsBm: true }] },
    rolledback: { pill: 'Rolled back', tone: 'ok', title: 'Original cast restored',
      body: 'Call sheet v13 is live again. A correction went to the same six people; the earlier notices are kept in the audit trail, marked superseded.',
      did: ['Restored call sheet v13', 'Sent six corrections'], didNot: ['Delete the earlier notices', 'Clear the physio rest flag'],
      actions: [{ label: 'Start a new draft', to: 'pending', kind: 'ghost' }] },
    error: { pill: 'Error', tone: 'bad', title: 'Run stopped at the policy step',
      body: 'The contract check returned an unexpected role tier for L. Varga. Corps stopped the run rather than guess; the error is with our support team.',
      did: ['Halted at step 02 · Policy', 'Kept intake as a draft', 'Opened ticket CRP-4471'], didNot: ['Draft a cast change', 'Continue past a failed check'],
      actions: [{ label: 'Retry run', to: 'pending', kind: 'solid' }] },
  };

  const $ = (id: string) => document.getElementById(id)!;
  const pill = $('c-pill'), title = $('c-title'), body = $('c-body'), did = $('c-did'), didNot = $('c-didnot'), acts = $('c-actions'), log = $('c-log');
  const stateBtns = [...document.querySelectorAll<HTMLButtonElement>('.state-btn')];
  const role = () => (document.querySelector<HTMLInputElement>('input[name="role"]:checked')?.value ?? 'bm');
  let seqNo = 0; // ponytail: a fake clock — the demo is sample data
  const stamp = () => { seqNo += 1; const m = 12 + seqNo; return `09:${String(m).padStart(2, '0')}`; };
  const li = (t: string) => { const el = document.createElement('li'); el.textContent = t; return el; };
  const addLog = (t: string) => { const el = document.createElement('li'); el.innerHTML = `<span>${stamp()}</span> `; el.append(t); log.prepend(el); };
  let loadTimer = 0;

  const render = (key: string, note?: string) => {
    const s = S[key];
    clearTimeout(loadTimer);
    stateBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.state === key)));
    pill.textContent = s.pill; pill.dataset.tone = s.tone;
    title.textContent = s.title; body.textContent = s.body;
    did.replaceChildren(...s.did.map(li)); didNot.replaceChildren(...s.didNot.map(li));
    if (s.loading) {
      did.replaceChildren(...[0, 1, 2].map(() => Object.assign(document.createElement('li'), { className: 'skel', ariaHidden: 'true' })));
      loadTimer = window.setTimeout(() => render('pending', 'Data refreshed; draft v14 ready'), reduce ? 0 : 1600);
    }
    acts.replaceChildren(...s.actions.map((a) => {
      const b = document.createElement('button');
      b.className = `btn btn-${a.kind ?? 'ghost'}`; b.textContent = a.label; b.type = 'button';
      b.addEventListener('click', () => {
        if (a.needsBm && role() !== 'bm') { addLog(`Rehearsal assistant tried “${a.label}” — refused`); render('permission'); return; }
        addLog(`${role() === 'bm' ? 'Ballet master' : 'Rehearsal assistant'}: ${a.label}`);
        render(a.to);
      });
      return b;
    }));
    if (note) addLog(note);
  };
  stateBtns.forEach((b) => b.addEventListener('click', () => { addLog(`Viewing state: ${b.textContent?.trim()}`); render(b.dataset.state!); }));
  addLog('Run 0187 drafted · awaiting ballet master');
  render('pending');

  /* ---------- case filters + context handoff ---------- */
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const caseEls = [...document.querySelectorAll<HTMLElement>('.case')];
  const empty = document.querySelector<HTMLElement>('.empty')!;
  chips.forEach((c) => c.addEventListener('click', () => {
    const f = c.dataset.filter!;
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    let shown = 0;
    caseEls.forEach((el) => { const on = f === 'all' || el.dataset.tag === f; el.hidden = !on; if (on) shown++; });
    empty.hidden = shown > 0;
  }));

  const form = $('form') as HTMLFormElement;
  const ctx = $('ctx'), ctxName = $('ctx-name'), msg = $('f-msg'), submit = $('submit') as HTMLButtonElement;
  document.querySelectorAll<HTMLAnchorElement>('.case-link').forEach((a) => a.addEventListener('click', () => {
    const tag = a.dataset.context!;
    ctxName.textContent = a.closest('.case')!.querySelector('h3')!.textContent!;
    ctx.hidden = false;
    // only non-sensitive intent: the workflow select; the case reference is attached only if the box is ticked
    (form.elements.namedItem('workflow') as HTMLSelectElement).value = tag;
  }));

  /* ---------- form: validation, loading, duplicate, network error, success ---------- */
  const sent = new Set<string>();
  const say = (t: string, tone: string) => { msg.textContent = t; msg.dataset.tone = tone; };
  const checks: Record<string, (v: string) => string> = {
    name: (v) => (v.trim() ? '' : 'Tell us who to reply to.'),
    email: (v) => (!v.trim() ? 'We need an address to reply to.' : /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) ? '' : 'That address looks incomplete.'),
    company: (v) => (v.trim() ? '' : 'Which company is this for?'),
    size: (v) => (v ? '' : 'Choose an ensemble size.'),
  };
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    let first: HTMLElement | null = null;
    for (const [k, fn] of Object.entries(checks)) {
      const el = form.elements.namedItem(k) as HTMLInputElement;
      const err = fn(el.value);
      el.setAttribute('aria-invalid', String(!!err));
      const slot = form.querySelector(`[data-err="${k}"]`)!;
      slot.textContent = err;
      if (err) { el.setAttribute('aria-describedby', `err-${k}`); slot.id = `err-${k}`; first ??= el; }
    }
    if (first) { first.focus(); say('Check the highlighted fields.', 'bad'); return; }
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim().toLowerCase();
    if (sent.has(email)) { say('We already have a request from this address. Our team will reply to that one — no need to send it twice.', 'warn'); return; }
    submit.disabled = true; submit.textContent = 'Sending…'; say('', '');
    setTimeout(() => {
      submit.disabled = false; submit.textContent = 'Send request';
      if ((form.elements.namedItem('simfail') as HTMLInputElement).checked) { say('The request didn’t reach us. Nothing was lost — your answers are still here. Try again.', 'bad'); return; }
      sent.add(email);
      say('Request received. The implementation team will reply within two working days with three proposed times.', 'ok');
    }, reduce ? 200 : 1100);
  });
  form.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.getAttribute('aria-invalid') === 'true' && checks[el.name] && !checks[el.name](el.value)) {
      el.setAttribute('aria-invalid', 'false'); form.querySelector(`[data-err="${el.name}"]`)!.textContent = '';
    }
  });
</script>
