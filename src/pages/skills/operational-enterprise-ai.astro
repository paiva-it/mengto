---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

// Corps — a fictional rehearsal-operations system for ballet companies.
// Every company, person, run and number below is sample data.

const traceSteps = [
  { t: '09:12:04', k: 'Intake', h: 'Physio flag received', d: 'M. Okafor (Myrtha) — rest 72 h, cleared from Thu 14:00 call' },
  { t: '09:12:06', k: 'Policy', h: 'Four checks recorded', d: 'Weekly hour cap · contract role · partnering history · rest gap' },
  { t: '09:12:09', k: 'Action', h: 'Cast change prepared', d: 'L. Varga to Myrtha, Thu + Sat. Call sheet redrafted, not sent' },
  { t: '09:12:11', k: 'Audit', h: 'Evidence packet attached', d: 'Physio ref PX-2291 · hours ledger · draft notices to 6 people' },
];

const week = [
  { d: 'Mon', h: 5.5 }, { d: 'Tue', h: 6 }, { d: 'Wed', h: 3.5 }, { d: 'Thu', h: 6.5, add: true },
  { d: 'Fri', h: 0 }, { d: 'Sat', h: 4, add: true }, { d: 'Sun', h: 0 },
];
const cap = 30;
const weekTotal = week.reduce((s, x) => s + x.h, 0);

const metrics = [
  { n: '14', l: 'calls to rewrite', s: 'Studio, stage and costume calls that named the injured dancer' },
  { n: '6', l: 'people to tell', s: 'Dancer, understudy, partner, ballet master, wardrobe, stage management' },
  { n: '3', l: 'contracts to read', s: 'Role tier, overtime clause and touring rider for the understudy' },
  { n: '47', u: 'min', l: 'by hand, start to sent', s: 'Timed once by the company office, one substitution, Oct 2025' },
];

const solutions = [
  {
    id: 'substitution',
    title: 'Injury and illness substitutions',
    lede: 'A physio flag becomes a prepared cast change in seconds. It reaches the studio only after the ballet master signs it.',
    summary: 'Reads the rest flag, finds eligible understudies, checks hours and contract tier, and drafts the cast change with every notice it implies.',
    permissions: 'Read: casting grid, rehearsal calendar, physio clear/rest flag (never the note). Write: drafts only.',
    action: 'Drafts a cast change, a redrafted call sheet and six notifications. Nothing is sent.',
    approval: 'Ballet master, or the artistic director as deputy. A rehearsal assistant can view but not approve.',
    output: 'Published call sheet, updated casting grid, notices to dancer, partner, wardrobe and stage management.',
    audit: 'Who flagged, which checks ran with their inputs, who approved, when each notice was read.',
    exception: 'No eligible understudy under the hour cap: the run stops and names the constraint instead of breaking it.',
    rollback: 'One step back to the last approved cast. Sent notices are retracted with a correction, not deleted.',
  },
  {
    id: 'callsheet',
    title: 'Daily rehearsal call sheets',
    lede: 'Tomorrow’s calls drafted at 16:00 from the casting grid, the room plan and who is actually fit to work.',
    summary: 'Builds the next day’s studio, stage and fitting calls against room capacity, pianist availability and rest gaps.',
    permissions: 'Read: casting grid, room bookings, pianist roster, wardrobe fittings. Write: draft call sheet.',
    action: 'Proposes a call sheet and flags every conflict it could not resolve on its own.',
    approval: 'Company manager publishes. Any change after 18:00 also needs the ballet master.',
    output: 'One published call sheet to the company board, the app and the stage door screen.',
    audit: 'Draft diff against the previous day, every unresolved conflict and who overrode it.',
    exception: 'Room double-booked by the venue: both calls stay drafted and marked, nothing is moved silently.',
    rollback: 'Republish yesterday’s approved version for a given studio; later edits stay as a draft.',
  },
  {
    id: 'workload',
    title: 'Dancer workload limits',
    lede: 'Hours, rest gaps and jump-heavy repertoire tracked per dancer, with the cap enforced before the cast is drafted.',
    summary: 'Keeps a ledger of rehearsal and performance hours per dancer and refuses drafts that would cross a limit.',
    permissions: 'Read: calendar, performance log, limits set by the medical team. Cannot edit limits.',
    action: 'Warns at 85 % of a weekly cap and blocks drafts that would exceed it.',
    approval: 'Only the medical lead can raise a dancer’s limit, and only for a dated window.',
    output: 'A weekly load view per dancer shared with the dancer, ballet master and physio.',
    audit: 'Every warning, every block, and every limit change with its reason and expiry.',
    exception: 'Performance log late from the venue: the ledger is marked stale and new drafts pause.',
    rollback: 'Limit changes expire automatically; an early revert is one action for the medical lead.',
  },
  {
    id: 'touring',
    title: 'Touring freight and per diems',
    lede: 'Set, costume and rider manifests reconciled per venue, with per diems calculated and held for finance.',
    summary: 'Matches the touring party and freight manifest to each venue and prepares per diem runs for approval.',
    permissions: 'Read: touring party, venue riders, freight manifest. Write: draft per diem batch only.',
    action: 'Prepares a per diem batch and a freight checklist per venue. No payment is initiated.',
    approval: 'Tour manager approves the batch; finance releases it from their own system.',
    output: 'Per diem batch file for finance and a freight checklist for the crew chief.',
    audit: 'Party list snapshot, rates used and their source, approver, release reference from finance.',
    exception: 'A dancer added to the party after the batch: the batch is invalidated and re-drafted.',
    rollback: 'An unreleased batch is withdrawn in one step. Released payments are corrected in finance.',
  },
];
const fields = [
  ['summary', 'Summary'], ['permissions', 'Permissions'], ['action', 'Action'], ['approval', 'Approval'],
  ['output', 'Output'], ['audit', 'Audit'], ['exception', 'Exception'], ['rollback', 'Rollback'],
] as const;

const demoStates = [
  ['pending', 'Awaiting approval'], ['loading', 'Loading'], ['unavailable', 'Integration unavailable'],
  ['permission', 'Insufficient permission'], ['stale', 'Stale data'], ['denied', 'Approval denied'],
  ['partial', 'Partial completion'], ['released', 'Released'], ['rolledback', 'Rolled back'], ['error', 'Error'],
];

const risks = [
  { r: 'A dancer is cast against medical advice', c: 'A rest flag is a hard block. Corps cannot clear it; only the physio’s own system can.', w: 'Trace · Policy' },
  { r: 'The schedule changes without anyone deciding', c: 'Every change is a draft until a named owner approves it. Drafts never reach dancers.', w: 'Approval gate' },
  { r: 'Too many people can change too much', c: 'Roles are scoped per company, studio and production. New users start read-only.', w: 'Permissions' },
  { r: 'Health information spreads', c: 'Medical notes stay in your physio system. Corps stores a flag, a date and a reference.', w: 'Audit packet' },
  { r: 'A bad change is released', c: 'One step back to the last approved state; sent notices are corrected, never silently erased.', w: 'Rollback' },
  { r: 'The model drafts something wrong', c: 'Rule checks run before and after every draft. A failed check halts the run and names it.', w: 'Exception' },
];

const cases = [
  {
    tag: 'substitutions', company: 'Northbank Ballet', where: 'Leeds · 62 dancers',
    facts: ['Live since 3 Feb 2026 on one production, then the full repertoire from 1 Apr', 'Connected: rehearsal calendar, casting grid, physio rest flags (read-only)', 'Not connected: payroll, ticketing', '118 substitutions approved, 9 denied, 2 rolled back to 30 Sep 2026'],
    quote: 'I still make the call. I just make it with the call sheet already written and the hours already counted.',
    who: 'Ines Halloran, Ballet Mistress',
    read: 'Our reading: the ballet master’s review moved from building the change to judging it.',
  },
  {
    tag: 'touring', company: 'Lindqvist Dance Theatre', where: 'Gothenburg · 34 dancers, 2 tours a year',
    facts: ['Pilot on the spring 2026 tour: 11 venues, 5 countries', 'Connected: touring party list, venue riders, freight manifest', 'Per diems drafted in Corps, released from their finance system', '22 per diem batches approved, 1 withdrawn before release'],
    quote: 'The batch is ready when I land. Finance still presses the button, which is how we want it.',
    who: 'Johan Ek, Tour Manager',
    read: 'Our reading: approval time fell because the evidence came with the batch, not because anything skipped review.',
  },
];

const faqs = [
  { q: 'Who owns a change once Corps drafts it?', a: 'The person who approves it. Corps records itself as the drafter and the approver as the owner; the audit packet names both. If nobody approves, nothing happens.' },
  { q: 'What data does Corps read, and what does it keep?', a: 'Calendars, casting grids, room bookings and touring lists through read-only connections. From the physio system it reads only a rest/clear flag, a date and a reference. Drafts and audit packets are kept for the season plus two years, or as your policy sets.' },
  { q: 'Which systems does it connect to?', a: 'Google and Microsoft calendars, the common casting spreadsheets, two physio record systems and CSV exports for anything else. If your system is not on the list, we say so in the first call instead of promising a connector.' },
  { q: 'Who reviews what the model writes?', a: 'Your named approvers, every time, for every workflow on this page. Deterministic checks run first and again after the draft; a human signs before anything leaves Corps.' },
  { q: 'What happens when something fails mid-run?', a: 'The run stops at the failed step, keeps everything it prepared as a draft and tells the owner which step failed and why. Partial releases are listed item by item with a one-step rollback.' },
  { q: 'How does procurement work?', a: 'A season licence per company, priced by ensemble size. We send our data processing agreement, sub-processor list and the current security review status before you sign — including what we do not have yet.' },
];
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Corps — rehearsal operations with a visible boundary</title>
  <meta name="description" content="Corps prepares cast changes, call sheets and per diems for ballet companies, and waits for a named person to approve them." />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body class="oe">
  <a class="skip" href="#main">Skip to content</a>

  <header class="hdr">
    <div class="wrap hdr-in">
      <a class="brand" href="#top" aria-label="Corps home">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><rect x="0.5" y="0.5" width="17" height="17" fill="none" stroke="currentColor"/><path d="M9 3v12M4 9h10" stroke="currentColor"/></svg>
        <span>CORPS</span>
      </a>
      <nav aria-label="Primary" class="nav">
        <a href="#product">Product</a>
        <a href="#solutions">Solutions</a>
        <a href="#security">Security</a>
        <a href="#cases">Case studies</a>
      </nav>
      <a class="btn btn-line" href="#review">Request a season review</a>
    </div>
  </header>

  <main id="main">
    <!-- HERO -->
    <section id="top" class="hero dark grid-bg">
      <div class="wrap hero-in">
        <div class="hero-copy">
          <p class="eyebrow"><span class="rule"></span>Controlled automation for ballet companies</p>
          <h1>Prepares the cast change. Never calls the curtain.</h1>
          <p class="lede">Corps reads the injury flag, checks hours and contracts, and drafts every call and notice a substitution needs. Then it stops, until the ballet master signs. Every change keeps its evidence and a one-step way back.</p>
          <div class="ctas">
            <a class="btn btn-solid" href="#review">Map your season</a>
            <a class="btn btn-ghost" href="#security">Review the controls</a>
          </div>
          <dl class="boundary">
            <div><dt>Corps does</dt><dd>Read, check, draft, record</dd></div>
            <div><dt>People do</dt><dd>Approve, release, overrule</dd></div>
          </dl>
        </div>

        <figure class="trace" id="trace" aria-labelledby="trace-cap">
          <div class="trace-top mono">
            <span>Workflow trace · sample data</span>
            <span>Run 0187 / <span class="sig" data-run-status>Review required</span></span>
          </div>
          <p class="trace-title">Giselle, Act II — Thursday &amp; Saturday</p>
          <ol class="steps">
            {traceSteps.map((s, i) => (
              <li class="step" data-step={i}>
                <span class="mono t">{s.t}</span>
                <span class="mono k">0{i + 1} · {s.k}</span>
                <span class="h">{s.h}</span>
                <span class="d">{s.d}</span>
                <span class="dot" aria-hidden="true"></span>
              </li>
            ))}
          </ol>
          <div class="gate" data-step="4">
            <div class="mono gate-top"><span>Human approval gate</span><span>Owner · Ballet master</span></div>
            <p>Nothing reaches the studio until the ballet master reviews the cast, the hours and the rollback plan.</p>
          </div>
          <div class="load">
            <div class="load-head mono"><span>L. Varga · load this week if approved</span><span><b class="num">{weekTotal}</b> / {cap} h cap</span></div>
            <div class="bars" role="img" aria-label={`Daily rehearsal hours for L. Varga, Monday to Sunday: ${week.map((w) => `${w.d} ${w.h} hours${w.add ? ' including the new call' : ''}`).join(', ')}. Total ${weekTotal} of a ${cap} hour weekly cap.`}>
              {week.map((w) => (
                <div class="bar-col">
                  <div class="bar"><i class={w.add ? 'add' : ''} style={`--h:${(w.h / 7) * 100}%`}></i></div>
                  <span class="mono">{w.d}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="trace-stats">
            <div><b class="num" data-count="4">4 / 4</b><span>Checks recorded</span></div>
            <div><b class="num">1</b><span>Approval pending</span></div>
            <div><b class="num">1 step</b><span>Rollback to original cast</span></div>
          </div>
          <figcaption id="trace-cap" class="sr">Sample workflow trace for run 0187: a physio rest flag for one dancer leads to four recorded checks, a prepared cast change and an evidence packet. The change is waiting for the ballet master's approval and can be rolled back in one step.</figcaption>
        </figure>
      </div>
    </section>

    <!-- METRICS (white interlude) -->
    <section class="light metrics" aria-labelledby="m-h">
      <div class="wrap">
        <div class="sec-head">
          <p class="mono kicker">01 — The problem</p>
          <h2 id="m-h">One sprained ankle on a Tuesday rewrites the whole week.</h2>
        </div>
        <div class="m-grid">
          {metrics.map((m) => (
            <div class="m reveal">
              <b class="num m-n">{m.n}{m.u && <small>{m.u}</small>}</b>
              <span class="m-l">{m.l}</span>
              <span class="m-s">{m.s}</span>
            </div>
          ))}
        </div>
        <p class="mono source">Scope: one substitution in a sample week at Northbank Ballet, 2025–26 season, counted from their office’s schedule export. Not a benchmark, not an average.</p>
      </div>
    </section>

    <!-- SOLUTIONS -->
    <section id="solutions" class="light solutions" aria-labelledby="s-h">
      <div class="wrap">
        <div class="sec-head split">
          <div>
            <p class="mono kicker">02 — Workflows</p>
            <h2 id="s-h">Four workflows. Each one shows its permissions, its approver and its way back.</h2>
          </div>
          <p class="sec-note">Open a row to see what Corps may read and write, who signs, what it records, what stops it, and how the change is undone.</p>
        </div>
        <ul class="rows">
          {solutions.map((s, i) => (
            <li class="row" data-row>
              <h3>
                <button class="row-btn" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`row-${s.id}`} id={`rowb-${s.id}`}>
                  <span class="mono idx">0{i + 1}</span>
                  <span class="row-title">{s.title}</span>
                  <span class="row-lede">{s.lede}</span>
                  <span class="row-tog mono" aria-hidden="true"><span class="lbl-open">Expand</span><span class="lbl-close">Close</span> <i></i></span>
                </button>
              </h3>
              <div class="row-panel" id={`row-${s.id}`} role="region" aria-labelledby={`rowb-${s.id}`} hidden={i !== 0}>
                <p class="flow mono" aria-label="Flow">Intake → Checks → Draft → <b>Approval</b> → Release → Audit</p>
                <dl class="spec">
                  {fields.map(([k, label]) => (
                    <div class={`cell c-${k}`}><dt class="mono">{label}</dt><dd>{s[k]}</dd></div>
                  ))}
                </dl>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- DEMO -->
    <section id="product" class="dark demo" aria-labelledby="d-h">
      <div class="wrap">
        <div class="sec-head split">
          <div>
            <p class="mono kicker">03 — Product</p>
            <h2 id="d-h">Run 0187, every state it can be in.</h2>
          </div>
          <p class="sec-note">Sample data, deterministic. Act as the ballet master or as a rehearsal assistant, approve or deny, then roll back — or jump to any state from the list.</p>
        </div>

        <div class="demo-grid">
          <div class="demo-side">
            <fieldset class="role">
              <legend class="mono">Acting as</legend>
              <label><input type="radio" name="role" value="bm" checked /> <span>Ballet master</span></label>
              <label><input type="radio" name="role" value="ra" /> <span>Rehearsal assistant</span></label>
            </fieldset>
            <p class="mono side-lbl" id="states-lbl">States</p>
            <ul class="states" aria-labelledby="states-lbl">
              {demoStates.map(([k, l]) => (
                <li><button class="state-btn" data-state={k} aria-pressed={k === 'pending' ? 'true' : 'false'}><i class={`tone-dot t-${k}`}></i>{l}</button></li>
              ))}
            </ul>
          </div>

          <div class="console" aria-live="polite">
            <div class="console-top mono">
              <span>Corps · Northbank Ballet · Giselle</span>
              <span id="c-clock">Data as of 09:12</span>
            </div>
            <div class="console-body">
              <div class="c-status">
                <span class="pill mono" id="c-pill">Awaiting approval</span>
                <span class="mono c-run">Run 0187</span>
              </div>
              <h3 id="c-title">Cast change ready for your review</h3>
              <p id="c-body" class="c-body"></p>
              <div class="c-cols">
                <div><p class="mono c-sub">Corps did</p><ul id="c-did"></ul></div>
                <div><p class="mono c-sub">Corps did not</p><ul id="c-didnot"></ul></div>
              </div>
              <div class="c-actions" id="c-actions"></div>
            </div>
            <ol class="c-log mono" id="c-log" aria-label="Audit log"></ol>
          </div>
        </div>
      </div>
    </section>

    <!-- SECURITY -->
    <section id="security" class="dark security" aria-labelledby="sec-h">
      <div class="wrap">
        <div class="sec-head split">
          <div>
            <p class="mono kicker">04 — Security &amp; governance</p>
            <h2 id="sec-h">Each control answers a specific risk.</h2>
          </div>
          <p class="sec-note">There are no badges on this page. In the review we show you the current security assessment, the sub-processor list and the data processing agreement — and say plainly what we do not have yet.</p>
        </div>
        <div class="risk-table" role="table" aria-label="Risks and controls">
          <div class="risk-row head mono" role="row">
            <span role="columnheader">Risk</span><span role="columnheader">Control</span><span role="columnheader">Where you see it</span>
          </div>
          {risks.map((x) => (
            <div class="risk-row reveal" role="row">
              <span role="cell" class="r">{x.r}</span>
              <span role="cell" class="c">{x.c}</span>
              <span role="cell" class="w mono">{x.w}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CASES -->
    <section id="cases" class="light cases" aria-labelledby="c-h">
      <div class="wrap">
        <div class="sec-head split">
          <div>
            <p class="mono kicker">05 — Case studies</p>
            <h2 id="c-h">What was connected, what was approved, what they said.</h2>
          </div>
          <div class="filters" role="group" aria-label="Filter case studies">
            <button class="chip" data-filter="all" aria-pressed="true">All</button>
            <button class="chip" data-filter="substitutions" aria-pressed="false">Substitutions</button>
            <button class="chip" data-filter="touring" aria-pressed="false">Touring</button>
          </div>
        </div>
        <div class="case-list">
          {cases.map((c) => (
            <article class="case" data-tag={c.tag}>
              <header class="case-head">
                <div><h3>{c.company}</h3><p class="mono">{c.where}</p></div>
                <span class="mono case-tag">{c.tag}</span>
              </header>
              <div class="case-body">
                <div>
                  <p class="mono c-sub">Implementation facts</p>
                  <ul class="facts">{c.facts.map((f) => <li>{f}</li>)}</ul>
                </div>
                <div>
                  <p class="mono c-sub">In their words</p>
                  <blockquote><p>“{c.quote}”</p><footer>— {c.who}</footer></blockquote>
                  <p class="mono c-sub">Interpretation</p>
                  <p class="read">{c.read}</p>
                </div>
              </div>
              <a class="case-link" href="#review" data-context={c.tag}>Ask about a pilot like this →</a>
            </article>
          ))}
          <p class="empty mono" hidden>No case studies for this workflow yet.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="light faq" aria-labelledby="f-h">
      <div class="wrap faq-in">
        <div>
          <p class="mono kicker">06 — Questions buyers ask</p>
          <h2 id="f-h">Ownership, data, failure, procurement.</h2>
        </div>
        <div class="faq-list">
          {faqs.map((f) => (
            <details>
              <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="review" class="dark cta grid-bg" aria-labelledby="r-h">
      <div class="wrap cta-in">
        <div class="cta-copy">
          <p class="mono kicker">07 — Season review</p>
          <h2 id="r-h">For companies with a resident ensemble and a ballet master who signs the call sheet.</h2>
          <p class="lede">We map one workflow from your current season — usually substitutions — against your systems, roles and approval rules, and tell you whether Corps fits. If it doesn’t, you keep the map.</p>
          <dl class="after">
            <div><dt class="mono">Who receives it</dt><dd>Our two-person implementation team, not a sales queue.</dd></div>
            <div><dt class="mono">Response</dt><dd>A reply within two working days with three proposed times.</dd></div>
            <div><dt class="mono">Data use</dt><dd>Only to arrange the review. Deleted after 90 days if we don’t work together.</dd></div>
          </dl>
        </div>

        <form class="form" id="form" novalidate>
          <div class="form-top mono"><span>Request a season review</span><span>Sample form · nothing is sent</span></div>
          <div class="f-grid">
            <label class="fld"><span>Name</span><input name="name" autocomplete="name" required /><em class="err" data-err="name"></em></label>
            <label class="fld"><span>Work e-mail</span><input name="email" type="email" autocomplete="email" required /><em class="err" data-err="email"></em></label>
            <label class="fld"><span>Company</span><input name="company" autocomplete="organization" required /><em class="err" data-err="company"></em></label>
            <label class="fld"><span>Ensemble size</span>
              <select name="size" required>
                <option value="">Choose…</option>
                <option>Under 20 dancers</option>
                <option>20–40 dancers</option>
                <option>41–80 dancers</option>
                <option>More than 80</option>
              </select>
              <em class="err" data-err="size"></em>
            </label>
            <label class="fld wide"><span>Workflow to map first</span>
              <select name="workflow">
                <option value="substitutions">Injury and illness substitutions</option>
                <option value="callsheet">Daily rehearsal call sheets</option>
                <option value="workload">Dancer workload limits</option>
                <option value="touring">Touring freight and per diems</option>
              </select>
            </label>
            <div class="ctx wide" id="ctx" hidden>
              <label class="check"><input type="checkbox" name="useContext" /> <span>Include which case study I came from (<b id="ctx-name"></b>). Nothing else is attached.</span></label>
            </div>
            <label class="check wide"><input type="checkbox" name="simfail" /> <span class="mono dim">Simulate a network failure</span></label>
          </div>
          <div class="f-foot">
            <button class="btn btn-solid" type="submit" id="submit">Send request</button>
            <p class="f-msg" id="f-msg" role="status"></p>
          </div>
        </form>
      </div>
    </section>
  </main>

  <footer class="foot dark">
    <div class="wrap foot-in mono">
