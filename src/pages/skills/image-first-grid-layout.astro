---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';
import Rails from '../../components/skills/image-first-grid-layout/Rails.astro';

const u = (id: string, w = 2400) => `https://images.unsplash.com/photo-${id}?w=${w}&q=72&auto=format&fit=crop`;
const img = {
  hero: '1513039464749-94912b3841ce',
  reef: '1583212292454-1fe6229603b7',
  rays: '1530053969600-caed2596d242',
  visit: '1551244072-5d12893278ab',
};

// Depth gauge on a log scale, 0 → 1 000 m, so the reef and the twilight zone both read.
const depth = (m: number) => (Math.log10(m + 1) / Math.log10(1001)) * 100;
const halls = [
  { n: '01', name: 'Sunlit Reef', from: 0, to: 20, body: 'Hard corals under full-spectrum light, every colony grown from fragments in our own nursery. Tangs, clownfish and a hawksbill called Bo.' },
  { n: '02', name: 'Kelp Forest', from: 5, to: 30, body: 'A seven-metre surge tank that moves the kelp the way a North Atlantic swell does: one long push every eleven seconds.' },
  { n: '03', name: 'Open Ocean', from: 0, to: 200, body: 'The main tank. Eagle rays, two loggerheads, a shoal of six hundred sardines, and a floor window you can lie under.' },
  { n: '04', name: 'Twilight Room', from: 200, to: 1000, body: 'Moon and comb jellies in circular kreisel tanks, lit at the low blue they would actually see four hundred metres down.' },
];

const proof = [
  ['92 %', 'of residents bred in-house or taken in injured'],
  ['0', 'animals collected from the wild since 2019'],
  ['31', 'rehabilitated and returned to the sea last year'],
  ['38 cm', 'of acrylic between you and 4.2 million litres'],
];

const hours = [
  ['Day entry', 'Daily', '09:30 – 18:00'],
  ['After Dark', 'Thu – Sat', '19:00 – 23:00'],
  ['Members’ mornings', 'Sunday', '08:30 – 09:30'],
  ['Last descent', 'Every day', '60 min before close'],
];

const tickets = [
  { id: 'day', name: 'Day entry', note: 'All four halls, timed', price: 24 },
  { id: 'dark', name: 'After Dark', note: 'Adults only, lights at 10 %', price: 32 },
  { id: 'member', name: 'Annual member', note: 'Unlimited, plus Sunday mornings', price: 68 },
];
const slots = ['10:00', '11:30', '13:00', '14:30', '16:00'];
---
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Brinehall Aquarium — Hall 03, The Open Ocean</title>
    <meta name="description" content="Brinehall, a fictional public aquarium on Pier 9: four halls, one continuous descent." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href={u(img.hero)} />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body>
    <BackPill />

    <!-- ============ HERO ============ -->
    <header class="stage stage--hero" id="top">
      <div class="stage__media" data-parallax>
        <img src={u(img.hero)} alt="A spotted eagle ray gliding through deep blue water above a dim reef" fetchpriority="high" />
      </div>
      <div class="wash wash--hero" aria-hidden="true"></div>
      <canvas class="lines" aria-hidden="true"></canvas>
      <Rails top="88px" bottom="56px" />

      <nav class="nav wrap" aria-label="Main">
        <a class="logo" href="#top" aria-label="Brinehall Aquarium, home">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M2 14c3-4 6-4 10 0s7 4 10 0M2 19c3-4 6-4 10 0s7 4 10 0" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="6" r="2.6" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
          <span>Brinehall</span>
        </a>
        <ul class="nav__links">
          <li><a href="#halls">Halls</a></li>
          <li><a href="#care">Care</a></li>
          <li><a href="#visit">Visit</a></li>
        </ul>
        <div class="nav__end">
          <span class="nav__status"><i class="dot"></i>Open until 18:00</span>
          <a class="btn btn--glass btn--sm" href="#visit">Tickets <span aria-hidden="true">→</span></a>
        </div>
      </nav>

      <div class="hero wrap grid">
        <div class="hero__copy">
          <p class="label reveal" style="--d:.1s"><span class="label__k">Hall 03</span> The Open Ocean <span class="sep">/</span> opens 14 November</p>
          <h1 class="hero__title">
            <span class="mask"><span style="--d:.15s">Stand beneath</span></span>
            <span class="mask"><span style="--d:.27s">the open ocean.</span></span>
          </h1>
          <p class="hero__lede reveal" style="--d:.55s">
            Our new main tank holds 4.2 million litres of filtered seawater behind a single acrylic wall.
            Walk the ramp down its flank and finish on the floor, looking up at the rays.
          </p>
          <div class="hero__cta reveal" style="--d:.7s">
            <a class="btn btn--glass btn--sweep" href="#visit">Book a timed descent <span aria-hidden="true">→</span></a>
            <a class="btn btn--ghost" href="#halls">See the four halls</a>
          </div>
        </div>

        <aside class="tele card reveal" style="--d:.85s" aria-label="Tank 01 live readings">
          <div class="tele__head">
            <span class="mono"><i class="dot dot--live"></i>Tank 01 — live</span>
            <span class="mono dim">Sensor 7 / 12</span>
          </div>
          <dl class="tele__grid">
            <div><dt>Water</dt><dd><b data-temp>22.4</b> °C</dd></div>
            <div><dt>Salinity</dt><dd><b data-sal>34.8</b> psu</dd></div>
            <div><dt>Depth</dt><dd><b>9.5</b> m</dd></div>
            <div><dt>Residents</dt><dd><b>1 184</b></dd></div>
          </dl>
          <p class="tele__note"><span class="accent">Inês</span>, spotted eagle ray, last passed the floor window <b class="mono" data-pass>0:42</b> ago.</p>
        </aside>
      </div>

      <div class="strip wrap" aria-hidden="true">
        <span class="mono">Fig. 01 — Aetobatus narinari, Tank 01</span>
        <span class="mono strip__mid">Scroll to descend <i class="cue"></i></span>
        <span class="mono">Pier 9 · Gallery level −2</span>
      </div>
    </header>

    <main>
      <!-- ============ HALLS ============ -->
      <section class="stage stage--halls" id="halls" aria-labelledby="halls-title">
        <div class="stage__media" data-parallax>
          <img src={u(img.reef)} alt="Sunlit coral reef with a scatter of small orange fish" loading="lazy" />
        </div>
        <div class="wash wash--halls" aria-hidden="true"></div>
        <Rails top="72px" bottom="0px" />

        <div class="wrap grid halls__top">
          <div class="halls__head">
            <p class="label reveal"><span class="label__k">02</span> The descent</p>
            <h2 class="h2" id="halls-title">
              <span class="mask"><span>Four halls,</span></span>
              <span class="mask"><span>one continuous dive.</span></span>
            </h2>
          </div>
          <p class="halls__intro reveal" style="--d:.2s">
            Brinehall is built as a ramp, not a maze. You enter at the waterline and lose light one hall at a time,
            from reef to the edge of the deep, roughly the way a diver would.
          </p>
        </div>

        <ol class="wrap halls__row">
          {halls.map((h, i) => (
            <li class="hall reveal" style={`--d:${0.1 + i * 0.1}s`}>
              <a href="#visit" class="hall__link">
                <span class="hall__n mono">{h.n}</span>
                <span class="hall__depth mono">{h.from}–{h.to.toLocaleString('en-GB').replace(',', ' ')} m</span>
                <span class="gauge" aria-hidden="true">
                  <span class="gauge__fill" style={`left:${depth(h.from)}%;width:${depth(h.to) - depth(h.from)}%`}></span>
                </span>
                <h3 class="hall__name">{h.name}</h3>
                <span class="hall__body">{h.body}</span>
                <span class="hall__go mono">Enter hall <span aria-hidden="true">→</span></span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <!-- ============ CARE ============ -->
      <section class="stage stage--care" id="care" aria-labelledby="care-title">
        <div class="stage__media" data-parallax>
          <img src={u(img.rays)} alt="Shafts of sunlight falling through clear blue water" loading="lazy" />
        </div>
        <div class="wash wash--care" aria-hidden="true"></div>
        <Rails top="72px" bottom="0px" />

        <div class="wrap grid care__body">
          <p class="label reveal care__label"><span class="label__k">03</span> How we keep them</p>
          <blockquote class="care__quote">
            <p id="care-title" class="reveal">
              <span class="hi">We don’t take from the sea to fill a tank.</span>{' '}
              Nine in ten of the animals you’ll meet here hatched in our nursery or arrived injured and stayed,
              and the rest are on a list to go home.
            </p>
            <footer class="reveal mono" style="--d:.2s">Dr. Maren Aalto <span class="dim">— Head of husbandry</span></footer>
          </blockquote>
        </div>

        <dl class="wrap proof">
          {proof.map(([v, k], i) => (
            <div class="proof__cell reveal" style={`--d:${i * 0.08}s`}>
              <dt class="proof__k">{k}</dt>
              <dd class="proof__v">{v}</dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- ============ VISIT ============ -->
      <section class="stage stage--visit" id="visit" aria-labelledby="visit-title">
        <div class="stage__media" data-parallax>
          <img src={u(img.visit)} alt="Looking up from a reef towards the sunlit surface, a shoal of small fish overhead" loading="lazy" />
        </div>
        <div class="wash wash--visit" aria-hidden="true"></div>
        <Rails top="72px" bottom="0px" />

        <div class="wrap grid visit">
          <div class="visit__copy">
            <p class="label reveal"><span class="label__k">04</span> Visit</p>
            <h2 class="h2" id="visit-title">
              <span class="mask"><span>Plan the</span></span>
              <span class="mask"><span>descent.</span></span>
            </h2>
            <table class="hours reveal" style="--d:.15s">
              <caption class="sr-only">Opening hours</caption>
              <tbody>
                {hours.map(([a, b, c]) => (
                  <tr><th scope="row">{a}</th><td>{b}</td><td class="mono">{c}</td></tr>
                ))}
              </tbody>
            </table>
          </div>

          <form class="ticket card reveal" style="--d:.25s" aria-label="Reserve a timed entry">
            <fieldset class="ticket__types">
              <legend class="mono dim">Ticket</legend>
              {tickets.map((t, i) => (
                <label class="opt">
                  <input type="radio" name="ticket" value={t.id} data-price={t.price} checked={i === 0} />
                  <span class="opt__main"><b>{t.name}</b><span>{t.note}</span></span>
                  <span class="opt__price mono">€{t.price}</span>
                </label>
              ))}
            </fieldset>
            <div class="ticket__side">
              <fieldset class="slots">
                <legend class="mono dim">Descent, Thu 14 Nov</legend>
                <div class="slots__row">
                  {slots.map((s, i) => (
                    <label class="slot"><input type="radio" name="slot" value={s} checked={i === 1} /><span class="mono">{s}</span></label>
                  ))}
                </div>
              </fieldset>
              <div class="ticket__total">
                <span class="mono dim">Per person</span>
                <output class="ticket__price" data-total>€24</output>
              </div>
              <button type="submit" class="btn btn--glass btn--sweep btn--block">Reserve <span data-slot>11:30</span> <span aria-hidden="true">→</span></button>
              <p class="ticket__msg mono" role="status" aria-live="polite"></p>
            </div>
          </form>
        </div>
      </section>
    </main>

    <!-- ============ FOOTER ============ -->
    <footer class="foot">
      <Rails top="0px" bottom="0px" />
      <div class="wrap foot__in">
        <p class="foot__mark" aria-hidden="true">Brinehall</p>
        <div class="foot__row">
          <span class="mono">Pier 9, Brinehall Quay</span>
          <span class="mono">Run by the Brinehall Aquarium Trust</span>
          <a class="mono" href="#top">Back to the surface ↑</a>
          <span class="mono dim">A fictional aquarium. Photos: Unsplash.</span>
        </div>
      </div>
    </footer>

    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // --- Reveal on view (masked lines + soft fades) ---
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal, .mask').forEach((el) => io.observe(el));

      // --- Slow image parallax on each stage (translate only, the image is oversized) ---
      const stages = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
      if (!reduce) {
        let ticking = false;
        const update = () => {
          ticking = false;
          const vh = innerHeight;
          for (const el of stages) {
            const r = el.parentElement!.getBoundingClientRect();
            if (r.bottom < 0 || r.top > vh) continue;
            const p = (r.top + r.height / 2 - vh / 2) / (vh + r.height); // -0.5 … 0.5
            el.style.transform = `translate3d(0, ${(p * -9).toFixed(2)}%, 0)`;
          }
        };
        addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
        update();
      }

      // --- Faint drifting line field over the hero image (screen-blended canvas) ---
      const cv = document.querySelector<HTMLCanvasElement>('.lines');
      const ctx = cv?.getContext('2d');
      if (cv && ctx) {
        let w = 0, h = 0, raf = 0, visible = true;
        const dpr = Math.min(devicePixelRatio || 1, 1.5);
        const N = 22;
        const seeds = Array.from({ length: N }, (_, i) => ({ y: (i + 0.5) / N, a: 0.4 + Math.random() * 0.6, f: 0.6 + Math.random() * 1.4, s: 0.15 + Math.random() * 0.35, o: Math.random() * 6.28 }));
        const resize = () => {
          w = cv.clientWidth; h = cv.clientHeight;
          cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        const draw = (t: number) => {
          ctx.clearRect(0, 0, w, h);
          ctx.globalCompositeOperation = 'lighter';
          for (const s of seeds) {
            const g = ctx.createLinearGradient(0, 0, w, 0);
            g.addColorStop(0, 'rgba(156,228,236,0)');
            g.addColorStop(0.55, `rgba(156,228,236,${0.11 * s.a})`);
            g.addColorStop(1, 'rgba(156,228,236,0)');
            ctx.strokeStyle = g; ctx.lineWidth = 1;
            ctx.beginPath();
            for (let x = 0; x <= w; x += 16) {
              const k = x / w;
              const y = s.y * h + Math.sin(k * 6.28 * s.f + t * s.s + s.o) * 22 + Math.sin(k * 15 + t * s.s * 1.7) * 6 - k * 40;
              x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
            }
            ctx.stroke();
          }
        };
        const loop = (ms: number) => { draw(ms / 1000); raf = requestAnimationFrame(loop); };
        const start = () => { cancelAnimationFrame(raf); if (reduce) draw(0); else if (visible && !document.hidden) raf = requestAnimationFrame(loop); };
        new ResizeObserver(() => { resize(); if (reduce) draw(0); }).observe(cv);
        new IntersectionObserver(([e]) => { visible = e.isIntersecting; visible ? start() : cancelAnimationFrame(raf); }).observe(cv);
        document.addEventListener('visibilitychange', () => (document.hidden ? cancelAnimationFrame(raf) : start()));
        resize(); start();
      }

      // --- Live tank readout: small sensor jitter + a running "last pass" clock ---
      const tEl = document.querySelector('[data-temp]'), sEl = document.querySelector('[data-sal]'), pEl = document.querySelector('[data-pass]');
      let pass = 42;
      setInterval(() => {
        pass = pass >= 95 ? 3 : pass + 1;
        if (pEl) pEl.textContent = `${Math.floor(pass / 60)}:${String(pass % 60).padStart(2, '0')}`;
        if (pass % 4 === 0 && tEl && sEl) {
          tEl.textContent = (22.4 + (Math.random() - 0.5) * 0.2).toFixed(1);
          sEl.textContent = (34.8 + (Math.random() - 0.5) * 0.2).toFixed(1);
        }
      }, 1000);

      // --- Ticket picker ---
      const form = document.querySelector<HTMLFormElement>('.ticket');
      if (form) {
        const total = form.querySelector('[data-total]')!, slotLabel = form.querySelector('[data-slot]')!, msg = form.querySelector('.ticket__msg')!;
        const sync = () => {
          const t = form.querySelector<HTMLInputElement>('input[name=ticket]:checked')!;
          const s = form.querySelector<HTMLInputElement>('input[name=slot]:checked')!;
          total.textContent = `€${t.dataset.price}`;
          slotLabel.textContent = s.value;
          msg.textContent = '';
        };
        form.addEventListener('change', sync);
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const s = form.querySelector<HTMLInputElement>('input[name=slot]:checked')!;
          msg.textContent = `Held for 10 minutes: Thu 14 Nov, ${s.value}. (Demo — nothing was booked.)`;
        });
      }
    </script>

    <style is:global>
      :root {
        --max: 1280px; --gut: 24px; --inset: 24px;
        --ink: #03080d; --fg: #eef5f6; --muted: rgb(214 230 234 / .66); --dim: rgb(214 230 234 / .44);
        --accent: #9ce4ec;
        --line: rgb(226 242 246 / .17); --line-soft: rgb(226 242 246 / .11); --marker: rgb(226 242 246 / .55);
        --glass: rgb(5 13 20 / .38);
        --ease: cubic-bezier(.2,.7,.1,1);
        color-scheme: dark;
      }
      @media (max-width: 720px) { :root { --gut: 16px; --inset: 16px; } }
      html { background: var(--ink); scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body { margin: 0; background: var(--ink); color: var(--fg); font: 400 16px/1.55 'Geist', ui-sans-serif, system-ui, sans-serif; -webkit-font-smoothing: antialiased; overflow-x: clip; }
      a { color: inherit; text-decoration: none; }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      .mono { font-family: 'Geist Mono', ui-monospace, monospace; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; font-variant-numeric: tabular-nums; }
      .dim { color: var(--dim); }
      .accent { color: var(--accent); }
      :focus-visible { outline: 1px solid var(--accent); outline-offset: 3px; }

      .wrap { width: min(100% - 2 * var(--gut), var(--max)); margin-inline: auto; position: relative; z-index: 3; }
      .grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); }

      /* ---------- stage: the image is the foundation ---------- */
      .stage { position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; }
      .stage__media { position: absolute; inset: -9% 0; z-index: 0; will-change: transform; }
      .stage__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .stage--hero .stage__media img { animation: settle 2.6s var(--ease) both; object-position: 62% 30%; }
      @keyframes settle { from { transform: scale(1.08); filter: brightness(.6); } to { transform: scale(1); filter: none; } }
      .wash { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
      .wash--hero {
        background:
          linear-gradient(90deg, rgb(3 8 13 / .82) 0%, rgb(3 8 13 / .45) 38%, rgb(3 8 13 / 0) 64%),
          linear-gradient(0deg, rgb(3 8 13 / .92) 0%, rgb(3 8 13 / .35) 34%, rgb(3 8 13 / 0) 55%),
          linear-gradient(180deg, rgb(3 8 13 / .55) 0%, rgb(3 8 13 / 0) 18%);
      }
      .lines { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; mix-blend-mode: screen; pointer-events: none; }

      /* ---------- nav ---------- */
      .nav { height: 88px; display: grid; grid-template-columns: repeat(4, 1fr); align-items: center; }
      .logo { display: inline-flex; align-items: center; gap: 10px; padding-left: var(--inset); font-weight: 600; letter-spacing: .14em; text-transform: uppercase; font-size: 14px; }
      .logo svg { color: var(--accent); }
      .nav__links { grid-column: 2 / 4; display: flex; gap: 0; margin: 0; padding: 0; list-style: none; }
      .nav__links li { flex: 1; }
      .nav__links a { display: inline-block; padding: 8px var(--inset); font-size: 14px; color: var(--muted); transition: color .3s; }
      .nav__links a:hover { color: var(--fg); }
      .nav__end { display: flex; align-items: center; justify-content: flex-end; gap: 18px; padding-right: var(--inset); }
      .nav__status { font-size: 13px; color: var(--muted); display: inline-flex; align-items: center; gap: 8px; }
      .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); display: inline-block; box-shadow: 0 0 10px var(--accent); }
      .dot--live { margin-right: 8px; animation: pulse 2s ease-in-out infinite; }
      @keyframes pulse { 50% { opacity: .35; } }

      /* ---------- buttons: translucent fill, thin border, moving highlight ---------- */
      .btn { position: relative; overflow: hidden; display: inline-flex; align-items: center; justify-content: center; gap: 10px; height: 50px; padding: 0 22px; border-radius: 2px; font: 500 15px/1 'Geist', sans-serif; color: var(--fg); border: 1px solid var(--line); cursor: pointer; transition: border-color .35s, background .35s; }
      .btn--sm { height: 40px; padding: 0 16px; font-size: 14px; }
      .btn--block { width: 100%; }
      .btn--glass { background: rgb(6 16 24 / .5); backdrop-filter: blur(10px); border-color: rgb(226 242 246 / .28); }
      .btn--ghost { background: transparent; border-color: transparent; color: var(--muted); }
      .btn--ghost:hover { color: var(--fg); border-color: var(--line); }
      .btn--glass:hover { border-color: rgb(156 228 236 / .6); background: rgb(10 26 36 / .6); }
      .btn--sweep::after, .btn--glass:hover::after {
        content: ''; position: absolute; inset: 0; width: 40%;
        background: linear-gradient(100deg, transparent, rgb(156 228 236 / .22), transparent);
        transform: translateX(-120%); animation: sweep 4.5s var(--ease) 1.4s infinite;
      }
      .btn--glass:hover::after { animation-duration: 1.2s; animation-delay: 0s; }
      @keyframes sweep { 0% { transform: translateX(-120%); } 35%, 100% { transform: translateX(320%); } }

      /* ---------- hero ---------- */
      .stage--hero { min-height: max(100svh, 760px); }
      .hero { flex: 1; align-items: end; align-content: end; padding-bottom: 104px; padding-top: 48px; row-gap: 32px; }
      .hero__copy { grid-column: 1 / 10; padding-left: var(--inset); }
      .label { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 0 0 26px; font-size: 13px; color: var(--muted); letter-spacing: .01em; }
      .label__k { font-family: 'Geist Mono', monospace; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink); background: var(--accent); padding: 4px 7px; border-radius: 1px; }
      .sep { color: var(--dim); }
      .hero__title { margin: 0; font-weight: 500; font-size: clamp(46px, 7.6vw, 112px); line-height: .94; letter-spacing: -.048em; }
      .mask { display: block; overflow: hidden; padding-bottom: .06em; margin-bottom: -.06em; }
      .mask > span { display: block; }
      .js .mask > span { transform: translateY(105%); transition: transform 1.25s var(--ease) var(--d, 0s); }
      .js .mask.in > span { transform: none; }
      .js .reveal { opacity: 0; transform: translateY(14px); transition: opacity 1s var(--ease) var(--d, 0s), transform 1s var(--ease) var(--d, 0s); }
      .js .reveal.in { opacity: 1; transform: none; }
      .hero__lede { max-width: 44ch; margin: 28px 0 32px; font-size: 17px; color: var(--muted); font-weight: 300; }
      .hero__cta { display: flex; flex-wrap: wrap; gap: 10px; }

      .card { background: var(--glass); backdrop-filter: blur(14px) saturate(120%); border: 1px solid var(--line); position: relative; }
      .card::before { content: ''; position: absolute; left: -1px; right: -1px; top: -1px; height: 1px; background: linear-gradient(90deg, transparent, var(--accent), transparent); opacity: .7; }
      .tele { grid-column: 10 / 13; align-self: end; padding: 20px var(--inset) 22px; }
      .tele__head { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 16px; border-bottom: 1px solid var(--line-soft); }
      .tele__grid { display: grid; grid-template-columns: 1fr 1fr; margin: 0; }
      .tele__grid > div { padding: 16px 0 14px; border-bottom: 1px solid var(--line-soft); }
      .tele__grid > div:nth-child(odd) { border-right: 1px solid var(--line-soft); }
      .tele__grid > div:nth-child(even) { padding-left: 18px; }
      .tele__grid dt { font-size: 12px; color: var(--dim); margin-bottom: 4px; }
      .tele__grid dd { margin: 0; color: var(--muted); font-size: 13px; }
      .tele__grid b { color: var(--fg); font-weight: 400; font-size: 26px; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
      .tele__note { margin: 16px 0 0; font-size: 13px; color: var(--muted); line-height: 1.5; }
      .tele__note b { color: var(--fg); font-weight: 400; font-size: 12px; }

      .strip { height: 56px; position: absolute; bottom: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; padding: 0 var(--inset); color: var(--dim); }
      .strip__mid { display: inline-flex; align-items: center; gap: 10px; color: var(--muted); }
      .cue { width: 1px; height: 18px; background: linear-gradient(var(--accent), transparent); animation: cue 2.2s var(--ease) infinite; }
      @keyframes cue { 0% { transform: scaleY(0); transform-origin: top; } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }

      /* ---------- shared section heading ---------- */
      .h2 { margin: 0; font-weight: 500; font-size: clamp(38px, 5.2vw, 76px); line-height: .98; letter-spacing: -.045em; }

      /* ---------- halls ---------- */
      .stage--halls { min-height: max(100svh, 820px); }
      .wash--halls { background: linear-gradient(180deg, rgb(3 8 13 / .9) 0%, rgb(3 8 13 / .35) 30%, rgb(3 8 13 / .1) 50%, rgb(3 8 13 / .78) 78%, rgb(3 8 13 / .95) 100%), linear-gradient(90deg, rgb(3 8 13 / .5), transparent 60%); }
      .halls__top { padding-top: 120px; align-items: end; row-gap: 24px; }
      .halls__head { grid-column: 1 / 8; padding-left: var(--inset); }
      .halls__intro { grid-column: 10 / 13; margin: 0; padding: 0 var(--inset); font-size: 15px; color: var(--muted); font-weight: 300; }
      .halls__row { list-style: none; margin: auto auto 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
      .hall__link { position: relative; display: flex; flex-direction: column; height: 100%; padding: 26px var(--inset) 34px; transition: background .5s var(--ease); }
      .hall__link::before { content: ''; position: absolute; left: 0; right: 100%; top: -1px; height: 1px; background: var(--accent); transition: right .7s var(--ease); }
      .hall__link:hover, .hall__link:focus-visible { background: linear-gradient(180deg, rgb(156 228 236 / .07), rgb(3 8 13 / .2)); }
      .hall__link:hover::before, .hall__link:focus-visible::before { right: 0; }
      .hall__n { color: var(--accent); }
      .hall__depth { color: var(--dim); margin-top: 22px; }
      .gauge { position: relative; height: 3px; margin: 10px 0 26px; background: repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px 10%); }
      .gauge::after { content: ''; position: absolute; left: 0; right: 0; top: 1px; height: 1px; background: var(--line-soft); }
      .gauge__fill { position: absolute; top: 0; bottom: 0; background: var(--accent); box-shadow: 0 0 8px rgb(156 228 236 / .6); }
      .hall__name { margin: 0 0 10px; font-size: 24px; font-weight: 500; letter-spacing: -.03em; }
      .hall__body { color: var(--muted); font-size: 14px; font-weight: 300; line-height: 1.55; flex: 1; }
      .hall__go { margin-top: 22px; color: var(--muted); transition: color .3s, letter-spacing .5s var(--ease); }
      .hall__link:hover .hall__go { color: var(--fg); letter-spacing: .14em; }

      /* ---------- care ---------- */
      .stage--care { min-height: max(100svh, 760px); }
      .wash--care { background: linear-gradient(90deg, rgb(3 8 13 / .85) 0%, rgb(3 8 13 / .4) 50%, rgb(3 8 13 / .15) 100%), linear-gradient(0deg, rgb(3 8 13 / .95) 0%, rgb(3 8 13 / 0) 45%), linear-gradient(180deg, rgb(3 8 13 / .9) 0%, transparent 25%); }
      .care__body { flex: 1; align-content: end; padding: 120px 0 56px; }
      .care__label { grid-column: 1 / -1; padding-left: var(--inset); }
      .care__quote { grid-column: 1 / 10; margin: 0; padding-left: var(--inset); }
      .care__quote p { margin: 0; font-size: clamp(26px, 3.3vw, 46px); line-height: 1.16; letter-spacing: -.03em; font-weight: 400; color: var(--dim); }
      .care__quote .hi { color: var(--fg); }
      .care__quote footer { margin-top: 28px; color: var(--fg); }
      .proof { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0 auto; border-top: 1px solid var(--line); }
      .proof__cell { display: flex; flex-direction: column-reverse; justify-content: flex-end; padding: 24px var(--inset) 40px; }
      .proof__v { margin: 0 0 12px; font-size: clamp(34px, 3.6vw, 52px); letter-spacing: -.045em; font-weight: 400; line-height: 1; }
      .proof__k { font-size: 13px; color: var(--muted); max-width: 24ch; }
      .proof__cell:first-child .proof__v { color: var(--accent); }

      /* ---------- visit ---------- */
      .stage--visit { min-height: max(100svh, 820px); }
      .stage--visit .stage__media img { object-position: 50% 40%; }
      .wash--visit { background: linear-gradient(90deg, rgb(3 8 13 / .9) 0%, rgb(3 8 13 / .55) 45%, rgb(3 8 13 / .35) 100%), linear-gradient(0deg, rgb(3 8 13 / .9) 0%, transparent 50%), linear-gradient(180deg, rgb(3 8 13 / .9), transparent 22%); }
      .visit { flex: 1; align-items: end; padding: 140px 0 64px; row-gap: 40px; }
      .visit__copy { grid-column: 1 / 7; padding: 0 var(--inset); }
      .hours { width: 100%; margin-top: 40px; border-collapse: collapse; font-size: 14px; }
      .hours tr { border-top: 1px solid var(--line); }
      .hours tr:last-child { border-bottom: 1px solid var(--line); }
      .hours th { text-align: left; font-weight: 500; padding: 14px 0; }
      .hours td { color: var(--muted); padding: 14px 0; }
      .hours td.mono { text-align: right; color: var(--fg); }

      .ticket { grid-column: 7 / 13; display: grid; grid-template-columns: 1fr 1fr; }
      fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
      legend { float: left; width: 100%; padding: 0; margin-bottom: 14px; }
      legend + * { clear: both; }
      .ticket__types { padding: 22px var(--inset); border-right: 1px solid var(--line-soft); }
      .opt { display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: center; padding: 14px 14px; margin: 0 -14px; border: 1px solid transparent; cursor: pointer; transition: border-color .3s, background .3s; position: relative; }
      .opt + .opt { border-top-color: var(--line-soft); }
      .opt input, .slot input { position: absolute; opacity: 0; pointer-events: none; }
      .opt__main { display: flex; flex-direction: column; gap: 2px; }
      .opt__main b { font-weight: 500; font-size: 15px; }
      .opt__main span { font-size: 13px; color: var(--dim); }
      .opt__price { font-size: 13px; color: var(--muted); }
      .opt:has(input:checked) { border-color: rgb(156 228 236 / .45); background: rgb(156 228 236 / .06); }
      .opt:has(input:checked) .opt__price { color: var(--accent); }
      .opt:has(input:focus-visible), .slot:has(input:focus-visible) { outline: 1px solid var(--accent); outline-offset: 2px; }
      .ticket__side { padding: 22px var(--inset); display: flex; flex-direction: column; gap: 22px; }
      .slots__row { display: flex; flex-wrap: wrap; gap: 6px; }
      .slot { position: relative; cursor: pointer; }
      .slot span { display: inline-block; padding: 9px 10px; border: 1px solid var(--line); color: var(--muted); transition: all .3s; }
      .slot:hover span { color: var(--fg); }
      .slot input:checked + span { border-color: var(--accent); color: var(--ink); background: var(--accent); }
      .ticket__total { display: flex; align-items: baseline; justify-content: space-between; border-top: 1px solid var(--line-soft); padding-top: 18px; margin-top: auto; }
      .ticket__price { font-size: 40px; letter-spacing: -.04em; line-height: 1; }
      .ticket__msg { margin: 0; min-height: 1.5em; color: var(--accent); text-transform: none; letter-spacing: .02em; line-height: 1.5; }

      /* ---------- footer ---------- */
      .foot { position: relative; background: var(--ink); padding: 72px 0 80px; overflow: hidden; }
      .foot__in { padding: 0; }
      .foot__mark { margin: 0 0 40px; padding-left: var(--inset); font-size: clamp(56px, 14.6vw, 210px); font-weight: 600; letter-spacing: -.05em; line-height: .86; text-transform: uppercase; color: transparent; background: linear-gradient(180deg, rgb(226 242 246 / .2), rgb(226 242 246 / .02) 90%); -webkit-background-clip: text; background-clip: text; }
      .foot__row { display: grid; grid-template-columns: repeat(4, 1fr); row-gap: 14px; color: var(--muted); border-top: 1px solid var(--line); padding-top: 22px; }
      .foot__row > * { padding-inline: var(--inset); }
      .foot__row a:hover { color: var(--accent); }

      /* ---------- responsive ---------- */
      @media (max-width: 1080px) {
        .nav__status { display: none; }
        .hero__copy { grid-column: 1 / -1; }
        .tele { grid-column: 7 / 13; }
        .halls__head { grid-column: 1 / -1; }
        .halls__intro { grid-column: 1 / 9; }
        .halls__row { grid-template-columns: repeat(2, 1fr); }
        .hall:nth-child(n+3) { border-top: 1px solid var(--line-soft); }
        .care__quote { grid-column: 1 / -1; }
        .proof { grid-template-columns: repeat(2, 1fr); }
        .visit__copy, .ticket { grid-column: 1 / -1; }
      }
      @media (max-width: 720px) {
        .nav { grid-template-columns: 1fr auto; height: 72px; }
        .nav__links { display: none; }
        .stage--hero { min-height: 100svh; }
        .stage--hero .rails { --rt: 72px !important; }
        .stage--hero .stage__media img { object-position: 70% 30%; }
        .hero { padding-top: 120px; padding-bottom: 80px; }
        .hero__lede { font-size: 16px; margin: 20px 0 24px; }
        .hero__cta .btn--ghost { display: none; }
        .tele { grid-column: 1 / -1; padding-block: 14px 4px; }
        .tele__head { padding-bottom: 10px; }
        .tele__grid { grid-template-columns: repeat(4, 1fr); }
        .tele__grid > div, .tele__grid > div:nth-child(even) { padding: 10px 0 10px 10px; border: 0; border-right: 1px solid var(--line-soft); }
        .tele__grid > div:first-child { padding-left: 0; }
        .tele__grid > div:last-child { border-right: 0; }
        .tele__grid b { font-size: 19px; }
        .tele__grid dd { font-size: 11px; }
        .tele__note { display: none; }
        .wash:not(.wash--hero) { background-color: rgb(3 8 13 / .35); }
        .hall__link { background: rgb(3 8 13 / .42); backdrop-filter: blur(6px); }
        .strip > :first-child, .strip > :last-child { display: none; }
        .strip { justify-content: center; }
        .halls__top { padding-top: 104px; }
        .halls__intro { grid-column: 1 / -1; }
        .halls__row { grid-template-columns: 1fr; margin-top: 48px; }
        .hall + .hall { border-top: 1px solid var(--line-soft); }
        .hall__link { padding-bottom: 26px; }
        .care__body { padding-top: 104px; }
        .proof__cell { padding-bottom: 28px; }
        .visit { padding-top: 104px; }
        .ticket { grid-template-columns: 1fr; }
        .ticket__types { border-right: 0; border-bottom: 1px solid var(--line-soft); }
        .foot__row { grid-template-columns: 1fr; }
        .hours tr { display: grid; grid-template-columns: 1fr auto; align-items: center; padding: 12px 0; }
        .hours th, .hours td { padding: 0; }
        .hours td:nth-child(2) { grid-row: 2; font-size: 13px; }
        .hours td.mono { grid-column: 2; grid-row: 1 / 3; }
      }
      @media (prefers-reduced-motion: reduce) {
        .stage--hero .stage__media img, .btn::after, .cue, .dot--live { animation: none !important; }
        .js .mask > span, .js .reveal { transition: none; transform: none; opacity: 1; }
      }
    </style>
  </body>
</html>
