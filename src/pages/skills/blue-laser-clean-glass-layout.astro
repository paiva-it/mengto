---
import '../../styles/global.css';
import BackPill from '../../components/BackPill.astro';

const meta = [
  ['Laser', '450 nm line · Class 1'],
  ['Pass', '3 of 5 · dorsal'],
  ['Elapsed', '02:14:09', 'elapsed'],
  ['In the room', '38 visitors'],
];

const bays = [
  ['Bay 1', 'Strata Hall', 'Idle'],
  ['Bay 2', 'Abyssal Room', 'Curing'],
  ['Bay 3', 'Open Scan Room', 'Live'],
  ['Bay 4', 'Drawer Annex', 'Queued'],
];

const metrics = [
  ['Scanned this season', '312', 'specimens', '+9 this week'],
  ['Points tonight', '25.6M', 'measured', 'pass 3 running'],
  ['Mean deviation', '0.038', 'mm', 'inside ±0.05 spec'],
  ['Watching now', '38', 'visitors', 'cap 60'],
];

const rows = [
  ['CMN-P 4412', 'Platypterygius skull', 'Albian, 104 Ma', '25.6M', 'Scanning'],
  ['CMN-V 1187', 'Smilodon fatalis mandible', 'Pleistocene, 13 ka', '11.2M', 'Meshing'],
  ['CMN-I 0931', 'Meganeura wing, slab', 'Carboniferous, 300 Ma', '4.8M', 'Queued'],
  ['CMN-M 2205', 'Narwhal tusk, sinistral whorl', 'Collected 1931', '9.4M', 'Published'],
  ['CMN-P 0078', 'Walliserops trilobite', 'Devonian, 400 Ma', '6.1M', 'Published'],
];

const events = [
  ['21:42', 'Pass 3 started', 'Dorsal aspect, turntable at 0.25° steps.'],
  ['21:38', 'Turntable recalibrated', 'Drift of 0.006° corrected against the reference sphere.'],
  ['21:20', 'Climate steady', '18.2 °C, 41 % RH. Matrix is stable.'],
  ['21:05', 'Pass 2 merged', '17.9M points aligned, residual 0.031 mm.'],
  ['20:51', 'Doors opened', '22 visitors took the gallery bench.'],
];

const steps = [
  ['01', 'Out of the drawer', 'A conservator lifts the specimen into a foam cradle cut to its shape the week before. Nitrile gloves, no metal, nothing that warms the bone.'],
  ['02', 'One thin line, many passes', 'A 450 nm line sweeps the surface while the turntable steps a quarter of a degree. Five passes, five aspects, roughly two hours each.'],
  ['03', 'Points become a surface', 'Overnight the passes are aligned and meshed. Anything outside ±0.05 mm is flagged and rescanned before the model is signed off.'],
  ['04', 'Back home, open to all', 'The bone returns to its drawer by morning. The model goes online under CC BY, free to print, measure or teach with.'],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lightline — The Open Scan Room · Corvane Museum of Natural History</title>
    <meta
      name="description"
      content="Lightline is Corvane Museum's open scan room: watch conservators laser-scan a fossil every night, then walk the model."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <canvas id="laser" aria-hidden="true"></canvas>
    <div class="vignette" aria-hidden="true"></div>

    <div class="page">
      <header class="nav-wrap">
        <nav class="nav glass" aria-label="Primary">
          <a class="brand" href="#top"><span class="dot"></span>Corvane <span class="brand-sub">Museum of Natural History</span></a>
          <ul class="links">
            <li><a href="#console">Scan room</a></li>
            <li><a href="#process">Process</a></li>
            <li><a href="#visit">Visit</a></li>
          </ul>
          <a class="btn btn-blue btn-sm" href="#visit">Book entry</a>
        </nav>
      </header>

      <main class="frame" id="top">
        <span class="corner tl"></span><span class="corner tr"></span>

        <section class="hero">
          <div class="hero-copy">
            <p class="eyebrow"><span class="live"></span>Exhibit 07 · Lightline · East Wing</p>
            <h1>
              <span class="mask"><span>Every bone,</span></span>
              <span class="mask"><span>read by a line</span></span>
              <span class="mask"><span class="muted-h">of light.</span></span>
            </h1>
            <p class="lede">
              Behind the glass of the Open Scan Room, our conservators laser-scan one fossil a night. Watch a
              104-million-year-old ichthyosaur skull become forty million measured points, then walk the model before the
              bone goes back to its drawer.
            </p>
            <div class="ctas">
              <a class="btn btn-blue" href="#visit">Book a timed entry</a>
              <a class="btn btn-glass" href="#console">Watch tonight's scan</a>
            </div>
          </div>

          <div class="floaters" aria-label="Tonight's scan">
            <article class="card glass f1">
              <div class="card-head">
                <span class="label"><span class="live"></span>Now scanning</span>
                <span class="mono dim small">Bay 3</span>
              </div>
              <p class="spec">Platypterygius skull</p>
              <p class="mono dim small">CMN-P 4412 · Albian, 104 Ma</p>
              <div class="bar" role="progressbar" aria-valuenow="62" aria-valuemin="0" aria-valuemax="100" aria-label="Pass 3 progress">
                <span style="width:62%"></span>
              </div>
              <div class="row-between mono small"><span class="dim">Pass 3 / 5</span><span>62 %</span></div>
            </article>

            <article class="card glass f2">
              <div class="card-head">
                <span class="label">Point cloud</span>
                <span class="chip">±0.04 mm</span>
              </div>
              <p class="big"><span id="pts">25,614,208</span></p>
              <p class="mono dim small">points captured tonight</p>
              <div class="spark" aria-hidden="true">
                {[22, 34, 30, 48, 41, 56, 52, 64, 58, 72, 69, 84, 78, 90].map((h) => <span style={`height:${h}%`}></span>)}
              </div>
            </article>

            <div class="pill glass f3">
              <span class="live"></span><span class="mono small">18.2 °C · 41 % RH · stable</span>
            </div>
          </div>

          <dl class="meta">
            {meta.map(([k, v, id]) => (
              <div>
                <dt>{k}</dt>
                <dd id={id}>{v}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="section" id="console" aria-labelledby="console-h">
          <span class="corner tl"></span><span class="corner tr"></span>
          <div class="section-head">
            <p class="eyebrow">02 · What the conservators see</p>
            <h2 id="console-h">The scan room console, in public.</h2>
            <p class="sub">
              The same screen the night team works from is mirrored onto the gallery wall. Nothing is staged: if a pass drifts,
              you watch it get rescanned.
            </p>
          </div>

          <div class="shell glass">
            <div class="shell-top">
              <div class="shell-title"><span class="dot"></span>Lightline Console</div>
              <div class="tabs" role="tablist" aria-label="Console views">
                <button role="tab" aria-selected="false">Queue</button>
                <button role="tab" aria-selected="true">Live</button>
                <button role="tab" aria-selected="false">Archive</button>
              </div>
              <label class="search">
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.4"/></svg>
                <span class="sr">Search the collection</span>
                <input type="search" placeholder="Catalogue no., taxon, drawer…" />
              </label>
            </div>

            <div class="shell-body">
              <aside class="side">
                <p class="label">Gallery bays</p>
                <ul>
                  {bays.map(([b, n, s]) => (
                    <li class={s === 'Live' ? 'on' : ''}>
                      <span class="mono dim small">{b}</span>
                      <span class="bay-name">{n}</span>
                      <span class={`state s-${s.toLowerCase()}`}>{s}</span>
                    </li>
                  ))}
                </ul>
                <div class="operator">
                  <p class="label">Tonight's operator</p>
                  <p>R. Okafor-Lind</p>
                  <p class="dim small">Senior conservator, vertebrate palaeontology</p>
                </div>
              </aside>

              <div class="main-col">
                <div class="metrics">
                  {metrics.map(([k, v, u, n]) => (
                    <div class="metric">
                      <p class="label">{k}</p>
                      <p class="m-val">{v} <span class="m-unit">{u}</span></p>
                      <p class="mono small blue">{n}</p>
                    </div>
                  ))}
                </div>

                <div class="table-wrap">
                  <table>
                    <caption class="sr">Specimen scan queue</caption>
                    <thead>
                      <tr><th scope="col">Catalogue</th><th scope="col">Specimen</th><th scope="col">Points</th><th scope="col">Status</th></tr>
                    </thead>
                    <tbody>
                      {rows.map(([c, s, a, p, st]) => (
                        <tr>
                          <td class="mono">{c}</td>
                          <td>{s}<span class="age">{a}</span></td>
                          <td class="mono">{p}</td>
                          <td><span class={`state s-${st.toLowerCase()}`}>{st}</span></td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>

              <aside class="stream">
                <p class="label"><span class="live"></span>Event stream</p>
                <ol>
                  {events.map(([t, h, d]) => (
                    <li>
                      <span class="mono small blue">{t}</span>
                      <p class="ev-h">{h}</p>
                      <p class="dim small">{d}</p>
                    </li>
                  ))}
                </ol>
              </aside>
            </div>
          </div>
        </section>

        <section class="section" id="process" aria-labelledby="process-h">
          <span class="corner tl"></span><span class="corner tr"></span>
          <div class="section-head split">
            <div>
              <p class="eyebrow">03 · From drawer to light</p>
              <h2 id="process-h">One night, four careful hands-offs.</h2>
            </div>
            <p class="sub">
              Lightline exists because most of the collection never leaves its drawers. A scan is the gentlest way we know to
              let three million specimens be studied without being handled.
            </p>
          </div>
          <ol class="steps">
            {steps.map(([n, h, d]) => (
              <li class="card glass step">
                <span class="mono blue">{n}</span>
                <h3>{h}</h3>
                <p class="dim">{d}</p>
              </li>
            ))}
          </ol>
          <dl class="stats">
            <div><dt>Specimens published</dt><dd>3,904</dd></div>
            <div><dt>Points on record</dt><dd>14.2 TB</dd></div>
            <div><dt>Downloads last year</dt><dd>211k</dd></div>
          </dl>
        </section>

        <section class="section" id="visit" aria-labelledby="visit-h">
          <span class="corner tl"></span><span class="corner tr"></span>
          <div class="visit glass">
            <div>
              <p class="eyebrow"><span class="live"></span>04 · Visit</p>
              <h2 id="visit-h">Sit on the gallery bench for a pass.</h2>
              <p class="sub">
                Lightline is included with museum admission. Evening scans run late on Thursdays and Fridays; entry is timed
                so the room never holds more than sixty.
              </p>
              <div class="ctas">
                <a class="btn btn-blue" href="#top">Book a timed entry</a>
                <a class="btn btn-glass" href="#console">Browse the models</a>
              </div>
            </div>
            <dl class="hours">
              <div><dt>Tue – Sun</dt><dd>10:00 – 18:00</dd></div>
              <div><dt>Late scans · Thu, Fri</dt><dd>until 22:00</dd></div>
              <div><dt>Admission</dt><dd>Included · £14</dd></div>
              <div><dt>Where</dt><dd>East Wing, level 2</dd></div>
            </dl>
          </div>
        </section>

        <footer class="foot">
          <span class="mono small dim">Corvane Museum of Natural History · 14 Hollis Embankment</span>
          <span class="mono small dim">Lightline is a fictional exhibit.</span>
        </footer>
      </main>
    </div>

    <BackPill />

    <style is:global>
      :root {
        --bg: #05070c;
        --ink: #f3f5fa;
        --muted: #8b93a7;
        --dim: #5d6579;
        --blue: #5b7cff;
        --blue-hi: #8fa6ff;
        --line: rgb(255 255 255 / 0.07);
        --display: 'Inter Tight', ui-sans-serif, system-ui, sans-serif;
        --sans: 'Inter', ui-sans-serif, system-ui, sans-serif;
        --mono: 'JetBrains Mono', ui-monospace, monospace;
      }
      html { background: var(--bg); scroll-behavior: smooth; }
      body { margin: 0; color: var(--ink); font-family: var(--sans); background: var(--bg); overflow-x: hidden; -webkit-font-smoothing: antialiased; }
      #laser { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; display: block;
        background: radial-gradient(60% 50% at 70% 20%, #121a33 0%, transparent 70%), var(--bg); }
      .vignette { position: fixed; inset: 0; z-index: 0; pointer-events: none;
        background: linear-gradient(90deg, rgb(5 7 12 / 0.7), transparent 45%), linear-gradient(0deg, rgb(5 7 12 / 0.5), transparent 30%); }
      .page { position: relative; z-index: 1; }

      a { color: inherit; text-decoration: none; }
      :focus-visible { outline: 2px solid var(--blue-hi); outline-offset: 3px; border-radius: 6px; }
      .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      .mono { font-family: var(--mono); letter-spacing: -0.01em; }
      .small { font-size: 12px; }
      .dim { color: var(--muted); }
      .blue { color: var(--blue-hi); }
      .row-between { display: flex; justify-content: space-between; }

      /* glass + border-gradient wrapper */
      .glass {
        border: 1px solid transparent;
        background:
          linear-gradient(180deg, rgb(14 18 30 / 0.66), rgb(8 10 18 / 0.54)) padding-box,
          linear-gradient(155deg, rgb(255 255 255 / 0.2), rgb(255 255 255 / 0.04) 38%, rgb(255 255 255 / 0.03) 62%, rgb(111 140 255 / 0.32)) border-box;
        backdrop-filter: blur(16px) saturate(130%);
        -webkit-backdrop-filter: blur(16px) saturate(130%);
        box-shadow: 0 1px 0 rgb(255 255 255 / 0.04) inset, 0 30px 60px -30px rgb(0 0 0 / 0.8);
      }

      .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--blue); box-shadow: 0 0 10px var(--blue); display: inline-block; }
      .live { width: 6px; height: 6px; border-radius: 50%; background: var(--blue-hi); display: inline-block; margin-right: 8px;
        box-shadow: 0 0 0 3px rgb(91 124 255 / 0.18), 0 0 10px var(--blue); animation: blink 2.4s ease-in-out infinite; vertical-align: middle; }
      @keyframes blink { 50% { opacity: 0.45; } }

      .label, .eyebrow, dt, th { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); font-weight: 500; }
      .eyebrow { margin: 0 0 22px; display: flex; align-items: center; }

      /* nav */
      .nav-wrap { position: sticky; top: 0; z-index: 10; padding: 16px 16px 0; }
      .nav { max-width: 1180px; margin: 0 auto; display: flex; align-items: center; gap: 24px; padding: 8px 8px 8px 20px; border-radius: 999px; }
      .brand { display: flex; align-items: center; gap: 10px; font-family: var(--display); font-weight: 600; font-size: 15px; letter-spacing: -0.01em; white-space: nowrap; }
      .brand-sub { color: var(--muted); font-weight: 500; }
      .links { display: flex; gap: 4px; list-style: none; margin: 0 0 0 auto; padding: 0; }
      .links a { display: block; padding: 8px 14px; border-radius: 999px; font-size: 14px; color: #c9cfdc; transition: background 0.2s, color 0.2s; }
      .links a:hover { background: rgb(255 255 255 / 0.06); color: #fff; }

      .btn { display: inline-flex; align-items: center; justify-content: center; height: 46px; padding: 0 22px; border-radius: 999px; font-size: 14.5px; font-weight: 500; transition: filter 0.2s, background 0.2s, box-shadow 0.2s; white-space: nowrap; }
      .btn-sm { height: 38px; padding: 0 18px; font-size: 13.5px; }
      .btn-blue { background: linear-gradient(180deg, #6d8bff, #3f5ef0); color: #fff; box-shadow: 0 0 0 1px rgb(150 170 255 / 0.4) inset, 0 10px 30px -8px rgb(70 100 255 / 0.65); }
      .btn-blue:hover { filter: brightness(1.12); }
      .btn-glass { background: rgb(255 255 255 / 0.04); border: 1px solid rgb(255 255 255 / 0.14); backdrop-filter: blur(12px); color: #e6e9f2; }
      .btn-glass:hover { background: rgb(255 255 255 / 0.09); }

      /* frame rails */
      .frame { position: relative; max-width: 1240px; margin: 0 auto; border-inline: 1px solid var(--line); }
      .corner { position: absolute; top: -4px; width: 7px; height: 7px; border: 1px solid rgb(143 166 255 / 0.55); background: var(--bg); }
      .corner.tl { left: -4px; } .corner.tr { right: -4px; }

      /* hero */
      .hero { position: relative; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 32px; padding: 96px 56px 0; min-height: calc(100svh - 70px); box-sizing: border-box; align-content: start; }
      h1 { font-family: var(--display); font-weight: 600; font-size: clamp(50px, 7.4vw, 108px); line-height: 0.92; letter-spacing: -0.055em; margin: 0; }
      .mask { display: block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; }
      .mask > span { display: inline-block; animation: rise 1.1s cubic-bezier(0.2, 0.7, 0.1, 1) backwards; }
      .mask:nth-child(2) > span { animation-delay: 0.08s; }
      .mask:nth-child(3) > span { animation-delay: 0.16s; }
      .muted-h { color: #9aa6c8; }
      @keyframes rise { from { transform: translateY(105%); } }
      .lede { max-width: 520px; color: #a3abbd; font-size: 17px; line-height: 1.6; margin: 28px 0 0; }
      .ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }

      .floaters { position: relative; min-height: 460px; }
      .card { border-radius: 20px; padding: 20px; }
      .card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
      .card-head .label { display: flex; align-items: center; }
      .f1 { position: absolute; top: 20px; right: 0; width: 300px; animation: drift 9s ease-in-out infinite; }
      .f2 { position: absolute; top: 236px; left: 0; width: 270px; animation: drift 11s ease-in-out -4s infinite; }
      .f3 { position: absolute; top: 410px; right: 24px; animation: drift 10s ease-in-out -2s infinite; }
      @keyframes drift { 50% { transform: translateY(-8px); } }
      .spec { font-family: var(--display); font-size: 21px; font-weight: 600; letter-spacing: -0.02em; margin: 0 0 4px; }
      .card p { margin: 0; }
      .bar { height: 4px; border-radius: 4px; background: rgb(255 255 255 / 0.07); margin: 18px 0 10px; overflow: hidden; }
      .bar span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #3f5ef0, #a8b8ff); box-shadow: 0 0 12px var(--blue); }
      .chip { font-family: var(--mono); font-size: 11px; padding: 4px 8px; border-radius: 999px; color: var(--blue-hi); background: rgb(91 124 255 / 0.12); border: 1px solid rgb(91 124 255 / 0.3); }
      .big { font-family: var(--display); font-size: 34px; font-weight: 600; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
      .spark { display: flex; align-items: flex-end; gap: 4px; height: 44px; margin-top: 16px; }
      .spark span { flex: 1; border-radius: 2px; background: linear-gradient(180deg, rgb(143 166 255 / 0.9), rgb(91 124 255 / 0.15)); }
      .pill { display: inline-flex; align-items: center; padding: 10px 16px; border-radius: 999px; color: #c9cfdc; }

      .meta { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, 1fr); margin: 40px -56px 0; border-top: 1px solid var(--line); }
      .meta div { padding: 20px 56px 22px; border-right: 1px solid var(--line); }
      .meta div:last-child { border-right: 0; }
      .meta dd { margin: 8px 0 0; font-family: var(--mono); font-size: 14px; color: #dfe4ef; font-variant-numeric: tabular-nums; }

      /* sections */
      .section { position: relative; padding: 112px 56px; border-top: 1px solid var(--line); }
      .section-head { max-width: 760px; margin-bottom: 48px; }
      .section-head.split { max-width: none; display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: end; }
      h2 { font-family: var(--display); font-weight: 600; font-size: clamp(34px, 4.6vw, 60px); line-height: 1; letter-spacing: -0.045em; margin: 0; }
      .sub { color: #a3abbd; font-size: 16.5px; line-height: 1.6; margin: 20px 0 0; max-width: 560px; }
      .split .sub { margin: 0; }

      /* dashboard shell */
      .shell { border-radius: 24px; overflow: hidden; }
      .shell-top { display: flex; align-items: center; gap: 20px; padding: 14px 18px; border-bottom: 1px solid var(--line); background: rgb(255 255 255 / 0.02); }
      .shell-title { display: flex; align-items: center; gap: 10px; font-weight: 500; font-size: 14px; white-space: nowrap; }
      .tabs { display: flex; gap: 2px; padding: 3px; border-radius: 999px; background: rgb(0 0 0 / 0.3); border: 1px solid var(--line); }
      .tabs button { font: 500 13px var(--sans); color: var(--muted); background: none; border: 0; padding: 6px 14px; border-radius: 999px; cursor: pointer; }
      .tabs button[aria-selected='true'] { color: #fff; background: rgb(91 124 255 / 0.2); box-shadow: 0 0 0 1px rgb(91 124 255 / 0.35) inset; }
      .search { margin-left: auto; display: flex; align-items: center; gap: 8px; height: 36px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line); background: rgb(0 0 0 / 0.25); color: var(--muted); min-width: 0; width: 280px; }
      .search input { all: unset; font-size: 13px; color: #fff; width: 100%; }
      .search:focus-within { border-color: rgb(91 124 255 / 0.6); }

      .shell-body { display: grid; grid-template-columns: 210px minmax(0, 1fr) 260px; }
      .side, .stream { padding: 20px 18px; }
      .side { border-right: 1px solid var(--line); }
      .stream { border-left: 1px solid var(--line); }
      .side ul, .stream ol { list-style: none; margin: 14px 0 0; padding: 0; }
      .side li { display: grid; grid-template-columns: 1fr auto; row-gap: 2px; padding: 10px 12px; border-radius: 12px; margin-bottom: 4px; border: 1px solid transparent; }
      .side li .mono { grid-column: 1; }
      .side li .bay-name { grid-column: 1; font-size: 14px; }
      .side li .state { grid-column: 2; grid-row: 1 / 3; align-self: center; }
      .side li.on { background: rgb(91 124 255 / 0.08); border-color: rgb(91 124 255 / 0.25); }
      .operator { margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--line); }
      .operator p:not(.label) { margin: 0 0 4px; font-size: 14px; }
      .operator .label { margin-bottom: 10px; }

      .state { font-family: var(--mono); font-size: 11px; padding: 3px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); white-space: nowrap; }
      .s-live, .s-scanning { color: #c7d2ff; border-color: rgb(91 124 255 / 0.45); background: rgb(91 124 255 / 0.14); }
      .s-meshing, .s-curing { color: #b3bccf; border-color: rgb(255 255 255 / 0.14); }
      .s-published { color: #9fb0d8; }

      .main-col { padding: 20px; min-width: 0; }
      .metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
      .metric { padding: 16px; border-radius: 16px; border: 1px solid var(--line); background: linear-gradient(180deg, rgb(255 255 255 / 0.035), rgb(255 255 255 / 0.01)); transition: border-color 0.25s, background 0.25s; }
      .metric:hover { border-color: rgb(91 124 255 / 0.35); }
      .metric p { margin: 0; }
      .m-val { font-family: var(--display); font-size: 30px; font-weight: 600; letter-spacing: -0.04em; margin: 10px 0 6px !important; }
      .m-unit { font-family: var(--sans); font-size: 13px; color: var(--muted); letter-spacing: 0; font-weight: 400; }

      .table-wrap { margin-top: 16px; border: 1px solid var(--line); border-radius: 16px; overflow-x: auto; }
      table { width: 100%; border-collapse: collapse; font-size: 13.5px; min-width: 520px; }
      th { text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--line); background: rgb(255 255 255 / 0.02); }
      td { padding: 12px 16px; border-bottom: 1px solid var(--line); white-space: nowrap; }
      tbody tr:last-child td { border-bottom: 0; }
      tbody tr { transition: background 0.2s; }
      tbody tr:hover { background: rgb(91 124 255 / 0.05); }

      .age { display: block; font-size: 12px; color: var(--dim); margin-top: 2px; }
      .stream .label { display: flex; align-items: center; }
      .stream li { position: relative; padding: 0 0 16px 16px; border-left: 1px solid var(--line); }
      .stream li::before { content: ''; position: absolute; left: -3px; top: 5px; width: 5px; height: 5px; border-radius: 50%; background: #2a3350; }
      .stream li:first-child::before { background: var(--blue-hi); box-shadow: 0 0 8px var(--blue); }
      .stream li:last-child { padding-bottom: 0; }
      .stream p { margin: 2px 0 0; }
      .ev-h { font-size: 14px; }

      /* process */
      .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
      .step { padding: 24px; min-height: 240px; display: flex; flex-direction: column; transition: transform 0.35s, box-shadow 0.35s; }
      .step:hover { transform: translateY(-3px); }
      .step h3 { font-family: var(--display); font-size: 21px; font-weight: 600; letter-spacing: -0.025em; margin: 56px 0 10px; }
      .step p { margin: 0; font-size: 14.5px; line-height: 1.55; }
      .stats { display: grid; grid-template-columns: repeat(3, 1fr); margin: 56px -56px -112px; border-top: 1px solid var(--line); }
      .stats div { padding: 28px 56px 32px; border-right: 1px solid var(--line); }
      .stats div:last-child { border-right: 0; }
      .stats dd { margin: 10px 0 0; font-family: var(--display); font-weight: 600; font-size: clamp(36px, 4.4vw, 56px); letter-spacing: -0.05em; }

      /* visit */
      .visit { border-radius: 28px; padding: 48px; display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; align-items: center; }
      .hours { margin: 0; }
      .hours div { display: flex; justify-content: space-between; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line); }
      .hours div:last-child { border-bottom: 0; }
      .hours dd { margin: 0; font-size: 15px; text-align: right; }

      .foot { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 28px 56px 80px; border-top: 1px solid var(--line); }

      @media (max-width: 1100px) {
        .shell-body { grid-template-columns: 200px minmax(0, 1fr); }
        .stream { grid-column: 1 / -1; border-left: 0; border-top: 1px solid var(--line); }
        .stream ol { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0 16px; }
        .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      }
      @media (max-width: 860px) {
        .links, .brand-sub { display: none; }
        .nav { justify-content: space-between; }
        .hero { grid-template-columns: 1fr; padding: 64px 24px 0; min-height: 0; }
        .floaters { min-height: 0; display: grid; gap: 12px; margin-top: 16px; }
        .f1, .f2, .f3 { position: static; width: auto; }
        .f3 { justify-self: start; }
        .meta { grid-template-columns: repeat(2, 1fr); margin: 32px -24px 0; }
        .meta div { padding: 16px 24px; border-bottom: 1px solid var(--line); }
        .meta div:nth-child(2n) { border-right: 0; }
        .section { padding: 80px 24px; }
        .section-head.split { grid-template-columns: 1fr; gap: 20px; }
        .shell-top { flex-wrap: wrap; }
        .search { width: 100%; margin-left: 0; }
        .shell-body { grid-template-columns: 1fr; }
        .side { border-right: 0; border-bottom: 1px solid var(--line); }
        .side ul { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
        .side li { margin: 0; }
        .operator { display: none; }
        .main-col { padding: 16px; }
        .steps { grid-template-columns: 1fr; }
        .step { min-height: 0; }
        .step h3 { margin-top: 28px; }
        .corner { display: none; }
        .hero-copy { padding-right: 36px; }
        .stats { grid-template-columns: 1fr; margin: 48px -24px -80px; }
        .stats div { padding: 20px 24px; border-right: 0; border-bottom: 1px solid var(--line); }
        .visit { grid-template-columns: 1fr; padding: 28px 22px; gap: 28px; }
        .foot { padding: 24px 24px 80px; }
      }
      @media (max-width: 420px) {
        .tabs { order: 3; }
        .metric { padding: 14px 12px; }
        .m-val { font-size: 25px; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition: none !important; }
        html { scroll-behavior: auto; }
      }
    </style>

    <script>
      // Fixed laser atmosphere: 18 slow procedural wave bands + one narrow moving signal beam with smoke.
      const canvas = document.getElementById('laser') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const BANDS = 18;
      let w = 0, h = 0, dpr = 1, raf = 0;

      // Smoke puffs drift up along the beam; positions are a fraction of beam length.
      const puffs = Array.from({ length: 9 }, (_, i) => ({ t: i / 9, r: 90 + Math.random() * 120, s: 0.00002 + Math.random() * 0.00002, o: Math.random() * 6 }));

      function resize() {
        dpr = Math.min(devicePixelRatio || 1, 1.75);
        w = innerWidth; h = innerHeight;
        canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      }

      // Beam is a slanted line; x at a given y.
      function beam(t: number) {
        const mobile = w < 860;
        const base = mobile ? 0.93 : 0.66;
        const cx = w * (base + (mobile ? 0.025 : 0.1) * Math.sin(t * 0.00011));
        const slant = w * (mobile ? 0.025 : 0.07);
        return { top: cx + slant, bot: cx - slant, at: (y: number) => cx + slant - (2 * slant * y) / h };
      }

      function draw(t: number) {
        if (!ctx) return;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, w, h);
        const b = beam(t);
        const pulse = 0.88 + 0.12 * Math.sin(t * 0.0016);

        // wave bands
        ctx.globalCompositeOperation = 'source-over';
        for (let i = 0; i < BANDS; i++) {
          const k = i / (BANDS - 1);
          const y0 = h * (0.3 + 0.68 * k);
          const amp = 10 + 26 * k;
          ctx.beginPath();
          for (let x = 0; x <= w + 20; x += 20) {
            const y = y0 + Math.sin(x * 0.0032 + t * 0.00018 + i * 0.55) * amp + Math.sin(x * 0.0011 - t * 0.00011 + i) * amp * 0.6;
            x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
          }
          ctx.strokeStyle = `rgba(110, 135, 255, ${0.035 + 0.075 * (1 - Math.abs(k - 0.55))})`;
          ctx.lineWidth = 1;
          ctx.stroke();
        }

        ctx.globalCompositeOperation = 'lighter';

        // smoke / fog hugging the beam
        for (const p of puffs) {
          const f = (p.t + (reduced ? 0 : t * p.s)) % 1;
          const y = h * (1 - f);
          const x = b.at(y) + Math.sin(t * 0.0003 + p.o) * 40;
          const r = p.r * (0.7 + f * 0.6);
          const g = ctx.createRadialGradient(x, y, 0, x, y, r);
          const a = 0.05 * Math.sin(f * Math.PI) * pulse;
          g.addColorStop(0, `rgba(90, 120, 255, ${a})`);
          g.addColorStop(1, 'rgba(90, 120, 255, 0)');
          ctx.fillStyle = g;
          ctx.fillRect(x - r, y - r, r * 2, r * 2);
        }

        // beam: wide soft halo, tight blue glow, white-hot core — thickness separate from glow
        const passes: [number, string][] = [
          [70, `rgba(60, 90, 255, ${0.035 * pulse})`],
          [26, `rgba(80, 110, 255, ${0.08 * pulse})`],
          [8, `rgba(110, 140, 255, ${0.3 * pulse})`],
          [3, `rgba(170, 190, 255, ${0.65 * pulse})`],
          [1.2, `rgba(255, 255, 255, ${0.95})`],
        ];
        ctx.lineCap = 'round';
        for (const [lw, c] of passes) {
          ctx.beginPath();
          ctx.moveTo(b.top, -20);
          ctx.lineTo(b.bot, h + 20);
          ctx.strokeStyle = c;
          ctx.lineWidth = lw;
          ctx.stroke();
        }

        // scan points where each band crosses the beam
        for (let i = 0; i < BANDS; i += 2) {
          const k = i / (BANDS - 1);
          const y = h * (0.3 + 0.68 * k);
          const x = b.at(y);
          const g = ctx.createRadialGradient(x, y, 0, x, y, 14);
          g.addColorStop(0, `rgba(200, 215, 255, ${0.5 * pulse})`);
          g.addColorStop(1, 'rgba(90, 120, 255, 0)');
          ctx.fillStyle = g;
          ctx.fillRect(x - 14, y - 14, 28, 28);
        }

        // bloom at the top where the beam enters
        const bl = ctx.createRadialGradient(b.top, 0, 0, b.top, 0, h * 0.5);
        bl.addColorStop(0, `rgba(80, 110, 255, ${0.16 * pulse})`);
        bl.addColorStop(1, 'rgba(80, 110, 255, 0)');
        ctx.fillStyle = bl;
        ctx.fillRect(0, 0, w, h * 0.5);
      }

      // ponytail: motion is slow, so ~30 fps is plenty and halves the backdrop-blur repaint cost.
      let last = 0;
      function loop(t: number) {
        if (t - last > 30) { draw(t); last = t; }
        raf = requestAnimationFrame(loop);
      }

      resize();
      addEventListener('resize', () => { resize(); if (reduced) draw(4000); });
      if (reduced) draw(4000);
      else raf = requestAnimationFrame(loop);
      document.addEventListener('visibilitychange', () => {
        if (reduced) return;
        cancelAnimationFrame(raf);
        if (!document.hidden) raf = requestAnimationFrame(loop);
      });

      // Live readouts: elapsed clock and point counter.
      if (!reduced) {
        const el = document.getElementById('elapsed');
        const pts = document.getElementById('pts');
        let secs = 2 * 3600 + 14 * 60 + 9;
        let n = 25614208;
        setInterval(() => {
          secs++;
          n += 2400 + Math.floor(Math.random() * 1600);
          const p = (v: number) => String(v).padStart(2, '0');
          if (el) el.textContent = `${p(Math.floor(secs / 3600))}:${p(Math.floor(secs / 60) % 60)}:${p(secs % 60)}`;
          if (pts) pts.textContent = n.toLocaleString('en-GB');
        }, 1000);
      }

      // Tabs: visual state only, keyboard reachable.
      document.querySelectorAll<HTMLButtonElement>('.tabs button').forEach((btn, _, all) => {
        btn.addEventListener('click', () => all.forEach((b) => b.setAttribute('aria-selected', String(b === btn))));
      });
    </script>
  </body>
</html>
