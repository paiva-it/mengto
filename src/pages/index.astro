---
import { existsSync } from 'node:fs';

import skills from '../data/skills.json';
import '../styles/global.css';

type Meta = { title: string; kind: 'website' | 'section'; category: string; concept: string; notes?: string };

const metas = import.meta.glob<Meta>('../data/meta/*.json', { eager: true, import: 'default' });
const titleCase = (name: string) => name.split('-').map((w) => w[0].toUpperCase() + w.slice(1)).join(' ');

const cards = skills.map((skill) => {
  const meta = metas[`../data/meta/${skill.name}.json`];
  return {
    ...skill,
    title: meta?.title ?? titleCase(skill.name),
    kind: meta?.kind,
    category: meta?.category ?? 'Unsorted',
    concept: meta?.concept,
    built: Boolean(meta),
    preview: existsSync(`public/previews/${skill.name}.jpg`) ? `/previews/${skill.name}.jpg` : null,
  };
});

const categories = [...new Set(cards.map((c) => c.category))].sort();
const builtCount = cards.filter((c) => c.built).length;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>Web Design Skills</title>
  </head>
  <body class="min-h-screen bg-[#0c0c0d] text-neutral-200 antialiased [font-family:'Inter_Tight',ui-sans-serif,system-ui]">
    <header class="mx-auto max-w-[1440px] px-4 pt-16 pb-10 sm:px-8 sm:pt-24">
      <p class="font-mono text-xs tracking-[0.18em] text-neutral-500 uppercase">
        {cards.length} skills · {builtCount} examples
      </p>
      <h1 class="mt-4 max-w-3xl text-4xl font-medium tracking-tight text-white sm:text-6xl">
        Web design skills, each shown by the page it built.
      </h1>
      <p class="mt-5 max-w-2xl text-base text-neutral-400 sm:text-lg">
        Every card is an example page made by following that skill. Hover to run it live, click to open it.
      </p>

      <div class="mt-10 flex flex-col gap-4 lg:flex-row lg:items-center">
        <label class="relative w-full lg:max-w-sm">
          <span class="sr-only">Search skills</span>
          <input
            id="search"
            type="search"
            placeholder="Search skills…"
            autocomplete="off"
            class="w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-sm text-white placeholder:text-neutral-500 focus:border-white/30 focus:outline-none"
          />
        </label>
        <div id="filters" class="flex flex-wrap gap-2" role="group" aria-label="Filter by category">
          <button type="button" data-cat="" aria-pressed="true" class="chip">All</button>
          {categories.map((c) => <button type="button" data-cat={c} aria-pressed="false" class="chip">{c}</button>)}
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-[1440px] px-4 pb-24 sm:px-8">
      <ul id="grid" class="grid gap-x-6 gap-y-10 sm:grid-cols-2 xl:grid-cols-3">
        {
          cards.map((c) => (
            <li
              class="card group"
              data-cat={c.category}
              data-search={`${c.name} ${c.title} ${c.description} ${c.concept ?? ''} ${c.category}`.toLowerCase()}
            >
              <a
                href={`/skills/${c.name}/`}
                class="preview relative block aspect-[16/10] overflow-hidden rounded-xl border border-white/10 bg-neutral-900"
                data-src={`/skills/${c.name}/?shot`}
                aria-label={`Open ${c.title} example`}
              >
                {c.preview ? (
                  <img src={c.preview} alt="" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
                ) : (
                  <span class="absolute inset-0 grid place-items-center font-mono text-xs text-neutral-600">
                    {c.built ? 'no preview yet' : 'not built yet'}
                  </span>
                )}
              </a>
              <div class="mt-4 flex items-start justify-between gap-4">
                <h2 class="text-lg font-medium text-white">
                  <a href={`/skills/${c.name}/`} class="hover:underline">
                    {c.title}
                  </a>
                </h2>
                {c.kind && (
                  <span class="mt-1 shrink-0 rounded-full border border-white/10 px-2 py-0.5 font-mono text-[10px] tracking-wider text-neutral-400 uppercase">
                    {c.kind}
                  </span>
                )}
              </div>
              <button
                type="button"
                class="copy mt-2 flex [font-variant-ligatures:none] max-w-full items-center gap-2 rounded-md bg-white/[0.05] px-2 py-1 font-mono text-xs text-neutral-300 hover:bg-white/10"
                data-copy={c.command}
                title="Copy command"
              >
                <span class="truncate">{c.command}</span>
                <span class="copied text-neutral-500" aria-live="polite">copy</span>
              </button>
              <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-neutral-400">{c.description}</p>
              {c.concept && <p class="mt-2 text-sm text-neutral-500">Example: {c.concept}</p>}
            </li>
          ))
        }
      </ul>
      <p id="empty" class="hidden py-20 text-center text-neutral-500">No skills match.</p>
    </main>

    <footer class="mx-auto max-w-[1440px] border-t border-white/10 px-4 py-10 text-sm text-neutral-500 sm:px-8">
      Skills by <a href="https://github.com/MengTo/skills" class="text-neutral-300 hover:underline">Meng To</a> (MIT).
      Example pages built with <a href="https://claude.com/claude-code" class="text-neutral-300 hover:underline">Claude Code</a>.
      Photos, libraries, fonts and icons are credited in
      <a href="https://github.com/paiva-it/mengto#credits" class="text-neutral-300 hover:underline">the README</a> and
      <a href="https://github.com/paiva-it/mengto/blob/main/CREDITS.md" class="text-neutral-300 hover:underline">CREDITS.md</a>.
    </footer>

    <style>
      .chip {
        border-radius: 999px;
        border: 1px solid rgb(255 255 255 / 0.1);
        padding: 6px 12px;
        font-size: 13px;
        color: rgb(163 163 163);
        cursor: pointer;
      }
      .chip:hover {
        color: white;
      }
      .chip[aria-pressed='true'] {
        background: white;
        color: black;
        border-color: white;
      }
      .preview :global(iframe) {
        position: absolute;
        top: 0;
        left: 0;
        width: 1440px;
        height: 900px;
        border: 0;
        transform-origin: 0 0;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s;
      }
      .preview :global(iframe.ready) {
        opacity: 1;
      }
    </style>

    <script>
      const search = document.getElementById('search') as HTMLInputElement;
      const filters = document.getElementById('filters')!;
      const cards = [...document.querySelectorAll<HTMLElement>('.card')];
      const empty = document.getElementById('empty')!;
      let category = '';

      const apply = () => {
        const q = search.value.trim().toLowerCase();
        let shown = 0;
        for (const card of cards) {
          const visible = (!category || card.dataset.cat === category) && (!q || card.dataset.search!.includes(q));
          card.hidden = !visible;
          shown += Number(visible);
        }
        empty.classList.toggle('hidden', shown > 0);
      };

      search.addEventListener('input', apply);
      filters.addEventListener('click', (e) => {
        const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-cat]');
        if (!chip) {
          return;
        }
        category = chip.dataset.cat!;
        for (const b of filters.querySelectorAll('button')) {
          b.setAttribute('aria-pressed', String(b === chip));
        }
        apply();
      });

      document.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.copy');
        if (!btn) {
          return;
        }
        await navigator.clipboard.writeText(btn.dataset.copy!);
        const label = btn.querySelector('.copied')!;
        label.textContent = 'copied';
        setTimeout(() => (label.textContent = 'copy'), 1200);
      });

      // Live preview on hover: one iframe at a time, scaled from 1440×900 to the card width.
      // ponytail: single live iframe; heavy WebGL pages make more than one at once unpleasant.
      const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let live: HTMLIFrameElement | null = null;
      let timer = 0;

      const stop = () => {
        clearTimeout(timer);
        live?.remove();
        live = null;
      };

      if (canHover && !reduced) {
        for (const link of document.querySelectorAll<HTMLAnchorElement>('.preview')) {
          link.addEventListener('mouseenter', () => {
            stop();
            timer = window.setTimeout(() => {
              const frame = document.createElement('iframe');
              frame.src = link.dataset.src!;
              frame.tabIndex = -1;
              frame.setAttribute('aria-hidden', 'true');
              frame.style.transform = `scale(${link.clientWidth / 1440})`;
              frame.addEventListener('load', () => setTimeout(() => frame.classList.add('ready'), 400));
              link.append(frame);
              live = frame;
            }, 250);
          });
          link.addEventListener('mouseleave', stop);
        }
      }
    </script>
  </body>
</html>
